SECRET_CONFIG_KEYS = {"IMAP_PASSWORD", "SMTP_PASSWORD", "OPENROUTER_API_KEY", "API_KEY", "TTYCHATTER_API_KEY"}


def strip_config_quotes(value: str) -> str:
    """Strip one simple matching quote pair from a config value.

    Config files are KEY=VALUE, but operators often write shell-looking values
    such as KEY="value".  This is intentionally not a full shell parser; it only
    removes one outer matching single-quote or double-quote pair.
    """
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        return value[1:-1]
    return value


def parse_config_line(raw: str) -> Optional[Tuple[str, str]]:
    """Parse one mailbot config line.

    Accepted syntax is KEY=VALUE, with optional whitespace around KEY and VALUE.
    For compatibility with shell-style files copied from rc examples, an
    optional leading "export " is ignored.  Keys are normalized to uppercase.
    Lines that are blank, comments, or lack '=' return None.
    """
    line = raw.strip().lstrip("\ufeff")
    if not line or line.startswith("#") or "=" not in line:
        return None
    if line.lower().startswith("export "):
        line = line[len("export "):].lstrip()
    key, value = line.split("=", 1)
    key = key.strip().upper()
    if not key:
        return None
    return key, strip_config_quotes(value)


def config_line_key(raw: str) -> str:
    parsed = parse_config_line(raw)
    return parsed[0] if parsed else ""


def config_parse_summary(path: Path) -> Tuple[int, List[str]]:
    recognized = 0
    ignored: List[str] = []
    if not path.exists():
        return recognized, ignored
    for lineno, raw in enumerate(path.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        parsed = parse_config_line(raw)
        if parsed is None:
            ignored.append(f"line {lineno}: not KEY=VALUE")
            continue
        key, _value = parsed
        if key in KNOWN_CONFIG_KEYS:
            recognized += 1
        elif key != "CONFIG_FILE":
            ignored.append(f"line {lineno}: unknown key {key}")
    return recognized, ignored


def default_config_dir() -> Path:
    xdg_config_home = os.environ.get("XDG_CONFIG_HOME", "").strip()
    if xdg_config_home:
        return expand_path(xdg_config_home) / "ttychatter" / "mailbot"
    return Path.home() / ".config" / "ttychatter" / "mailbot"


def default_config_file() -> Path:
    env_path = os.environ.get(CONFIG_ENV_VAR, "").strip()
    if env_path:
        return expand_path(env_path)
    return default_config_dir() / "config"


def resolve_config_file(cli_value: Optional[str]) -> Path:
    if cli_value:
        return expand_path(cli_value)
    return default_config_file()


def default_config_file_string() -> str:
    return str(default_config_file())


def parse_bool(value: str, default: bool = False) -> bool:
    if value == "":
        return default
    return value.strip().lower() in {"1", "yes", "y", "true", "on"}


def parse_int(value: str, default: int) -> int:
    try:
        return int(value)
    except ValueError:
        return default


def split_addresses(value: str) -> List[str]:
    """Normalize a user supplied address list.

    ALLOWED_FROM is security-sensitive.  A human may write it as one address,
    a comma-separated list, a semicolon-separated list, or a whitespace-separated
    list.  The mail headers are later parsed with email.utils.parseaddr(), so
    this function stores only lowercase bare addresses.  It deliberately accepts
    the wildcard "*" for temporary lab testing, but administrators should not
    leave that enabled on a real public mailbox.
    """
    out: List[str] = []
    for item in re.split(r"[;,\s]+", value.strip()):
        item = item.strip().lower()
        if not item:
            continue
        if item == "*" or item.startswith("@") or item.startswith("*@"):
            out.append(item)
            continue
        parsed = parseaddr(item)[1].strip().lower()
        if parsed:
            out.append(parsed)
    return out



def split_config_words(value: str) -> List[str]:
    """Split comma, semicolon, or whitespace separated config words."""
    return [item.strip() for item in re.split(r"[;,\s]+", value.strip()) if item.strip()]


def normalize_keyword(value: str) -> str:
    return (value or "").strip().lower().replace("_", "-")


def normalize_output_mode(value: str, default: str = "auto") -> str:
    value = normalize_keyword(value)
    if value in {"body", "inline", "text"}:
        return "body"
    if value in {"attachment", "attach", "file"}:
        return "attachment"
    if value in {"auto", "default", ""}:
        return default
    return default


def set_config_value(config_file: Path, key: str, value: str) -> None:
    config_file.parent.mkdir(parents=True, exist_ok=True)
    lines: List[str] = []
    replaced = False
    if config_file.exists():
        lines = config_file.read_text(encoding="utf-8", errors="replace").splitlines()
    out: List[str] = []
    wanted = key.upper()
    for line in lines:
        if config_line_key(line) == wanted:
            out.append(f"{wanted}={value}")
            replaced = True
        else:
            out.append(line)
    if not replaced:
        out.append(f"{key.upper()}={value}")
    config_file.write_text("\n".join(out) + "\n", encoding="utf-8")
    try:
        os.chmod(config_file, 0o600)
    except OSError:
        pass




def config_key_present(config_file: Path, key: str) -> bool:
    wanted = key.strip().upper()
    if not wanted or not config_file.exists():
        return False
    for line in config_file.read_text(encoding="utf-8", errors="replace").splitlines():
        if config_line_key(line) == wanted:
            return True
    return False


def unset_config_value(config_file: Path, key: str) -> None:
    if not config_file.exists():
        return
    wanted = key.upper()
    lines = config_file.read_text(encoding="utf-8", errors="replace").splitlines()
    out = [line for line in lines if config_line_key(line) != wanted]
    config_file.write_text("\n".join(out) + ("\n" if out else ""), encoding="utf-8")


def load_config(path: Path = DEFAULT_CONFIG_FILE) -> Config:
    cfg = Config(config_file=path)
    # Password-file defaults follow the selected config file. This keeps
    # --config-file and TTYCHATTER_MAILBOT_CONFIG coherent.
    cfg.imap_password_gpg_file = path.parent / "imap-password.gpg"
    cfg.smtp_password_gpg_file = path.parent / "smtp-password.gpg"
    if not path.exists():
        cfg.config_load_notes.append(f"config file not found: {path}")
        return cfg

    for lineno, raw in enumerate(path.read_text(encoding="utf-8", errors="replace").splitlines(), start=1):
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        parsed = parse_config_line(raw)
        if parsed is None:
            cfg.config_load_notes.append(f"ignored line {lineno}: expected KEY=VALUE")
            continue
        key, value = parsed
        known = True

        if key == "IMAP_HOST": cfg.imap_host = value
        elif key == "IMAP_PORT": cfg.imap_port = parse_int(value, cfg.imap_port)
        elif key == "IMAP_SSL": cfg.imap_ssl = parse_bool(value, cfg.imap_ssl)
        elif key == "IMAP_USER": cfg.imap_user = value
        elif key == "IMAP_PASSWORD": cfg.imap_password = value
        elif key == "IMAP_PASSWORD_GPG_FILE": cfg.imap_password_gpg_file = expand_path(value)
        elif key == "IMAP_MAILBOX": cfg.imap_mailbox = value

        elif key == "SEND_METHOD": cfg.send_method = value.lower()
        elif key == "REPLY_METHOD": cfg.send_method = value.lower()
        elif key == "SENDMAIL": cfg.sendmail_path = value
        elif key == "SENDMAIL_PATH": cfg.sendmail_path = value

        elif key == "SMTP_HOST": cfg.smtp_host = value
        elif key == "SMTP_PORT": cfg.smtp_port = parse_int(value, cfg.smtp_port)
        elif key == "SMTP_SSL": cfg.smtp_ssl = parse_bool(value, cfg.smtp_ssl)
        elif key == "SMTP_STARTTLS": cfg.smtp_starttls = parse_bool(value, cfg.smtp_starttls)
        elif key == "SMTP_USER": cfg.smtp_user = value
        elif key == "SMTP_PASSWORD": cfg.smtp_password = value
        elif key == "SMTP_PASSWORD_GPG_FILE": cfg.smtp_password_gpg_file = expand_path(value)

        elif key == "MAIL_FROM": cfg.mail_from = value
        elif key == "MAIL_TO": cfg.mail_to = value
        elif key == "ALLOWED_FROM": cfg.allowed_from = split_addresses(value)
        elif key in {"DENY_FROM", "BANNED_FROM", "BANNED_LIST"}: cfg.deny_from = split_addresses(value)
        elif key == "REJECT_SELF_SENDER": cfg.reject_self_sender = parse_bool(value, cfg.reject_self_sender)

        elif key == "SUBJECT_PREFIX": cfg.subject_prefix = value
        elif key == "SUBJECT_SEPARATOR": cfg.subject_separator = value
        elif key == "SESSION_OPEN_DELIM": cfg.session_open_delim = value
        elif key == "SESSION_CLOSE_DELIM": cfg.session_close_delim = value
        elif key == "ALLOW_COMMANDS_IN_SUBJECT": cfg.allow_commands_in_subject = parse_bool(value, cfg.allow_commands_in_subject)
        elif key == "ALLOW_BODY_COMMAND_SUBJECTS": cfg.allow_body_command_subjects = parse_bool(value, cfg.allow_body_command_subjects)
        elif key == "ALLOW_BARE_CONTROL_SUBJECTS": cfg.allow_bare_control_subjects = parse_bool(value, cfg.allow_bare_control_subjects)
        elif key == "ALLOW_LEGACY_BRACED_CONTROL": cfg.allow_legacy_braced_control = parse_bool(value, cfg.allow_legacy_braced_control)
        elif key == "RE_SESSION_SUBJECTS": cfg.re_session_subjects = normalize_keyword(value)

        elif key == "OPEN_TO_PUBLIC": cfg.open_to_public = parse_bool(value, cfg.open_to_public)
        elif key == "PUBLIC_SESSION_MODE": cfg.public_session_mode = normalize_keyword(value)
        elif key == "PUBLIC_SESSION_PREFIX": cfg.public_session_prefix = sanitize_session_name(value)
        elif key == "PUBLIC_SHARED_SESSION": cfg.public_shared_session = sanitize_session_name(value)
        elif key == "PUBLIC_ALLOW_NAMED_SESSIONS": cfg.public_allow_named_sessions = parse_bool(value, cfg.public_allow_named_sessions)
        elif key == "PUBLIC_ALLOWED_COMMANDS": cfg.public_allowed_commands = [normalize_keyword(x) for x in split_config_words(value)]
        elif key == "PUBLIC_SESSION_CLEANUP": cfg.public_session_cleanup = parse_bool(value, cfg.public_session_cleanup)
        elif key == "PUBLIC_SESSION_TTL_HOURS": cfg.public_session_ttl_hours = max(0, parse_int(value, cfg.public_session_ttl_hours))
        elif key == "PUBLIC_SESSION_IDLE_HOURS": cfg.public_session_idle_hours = max(0, parse_int(value, cfg.public_session_idle_hours))
        elif key == "PUBLIC_SESSION_MAX_COUNT": cfg.public_session_max_count = max(0, parse_int(value, cfg.public_session_max_count))
        elif key == "PUBLIC_SESSION_MAX_TURNS": cfg.public_session_max_turns = max(0, parse_int(value, cfg.public_session_max_turns))
        elif key == "PUBLIC_SESSION_INDEX_FILE": cfg.public_session_index_file = expand_path(value)
        elif key == "PUBLIC_SESSION_ARCHIVE_ON_DELETE": cfg.public_session_archive_on_delete = parse_bool(value, cfg.public_session_archive_on_delete)
        elif key == "PUBLIC_SESSION_ARCHIVE_USER_TOGGLE": cfg.public_session_archive_user_toggle = parse_bool(value, cfg.public_session_archive_user_toggle)
        elif key == "PUBLIC_SESSION_ARCHIVE_FAILURE_POLICY": cfg.public_session_archive_failure_policy = normalize_keyword(value)
        elif key == "PUBLIC_SESSION_ARCHIVE_MAX_BYTES": cfg.public_session_archive_max_bytes = max(1, parse_int(value, cfg.public_session_archive_max_bytes))

        elif key == "POLL_INTERVAL": cfg.poll_interval = max(1, parse_int(value, cfg.poll_interval))
        elif key == "MAX_MESSAGES_PER_RUN": cfg.max_messages_per_run = max(1, parse_int(value, cfg.max_messages_per_run))
        elif key == "MAX_BODY_BYTES": cfg.max_body_bytes = max(1, parse_int(value, cfg.max_body_bytes))
        elif key == "MAX_ATTACHMENT_BYTES": cfg.max_attachment_bytes = max(1, parse_int(value, cfg.max_attachment_bytes))
        elif key == "PROCESS_ATTACHMENTS": cfg.process_attachments = parse_bool(value, cfg.process_attachments)
        elif key == "MARK_SEEN": cfg.mark_seen = parse_bool(value, cfg.mark_seen)

        elif key == "TTYCHATTER_COMMAND": cfg.ttychatter_command = value
        elif key == "TTYCHATTER_EXTRA_ARGS": cfg.ttychatter_extra_args = value
        elif key == "SESSION_DIR": cfg.session_dir = expand_path(value)
        elif key == "ATTACHMENT_DIR": cfg.attachment_dir = expand_path(value)
        elif key == "WORK_DIR": cfg.work_dir = expand_path(value)
        elif key == "PROCESSED_DB": cfg.processed_db = expand_path(value)

        elif key == "REPLY_SUBJECT_PREFIX": cfg.reply_subject_prefix = value
        elif key == "INCLUDE_TTYCHATTER_STDERR": cfg.include_ttychatter_stderr = parse_bool(value, cfg.include_ttychatter_stderr)

        elif key == "USER_REGISTRY": cfg.user_registry = parse_bool(value, cfg.user_registry)
        elif key == "SUBJECT_SESSIONS": cfg.subject_sessions = parse_bool(value, cfg.subject_sessions)
        elif key == "USER_REGISTRY_FILE": cfg.user_registry_file = expand_path(value)
        elif key == "USER_HOME_ROOT": cfg.user_home_root = expand_path(value)
        elif key == "USER_SECRET_DIR": cfg.user_secret_dir = expand_path(value)
        elif key in {"DEFAULT_OPENROUTER_API_KEY_FILE", "SERVER_OPENROUTER_API_KEY_FILE", "OPENROUTER_API_KEY_FILE"}: cfg.default_openrouter_api_key_file = expand_path(value)
        elif key == "LEGACY_OPENROUTER_CONFIG_FILE": cfg.legacy_openrouter_config_file = expand_path(value)
        elif key == "MIGRATE_PLAINTEXT_OPENROUTER_API_KEY": cfg.migrate_plaintext_openrouter_api_key = parse_bool(value, cfg.migrate_plaintext_openrouter_api_key)
        elif key == "ALLOW_USER_API_KEYS": cfg.allow_user_api_keys = parse_bool(value, cfg.allow_user_api_keys)
        elif key == "USER_TTYCONFIG_ALLOWED_KEYS": cfg.user_ttyconfig_allowed_keys = [x.upper() for x in split_config_words(value)]

        elif key == "SPAM_PROTECTION": cfg.spam_protection = parse_bool(value, cfg.spam_protection)
        elif key == "SPAM_REJECT_AUTO_SUBMITTED": cfg.spam_reject_auto_submitted = parse_bool(value, cfg.spam_reject_auto_submitted)
        elif key == "SPAM_REJECT_LIST_MAIL": cfg.spam_reject_list_mail = parse_bool(value, cfg.spam_reject_list_mail)
        elif key == "SPAM_MAX_RECIPIENTS": cfg.spam_max_recipients = max(1, parse_int(value, cfg.spam_max_recipients))
        elif key == "RATE_LIMIT_ENABLED": cfg.rate_limit_enabled = parse_bool(value, cfg.rate_limit_enabled)
        elif key == "RATE_LIMIT_DB": cfg.rate_limit_db = expand_path(value)
        elif key == "RATE_LIMIT_WINDOW_SECONDS": cfg.rate_limit_window_seconds = max(1, parse_int(value, cfg.rate_limit_window_seconds))
        elif key == "RATE_LIMIT_SENDER_MESSAGES": cfg.rate_limit_sender_messages = max(1, parse_int(value, cfg.rate_limit_sender_messages))
        elif key == "RATE_LIMIT_GLOBAL_MESSAGES": cfg.rate_limit_global_messages = max(1, parse_int(value, cfg.rate_limit_global_messages))
        elif key == "RATE_LIMIT_PUBLIC_SENDER_MESSAGES": cfg.rate_limit_public_sender_messages = max(1, parse_int(value, cfg.rate_limit_public_sender_messages))
        elif key == "RATE_LIMIT_PUBLIC_GLOBAL_MESSAGES": cfg.rate_limit_public_global_messages = max(1, parse_int(value, cfg.rate_limit_public_global_messages))
        elif key == "RATE_LIMIT_ALLOWED_FROM": cfg.rate_limit_allowed_from = parse_bool(value, cfg.rate_limit_allowed_from)
        elif key == "ABUSE_LIMIT_ALLOWED_FROM": cfg.abuse_limit_allowed_from = parse_bool(value, cfg.abuse_limit_allowed_from)
        elif key == "MAX_MESSAGE_BYTES": cfg.max_message_bytes = max(1, parse_int(value, cfg.max_message_bytes))
        elif key == "MAX_ATTACHMENT_COUNT": cfg.max_attachment_count = max(0, parse_int(value, cfg.max_attachment_count))
        elif key == "MAX_TOTAL_ATTACHMENT_BYTES": cfg.max_total_attachment_bytes = max(0, parse_int(value, cfg.max_total_attachment_bytes))
        elif key == "DAILY_QUOTA_ENABLED": cfg.daily_quota_enabled = parse_bool(value, cfg.daily_quota_enabled)
        elif key == "DAILY_QUOTA_DB": cfg.daily_quota_db = expand_path(value)
        elif key == "DAILY_QUOTA_SENDER_MESSAGES": cfg.daily_quota_sender_messages = max(0, parse_int(value, cfg.daily_quota_sender_messages))
        elif key == "DAILY_QUOTA_PUBLIC_SENDER_MESSAGES": cfg.daily_quota_public_sender_messages = max(0, parse_int(value, cfg.daily_quota_public_sender_messages))
        elif key == "DAILY_QUOTA_GLOBAL_MESSAGES": cfg.daily_quota_global_messages = max(0, parse_int(value, cfg.daily_quota_global_messages))
        elif key == "MAX_SESSIONS_PER_SENDER": cfg.max_sessions_per_sender = max(0, parse_int(value, cfg.max_sessions_per_sender))
        elif key == "API_COST_PROTECTION": cfg.api_cost_protection = parse_bool(value, cfg.api_cost_protection)
        elif key == "API_MAX_INPUT_CHARS": cfg.api_max_input_chars = max(0, parse_int(value, cfg.api_max_input_chars))
        elif key == "API_MAX_ESTIMATED_TOKENS": cfg.api_max_estimated_tokens = max(0, parse_int(value, cfg.api_max_estimated_tokens))
        elif key == "API_MAX_ATTACHMENT_BYTES": cfg.api_max_attachment_bytes = max(0, parse_int(value, cfg.api_max_attachment_bytes))

        elif key == "CONFIG_SUBJECT_TOKEN": cfg.config_subject_token = value
        elif key == "MODELS_SUBJECT_TOKEN": cfg.models_subject_token = value
        elif key == "COMMAND_SUBJECT_TOKEN": cfg.command_subject_token = value
        elif key == "MAILBOT_SUBJECT_TOKEN": cfg.mailbot_subject_token = value
        elif key == "BODY_COMMAND_SUBJECTS": cfg.body_command_subjects = split_config_words(value)
        elif key == "MAILBOT_MANPAGE_FILE": cfg.mailbot_manpage_file = expand_path(value) if value else None
        elif key == "CONFIG_UPDATE_REQUIRES_ATTACHMENT": cfg.config_update_requires_attachment = parse_bool(value, cfg.config_update_requires_attachment)
        elif key == "MODEL_CACHE_FILE": cfg.model_cache_file = expand_path(value)
        elif key == "TTYCHATTER_CONTROL_TIMEOUT": cfg.ttychatter_control_timeout = max(1, parse_int(value, cfg.ttychatter_control_timeout))
        elif key == "SESSION_LIST_HEAD_LINES": cfg.session_list_head_lines = max(0, parse_int(value, cfg.session_list_head_lines))
        elif key == "SESSION_LIST_TAIL_LINES": cfg.session_list_tail_lines = max(0, parse_int(value, cfg.session_list_tail_lines))
        elif key == "SESSION_LIST_MAX_SESSIONS": cfg.session_list_max_sessions = max(1, parse_int(value, cfg.session_list_max_sessions))
        elif key == "SESSION_PREVIEW_LINE_CHARS": cfg.session_preview_line_chars = max(20, parse_int(value, cfg.session_preview_line_chars))
        elif key == "SESSION_SEARCH_MAX_MATCHES": cfg.session_search_max_matches = max(1, parse_int(value, cfg.session_search_max_matches))
        elif key == "MODEL_SEARCH_MAX_MATCHES": cfg.model_search_max_matches = max(1, parse_int(value, cfg.model_search_max_matches))
        elif key == "COMMAND_OUTPUT_MODE": cfg.command_output_mode = normalize_output_mode(value, cfg.command_output_mode)
        elif key == "MODEL_CACHE_OUTPUT": cfg.model_cache_output = normalize_output_mode(value, cfg.model_cache_output)
        elif key == "MODEL_SEARCH_OUTPUT": cfg.model_search_output = normalize_output_mode(value, cfg.model_search_output)
        elif key == "MODEL_LIST_OUTPUT": cfg.model_list_output = normalize_output_mode(value, cfg.model_list_output)
        elif key == "SESSIONS_OUTPUT": cfg.sessions_output = normalize_output_mode(value, cfg.sessions_output)
        elif key == "CONFIG_OUTPUT": cfg.config_output = normalize_output_mode(value, cfg.config_output)
        elif key == "OUTPUT_INLINE_MAX_BYTES": cfg.output_inline_max_bytes = max(1000, parse_int(value, cfg.output_inline_max_bytes))
        elif key == "MAX_COMMAND_OUTPUT_BYTES": cfg.max_command_output_bytes = max(1000, parse_int(value, cfg.max_command_output_bytes))
        elif key == "MAX_OUTGOING_ATTACHMENT_BYTES": cfg.max_outgoing_attachment_bytes = max(1, parse_int(value, cfg.max_outgoing_attachment_bytes))
        elif key == "CONFIG_FILE":
            pass
        else:
            known = False

        if not known:
            cfg.config_load_notes.append(f"ignored line {lineno}: unknown key {key}")

    # Environment overrides are useful on servers, cron jobs, and test runs.
    cfg.imap_password = os.environ.get("TTYCHATTER_IMAP_PASSWORD", cfg.imap_password)
    cfg.smtp_password = os.environ.get("TTYCHATTER_SMTP_PASSWORD", cfg.smtp_password)
    env_manpage = os.environ.get("TTYCHATTER_MAILBOT_MANPAGE_FILE", "").strip()
    if env_manpage:
        cfg.mailbot_manpage_file = expand_path(env_manpage)

    if cfg.re_session_subjects not in {"no", "public", "always"}:
        cfg.config_load_notes.append("RE_SESSION_SUBJECTS must be no, public, or always; using public")
        cfg.re_session_subjects = "public"
    if cfg.public_session_mode not in {"per-sender", "per-message", "shared"}:
        cfg.config_load_notes.append("PUBLIC_SESSION_MODE must be per-sender, per-message, or shared; using per-sender")
        cfg.public_session_mode = "per-sender"
    if not cfg.public_session_prefix:
        cfg.public_session_prefix = "public"
    if not cfg.public_shared_session:
        cfg.public_shared_session = "public-demo"
    if cfg.public_session_archive_failure_policy not in {"keep", "delete"}:
        cfg.config_load_notes.append("PUBLIC_SESSION_ARCHIVE_FAILURE_POLICY must be keep or delete; using keep")
        cfg.public_session_archive_failure_policy = "keep"
    if not cfg.body_command_subjects:
        cfg.body_command_subjects = ["MAILBOT", "CMD"]
    cfg.user_ttyconfig_allowed_keys = sorted({x.strip().upper() for x in cfg.user_ttyconfig_allowed_keys if x.strip()})
    if not cfg.user_ttyconfig_allowed_keys:
        cfg.config_load_notes.append("USER_TTYCONFIG_ALLOWED_KEYS empty; using MODEL and CONTEXT_TURNS")
        cfg.user_ttyconfig_allowed_keys = ["CONTEXT_TURNS", "MODEL"]
    return cfg


# ---------------------------------------------------------------------------
# GPG helpers
# ---------------------------------------------------------------------------
# The mailbot supports encrypted IMAP/SMTP passwords using external gpg.  This
# mirrors ttychatter's API-key philosophy: do not implement crypto in the app;
# call a standard Unix tool that users already understand and can replace.
# ---------------------------------------------------------------------------


def gpg_available() -> bool:
    from shutil import which
    return which("gpg") is not None


def gpg_subprocess_environment() -> dict:
    """Return an environment suitable for invoking gpg from this process.

    gpg-agent/pinentry frequently needs GPG_TTY in order to ask for a
    passphrase.  Interactive shells often export it, but a mailbot test run
    such as `ttychatter.mailbot --once` should not depend on shell startup
    files doing that correctly.  If this process has a controlling tty, pass
    that location to gpg.  Daemon/service runs without a tty still need an
    already-unlocked agent, plaintext config secrets, sendmail delivery, or a
    deployment-specific secret manager.
    """
    env = os.environ.copy()
    if env.get("GPG_TTY"):
        return env
    for stream in (sys.stdin, sys.stderr, sys.stdout):
        try:
            if stream.isatty():
                env["GPG_TTY"] = os.ttyname(stream.fileno())
                break
        except Exception:
            continue
    return env


def gpg_failure(action: str, path: Path, stderr: str) -> RuntimeError:
    detail = (stderr or "").strip()
    lines = [f"gpg failed {action} {path}"]
    if detail:
        lines.append(detail)
    lower = detail.lower()
    if (
        "problem with the agent" in lower
        or "bad session key" in lower
        or "no pinentry" in lower
        or "inappropriate ioctl" in lower
        or "permission denied" in lower
    ):
        lines.extend([
            "",
            "This usually means gpg-agent or pinentry could not unlock the password file.",
            f"Process user: {getpass.getuser()}",
            f"HOME: {Path.home()}",
            f"GPG_TTY: {os.environ.get('GPG_TTY', '') or '(unset)'}",
            "Try the same decrypt as the mailbot user:",
            f"  gpg --decrypt {shlex.quote(str(path))}",
            "For an interactive shell, also try:",
            "  export GPG_TTY=$(tty)",
            "  gpgconf --kill gpg-agent",
            f"  gpg --decrypt {shlex.quote(str(path))}",
            "Check that ~/.gnupg is owned by the mailbot user and is not group/world writable.",
            "Do not test this by switching to root unless the daemon is actually intended to run as root; root changes HOME, GNUPGHOME, and the gpg-agent socket.",
            "For unattended daemon runs, the agent must already be unlocked/cached, or use a plaintext password line protected by config-file permissions, or use SEND_METHOD=sendmail to avoid SMTP password decryption.",
        ])
    return RuntimeError("\n".join(lines))


def decrypt_gpg_file(path: Path) -> str:
    proc = subprocess.run(
        ["gpg", "--quiet", "--decrypt", str(path)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=gpg_subprocess_environment(),
    )
    if proc.returncode != 0:
        raise gpg_failure("decrypting", path, proc.stderr)
    # Trim transport line endings added by echo(1) or edited secret files while
    # preserving other characters in the password. A literal CR/LF cannot be
    # used in an IMAP LOGIN atom and commonly produces a server-side BAD reply.
    return proc.stdout.rstrip("\r\n")


def encrypt_secret_to_gpg(path: Path, secret: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    proc = subprocess.run(
        ["gpg", "--symmetric", "--cipher-algo", "AES256", "--yes", "--output", str(path)],
        input=secret,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=gpg_subprocess_environment(),
    )
    if proc.returncode != 0:
        raise gpg_failure("encrypting", path, proc.stderr)
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def load_password(plain: str, gpg_path: Path) -> str:
    if plain:
        return plain.rstrip("\r\n")
    if gpg_path.exists():
        return decrypt_gpg_file(gpg_path)
    return ""


def password_source_description(plain: str, gpg_path: Path) -> str:
    if plain:
        return "plaintext config/environment"
    if gpg_path.exists():
        return f"gpg file {gpg_path}"
    return f"missing; set plaintext password or create {gpg_path}"


def reject_imap_login_value(label: str, value: str) -> None:
    if not value:
        raise RuntimeError(f"{label} is unset; check CONFIG_FILE with --config")
    if "\r" in value or "\n" in value:
        raise RuntimeError(
            f"{label} contains a carriage return or newline. Re-enter it with "
            f"{PROGRAM} --set-imap-password --gpg or edit the config so the value is one line."
        )


def imap_login_failure(exc: Exception, cfg: Config) -> RuntimeError:
    text = str(exc)
    lines = [
        f"IMAP login failed for {cfg.imap_user!r} at {cfg.imap_host}:{cfg.imap_port}: {text}",
        f"CONFIG_FILE={cfg.config_file}",
        f"IMAP_PASSWORD_SOURCE={password_source_description(cfg.imap_password, cfg.imap_password_gpg_file)}",
    ]
    if "BAD" in text.upper():
        lines.extend([
            "The server rejected the LOGIN command syntax, not merely the credentials.",
            "Common causes are an empty IMAP_USER, a password containing CR/LF, or running under a different user/HOME than the configured mailbot account.",
            "Do not test by switching to root unless the service is configured to run as root; use --config-file if you must inspect a specific config.",
        ])
    else:
        lines.append("Check the username, password, SSL/STARTTLS/port settings, and provider IMAP-login policy.")
    return RuntimeError("\n".join(lines))



# ---------------------------------------------------------------------------
# User registry, per-user ttychatter homes, and API-key secret files
# ---------------------------------------------------------------------------
# The mailbot is the multi-user boundary. ttychatter.python still sees a
# normal HOME with a normal ~/.config/ttychatter/openrouter/config, but that
# HOME is synthesized per sender. API keys are injected through the subprocess
# environment after being read from chmod 600 secret files; they are not written
# to ttychatter config.
# ---------------------------------------------------------------------------


def chmod_private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path, 0o700)
    except OSError:
        pass


def chmod_private_file(path: Path) -> None:
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def write_private_text(path: Path, text: str, mode: int = 0o600) -> None:
    chmod_private_dir(path.parent)
    tmp = path.with_name(f"{path.name}.tmp-{os.getpid()}-{int(time.time() * 1000)}")
    tmp.write_text(text, encoding="utf-8")
    try:
        os.chmod(tmp, mode)
    except OSError:
        pass
    tmp.replace(path)
    try:
        os.chmod(path, mode)
    except OSError:
        pass


def read_json_file(path: Path, default: Any) -> Any:
    try:
        if path.exists():
            return json.loads(path.read_text(encoding="utf-8", errors="replace"))
    except Exception:
        return default
    return default


def write_json_file(path: Path, value: Any) -> None:
    data = json.dumps(value, indent=2, sort_keys=True) + "\n"
    write_private_text(path, data, mode=0o600)


def read_secret_file(path: Path) -> str:
    try:
        if not path.exists():
            return ""
        return path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def write_secret_file(path: Path, secret: str) -> None:
    secret = (secret or "").strip()
    if not secret:
        raise ValueError("empty secret refused")
    if "\r" in secret or "\n" in secret:
        raise ValueError("secret must be a single line")
    write_private_text(path, secret + "\n", mode=0o600)


def plaintext_openrouter_key_from_config(path: Path) -> str:
    if not path.exists():
        return ""
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        parsed = parse_config_line(raw)
        if parsed is None:
            continue
        key, value = parsed
        if key in {"OPENROUTER_API_KEY", "API_KEY", "TTYCHATTER_API_KEY"} and value and "REDACTED" not in value.upper():
            return value.strip()
    return ""


def remove_plaintext_openrouter_keys_from_config(path: Path) -> Optional[Path]:
    if not path.exists():
        return None
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    out: List[str] = []
    removed = False
    for raw in lines:
        key = config_line_key(raw)
        if key in {"OPENROUTER_API_KEY", "API_KEY", "TTYCHATTER_API_KEY"}:
            removed = True
            continue
        out.append(raw)
    if not removed:
        return None
    backup = path.with_name(path.name + ".bak-secret-migration-" + time.strftime("%Y%m%d-%H%M%S"))
    backup.write_text("\n".join(lines) + "\n", encoding="utf-8")
    chmod_private_file(backup)
    write_private_text(path, "\n".join(out).rstrip() + ("\n" if out else ""), mode=0o600)
    return backup


def migrate_plaintext_openrouter_api_key(cfg: Config) -> None:
    """Move a legacy plaintext OpenRouter key to the configured secret file.

    This targets the exact hazard of ~/.config/ttychatter/openrouter/config
    containing OPENROUTER_API_KEY. A backup is kept, and an existing different
    DEFAULT_OPENROUTER_API_KEY_FILE prevents destructive migration.
    """
    if not cfg.migrate_plaintext_openrouter_api_key:
        return
    legacy = cfg.legacy_openrouter_config_file
    if not legacy.exists():
        return
    key = plaintext_openrouter_key_from_config(legacy)
    if not key:
        return
    existing = read_secret_file(cfg.default_openrouter_api_key_file)
    if existing and existing != key:
        cfg.config_load_notes.append(
            f"legacy OpenRouter key remains in {legacy}; default key file differs: {cfg.default_openrouter_api_key_file}"
        )
        return
    if not existing:
        write_secret_file(cfg.default_openrouter_api_key_file, key)
    backup = remove_plaintext_openrouter_keys_from_config(legacy)
    if backup:
        cfg.config_load_notes.append(
            f"migrated plaintext OpenRouter key from {legacy} to {cfg.default_openrouter_api_key_file}; backup {backup}"
        )


def user_id_for_sender(sender: str) -> str:
    email_addr = sender_address(sender)
    digest = hashlib.sha256(email_addr.encode("utf-8")).hexdigest()[:16]
    return "u_" + digest


def profile_for_user_id(cfg: Config, email_addr: str, user_id: str) -> UserProfile:
    home = cfg.user_home_root / user_id
    tty_cfg_dir = home / ".config" / "ttychatter" / "openrouter"
    data_dir = home / ".local" / "share" / "ttychatter" / "openrouter"
    return UserProfile(
        email=email_addr,
        user_id=user_id,
        home_dir=home,
        config_file=tty_cfg_dir / "config",
        session_dir=data_dir / "sessions",
        attachment_dir=data_dir / "attachments",
        model_cache_file=tty_cfg_dir / "models-cache.json",
        favorites_file=tty_cfg_dir / "model-favorites.txt",
        api_key_file=cfg.user_secret_dir / f"{user_id}.openrouter.key",
    )


def load_user_registry(cfg: Config) -> dict:
    data = read_json_file(cfg.user_registry_file, {"version": 1, "users": {}})
    if not isinstance(data, dict):
        data = {"version": 1, "users": {}}
    if not isinstance(data.get("users"), dict):
        data["users"] = {}
    data.setdefault("version", 1)
    return data


def save_user_registry(cfg: Config, data: dict) -> None:
    write_json_file(cfg.user_registry_file, data)


def initial_user_config_text(profile: UserProfile) -> str:
    return textwrap.dedent(f"""\
        # ttychatter.mailbot per-user ttychatter.python config
        # This file stores non-secret ttychatter preferences only.
        # API keys are stored as chmod 600 files outside .config and injected by mailbot.
        CONTEXT_TURNS=12
        MODEL=openrouter/auto
        SESSION_DIR={profile.session_dir}
        ATTACHMENT_DIR={profile.attachment_dir}
        MODEL_CACHE_FILE={profile.model_cache_file}
        MODEL_FAVORITES_FILE={profile.favorites_file}
        """)


def ensure_user_profile(cfg: Config, profile: UserProfile) -> None:
    chmod_private_dir(cfg.user_home_root)
    chmod_private_dir(profile.home_dir)
    for path in [
        profile.config_file.parent,
        profile.session_dir,
        profile.attachment_dir,
        profile.model_cache_file.parent,
        profile.favorites_file.parent,
        cfg.user_secret_dir,
    ]:
        chmod_private_dir(path)
    if not profile.config_file.exists():
        write_private_text(profile.config_file, initial_user_config_text(profile), mode=0o600)
    if not config_key_present(profile.config_file, "MODEL"):
        set_config_value(profile.config_file, "MODEL", "openrouter/auto")
    # Enforce per-user paths while preserving user-editable preferences.
    set_config_value(profile.config_file, "SESSION_DIR", str(profile.session_dir))
    set_config_value(profile.config_file, "ATTACHMENT_DIR", str(profile.attachment_dir))
    set_config_value(profile.config_file, "MODEL_CACHE_FILE", str(profile.model_cache_file))
    set_config_value(profile.config_file, "MODEL_FAVORITES_FILE", str(profile.favorites_file))
    # If a user somehow placed a plaintext key in their ttychatter config,
    # immediately move it to the secret file and remove the config line.
    key = plaintext_openrouter_key_from_config(profile.config_file)
    if key:
        write_secret_file(profile.api_key_file, key)
        remove_plaintext_openrouter_keys_from_config(profile.config_file)


def lookup_or_create_user_profile(cfg: Config, sender: str) -> UserProfile:
    email_addr = sender_address(sender)
    if not email_addr:
        raise ValueError("cannot create registry user for empty sender")
    user_id = user_id_for_sender(email_addr)
    data = load_user_registry(cfg)
    users = data.setdefault("users", {})
    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    entry = users.get(email_addr)
    if not isinstance(entry, dict):
        entry = {"user_id": user_id, "created_at": now}
    entry["user_id"] = entry.get("user_id") or user_id
    entry["email"] = email_addr
    entry["updated_at"] = now
    entry["home_dir"] = str(cfg.user_home_root / entry["user_id"])
    entry["api_key_file"] = str(cfg.user_secret_dir / f"{entry['user_id']}.openrouter.key")
    users[email_addr] = entry
    save_user_registry(cfg, data)
    profile = profile_for_user_id(cfg, email_addr, entry["user_id"])
    ensure_user_profile(cfg, profile)
    return profile


def resolve_openrouter_api_key(cfg: Config, profile: Optional[UserProfile]) -> Tuple[str, str]:
    if profile is not None:
        user_key = read_secret_file(profile.api_key_file)
        if user_key:
            return user_key, f"user secret file {profile.api_key_file}"
    default_key = read_secret_file(cfg.default_openrouter_api_key_file)
    if default_key:
        return default_key, f"default secret file {cfg.default_openrouter_api_key_file}"
    env_key = os.environ.get("OPENROUTER_API_KEY", "").strip()
    if env_key:
        return env_key, "environment OPENROUTER_API_KEY"
    env_key = os.environ.get("TTYCHATTER_API_KEY", "").strip()
    if env_key:
        return env_key, "environment TTYCHATTER_API_KEY"
    return "", "missing"


def runtime_config_for_sender(cfg: Config, sender: str) -> Config:
    if not cfg.user_registry:
        key, source = resolve_openrouter_api_key(cfg, None)
        return replace(cfg, runtime_openrouter_api_key=key, runtime_api_key_source=source)
    profile = lookup_or_create_user_profile(cfg, sender)
    key, source = resolve_openrouter_api_key(cfg, profile)
    return replace(
        cfg,
        session_dir=profile.session_dir,
        attachment_dir=profile.attachment_dir,
        model_cache_file=profile.model_cache_file,
        work_dir=cfg.work_dir / profile.user_id,
        runtime_user_email=profile.email,
        runtime_user_id=profile.user_id,
        runtime_ttychatter_home=profile.home_dir,
        runtime_ttychatter_config_file=profile.config_file,
        runtime_user_api_key_file=profile.api_key_file,
        runtime_openrouter_api_key=key,
        runtime_api_key_source=source,
    )


def ttychatter_environment(cfg: Config) -> dict:
    env = os.environ.copy()
    if cfg.runtime_ttychatter_home is not None:
        home = cfg.runtime_ttychatter_home
        env["HOME"] = str(home)
        env["XDG_CONFIG_HOME"] = str(home / ".config")
        env["XDG_DATA_HOME"] = str(home / ".local" / "share")
        env["XDG_CACHE_HOME"] = str(home / ".cache")
    if cfg.runtime_openrouter_api_key:
        env["OPENROUTER_API_KEY"] = cfg.runtime_openrouter_api_key
        env["TTYCHATTER_API_KEY"] = cfg.runtime_openrouter_api_key
    return env


def save_runtime_user_api_key(cfg: Config, secret: str) -> str:
    if not cfg.allow_user_api_keys:
        return "per-user API keys are disabled by ALLOW_USER_API_KEYS=0\n"
    if cfg.runtime_user_api_key_file is None:
        return "per-user API-key storage requires USER_REGISTRY=1\n"
    write_secret_file(cfg.runtime_user_api_key_file, secret)
    if cfg.runtime_ttychatter_config_file is not None:
        unset_config_value(cfg.runtime_ttychatter_config_file, "OPENROUTER_API_KEY")
        unset_config_value(cfg.runtime_ttychatter_config_file, "API_KEY")
        unset_config_value(cfg.runtime_ttychatter_config_file, "TTYCHATTER_API_KEY")
    return f"saved per-user OpenRouter API key to secret file: {cfg.runtime_user_api_key_file}\nplaintext API-key config entries removed if present\n"


def forget_runtime_user_api_key(cfg: Config) -> str:
    if cfg.runtime_user_api_key_file is None:
        return "per-user API-key storage requires USER_REGISTRY=1\n"
    try:
        cfg.runtime_user_api_key_file.unlink()
        removed = True
    except FileNotFoundError:
        removed = False
    if cfg.runtime_ttychatter_config_file is not None:
        unset_config_value(cfg.runtime_ttychatter_config_file, "OPENROUTER_API_KEY")
        unset_config_value(cfg.runtime_ttychatter_config_file, "API_KEY")
        unset_config_value(cfg.runtime_ttychatter_config_file, "TTYCHATTER_API_KEY")
    if removed:
        return "removed per-user OpenRouter API key; this user now falls back to the server default key if available\n"
    return "no per-user OpenRouter API key was stored; this user already falls back to the server default key if available\n"


def runtime_user_status(cfg: Config) -> str:
    lines = ["ttychatter.mailbot user registry status"]
    if not cfg.user_registry:
        lines.append("USER_REGISTRY=0")
        lines.append(f"api_key_source={cfg.runtime_api_key_source or 'not resolved'}")
        return "\n".join(lines) + "\n"
    lines.extend([
        f"sender={cfg.runtime_user_email or '(not mapped)'}",
        f"user_id={cfg.runtime_user_id or '(not mapped)'}",
        f"ttychatter_home={cfg.runtime_ttychatter_home or '(not mapped)'}",
        f"ttychatter_config={cfg.runtime_ttychatter_config_file or '(not mapped)'}",
        f"session_dir={cfg.session_dir}",
        f"model_cache_file={cfg.model_cache_file}",
        f"user_api_key_file={cfg.runtime_user_api_key_file or '(not mapped)'}",
        f"api_key_source={cfg.runtime_api_key_source or 'missing'}",
    ])
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------------------
# Spam and abuse controls
# ---------------------------------------------------------------------------


def header_value(msg: Message, name: str) -> str:
    return (msg.get(name, "") or "").strip()


def message_recipient_count(msg: Message) -> int:
    fields = []
    for name in ("To", "Cc"):
        value = msg.get(name)
        if value:
            fields.append(value)
    return len(getaddresses(fields))


def spam_reject_reason(cfg: Config, msg: Message, sender: str) -> Optional[str]:
    if not cfg.spam_protection:
        return None
    if cfg.spam_reject_auto_submitted:
        auto = header_value(msg, "Auto-Submitted").lower()
        if auto and auto != "no":
            return f"Auto-Submitted={auto}"
        suppress = header_value(msg, "X-Auto-Response-Suppress").lower()
        if suppress and suppress != "none":
            return "auto-response suppression header present"
    if cfg.spam_reject_list_mail:
        precedence = header_value(msg, "Precedence").lower()
        if precedence in {"bulk", "junk", "list"}:
            return f"Precedence={precedence}"
        for name in ("List-Id", "List-Unsubscribe", "List-Post", "Feedback-ID"):
            if header_value(msg, name):
                return f"mailing-list/bulk header present: {name}"
    if cfg.spam_max_recipients > 0:
        count = message_recipient_count(msg)
        if count > cfg.spam_max_recipients:
            return f"too many visible recipients: {count} > {cfg.spam_max_recipients}"
    return None


def load_rate_limit_data(cfg: Config) -> dict:
    data = read_json_file(cfg.rate_limit_db, {"version": 1, "events": []})
    if not isinstance(data, dict):
        return {"version": 1, "events": []}
    if not isinstance(data.get("events"), list):
        data["events"] = []
    data.setdefault("version", 1)
    return data


def rate_limit_sender_key(sender: str) -> str:
    normalized = sender_address(sender)
    return hashlib.sha256(normalized.encode("utf-8")).hexdigest()[:24]


def rate_limit_check(cfg: Config, sender: str, privileged: bool, record: bool = False) -> Optional[str]:
    if not cfg.rate_limit_enabled:
        return None
    if privileged and not cfg.rate_limit_allowed_from:
        return None
    now = time.time()
    cutoff = now - max(1, cfg.rate_limit_window_seconds)
    data = load_rate_limit_data(cfg)
    events = []
    for item in data.get("events", []):
        try:
            when = float(item.get("t", 0))
        except Exception:
            continue
        if when >= cutoff:
            events.append({"t": when, "sender": str(item.get("sender", ""))})
    key = rate_limit_sender_key(sender)
    public_unprivileged = bool(cfg.open_to_public and not privileged)
    sender_limit = cfg.rate_limit_public_sender_messages if public_unprivileged else cfg.rate_limit_sender_messages
    global_limit = cfg.rate_limit_public_global_messages if public_unprivileged else cfg.rate_limit_global_messages
    sender_count = sum(1 for item in events if item.get("sender") == key)
    global_count = len(events)
    window = cfg.rate_limit_window_seconds
    if sender_limit > 0 and sender_count >= sender_limit:
        return f"rate limit exceeded for sender: {sender_count}/{sender_limit} in {window}s"
    if global_limit > 0 and global_count >= global_limit:
        return f"global rate limit exceeded: {global_count}/{global_limit} in {window}s"
    if record:
        events.append({"t": now, "sender": key})
        data["events"] = events
        write_json_file(cfg.rate_limit_db, data)
    return None


def abuse_admin_bypass(cfg: Config, privileged: bool) -> bool:
    return bool(privileged and not cfg.abuse_limit_allowed_from)


def message_size_bytes(msg: Message) -> int:
    try:
        return len(msg.as_bytes(policy=email.policy.default))
    except Exception:
        return len(str(msg).encode("utf-8", errors="replace"))


def attachment_stats(msg: Message) -> Tuple[int, int]:
    count = 0
    total = 0
    for part in msg.walk():
        if part.is_multipart():
            continue
        disposition = (part.get_content_disposition() or "").lower()
        filename = part.get_filename()
        if disposition != "attachment" and not filename:
            continue
        count += 1
        payload = part.get_payload(decode=True)
        if payload is not None:
            total += len(payload)
    return count, total


def message_limit_reject_reason(cfg: Config, msg: Message, privileged: bool) -> Optional[str]:
    if abuse_admin_bypass(cfg, privileged):
        return None
    size = message_size_bytes(msg)
    if cfg.max_message_bytes > 0 and size > cfg.max_message_bytes:
        return f"message too large: {size} bytes > {cfg.max_message_bytes}"
    count, total = attachment_stats(msg)
    if cfg.max_attachment_count > 0 and count > cfg.max_attachment_count:
        return f"too many attachments: {count} > {cfg.max_attachment_count}"
    if cfg.max_total_attachment_bytes > 0 and total > cfg.max_total_attachment_bytes:
        return f"attachments too large in total: {total} bytes > {cfg.max_total_attachment_bytes}"
    return None


def load_daily_quota_data(cfg: Config) -> dict:
    data = read_json_file(cfg.daily_quota_db, {"version": 1, "days": {}})
    if not isinstance(data, dict):
        data = {"version": 1, "days": {}}
    if not isinstance(data.get("days"), dict):
        data["days"] = {}
    data.setdefault("version", 1)
    return data


def daily_quota_check(cfg: Config, sender: str, privileged: bool, record: bool = False) -> Optional[str]:
    if not cfg.daily_quota_enabled:
        return None
    if abuse_admin_bypass(cfg, privileged):
        return None
    today = time.strftime("%Y-%m-%d", time.localtime())
    key = rate_limit_sender_key(sender)
    data = load_daily_quota_data(cfg)
    days = data.setdefault("days", {})
    day = days.setdefault(today, {"global": 0, "senders": {}})
    # Keep only today plus one previous day so the file cannot grow forever.
    data["days"] = {k: v for k, v in days.items() if k >= today}
    senders = day.setdefault("senders", {})
    sender_count = int(senders.get(key, 0))
    global_count = int(day.get("global", 0))
    public_unprivileged = bool(cfg.open_to_public and not privileged)
    sender_limit = cfg.daily_quota_public_sender_messages if public_unprivileged else cfg.daily_quota_sender_messages
    global_limit = cfg.daily_quota_global_messages
    if sender_limit > 0 and sender_count >= sender_limit:
        return f"daily quota exceeded for sender: {sender_count}/{sender_limit}"
    if global_limit > 0 and global_count >= global_limit:
        return f"daily global quota exceeded: {global_count}/{global_limit}"
    if record:
        senders[key] = sender_count + 1
        day["global"] = global_count + 1
        write_json_file(cfg.daily_quota_db, data)
    return None


def session_count_reject_reason(cfg: Config, session: str, privileged: bool) -> Optional[str]:
    if cfg.max_sessions_per_sender <= 0 or abuse_admin_bypass(cfg, privileged):
        return None
    existing = session_files_newest_first(cfg)
    path = session_log_path(cfg, session)
    if path.exists():
        return None
    if len(existing) >= cfg.max_sessions_per_sender:
        return f"session-count limit exceeded: {len(existing)}/{cfg.max_sessions_per_sender}; resume an existing session or archive old sessions"
    return None


def rough_token_count(text_chars: int, attachment_bytes: int) -> int:
    return max(0, (text_chars + attachment_bytes) // 4)


def api_cost_reject_reason(cfg: Config, body: str, attachments: List[Path], privileged: bool) -> Optional[str]:
    if not cfg.api_cost_protection or abuse_admin_bypass(cfg, privileged):
        return None
    body_chars = len((body or "").encode("utf-8", errors="replace"))
    attach_bytes = 0
    for path in attachments:
        try:
            attach_bytes += path.stat().st_size
        except OSError:
            pass
    total_chars = body_chars + attach_bytes
    if cfg.api_max_input_chars > 0 and total_chars > cfg.api_max_input_chars:
        return f"API input too large: {total_chars} bytes/chars > {cfg.api_max_input_chars}"
    if cfg.api_max_attachment_bytes > 0 and attach_bytes > cfg.api_max_attachment_bytes:
        return f"API attachment input too large: {attach_bytes} bytes > {cfg.api_max_attachment_bytes}"
    est_tokens = rough_token_count(body_chars, attach_bytes)
    if cfg.api_max_estimated_tokens > 0 and est_tokens > cfg.api_max_estimated_tokens:
        return f"estimated API token load too high: {est_tokens} > {cfg.api_max_estimated_tokens}"
    return None

# ---------------------------------------------------------------------------
# Message parsing
# ---------------------------------------------------------------------------
# Email is messy.  The mailbot keeps a deliberately conservative parser: prefer
# text/plain, ignore untrusted HTML when possible, size-limit message bodies, and
# save attachments into an isolated work directory before handing them to
# ttychatter.  Future maintainers should be careful here.  A mailbot is a bridge
# from the public mail world to a paid AI API; every boundary needs limits.
# ---------------------------------------------------------------------------



def subject_marker_from_parts(prefix: str, separator: str = ":") -> str:
    prefix = (prefix or "").strip()
    separator = separator if separator is not None else ":"
    if not prefix:
        return ""
    if not separator:
        return prefix
    return prefix if prefix.endswith(separator) else prefix + separator


def subject_marker(cfg: Config) -> str:
    return subject_marker_from_parts(cfg.subject_prefix, cfg.subject_separator)


def subject_regex(prefix: str) -> re.Pattern[str]:
    """Return the braced-session matcher for older callers/tests."""
    return subject_braced_regex(prefix)


def subject_braced_regex(prefix: str, separator: str = ":", open_delim: str = "{", close_delim: str = "}") -> re.Pattern[str]:
    marker = subject_marker_from_parts(prefix, separator)
    open_delim = open_delim or "{"
    close_delim = close_delim or "}"
    return re.compile(rf"\b{re.escape(marker)}{re.escape(open_delim)}(.+?){re.escape(close_delim)}")


def subject_bare_regex(prefix: str, separator: str = ":", open_delim: str = "{") -> re.Pattern[str]:
    # Bare control subjects intentionally do not accept the configured session
    # opening delimiter. The whole remainder of the Subject header is the
    # command line, so subjects such as "Re: tc:search mailbot" and
    # "tc:model-list --all" work.
    marker = subject_marker_from_parts(prefix, separator)
    negative = rf"(?!{re.escape(open_delim)})" if open_delim else ""
    return re.compile(rf"\b{re.escape(marker)}{negative}([^\r\n]+)")


def strip_reply_prefixes(subject: str) -> Tuple[str, bool]:
    text = (subject or "").strip()
    saw_reply = False
    while True:
        match = re.match(r"^(?:(?:re|fw|fwd)\s*:\s*)", text, flags=re.IGNORECASE)
        if not match:
            break
        saw_reply = True
        text = text[match.end():].strip()
    return text, saw_reply


def re_session_candidate(subject: str, cfg: Config) -> Optional[str]:
    stripped, saw_reply = strip_reply_prefixes(subject)
    if not saw_reply or not stripped:
        return None
    # A reply to a normal control subject is still parsed by the normal tc:/bot
    # grammar. This helper is only for the explicit "Re: session_name" shortcut.
    if subject_marker(cfg) and stripped.casefold().startswith(subject_marker(cfg).casefold()):
        return None
    if stripped.casefold() in {x.casefold() for x in cfg.body_command_subjects}:
        return None
    # Keep the convention simple: the whole remaining subject is the candidate
    # session name. Unsafe names are rejected later by session validation.
    candidate = stripped.splitlines()[0].strip()
    return candidate or None


def subject_session_candidate(subject: str, cfg: Config) -> Optional[str]:
    """Return the plain email subject as a session name candidate.

    This is the registry-era default: a user writes a normal email subject, and
    that subject names their private session. Reply prefixes are stripped so
    Re: naturally resumes the same session. Control subjects still win first.
    """
    stripped, _saw_reply = strip_reply_prefixes(subject)
    if not stripped:
        return None
    marker = subject_marker(cfg)
    if marker and stripped.casefold().startswith(marker.casefold()):
        return None
    if stripped.casefold() in {x.casefold() for x in cfg.body_command_subjects}:
        return None
    candidate = stripped.splitlines()[0].strip()
    if not candidate:
        return None
    return candidate[:160]


def body_after_first_command_line(body: str) -> str:
    lines = (body or "").splitlines()
    for idx, raw in enumerate(lines):
        line = raw.strip()
        if not line or line.startswith(">"):
            continue
        return "\n".join(lines[idx + 1:]).strip()
    return ""


def canonical_mailbot_command_word(word: str) -> str:
    """Return the canonical command name for a first command word."""
    command = normalize_keyword(word)
    aliases = {
        "?": "help",
        "admin-help": "help-admin",
        "operator-help": "help-admin",
        "manual": "manpage",
        "get-manpage": "manpage",
        "fetch-manpage": "manpage",
        "list": "sessions",
        "list-sessions": "sessions",
        "session-list": "sessions",
        "model-list": "models",
        "models-list": "models",
        "list-models": "models",
        "show-models": "models",
        "update-model-list": "update-models",
        "update-model-cache": "update-models",
        "refresh-models": "update-models",
        "refresh-model-cache": "update-models",
        "cache-models": "model-cache",
        "cached-models": "model-cache",
        "models-cache": "model-cache",
        "model-json": "model-cache",
        "search-models": "model-search",
        "models-search": "model-search",
        "model-list-search": "model-search",
        "find-model": "model-search",
        "find-models": "model-search",
        "grep-models": "model-search",
        "delete": "delete-session",
        "rm": "delete-session",
        "remove-session": "delete-session",
        "rm-session": "delete-session",
        "router-list": "routers",
        "faves": "favorites",
        "unbookmark-model": "unfavorite-model",
        "doctor": "ttydoctor",
        "ttyconfig-summary": "ttyconfig",
        "prefs": "ttyconfig",
        "preferences": "ttyconfig",
        "set": "tty-set",
        "unset": "tty-unset",
        "profile": "user",
        "registry": "user",
        "set-api-key": "api-key",
        "forget-api-key": "forget-api-key",
        "remove-api-key": "forget-api-key",
        "archive-public-session": "archive-session",
        "archive-on-expire": "archive-session",
        "public-archive": "archive-session",
        "archive-opt-in": "archive-session",
        "archive-opt-out": "archive-session",
    }
    return aliases.get(command, command)


def known_mailbot_command_words() -> set[str]:
    return {
        "help",
        "help-admin",
        "manpage",
        "config",
        "sessions",
        "search",
        "search-session",
        "rename-session",
        "delete-session",
        "archive-session",
        "model-cache",
        "model-search",
        "update-models",
        "models",
        "routers",
        "favorites",
        "favorite-model",
        "unfavorite-model",
        "test-model",
        "show-memory",
        "clear-memory",
        "ttyconfig",
        "ttydoctor",
        "credits",
        "user",
        "api-key",
        "forget-api-key",
        "tty-set",
        "tty-unset",
    }


def looks_like_mailbot_command_line(line: str, cfg: Config) -> bool:
    """Return true when a BODY_COMMAND_SUBJECT first line is a known command.

    This keeps Subject: MAILBOT useful for both command mail and ordinary AI
    prompts.  Known command words run as commands; other text is treated as a
    new chat prompt.
    """
    line = (line or "").strip()
    if not line:
        return False
    if parse_braced_delete_command(line) is not None:
        return True
    try:
        parts = shlex.split(line)
    except ValueError:
        parts = line.split()
    if not parts:
        return False
    first = parts[0]
    if is_config_token(first, cfg):
        return True
    if first == (cfg.models_subject_token or "MODELS").strip():
        return True
    command = canonical_mailbot_command_word(first)
    return command in known_mailbot_command_words()


def normalized_command_tokens_for_compare(line: str) -> List[str]:
    """Canonicalize a command line enough to compare common aliases.

    This helper is only used for the intuitive repeated-subject command case.
    It must not broadly convert ordinary subjects into commands, because
    SUBJECT_SESSIONS=1 deliberately lets normal email subjects name chats.
    """
    text = (line or "").strip()
    if not text:
        return []
    try:
        parts = shlex.split(text)
    except ValueError:
        parts = text.split()
    if not parts:
        return []
    parts[0] = canonical_mailbot_command_word(parts[0])
    return parts


def repeated_bare_command_subject_request(subject: str, cfg: Config, body: str) -> Optional[SubjectRequest]:
    """Catch obvious bare help/manual subjects without stealing prompts.

    A plain subject is normally a session name when SUBJECT_SESSIONS=1. That
    remains true for ordinary prompts. This special case is intentionally narrow:
    it handles the common user mistake Subject: help / Body: help, plus manual
    and help-admin, but it does not turn every command-looking subject into
    command mail.
    """
    if not cfg.allow_commands_in_subject:
        return None
    stripped, _saw_reply = strip_reply_prefixes(subject or "")
    stripped = stripped.splitlines()[0].strip() if stripped else ""
    if not stripped:
        return None
    marker = subject_marker(cfg)
    if marker and stripped.casefold().startswith(marker.casefold()):
        return None
    if stripped.casefold() in {x.casefold() for x in cfg.body_command_subjects}:
        return None

    subject_tokens = normalized_command_tokens_for_compare(stripped)
    intuitive_bare_commands = {"help", "manpage", "help-admin"}
    if not subject_tokens or subject_tokens[0] not in intuitive_bare_commands:
        return None

    first_line = first_command_line_from_body(body)
    if not first_line:
        return SubjectRequest("command", stripped, raw=stripped)

    body_tokens = normalized_command_tokens_for_compare(first_line)
    if body_tokens and body_tokens == subject_tokens:
        return SubjectRequest("command", first_line, raw=stripped)

    return None


def body_subject_request(subject: str, cfg: Config, body: str) -> Optional[SubjectRequest]:
    if not cfg.allow_body_command_subjects:
        return None
    subj = (subject or "").strip()
    stripped, _saw_reply = strip_reply_prefixes(subj)
    tokens = {x.strip().casefold() for x in cfg.body_command_subjects if x.strip()}
    if stripped.casefold() not in tokens:
        return None
    first_line = first_command_line_from_body(body)
    if not first_line:
        return SubjectRequest("command", "help", raw=stripped)
    try:
        parts = shlex.split(first_line)
    except ValueError:
        parts = first_line.split()
    if parts:
        head = normalize_keyword(parts[0])
        if head in {"session", "chat"} and len(parts) >= 2:
            return SubjectRequest("session", parts[1], raw=first_line, body_override=body_after_first_command_line(body))
        if head in {"new", "chat-new"}:
            return SubjectRequest("session", "new", raw=first_line, body_override=body_after_first_command_line(body))
        if is_config_token(parts[0], cfg) and len(parts) == 1:
            return SubjectRequest("config", cfg.config_subject_token, raw=first_line)
        models_token = (cfg.models_subject_token or "MODELS").strip()
        if models_token and parts[0] == models_token:
            rest = first_line[len(parts[0]):].strip()
            if rest:
                return SubjectRequest("command", "model-search " + shlex.quote(rest), raw=first_line)
            return SubjectRequest("command", "model-cache", raw=first_line)
    if looks_like_mailbot_command_line(first_line, cfg):
        # For Subject: MAILBOT / CMD, the first body line is already the
        # complete command line. Do not append it to itself for commands that
        # accept arguments, such as models or api-key.
        return SubjectRequest("command", first_line, raw=first_line)
    return SubjectRequest("session", "new", raw=first_line, body_override=body)


def token_equals(value: str, token: str) -> bool:
    return (value or "").strip().casefold() == (token or "").strip().casefold()


def first_shell_token(text: str) -> str:
    try:
        parts = shlex.split(text or "")
    except ValueError:
        parts = (text or "").split()
    return parts[0] if parts else ""


def split_first_word(text: str) -> Tuple[str, str]:
    text = (text or "").strip()
    if not text:
        return "", ""
    first = first_shell_token(text)
    if first:
        return first, text[len(first):].strip()
    parts = text.split(None, 1)
    return parts[0], parts[1] if len(parts) > 1 else ""


def parse_session_from_subject(subject: str, prefix: str) -> Optional[str]:
    """Return the braced session token, if any, for older callers/tests."""
    match = subject_braced_regex(prefix).search(subject or "")
    if not match:
        return None
    token = match.group(1).strip()
    return token or None


def is_config_token(token: str, cfg: Config) -> bool:
    return token_equals(token, cfg.config_subject_token)


def strip_command_envelope(token: str, cfg: Config) -> str:
    """Remove tc:CMD and legacy tc:{MAILBOT:...} wrappers.

    The canonical 0.4 control forms are tc:CONFIG, tc:MODELS, tc:CMD, and
    tc:command args.  Braced MAILBOT forms remain only as compatibility aliases.
    """
    token = (token or "").strip()
    if not token:
        return ""

    legacy = (cfg.mailbot_subject_token or "MAILBOT").strip()
    legacy_lower = legacy.casefold()
    lower = token.casefold()
    if legacy_lower and lower == legacy_lower:
        return ""
    if legacy_lower and lower.startswith(legacy_lower + ":"):
        return token[len(legacy) + 1:].strip()

    command_token = (cfg.command_subject_token or "CMD").strip()
    command_lower = command_token.casefold()
    aliases = {command_lower, "cmds", "command", "commands"}
    first, rest = split_first_word(token)
    if first.casefold() in aliases:
        return rest
    for marker in (command_token + ":", "CMD:", "CMDS:", "COMMAND:", "COMMANDS:"):
        if lower.startswith(marker.casefold()):
            return token[len(marker):].strip()
    return token


def legacy_mailbot_command_from_token(token: str, body: str, cfg: Config) -> Optional[str]:
    """Translate legacy MAILBOT braced tokens into a command line."""
    if not cfg.allow_legacy_braced_control:
        return None
    token = (token or "").strip()
    legacy = (cfg.mailbot_subject_token or "MAILBOT").strip()
    if not token or not legacy:
        return None
    lower = token.casefold()
    legacy_lower = legacy.casefold()
    if lower == legacy_lower or lower.startswith(legacy_lower + ":"):
        stripped = strip_command_envelope(token, cfg)
        return maybe_append_body_arguments(stripped, body) if stripped else (first_command_line_from_body(body) or "help")
    return None


def parse_subject_request(subject: str, cfg: Config, body: str = "") -> Optional[SubjectRequest]:
    subject = subject or ""

    body_request = body_subject_request(subject, cfg, body)
    if body_request is not None:
        return body_request

    repeated_bare_command = repeated_bare_command_subject_request(subject, cfg, body)
    if repeated_bare_command is not None:
        return repeated_bare_command

    braced = subject_braced_regex(
        cfg.subject_prefix,
        cfg.subject_separator,
        cfg.session_open_delim,
        cfg.session_close_delim,
    ).search(subject)
    if braced:
        token = braced.group(1).strip()
        if not token:
            return None
        if is_config_token(token, cfg):
            return SubjectRequest("config", cfg.config_subject_token, raw=token, legacy=True)
        legacy_command = legacy_mailbot_command_from_token(token, body, cfg)
        if legacy_command is not None:
            return SubjectRequest("command", legacy_command, raw=token, legacy=True)
        # tc:{new} deliberately remains the literal session request. run_ttychatter()
        # passes no session argument for it, letting ttychatter.python create its own
        # default session-YYYY-MM-DD-HH-MM-SS name.
        return SubjectRequest("session", token, raw=token)

    if cfg.allow_commands_in_subject and cfg.allow_bare_control_subjects:
        bare = subject_bare_regex(cfg.subject_prefix, cfg.subject_separator, cfg.session_open_delim).search(subject)
    else:
        bare = None
    if bare:
        command_text = bare.group(1).strip()
        if command_text:
            first, rest = split_first_word(command_text)
            if is_config_token(first, cfg) and not rest:
                return SubjectRequest("config", cfg.config_subject_token, raw=command_text)

            stripped = strip_command_envelope(command_text, cfg)
            if stripped != command_text:
                return SubjectRequest("command", maybe_append_body_arguments(stripped, body) if stripped else (first_command_line_from_body(body) or "help"), raw=command_text)

            models_token = (cfg.models_subject_token or "MODELS").strip()
            # MODELS is an exact uppercase control token so tc:MODELS remains a
            # cache-only shorthand while tc:models can still be used as the ordinary
            # allowlisted ttychatter model-list command.
            if models_token and first == models_token:
                if not rest:
                    return SubjectRequest("command", "model-cache", raw=command_text)
                return SubjectRequest("command", "model-search " + shlex.quote(rest), raw=command_text)

            return SubjectRequest("command", maybe_append_body_arguments(command_text, body), raw=command_text)

    re_mode = normalize_keyword(cfg.re_session_subjects)
    if re_mode == "always" or (re_mode == "public" and cfg.open_to_public):
        candidate = re_session_candidate(subject, cfg)
        if candidate:
            return SubjectRequest("session", candidate, raw=candidate, public_resume=True)

    if cfg.subject_sessions:
        candidate = subject_session_candidate(subject, cfg)
        if candidate:
            return SubjectRequest("session", candidate, raw=candidate)

    return None


def is_config_request(session: str, cfg: Config) -> bool:
    """Return true for the configured config workflow token."""
    return is_config_token(session, cfg)


def decode_part_payload(part: Message) -> str:
    payload = part.get_payload(decode=True)
    if payload is None:
        raw = part.get_payload()
        return raw if isinstance(raw, str) else ""
    charset = part.get_content_charset() or "utf-8"
    return payload.decode(charset, errors="replace")


def strip_html(text: str) -> str:
    text = re.sub(r"(?is)<(script|style).*?>.*?</\1>", "", text)
    text = re.sub(r"(?s)<br\s*/?>", "\n", text)
    text = re.sub(r"(?s)</p>", "\n\n", text)
    text = re.sub(r"(?s)<.*?>", "", text)
    return html.unescape(text).strip()


def extract_body(msg: Message, max_body_bytes: int) -> str:
    text_plain: List[str] = []
    text_html: List[str] = []

    if msg.is_multipart():
        for part in msg.walk():
            if part.is_multipart():
                continue
            disposition = (part.get_content_disposition() or "").lower()
            if disposition == "attachment":
                continue
            content_type = part.get_content_type()
            if content_type == "text/plain":
                text_plain.append(decode_part_payload(part))
            elif content_type == "text/html":
                text_html.append(strip_html(decode_part_payload(part)))
    else:
        if msg.get_content_type() == "text/html":
            text_html.append(strip_html(decode_part_payload(msg)))
        else:
            text_plain.append(decode_part_payload(msg))

    body = "\n".join(x for x in text_plain if x.strip()).strip()
    if not body:
        body = "\n".join(x for x in text_html if x.strip()).strip()

    raw = body.encode("utf-8", errors="replace")
    if len(raw) > max_body_bytes:
        raw = raw[:max_body_bytes]
        body = raw.decode("utf-8", errors="replace") + "\n\n[message body truncated by ttychatter.mailbot]"
    return body.strip()


def safe_filename(name: str) -> str:
    name = os.path.basename(name or "attachment")
    name = re.sub(r"[^A-Za-z0-9._-]+", "_", name).strip("._-")
    return name or "attachment"


def save_attachments(msg: Message, directory: Path, max_attachment_bytes: int) -> List[Path]:
    directory.mkdir(parents=True, exist_ok=True)
    saved: List[Path] = []
    counter = 1
    for part in msg.walk():
        if part.is_multipart():
            continue
        disposition = (part.get_content_disposition() or "").lower()
        filename = part.get_filename()
        if disposition != "attachment" and not filename:
            continue
        payload = part.get_payload(decode=True)
        if payload is None:
            continue
        if len(payload) > max_attachment_bytes:
            continue
        base = safe_filename(filename or f"attachment-{counter}")
        path = directory / f"{counter:02d}-{base}"
        path.write_bytes(payload)
        saved.append(path)
        counter += 1
    return saved



def looks_like_config_text(text: str) -> bool:
    """Very small sanity check for emailed config files.

    This does not try to validate every possible key.  Its job is to prevent an
    obviously wrong attachment, such as an image or forwarded HTML body, from
    replacing the mailbot config.  Real parsing still happens through load_config
    after the file is written.
    """
    useful = 0
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        parsed = parse_config_line(raw)
        if parsed is None:
            return False
        key, _value = parsed
        if key not in KNOWN_CONFIG_KEYS:
            return False
        useful += 1
    return useful > 0


def find_config_attachment(msg: Message, max_attachment_bytes: int) -> Optional[Tuple[str, str]]:
    """Return (filename, text) for the first plausible config attachment.

    The config-over-email workflow is intentionally attachment-based.  The bot
    sends the current config as an attached text file, the user edits that file,
    and then mails it back with subject tc:CONFIG.  Requiring an attachment
    avoids accidentally treating a normal email body as a replacement config.
    """
    for part in msg.walk():
        if part.is_multipart():
            continue
        filename = part.get_filename() or ''
        disposition = (part.get_content_disposition() or '').lower()
        if disposition != 'attachment' and not filename:
            continue
        safe = safe_filename(filename or 'config.txt')
        if not (safe.endswith('.txt') or 'config' in safe.lower()):
            continue
        payload = part.get_payload(decode=True)
        if payload is None or len(payload) > max_attachment_bytes:
            continue
        charset = part.get_content_charset() or 'utf-8'
        text = payload.decode(charset, errors='replace')
        if looks_like_config_text(text):
            return safe, text
    return None


def build_config_reply(cfg: Config, original: Message, body: str, attachment_text: Optional[str] = None) -> EmailMessage:
    """Build a reply for tc:CONFIG.

    If attachment_text is provided, it is attached as a text/plain config file.
    This is the safe round-trip path: request config, receive attachment, edit
    locally, reply with edited attachment.
    """
    reply_to = parseaddr(original.get('Reply-To') or original.get('From') or '')[1]
    dest = cfg.mail_to or reply_to
    subject = original.get('Subject', f'{subject_marker(cfg)}{cfg.config_subject_token}')
    msg = EmailMessage()
    msg['From'] = cfg.mail_from or cfg.smtp_user or cfg.imap_user
    msg['To'] = dest
    msg['Subject'] = f'{cfg.reply_subject_prefix} {subject}'
    msg['Message-ID'] = make_msgid(domain=(msg['From'].split('@')[-1] if '@' in msg['From'] else None))
    if original.get('Message-ID'):
        msg['In-Reply-To'] = original.get('Message-ID')
        msg['References'] = original.get('Message-ID')
    msg.set_content(mailbot_reply_body(cfg, body or "(empty response)", "success", command=cfg.config_subject_token))
    if attachment_text is not None:
        msg.add_attachment(attachment_text.encode('utf-8'), maintype='text', subtype='plain', filename='ttychatter-mailbot-config.txt')
    return msg


def public_config_text(cfg: Config) -> str:
    """Return the current config file, redacting plaintext password lines.

    The goal is editable configuration without accidentally emailing secrets in
    the clear. Encrypted password file paths are safe to show; plaintext
    password values are replaced with a comment.
    """
    if not cfg.config_file.exists():
        return '# ttychatter.mailbot config does not exist yet\n'
    out = []
    for raw in cfg.config_file.read_text(encoding='utf-8', errors='replace').splitlines():
        key = config_line_key(raw)
        if key in SECRET_CONFIG_KEYS:
            out.append(f'# {key}=REDACTED_BY_TTYCHATTER_MAILBOT')
        else:
            out.append(raw)
    return '\n'.join(out).rstrip() + '\n'


def apply_config_attachment(cfg: Config, text: str) -> Path:
    """Atomically replace the config file with emailed config text.

    A timestamped backup is kept beside the original.  This is intentionally
    simple and inspectable: future maintainers can see exactly what file was
    replaced and where the backup went.
    """
    cfg.config_file.parent.mkdir(parents=True, exist_ok=True)
    backup = cfg.config_file.with_name(cfg.config_file.name + '.bak-' + time.strftime('%Y%m%d-%H%M%S'))
    if cfg.config_file.exists():
        backup.write_text(cfg.config_file.read_text(encoding='utf-8', errors='replace'), encoding='utf-8')
    tmp = cfg.config_file.with_suffix(cfg.config_file.suffix + '.tmp')
    tmp.write_text(text.rstrip() + '\n', encoding='utf-8')
    tmp.replace(cfg.config_file)
    try:
        os.chmod(cfg.config_file, 0o600)
    except OSError:
        pass
    return backup

# ---------------------------------------------------------------------------
# IMAP / SMTP transport
# ---------------------------------------------------------------------------
# IMAP is only used for receiving and state flags.  SMTP or sendmail is used for
# replies.  OpenBSD users with smtpd can set SEND_METHOD=sendmail and avoid SMTP
# password storage entirely.  Users with hosted mail can configure SMTP.
# ---------------------------------------------------------------------------


def imap_connect(cfg: Config) -> imaplib.IMAP4:
    reject_imap_login_value("IMAP_USER", cfg.imap_user)
    password = load_password(cfg.imap_password, cfg.imap_password_gpg_file)
    reject_imap_login_value("IMAP password", password)
    if cfg.imap_ssl:
        conn: imaplib.IMAP4 = imaplib.IMAP4_SSL(cfg.imap_host, cfg.imap_port)
    else:
        conn = imaplib.IMAP4(cfg.imap_host, cfg.imap_port)
    try:
        conn.login(cfg.imap_user, password)
    except imaplib.IMAP4.error as exc:
        try:
            conn.logout()
        except Exception:
            pass
        raise imap_login_failure(exc, cfg)
    conn.select(cfg.imap_mailbox)
    return conn


def message_sender(msg: Message) -> str:
    return parseaddr(msg.get("From", ""))[1].lower()


def private_allowed_sender(sender: str, cfg: Config) -> bool:
    """Return true when sender is in ALLOWED_FROM, ignoring public-demo mode."""
    parsed_sender = parseaddr(sender or "")[1].strip().lower()
    if not parsed_sender:
        return False
    allowed = {item.strip().lower() for item in cfg.allowed_from if item.strip()}
    if "*" in allowed:
        return True
    return parsed_sender in allowed


def sender_address(value: str) -> str:
    return parseaddr(value or "")[1].strip().lower()


def sender_matches_list(sender: str, entries: List[str]) -> bool:
    parsed_sender = sender_address(sender)
    if not parsed_sender:
        return False
    sender_domain = parsed_sender.rsplit("@", 1)[-1] if "@" in parsed_sender else ""
    for raw in entries:
        item = (raw or "").strip().lower()
        if not item:
            continue
        if item == "*":
            return True
        if item.startswith("@") and sender_domain and sender_domain == item[1:]:
            return True
        if item.startswith("*@") and sender_domain and sender_domain == item[2:]:
            return True
        if parsed_sender == item:
            return True
    return False


def configured_self_senders(cfg: Config) -> set[str]:
    values = {
        sender_address(cfg.mail_from),
        sender_address(cfg.mail_to),
        sender_address(cfg.smtp_user),
        sender_address(cfg.imap_user),
    }
    return {v for v in values if v}


def is_self_sender(sender: str, cfg: Config) -> bool:
    parsed_sender = sender_address(sender)
    return bool(parsed_sender and parsed_sender in configured_self_senders(cfg))


def is_banned_sender(sender: str, cfg: Config) -> bool:
    return sender_matches_list(sender, cfg.deny_from)


def sender_reject_reason(sender: str, cfg: Config) -> Optional[str]:
    parsed_sender = sender_address(sender)
    if not parsed_sender:
        return "empty sender"
    if is_banned_sender(parsed_sender, cfg):
        return "sender is in DENY_FROM/BANNED_LIST"
    if cfg.reject_self_sender and is_self_sender(parsed_sender, cfg):
        return "self-sender rejected"
    return None


def allowed_sender(sender: str, cfg: Config) -> bool:
    """Return true when an incoming sender is allowed to produce work.

    ALLOWED_FROM is the private/admin allowlist. In public mode, any non-rejected
    sender may produce work. When USER_REGISTRY=1, each accepted public sender is
    mapped to a per-sender ttychatter HOME and secret/config state, so ordinary
    user commands operate on that user's own registry profile rather than on
    global mailbot state.
    """
    if sender_reject_reason(sender, cfg):
        return False
    return private_allowed_sender(sender, cfg) or bool(cfg.open_to_public)


def registry_user_commands_available(sender: str, cfg: Config) -> bool:
    """Return true when a non-ALLOWED_FROM sender should get user commands.

    With USER_REGISTRY=1, public senders have private per-user state under
    USER_HOME_ROOT / USER_SECRET_DIR. Commands such as sessions, models,
    ttyconfig, api-key, tty-set, and tty-unset therefore apply to that sender's
    own profile and should not be restricted to PUBLIC_ALLOWED_COMMANDS.

    ALLOWED_FROM remains the admin/private allowlist for global mailbot controls
    such as tc:CONFIG export/update. DENY_FROM/BANNED_LIST and self-sender
    rejection still apply before this function can return true.
    """
    return bool(cfg.open_to_public and cfg.user_registry and sender_address(sender) and not sender_reject_reason(sender, cfg))


def public_sender_is_privileged(sender: str, cfg: Config) -> bool:
    return not sender_reject_reason(sender, cfg) and private_allowed_sender(sender, cfg)


def load_processed(path: Path) -> set[str]:
    if not path.exists():
        return set()
    return {line.strip() for line in path.read_text(encoding="utf-8", errors="replace").splitlines() if line.strip()}


def remember_processed(path: Path, message_id: str) -> None:
    if not message_id:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(message_id + "\n")


def send_reply_sendmail(cfg: Config, reply: EmailMessage) -> None:
    proc = subprocess.run(
        [cfg.sendmail_path, "-t", "-oi"],
        input=reply.as_string(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "sendmail failed")


def send_reply_smtp(cfg: Config, reply: EmailMessage) -> None:
    password = load_password(cfg.smtp_password, cfg.smtp_password_gpg_file)
    context = ssl.create_default_context()
    if cfg.smtp_ssl:
        smtp: smtplib.SMTP = smtplib.SMTP_SSL(cfg.smtp_host, cfg.smtp_port, context=context)
    else:
        smtp = smtplib.SMTP(cfg.smtp_host, cfg.smtp_port)
    try:
        smtp.ehlo()
        if cfg.smtp_starttls:
            smtp.starttls(context=context)
            smtp.ehlo()
        if cfg.smtp_user:
            smtp.login(cfg.smtp_user, password)
        smtp.send_message(reply)
    finally:
        smtp.quit()


def send_reply(cfg: Config, reply: EmailMessage) -> None:
    if cfg.send_method == "smtp":
        send_reply_smtp(cfg, reply)
    else:
        send_reply_sendmail(cfg, reply)


# ---------------------------------------------------------------------------
# ttychatter subprocess bridge
# ---------------------------------------------------------------------------
# The command is invoked in loopback mode so stdout is the clean AI response.
# Interface/status chatter belongs on stderr and is retained only for optional
# debugging.  This is the same reason the Bash clients gained loopback mode: it
# makes ttychatter composable with other Unix transports.
# ---------------------------------------------------------------------------


def session_log_path(cfg: Config, session: str) -> Path:
    session = sanitize_session_name(session)
    if session.endswith(".log"):
        return cfg.session_dir / session
    return cfg.session_dir / f"{session}.log"


def sanitize_session_name(session: str) -> str:
    return re.sub(r"[^A-Za-z0-9._-]+", "_", (session or "").strip()).strip("._-") or "session"


def session_files_newest_first(cfg: Config) -> List[Path]:
    if not cfg.session_dir.exists():
        return []
    paths = [p for p in cfg.session_dir.glob("*.log") if p.is_file()]

    def mtime(path: Path) -> float:
        try:
            return path.stat().st_mtime
        except OSError:
            return 0.0

    paths.sort(key=lambda p: (mtime(p), p.name.lower()), reverse=True)
    return paths


def trim_preview_line(line: str, max_chars: int) -> str:
    line = line.rstrip("\r\n")
    line = re.sub(r"[\t ]+", " ", line)
    if len(line) > max_chars:
        return line[: max(0, max_chars - 3)] + "..."
    return line


def read_session_head_tail(path: Path, head_lines: int, tail_lines: int, line_chars: int) -> Tuple[List[str], List[str], int]:
    head: List[Tuple[int, str]] = []
    tail = deque(maxlen=max(0, tail_lines))
    total = 0
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            for idx, raw in enumerate(fh):
                line = trim_preview_line(raw, line_chars)
                if idx < head_lines:
                    head.append((idx, line))
                if tail_lines > 0:
                    tail.append((idx, line))
                total = idx + 1
    except OSError as exc:
        return [f"[could not read: {exc}]"], [], 0
    head_out = [line for _, line in head]
    tail_out = [line for idx, line in tail if idx >= head_lines]
    return head_out, tail_out, total


def format_session_list_with_previews(cfg: Config) -> str:
    paths = session_files_newest_first(cfg)
    if not paths:
        return f"no session logs found in {cfg.session_dir}\n"

    shown = paths[: cfg.session_list_max_sessions]
    lines: List[str] = [
        f"sessions in {cfg.session_dir}",
        f"count: {len(paths)}; showing: {len(shown)}; order: newest first",
        f"preview: head={cfg.session_list_head_lines} tail={cfg.session_list_tail_lines}",
        "",
    ]
    for path in shown:
        try:
            st = path.stat()
            modified = time.strftime("%Y-%m-%d %H:%M:%S %z", time.localtime(st.st_mtime))
            size = st.st_size
        except OSError:
            modified = "unknown"
            size = 0
        head, tail, total = read_session_head_tail(
            path,
            cfg.session_list_head_lines,
            cfg.session_list_tail_lines,
            cfg.session_preview_line_chars,
        )
        lines.append(f"== {path.stem} ==")
        lines.append(f"modified: {modified}; bytes: {size}; lines: {total}")
        lines.append("head:")
        if head:
            lines.extend(f"  {line}" for line in head)
        else:
            lines.append("  [empty]")
        lines.append("tail:")
        if tail:
            lines.extend(f"  {line}" for line in tail)
        else:
            lines.append("  [empty or already shown in head]")
        lines.append("")
    if len(paths) > len(shown):
        lines.append(f"[{len(paths) - len(shown)} older sessions not shown; raise SESSION_LIST_MAX_SESSIONS to include more]")
    return "\n".join(lines).rstrip() + "\n"


def search_session_logs(cfg: Config, query: str, session: Optional[str] = None) -> str:
    query = (query or "").strip()
    if not query:
        return "ERROR: search requires text\n"
    if session:
        paths = [session_log_path(cfg, session)]
    else:
        paths = session_files_newest_first(cfg)
    if not paths:
        return f"no session logs found in {cfg.session_dir}\n"
    needle = query.casefold()
    found = 0
    lines: List[str] = [f"search: {query}", ""]
    for path in paths:
        if not path.exists():
            continue
        file_matches: List[str] = []
        try:
            with path.open("r", encoding="utf-8", errors="replace") as fh:
                for lineno, raw in enumerate(fh, 1):
                    if needle in raw.casefold():
                        file_matches.append(f"{lineno}: {trim_preview_line(raw, cfg.session_preview_line_chars)}")
                        found += 1
                        if found >= cfg.session_search_max_matches:
                            break
        except OSError as exc:
            file_matches.append(f"[could not read: {exc}]")
        if file_matches:
            lines.append(f"--- {path.name} ---")
            lines.extend(file_matches)
            lines.append("")
        if found >= cfg.session_search_max_matches:
            break
    if found == 0:
        lines.append(f"no matches for: {query}")
    elif found >= cfg.session_search_max_matches:
        lines.append(f"[stopped after SESSION_SEARCH_MAX_MATCHES={cfg.session_search_max_matches}]")
    return "\n".join(lines).rstrip() + "\n"


def rename_session_file(cfg: Config, old: str, new: str) -> str:
    old_name = sanitize_session_name(old)
    new_name = sanitize_session_name(new)
    old_path = session_log_path(cfg, old_name)
    new_path = session_log_path(cfg, new_name)
    if not old_path.exists():
        raise FileNotFoundError(f"session not found: {old_name}")
    if new_path.exists():
        raise FileExistsError(f"target session already exists: {new_name}")
    new_path.parent.mkdir(parents=True, exist_ok=True)
    old_path.rename(new_path)
    return f"renamed session: {old_name} -> {new_name}\n"


def validated_session_log_target(cfg: Config, session: str) -> Tuple[str, Path]:
    raw = (session or "").strip()
    if not raw:
        raise ValueError("empty session name")
    if raw.endswith(".log"):
        raw = raw[:-4]
    name = sanitize_session_name(raw)
    if not name:
        raise ValueError("empty session name after sanitizing")
    if name != raw:
        raise ValueError(f"unsafe session name {session!r}; use exact sanitized session name {name!r}")
    root = cfg.session_dir.resolve()
    target = (root / f"{name}.log").resolve()
    try:
        target.relative_to(root)
    except ValueError as exc:
        raise ValueError("session path escapes SESSION_DIR") from exc
    if target.parent != root:
        raise ValueError("nested session paths are not accepted")
    return name, target


def delete_session_file(cfg: Config, session: str) -> str:
    name, target = validated_session_log_target(cfg, session)
    if not target.exists():
        raise FileNotFoundError(f"session not found: {name}")
    if not target.is_file():
        raise ValueError(f"session path is not a regular file: {target}")
    target.unlink()
    return f"deleted session: {name}\npath: {target}\n"


def parse_braced_delete_command(command_line: str) -> Optional[List[str]]:
    match = re.fullmatch(r"\s*(delete|rm|delete-session|remove-session)\s*\{([^}]+)\}\s*", command_line or "", flags=re.IGNORECASE)
    if not match:
        return None
    return [match.group(1), match.group(2).strip()]


def public_session_prefix(cfg: Config) -> str:
    return sanitize_session_name(cfg.public_session_prefix or "public")


def public_session_name_from_sender(cfg: Config, sender: str) -> str:
    parsed = parseaddr(sender or "")[1].strip().lower() or "unknown"
    digest = hashlib.sha256(parsed.encode("utf-8", errors="replace")).hexdigest()[:16]
    return f"{public_session_prefix(cfg)}-{digest}"


def public_session_name_for_message(cfg: Config, msg: Message, uid: bytes) -> str:
    mode = normalize_keyword(cfg.public_session_mode)
    prefix = public_session_prefix(cfg)
    if mode == "shared":
        return sanitize_session_name(cfg.public_shared_session or f"{prefix}-shared")
    if mode == "per-message":
        msgid = msg.get("Message-ID", f"imap-uid-{uid.decode(errors='replace')}")
        digest = hashlib.sha256(msgid.encode("utf-8", errors="replace")).hexdigest()[:16]
        return f"{prefix}-{time.strftime('%Y%m%d-%H%M%S')}-{digest}"
    return public_session_name_from_sender(cfg, message_sender(msg))


def public_resume_session_allowed(cfg: Config, candidate: str) -> Optional[str]:
    name = sanitize_session_name(candidate)
    if not name or name != (candidate or "").strip().removesuffix(".log"):
        return None
    prefix = public_session_prefix(cfg) + "-"
    if name == sanitize_session_name(cfg.public_shared_session) and normalize_keyword(cfg.public_session_mode) == "shared":
        return name
    if name.startswith(prefix):
        return name
    return None


def public_session_from_request(cfg: Config, request: SubjectRequest, msg: Message, uid: bytes) -> str:
    """Map an unprivileged public request to a safe public session."""
    if request.public_resume:
        resumed = public_resume_session_allowed(cfg, request.value)
        if resumed and public_session_owner_allows(cfg, resumed, message_sender(msg)):
            return resumed
    if cfg.public_allow_named_sessions and request.value:
        requested = sanitize_session_name(request.value)
        if requested.casefold() == "new":
            return public_session_name_for_message(cfg, msg, uid)
        return f"{public_session_prefix(cfg)}-{requested}"
    return public_session_name_for_message(cfg, msg, uid)


def public_owner_address(sender: str) -> str:
    return parseaddr(sender or "")[1].strip().lower()


def public_sender_key(sender: str) -> str:
    owner = public_owner_address(sender) or "unknown"
    return hashlib.sha256(owner.encode("utf-8", errors="replace")).hexdigest()[:24]


def empty_public_session_index() -> dict:
    return {"version": 1, "sessions": {}, "senders": {}}


def load_public_session_index(cfg: Config) -> dict:
    path = cfg.public_session_index_file
    if not path.exists():
        return empty_public_session_index()
    try:
        data = json.loads(path.read_text(encoding="utf-8", errors="replace"))
    except Exception:
        return empty_public_session_index()
    if not isinstance(data, dict):
        return empty_public_session_index()
    sessions = data.get("sessions")
    senders = data.get("senders")
    if not isinstance(sessions, dict):
        sessions = {}
    if not isinstance(senders, dict):
        senders = {}
    return {"version": 1, "sessions": sessions, "senders": senders}


def save_public_session_index(cfg: Config, data: dict) -> None:
    path = cfg.public_session_index_file
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + f".tmp-{os.getpid()}")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    try:
        os.chmod(tmp, 0o600)
    except OSError:
        pass
    tmp.replace(path)


def is_public_session_name(cfg: Config, name: str) -> bool:
    name = sanitize_session_name(name)
    prefix = public_session_prefix(cfg) + "-"
    if name.startswith(prefix):
        return True
    return name == sanitize_session_name(cfg.public_shared_session) and normalize_keyword(cfg.public_session_mode) == "shared"


def record_public_session(cfg: Config, session: str, sender: str) -> None:
    name = sanitize_session_name(session)
    owner = public_owner_address(sender)
    if not name or not owner or not is_public_session_name(cfg, name):
        return
    now = int(time.time())
    key = public_sender_key(owner)
    data = load_public_session_index(cfg)
    senders = data.setdefault("senders", {})
    sessions = data.setdefault("sessions", {})
    sender_entry = senders.get(key)
    if not isinstance(sender_entry, dict):
        sender_entry = {}
    sender_entry.setdefault("first_seen", now)
    sender_entry["last_seen"] = now
    sender_entry["sender"] = owner
    sender_entry.setdefault("archive_on_delete", bool(cfg.public_session_archive_on_delete))
    senders[key] = sender_entry

    session_entry = sessions.get(name)
    if not isinstance(session_entry, dict):
        session_entry = {}
    session_entry.setdefault("created", now)
    session_entry["last_seen"] = now
    session_entry["owner"] = owner
    session_entry["sender_key"] = key
    session_entry["archive_on_delete"] = bool(sender_entry.get("archive_on_delete", cfg.public_session_archive_on_delete))
    sessions[name] = session_entry
    save_public_session_index(cfg, data)


def public_session_owner_allows(cfg: Config, session: str, sender: str) -> bool:
    if normalize_keyword(cfg.public_session_mode) == "shared":
        return True
    owner = public_owner_address(sender)
    if not owner:
        return False
    data = load_public_session_index(cfg)
    entry = data.get("sessions", {}).get(sanitize_session_name(session), {})
    if not isinstance(entry, dict):
        return True
    known_owner = public_owner_address(str(entry.get("owner", "")))
    if not known_owner:
        return True
    return known_owner == owner


def public_archive_enabled_for_session(cfg: Config, session: str, data: Optional[dict] = None) -> bool:
    data = data or load_public_session_index(cfg)
    entry = data.get("sessions", {}).get(sanitize_session_name(session), {})
    if not isinstance(entry, dict):
        return bool(cfg.public_session_archive_on_delete)
    key = str(entry.get("sender_key", ""))
    sender_entry = data.get("senders", {}).get(key, {}) if key else {}
    if isinstance(sender_entry, dict) and "archive_on_delete" in sender_entry:
        return bool(sender_entry.get("archive_on_delete"))
    if "archive_on_delete" in entry:
        return bool(entry.get("archive_on_delete"))
    return bool(cfg.public_session_archive_on_delete)


def public_archive_owner_for_session(cfg: Config, session: str, data: Optional[dict] = None) -> str:
    data = data or load_public_session_index(cfg)
    entry = data.get("sessions", {}).get(sanitize_session_name(session), {})
    if not isinstance(entry, dict):
        return ""
    return public_owner_address(str(entry.get("owner", "")))


def public_archive_preference_status(cfg: Config, sender: str) -> Tuple[bool, str, List[ReplyAttachment]]:
    owner = public_owner_address(sender)
    if not owner:
        state = "enabled" if cfg.public_session_archive_on_delete else "disabled"
        return True, f"public archive-on-expire default: {state}\n", []
    data = load_public_session_index(cfg)
    key = public_sender_key(owner)
    sender_entry = data.get("senders", {}).get(key, {})
    if isinstance(sender_entry, dict) and "archive_on_delete" in sender_entry:
        state_bool = bool(sender_entry.get("archive_on_delete"))
        source = "sender preference"
    else:
        state_bool = bool(cfg.public_session_archive_on_delete)
        source = "default"
    state = "enabled" if state_bool else "disabled"
    return True, f"public archive-on-expire: {state} ({source})\n", []


def set_public_archive_preference(cfg: Config, sender: str, enabled: bool, dry_run: bool = False) -> Tuple[bool, str, List[ReplyAttachment]]:
    if not cfg.public_session_archive_user_toggle:
        return False, "public archive preference changes are disabled by PUBLIC_SESSION_ARCHIVE_USER_TOGGLE=0\n", []
    owner = public_owner_address(sender)
    if not owner:
        return False, "archive-session requires an email sender\n", []
    key = public_sender_key(owner)
    state = "enabled" if enabled else "disabled"
    if dry_run:
        return True, f"[dry-run] would set public archive-on-expire for {owner}: {state}\n", []
    data = load_public_session_index(cfg)
    senders = data.setdefault("senders", {})
    sessions = data.setdefault("sessions", {})
    now = int(time.time())
    sender_entry = senders.get(key)
    if not isinstance(sender_entry, dict):
        sender_entry = {}
    sender_entry.setdefault("first_seen", now)
    sender_entry["last_seen"] = now
    sender_entry["sender"] = owner
    sender_entry["archive_on_delete"] = bool(enabled)
    senders[key] = sender_entry
    changed_sessions = 0
    for entry in sessions.values():
        if isinstance(entry, dict) and entry.get("sender_key") == key:
            entry["archive_on_delete"] = bool(enabled)
            changed_sessions += 1
    save_public_session_index(cfg, data)
    return True, f"public archive-on-expire for {owner}: {state}\nupdated sessions: {changed_sessions}\n", []


def trim_public_session_log(cfg: Config, path: Path, dry_run: bool = False) -> str:
    max_turns = int(cfg.public_session_max_turns)
    if max_turns <= 0 or not path.is_file():
        return ""
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError as exc:
        return f"failed to inspect {path.name} for trimming: {exc}"
    chat_line_indices: List[int] = []
    for idx, line in enumerate(lines):
        match = re.match(r"^\[[^\]]+\]\s+([^:]+):", line)
        if not match:
            continue
        speaker = match.group(1).strip().lower()
        if speaker != "system":
            chat_line_indices.append(idx)
    keep_entries = max_turns * 2
    if len(chat_line_indices) <= keep_entries:
        return ""
    first_keep_idx = chat_line_indices[-keep_entries]
    removed = first_keep_idx
    header = f"[ttychatter.mailbot] public session trimmed to last {max_turns} input/output cycles at {time.strftime('%Y-%m-%d %H:%M:%S %z')}"
    new_text = header + "\n" + "\n".join(lines[first_keep_idx:]).rstrip() + "\n"
    if dry_run:
        return f"[dry-run] would trim {path.name}: remove {removed} leading lines"
    try:
        path.write_text(new_text, encoding="utf-8")
    except OSError as exc:
        return f"failed to trim {path.name}: {exc}"
    return f"trimmed {path.name}: removed {removed} leading lines"


def build_public_session_archive_message(cfg: Config, owner: str, session: str, path: Path, reason: str) -> EmailMessage:
    data = path.read_bytes()
    msg = EmailMessage()
    msg["From"] = cfg.mail_from or cfg.smtp_user or cfg.imap_user
    msg["To"] = owner
    msg["Subject"] = f"{PROGRAM} public session archive: {session}"
    msg["Message-ID"] = make_msgid(domain=(msg["From"].split("@")[-1] if "@" in msg["From"] else None))
    body = [
        "This public ttychatter.mailbot session has expired and is being removed from the server.",
        "",
        f"session: {session}",
        f"reason: {reason}",
        f"log: {path.name}",
        "",
        "The session log is attached as plain text.",
    ]
    msg.set_content("\n".join(body).rstrip() + "\n")
    msg.add_attachment(data, maintype="text", subtype="plain", filename=safe_filename(path.name))
    return msg


def send_public_session_archive(cfg: Config, owner: str, session: str, path: Path, reason: str, dry_run: bool = False) -> Tuple[bool, str]:
    if not owner:
        return False, f"archive failed {path.name}: no owner address recorded"
    try:
        size = path.stat().st_size
    except OSError as exc:
        return False, f"archive failed {path.name}: stat failed: {exc}"
    limit = min(max(1, cfg.public_session_archive_max_bytes), max(1, cfg.max_outgoing_attachment_bytes))
    if size > limit:
        return False, f"archive failed {path.name}: {size} bytes > archive limit {limit}"
    if dry_run:
        return True, f"[dry-run] would email archive of {path.name} to {owner}"
    try:
        send_reply(cfg, build_public_session_archive_message(cfg, owner, session, path, reason))
    except Exception as exc:
        return False, f"archive failed {path.name}: {exc}"
    return True, f"archived {path.name} to {owner}"


def public_command_allowed(cfg: Config, command_line: str) -> bool:
    braced_delete = parse_braced_delete_command(command_line or "")
    if braced_delete is not None:
        command = braced_delete[0]
    else:
        try:
            tokens = shlex.split(command_line or "help")
        except ValueError:
            tokens = (command_line or "help").split()
        command = tokens[0] if tokens else "help"
    command = normalize_keyword(command)
    public_aliases = {
        "?": "help",
        "admin-help": "help-admin",
        "operator-help": "help-admin",
        "manual": "manpage",
        "get-manpage": "manpage",
        "fetch-manpage": "manpage",
        "cache-models": "model-cache",
        "cached-models": "model-cache",
        "models-cache": "model-cache",
        "model-json": "model-cache",
        "search-models": "model-search",
        "models-search": "model-search",
        "model-list-search": "model-search",
        "find-model": "model-search",
        "find-models": "model-search",
        "grep-models": "model-search",
        "prefs": "ttyconfig",
        "preferences": "ttyconfig",
        "set": "tty-set",
        "unset": "tty-unset",
        "profile": "user",
        "registry": "user",
        "set-api-key": "api-key",
        "forget-api-key": "forget-api-key",
        "remove-api-key": "forget-api-key",
        "archive-public-session": "archive-session",
        "archive-on-expire": "archive-session",
        "public-archive": "archive-session",
        "archive-opt-in": "archive-session",
        "archive-opt-out": "archive-session",
    }
    command = public_aliases.get(command, command)
    allowed = {normalize_keyword(x) for x in cfg.public_allowed_commands if x}
    return command in allowed


def public_cleanup_session_candidates(cfg: Config) -> List[Path]:
    prefix = public_session_prefix(cfg) + "-"
    if not cfg.session_dir.exists():
        return []
    paths = [p for p in cfg.session_dir.glob(f"{prefix}*.log") if p.is_file()]
    if normalize_keyword(cfg.public_session_mode) == "shared":
        shared = session_log_path(cfg, cfg.public_shared_session)
        if shared.is_file() and shared not in paths:
            paths.append(shared)
    return paths


def cleanup_public_sessions(cfg: Config, dry_run: bool = False) -> str:
    if not cfg.open_to_public or not cfg.public_session_cleanup:
        return ""
    paths = public_cleanup_session_candidates(cfg)
    if not paths:
        return ""
    now = time.time()
    delete: dict[Path, str] = {}
    index = load_public_session_index(cfg)
    ttl_seconds = cfg.public_session_ttl_hours * 3600 if cfg.public_session_ttl_hours > 0 else 0
    idle_seconds = cfg.public_session_idle_hours * 3600 if cfg.public_session_idle_hours > 0 else 0
    sessions_index = index.get("sessions", {}) if isinstance(index.get("sessions", {}), dict) else {}
    for path in paths:
        try:
            st = path.stat()
        except OSError:
            continue
        entry = sessions_index.get(path.stem, {})
        created = entry.get("created") if isinstance(entry, dict) else None
        try:
            created_time = float(created)
        except (TypeError, ValueError):
            created_time = st.st_mtime
        ttl_age = now - created_time
        idle_age = now - st.st_mtime
        if ttl_seconds and ttl_age > ttl_seconds:
            delete[path] = f"ttl>{cfg.public_session_ttl_hours}h"
        if idle_seconds and idle_age > idle_seconds:
            delete[path] = f"idle>{cfg.public_session_idle_hours}h"
    max_count = cfg.public_session_max_count
    if max_count > 0:
        survivors = [p for p in paths if p not in delete]
        survivors.sort(key=lambda p: p.stat().st_mtime if p.exists() else 0.0, reverse=True)
        for path in survivors[max_count:]:
            delete[path] = f"count>{max_count}"

    lines: List[str] = []
    # Trim surviving public logs even when no deletion is due. This enforces the
    # bounded-demo policy without destroying the whole session early.
    for path in sorted([p for p in paths if p not in delete], key=lambda p: p.name):
        note = trim_public_session_log(cfg, path, dry_run=dry_run)
        if note:
            lines.append(note)

    if delete:
        lines.insert(0, "public session cleanup:")
    for path, reason in sorted(delete.items(), key=lambda item: item[0].name):
        session = path.stem
        archive_enabled = public_archive_enabled_for_session(cfg, session, index)
        owner = public_archive_owner_for_session(cfg, session, index)
        may_delete = True
        if archive_enabled:
            archive_ok, archive_note = send_public_session_archive(cfg, owner, session, path, reason, dry_run=dry_run)
            lines.append(archive_note)
            if not archive_ok and cfg.public_session_archive_failure_policy == "keep":
                may_delete = False
                lines.append(f"kept {path.name}: archive failed and PUBLIC_SESSION_ARCHIVE_FAILURE_POLICY=keep")
        if dry_run:
            lines.append(f"[dry-run] would delete {path.name}: {reason}" if may_delete else f"[dry-run] would keep {path.name}: {reason}")
            continue
        if not may_delete:
            continue
        try:
            path.unlink()
            lines.append(f"deleted {path.name}: {reason}")
            sessions = index.get("sessions", {})
            if isinstance(sessions, dict) and session in sessions:
                sessions.pop(session, None)
                save_public_session_index(cfg, index)
        except OSError as exc:
            lines.append(f"failed {path.name}: {reason}: {exc}")
    if not lines:
        return ""
    if lines[0] != "public session cleanup:":
        lines.insert(0, "public session cleanup:")
    return "\n".join(lines).rstrip() + "\n"

def run_ttychatter(cfg: Config, session: str, body: str, attachments: List[Path]) -> Tuple[int, str, str]:
    cfg.session_dir.mkdir(parents=True, exist_ok=True)
    cfg.attachment_dir.mkdir(parents=True, exist_ok=True)

    requested_session = (session or "").strip()
    let_ttychatter_name_session = requested_session.casefold() == "new"
    session_name = "" if let_ttychatter_name_session else session_log_path(cfg, requested_session).stem

    cmd = shlex.split(cfg.ttychatter_command)
    cmd.append("--loopback")
    for extra in shlex.split(cfg.ttychatter_extra_args):
        cmd.append(extra)
    for path in attachments:
        cmd.extend(["--attach", str(path)])
    if session_name:
        cmd.append(session_name)

    proc = subprocess.run(
        cmd,
        input=body,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=ttychatter_environment(cfg),
    )
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def ttychatter_session_from_stderr(stderr_text: str) -> str:
    for raw in (stderr_text or "").splitlines():
        line = raw.strip()
        if not line.lower().startswith("session:"):
            continue
        value = line.split(":", 1)[1].strip()
        if not value:
            continue
        path = Path(value)
        return path.stem if path.suffix == ".log" else path.name or value
    return ""


def display_session_name(requested_session: str, stderr_text: str) -> str:
    requested = (requested_session or "").strip()
    if requested.casefold() == "new":
        detected = ttychatter_session_from_stderr(stderr_text)
        return detected or "new (ttychatter default timestamped session)"
    return sanitize_session_name(requested)


def run_ttychatter_cli(cfg: Config, args: List[str], input_text: str = "", timeout: Optional[int] = None) -> Tuple[int, str, str]:
    """Run a noninteractive ttychatter.python utility command."""
    cmd = shlex.split(cfg.ttychatter_command) + [str(arg) for arg in args]
    try:
        proc = subprocess.run(
            cmd,
            input=input_text,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout or cfg.ttychatter_control_timeout,
            env=ttychatter_environment(cfg),
        )
        return proc.returncode, proc.stdout.strip(), proc.stderr.strip()
    except FileNotFoundError:
        return 127, "", f"command not found: {cmd[0] if cmd else cfg.ttychatter_command}"
    except subprocess.TimeoutExpired as exc:
        stdout = exc.stdout if isinstance(exc.stdout, str) else ""
        stderr = exc.stderr if isinstance(exc.stderr, str) else ""
        stderr = (stderr + "\n" if stderr else "") + f"command timed out after {timeout or cfg.ttychatter_control_timeout} seconds"
        return 124, stdout.strip(), stderr.strip()


def truncate_text_bytes(text: str, max_bytes: int) -> str:
    raw = (text or "").encode("utf-8", errors="replace")
    if len(raw) <= max_bytes:
        return text or ""
    return raw[:max_bytes].decode("utf-8", errors="replace") + f"\n\n[truncated to {max_bytes} bytes by ttychatter.mailbot]"


def format_cli_result(label: str, rc: int, stdout: str, stderr_text: str, max_bytes: int) -> str:
    combined_budget = max(1000, max_bytes)
    lines = [label, f"exit_status: {rc}"]
    if stdout:
        lines.extend(["", "--- stdout ---", truncate_text_bytes(stdout, combined_budget)])
    if stderr_text:
        lines.extend(["", "--- stderr ---", truncate_text_bytes(stderr_text, combined_budget)])
    if not stdout and not stderr_text:
        lines.extend(["", "(no output)"])
    return "\n".join(lines).rstrip() + "\n"


def parse_updated_model_cache_path(output: str) -> Optional[Path]:
    for line in (output or "").splitlines():
        match = re.search(r"updated model cache:\s*(.+)$", line)
        if match:
            return expand_path(match.group(1).strip())
    return None


def read_file_attachment(path: Path, cfg: Config, filename: Optional[str] = None) -> Tuple[Optional[ReplyAttachment], str]:
    try:
        if not path.exists() or not path.is_file():
            return None, f"attachment not found: {path}"
        size = path.stat().st_size
        if size > cfg.max_outgoing_attachment_bytes:
            return None, f"attachment too large: {path} ({size} bytes > {cfg.max_outgoing_attachment_bytes})"
        data = path.read_bytes()
    except OSError as exc:
        return None, f"attachment read failed: {path}: {exc}"
    guessed = mimetypes.guess_type(str(path))[0] or "application/octet-stream"
    if "/" in guessed:
        maintype, subtype = guessed.split("/", 1)
    else:
        maintype, subtype = "application", "octet-stream"
    if path.suffix.lower() == ".json":
        maintype, subtype = "application", "json"
    return ReplyAttachment(filename or safe_filename(path.name), data, maintype, subtype), f"attached: {filename or path.name} ({len(data)} bytes)"


def model_cache_reply(cfg: Config) -> Tuple[bool, str, List[ReplyAttachment]]:
    cache_path = cfg.model_cache_file
    intro = "model-cache: existing cache only; no OpenRouter fetch was attempted"
    ok, body, attachments = deliver_file_output(cfg, "model-cache", cache_path, "models-cache.json", intro)
    if not ok:
        body += "Run update-models when you intentionally want to refresh the cache.\n"
    return ok, body, attachments


def strings_from_json(value: Any) -> Iterable[str]:
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for key, child in value.items():
            yield str(key)
            yield from strings_from_json(child)
    elif isinstance(value, list):
        for child in value:
            yield from strings_from_json(child)
    elif value is not None:
        yield str(value)


def model_items_from_cache(data: Any) -> List[Any]:
    if isinstance(data, dict):
        for key in ("data", "models", "items"):
            value = data.get(key)
            if isinstance(value, list):
                return value
        return [data]
    if isinstance(data, list):
        return data
    return []


def model_item_summary(item: Any, line_chars: int) -> str:
    if isinstance(item, dict):
        model_id = str(item.get("id") or item.get("name") or item.get("slug") or "[no id]")
        display = str(item.get("name") or item.get("display_name") or item.get("displayName") or "")
        desc = str(item.get("description") or "")
        context = item.get("context_length") or item.get("contextLength") or ""
        output = item.get("max_completion_tokens") or item.get("maxCompletionTokens") or ""
        arch = item.get("architecture") if isinstance(item.get("architecture"), dict) else {}
        modalities = arch.get("input_modalities") or arch.get("inputModalities") or arch.get("modality") or ""
        if isinstance(modalities, list):
            modalities_text = "/".join(str(x) for x in modalities)
        else:
            modalities_text = str(modalities)
        pieces = [model_id]
        if display and display != model_id:
            pieces.append(f"name={display}")
        if context:
            pieces.append(f"ctx={context}")
        if output:
            pieces.append(f"out={output}")
        if modalities_text:
            pieces.append(f"modalities={modalities_text}")
        if desc:
            pieces.append("desc=" + trim_preview_line(desc, max(40, line_chars // 2)))
        return trim_preview_line("; ".join(pieces), line_chars)
    return trim_preview_line(str(item), line_chars)


def search_model_cache(cfg: Config, query: str) -> Tuple[bool, str]:
    query = (query or "").strip()
    if not query:
        return False, "usage: model-search TEXT\n"
    path = cfg.model_cache_file
    try:
        raw = path.read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        return False, f"model cache read failed: {path}: {exc}\nRun update-models when you intentionally want to refresh the cache.\n"
    try:
        data = json.loads(raw)
    except Exception as exc:
        # Keep a useful fallback for damaged or nonstandard caches. This is still
        # cache-only: no network or ttychatter model refresh is attempted.
        needle = query.casefold()
        lines = [
            f"model-cache search: {query}",
            f"cache: {path}",
            f"warning: JSON parse failed: {exc}",
            "fallback: raw line substring search",
            "",
        ]
        matches = 0
        for lineno, line in enumerate(raw.splitlines(), 1):
            if needle in line.casefold():
                matches += 1
                lines.append(f"{lineno}: {trim_preview_line(line, cfg.session_preview_line_chars)}")
                if matches >= cfg.model_search_max_matches:
                    lines.append(f"[stopped after MODEL_SEARCH_MAX_MATCHES={cfg.model_search_max_matches}]")
                    break
        if matches == 0:
            lines.append(f"no matches for: {query}")
        return matches > 0, "\n".join(lines).rstrip() + "\n"

    items = model_items_from_cache(data)
    needle = query.casefold()
    matches: List[str] = []
    for item in items:
        haystack = "\n".join(strings_from_json(item)).casefold()
        if needle in haystack:
            matches.append(model_item_summary(item, cfg.session_preview_line_chars))
            if len(matches) >= cfg.model_search_max_matches:
                break

    lines = [
        f"model-cache search: {query}",
        f"cache: {path}",
        f"items scanned: {len(items)}",
        f"matches: {len(matches)}",
        "",
    ]
    if matches:
        lines.extend(matches)
        if len(matches) >= cfg.model_search_max_matches:
            lines.append(f"[stopped after MODEL_SEARCH_MAX_MATCHES={cfg.model_search_max_matches}]")
    else:
        lines.append(f"no matches for: {query}")
    return bool(matches), "\n".join(lines).rstrip() + "\n"


def command_output_mode(cfg: Config, command: str) -> str:
    command = normalize_keyword(command)
    specific = {
        "model-cache": cfg.model_cache_output,
        "model-search": cfg.model_search_output,
        "models": cfg.model_list_output,
        "routers": cfg.model_list_output,
        "sessions": cfg.sessions_output,
        "config": cfg.config_output,
    }.get(command, cfg.command_output_mode)
    return normalize_output_mode(specific, normalize_output_mode(cfg.command_output_mode, "auto"))


def text_reply_attachment(filename: str, text: str) -> ReplyAttachment:
    return ReplyAttachment(filename, (text or "").encode("utf-8", errors="replace"), "text", "plain")


def deliver_text_output(cfg: Config, command: str, text: str, filename: str, intro: str = "") -> Tuple[str, List[ReplyAttachment]]:
    mode = command_output_mode(cfg, command)
    raw = (text or "").encode("utf-8", errors="replace")
    inline_limit = max(1000, cfg.output_inline_max_bytes)
    attach_limit = max(1, cfg.max_outgoing_attachment_bytes)
    if mode == "auto":
        mode = "body" if len(raw) <= inline_limit else "attachment"
    if mode == "attachment":
        if len(raw) > attach_limit:
            body = (intro.rstrip() + "\n" if intro else "") + f"output too large to attach: {len(raw)} bytes > {attach_limit}\n"
            body += truncate_text_bytes(text, cfg.max_command_output_bytes)
            return body.rstrip() + "\n", []
        body = intro.rstrip() + "\n" if intro else ""
        body += f"Attached: {filename} ({len(raw)} bytes)\n"
        return body, [text_reply_attachment(filename, text)]
    body = intro.rstrip() + "\n" if intro else ""
    body += truncate_text_bytes(text, cfg.max_command_output_bytes).rstrip() + "\n"
    return body, []


def deliver_file_output(cfg: Config, command: str, path: Path, filename: str, intro: str = "") -> Tuple[bool, str, List[ReplyAttachment]]:
    try:
        if not path.exists() or not path.is_file():
            body = (intro.rstrip() + "\n" if intro else "") + f"file not found: {path}\n"
            return False, body, []
        size = path.stat().st_size
        data = path.read_bytes()
    except OSError as exc:
        body = (intro.rstrip() + "\n" if intro else "") + f"file read failed: {path}: {exc}\n"
        return False, body, []

    mode = command_output_mode(cfg, command)
    inline_limit = max(1000, cfg.output_inline_max_bytes)
    # Auto is body for small readable text. Large JSON/cache/config payloads stay
    # attachments by default, matching normal mail and Unix expectations.
    if mode == "auto":
        if size <= inline_limit and path.suffix.lower() not in {".json"}:
            mode = "body"
        elif size <= max(4096, inline_limit // 4) and path.suffix.lower() == ".json":
            mode = "body"
        else:
            mode = "attachment"
    if mode == "body":
        try:
            text = data.decode("utf-8")
        except UnicodeDecodeError:
            text = data.decode("utf-8", errors="replace")
        body = intro.rstrip() + "\n" if intro else ""
        body += f"file: {path}\nbytes: {size}\n\n"
        body += truncate_text_bytes(text, cfg.max_command_output_bytes).rstrip() + "\n"
        return True, body, []

    attachment, note = read_file_attachment(path, cfg, filename)
    body = intro.rstrip() + "\n" if intro else ""
    body += f"file: {path}\n{note}\n"
    return attachment is not None, body, [attachment] if attachment else []


def build_reply(cfg: Config, original: Message, session: str, body: str, stderr_text: str, ok: bool) -> EmailMessage:
    sender = message_sender(original)
    reply_to = parseaddr(original.get("Reply-To") or original.get("From") or sender)[1]
    dest = cfg.mail_to or reply_to
    subject = original.get("Subject", f"{subject_marker(cfg)}{cfg.session_open_delim}{session}{cfg.session_close_delim}")
    if cfg.open_to_public and not private_allowed_sender(sender, cfg):
        # Public-demo replies advertise the actual public session name so a
        # normal mail reply with "Re: session_name" can resume the session.
        subject = session

    msg = EmailMessage()
    msg["From"] = cfg.mail_from or cfg.smtp_user or cfg.imap_user
    msg["To"] = dest
    msg["Subject"] = f"{cfg.reply_subject_prefix} {subject}"
    msg["Message-ID"] = make_msgid(domain=(msg["From"].split("@")[-1] if "@" in msg["From"] else None))
    if original.get("Message-ID"):
        msg["In-Reply-To"] = original.get("Message-ID")
        msg["References"] = original.get("Message-ID")

    status = "success" if ok else "error"
    text = [body or "(empty response)"]
    if cfg.include_ttychatter_stderr and stderr_text:
        text.extend(["", "--- ttychatter stderr ---", stderr_text])
    msg.set_content(mailbot_reply_body(cfg, "\n".join(text), status, session=session))
    return msg


def redact_api_key_literals(text: str) -> str:
    # Defensive scrub for subjects/logging paths. The command redactor catches
    # nonstandard BYO keys too, but this avoids accidentally echoing common
    # OpenRouter/OpenAI-style key literals in a free-form subject.
    return re.sub(r"\b(sk-or-v1-[A-Za-z0-9._-]+|sk-or-[A-Za-z0-9._-]+|sk-[A-Za-z0-9._-]+)\b", "REDACTED", text or "")


def redact_command_for_reply(command: str) -> str:
    text = (command or "help").strip()
    try:
        tokens = shlex.split(text)
    except ValueError:
        tokens = text.split()
    if not tokens:
        return "help"
    head = normalize_keyword(tokens[0])
    if head in {"api-key", "set-api-key"}:
        return f"{tokens[0]} REDACTED"
    if head in {"tty-set", "set"} and len(tokens) >= 2 and tokens[1].upper() in {"OPENROUTER_API_KEY", "API_KEY", "TTYCHATTER_API_KEY"}:
        return f"{tokens[0]} {tokens[1]} REDACTED"
    return redact_api_key_literals(text)


def redact_subject_for_reply(subject: str, cfg: Config) -> str:
    raw = subject or f"{cfg.subject_prefix}:help"
    req = parse_subject_request(raw, cfg, "")
    if req and req.kind == "command":
        redacted = redact_command_for_reply(req.value)
        if redacted != (req.value or "").strip():
            return f"{subject_marker(cfg)}{redacted}"
    return redact_api_key_literals(raw)


def footer_command_subject(cfg: Config) -> str:
    preferred = (cfg.mailbot_subject_token or "MAILBOT").strip()
    configured = [x.strip() for x in (cfg.body_command_subjects or []) if x.strip()]
    configured_upper = {x.upper() for x in configured}
    if preferred and (not configured_upper or preferred.upper() in configured_upper):
        return preferred
    if configured:
        return configured[0]
    return "MAILBOT"


def mailbot_reply_footer(cfg: Config, status: str, session: str = "", command: str = "") -> str:
    command_subject = footer_command_subject(cfg)
    lines = [
        "--",
        f"{PROGRAM} {status}",
    ]
    if session:
        lines.append(f"session: {session}")
    if command:
        lines.append(f"command: {redact_command_for_reply(command)}")
    lines.extend([
        "",
        "MAILBOT COMMANDS",
        "",
        "To use a mailbot command, put the command subject in the subject line",
        "and put the command itself in the message body:",
        "",
        f"Subject: {command_subject}",
        "Message body: COMMAND [ARGUMENTS]",
        "",
        "Common user commands:",
        "",
        "COMMAND               FUNCTION",
        "--------------------  --------------------------------------------",
        "help                  Email the help response.",
        "manpage | manual      Email the plain-text manual as an attachment.",
        "sessions              List saved conversation sessions.",
        "models [flags]        List available models using safe model-list flags.",
        "model-cache           Email cached model data without refreshing it.",
        "model-search TEXT     Search cached model data.",
        "favorites             List favorite models.",
        "ttyconfig | prefs     Show this sender's ttychatter configuration.",
        "ttydoctor             Run ttychatter diagnostics.",
        "api-key KEY           Save this sender's OpenRouter API key.",
        "forget-api-key        Remove this sender's saved OpenRouter API key.",
        "",
        f"For user help, send Subject: {command_subject} with Message body: help.",
    ])
    return "\n".join(lines).rstrip()


def mailbot_reply_body(cfg: Config, body: str, status: str, session: str = "", command: str = "") -> str:
    main = (body or "(empty response)").rstrip()
    footer = mailbot_reply_footer(cfg, status, session=session, command=command)
    return f"{AUTOMATED_MAILBOT_NOTICE}\n\n{main}\n\n{footer}\n"


def build_control_reply(
    cfg: Config,
    original: Message,
    command: str,
    body: str,
    ok: bool,
    attachments: Optional[List[ReplyAttachment]] = None,
) -> EmailMessage:
    sender = message_sender(original)
    reply_to = parseaddr(original.get("Reply-To") or original.get("From") or sender)[1]
    dest = cfg.mail_to or reply_to
    subject = redact_subject_for_reply(original.get("Subject", f"{cfg.subject_prefix}:help"), cfg)

    msg = EmailMessage()
    msg["From"] = cfg.mail_from or cfg.smtp_user or cfg.imap_user
    msg["To"] = dest
    msg["Subject"] = f"{cfg.reply_subject_prefix} {subject}"
    msg["Message-ID"] = make_msgid(domain=(msg["From"].split("@")[-1] if "@" in msg["From"] else None))
    if original.get("Message-ID"):
        msg["In-Reply-To"] = original.get("Message-ID")
        msg["References"] = original.get("Message-ID")

    status = "success" if ok else "error"
    msg.set_content(mailbot_reply_body(cfg, body or "(empty response)", status, command=command))
    for attachment in attachments or []:
        msg.add_attachment(
            attachment.data,
            maintype=attachment.maintype,
            subtype=attachment.subtype,
            filename=safe_filename(attachment.filename),
        )
    return msg


BODY_ARG_COMMANDS = {
    "models", "routers", "model-list", "models-list", "list-models", "show-models",
    "search", "search-session", "rename-session", "favorite-model",
    "unfavorite-model", "test-model", "show-memory", "clear-memory",
    "tty-set", "tty-unset", "set", "unset", "api-key", "set-api-key",
}


def is_mailbot_request(session: str, cfg: Config) -> bool:
    # Legacy compatibility only. New flat tc:<command> requests are identified
    # by parse_subject_request() before this helper is needed.
    return legacy_mailbot_command_from_token(session, "", cfg) is not None


def first_command_line_from_body(body: str) -> str:
    for raw in (body or "").splitlines():
        line = raw.strip()
        if not line:
            continue
        if line == "--":
            break
        if line.startswith(">"):
            continue
        return line
    return ""


def maybe_append_body_arguments(command: str, body: str) -> str:
    command = (command or "").strip()
    if not command:
        return ""
    body_line = first_command_line_from_body(body)
    if not body_line:
        return command
    try:
        parsed = shlex.split(command)
    except ValueError:
        return command
    if len(parsed) == 1 and parsed[0].lower().replace("_", "-") in BODY_ARG_COMMANDS:
        return command + " " + body_line
    return command


def mailbot_command_line(session: str, body: str, cfg: Config) -> str:
    # Legacy compatibility wrapper for callers that still pass a MAILBOT token.
    return legacy_mailbot_command_from_token(session, body, cfg) or first_command_line_from_body(body) or "help"


def mailbot_command_help(cfg: Config) -> str:
    command_subject = footer_command_subject(cfg)
    allowed_keys = ", ".join(cfg.user_ttyconfig_allowed_keys) or "none configured"
    allowed_keys = "\n  ".join(textwrap.wrap(allowed_keys, width=72))
    return f"""ttychatter.mailbot help for regular users

This help is for ordinary mailbot use. It does not list administrator-only
configuration commands or old compatibility syntaxes.

BASIC USE

To ask the AI a question, send an ordinary email to the bot.

  Subject: any topic or session name
  Body: your question or prompt

When subject sessions are enabled, the subject is also your conversation name.
Replying normally continues that conversation.

COMMAND USE

To run a mailbot command, send a new email like this:

  Subject: {command_subject}
  Body: COMMAND [ARGUMENTS]

Put only the command line in the body when you want command mode.

HELP AND DOCUMENTATION

COMMAND             FUNCTION
------------------  -----------------------------------------------
help                Show this regular-user help response.
manpage, manual     Email the full plain-text manual as an attachment.

USER PROFILE AND SETTINGS

COMMAND             FUNCTION
------------------  -----------------------------------------------
user                Show your mailbot user profile and API-key source.
prefs               Show your current ttychatter configuration.
ttyconfig           Same as prefs.
tty-set KEY VALUE   Set an allowed ttychatter preference.
set KEY VALUE       Same as tty-set.
tty-unset KEY       Remove an allowed ttychatter preference.
unset KEY           Same as tty-unset.
api-key KEY         Save your OpenRouter API key for your mailbot user.
forget-api-key      Remove your saved OpenRouter API key.

New user profiles are initialized with:

  CONTEXT_TURNS=12
  MODEL=openrouter/auto

Allowed tty-set keys on this bot:
  {allowed_keys}

CONVERSATIONS AND SESSIONS

COMMAND                     FUNCTION
--------------------------  -----------------------------------------
sessions                    List your saved sessions.
search TEXT                 Search all of your session logs.
search-session SESSION TEXT Search one session log.
rename-session OLD NEW      Rename a session log.
delete-session SESSION      Delete a session log.
archive-session             Show your archive-on-expire preference.
archive-session on          Save expiring public sessions before deletion.
archive-session off         Do not save expiring public sessions.
archive-session status      Show the archive preference status.

MODELS

COMMAND             FUNCTION
------------------  -----------------------------------------------
model-search TEXT   Search cached model data.
models [FLAGS]      List available models using safe model-list flags.
model-cache         Email cached model data without refreshing it.
update-models       Refresh your model cache, then email the cached data.
tty-set MODEL ID    Set your default model.
tty-set MODEL openrouter/auto
                    Use OpenRouter automatic model selection.
favorites           List favorite models.
favorite-model ID   Add a model to favorites.
unfavorite-model ID Remove a model from favorites.
test-model ID       Test a model.
routers [FLAGS]     List available routers using safe router-list flags.

SAFE MODEL-LIST FLAGS

--all --sort VALUE --modellist-sort-tokens --min-input-tokens N
--min-output-tokens N --hide-preview --show-preview --require-tokens
--allow-missing-tokens --model-type VALUE

OTHER USER UTILITIES

COMMAND             FUNCTION
------------------  -----------------------------------------------
ttydoctor           Run ttychatter diagnostics for your user profile.
credits             Show credit/status information from ttychatter.
show-memory SESSION Show memory for a session.
clear-memory SESSION
                    Clear memory for a session.

For the full plain-text manual, send:

  Subject: {command_subject}
  Body: manpage

Administrators can request operator-only help from an ALLOWED_FROM address:

  Subject: {command_subject}
  Body: help-admin
"""


def mailbot_admin_help(cfg: Config) -> str:
    marker = subject_marker(cfg)
    command_subject = footer_command_subject(cfg)
    models_token = cfg.models_subject_token or "MODELS"
    config_token = cfg.config_subject_token or "CONFIG"
    body_subjects = ", ".join(cfg.body_command_subjects) or "none configured"
    public_note = "enabled" if cfg.open_to_public else "disabled"
    return f"""ttychatter.mailbot administrator help

This help is for ALLOWED_FROM senders. Regular users should use:

  Subject: {command_subject}
  Body: help

ADMIN IDENTITY AND ACCESS

ALLOWED_FROM is the private/operator allowlist. In public mode, registered
users get their own per-user state under USER_HOME_ROOT and may use normal user
commands inside that profile. ALLOWED_FROM remains required for global mailbot
configuration export/update.

Public mode: {public_note}
Body-command subjects: {body_subjects}

GLOBAL MAILBOT CONFIGURATION

COMMAND/SUBJECT                  FUNCTION
-------------------------------  --------------------------------------
{marker}{config_token:<28} Export global mailbot config.
{marker}{config_token:<28} with attachment
                                 Apply edited global mailbot config.

MODEL CACHE SHORTHANDS

COMMAND/SUBJECT                  FUNCTION
-------------------------------  --------------------------------------
{marker}{models_token:<28} Return existing model cache only.
{marker}{models_token} TEXT{max(1, 25 - len(models_token)) * ' '} Search existing model cache for TEXT.
{marker}model-cache{17 * ' '} Same cache-only model response.
{marker}update-models{16 * ' '} Refresh model cache.

COMMAND ROUTING FOR OPERATORS

Preferred command mail:

  Subject: {command_subject}
  Body: COMMAND [ARGUMENTS]

Compatibility control subjects remain accepted when enabled:

  {marker}CMD
  {marker}command args
  {marker}{cfg.session_open_delim}session-name{cfg.session_close_delim}
  {marker}{cfg.session_open_delim}new{cfg.session_close_delim}

ADMIN NOTES

- Use help for the regular-user command list.
- Use manpage for the full plain-text manual.
- Use ttydoctor for runtime diagnostics.
- Non-ALLOWED_FROM users cannot export or apply the global mailbot config.
- Without USER_REGISTRY=1, public command mail falls back to PUBLIC_ALLOWED_COMMANDS:
  {', '.join(cfg.public_allowed_commands)}
"""


def mailbot_manpage_candidates(cfg: Optional[Config] = None) -> List[Path]:
    """Return external manpage candidates, most specific first.

    The mailbot can still fall back to its compiled-in manpage.  This lookup is
    intentionally simple so a packaged install can keep documentation in normal
    man(1) locations, while a single-user install can keep it beside the config
    or beside the executable.
    """
    candidates: List[Path] = []

    def add(path: Optional[Path]) -> None:
        if path is None:
            return
        try:
            path = path.expanduser().resolve()
        except Exception:
            path = path.expanduser()
        if path not in candidates:
            candidates.append(path)

    if cfg and cfg.mailbot_manpage_file:
        add(cfg.mailbot_manpage_file)

    if cfg:
        add(cfg.config_file.parent / "ttychatter.mailbot.1")
        add(cfg.config_file.parent / "ttychatter.mailbot.1.gz")

    for base in [Path(__file__).resolve().parent, Path(sys.argv[0]).resolve().parent]:
        add(base / "ttychatter.mailbot.1")
        add(base / "ttychatter.mailbot.1.gz")

    xdg_data_home = Path(os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local" / "share")))
    for man_dir in [
        xdg_data_home / "man" / "man1",
        Path.home() / ".local" / "share" / "man" / "man1",
        Path("/usr/local/share/man/man1"),
        Path("/usr/local/man/man1"),
        Path("/usr/share/man/man1"),
    ]:
        add(man_dir / "ttychatter.mailbot.1")
        add(man_dir / "ttychatter.mailbot.1.gz")

    # Lowest priority: current working directory.  This is convenient for a
    # source checkout, but packaged installs should prefer config, executable,
    # or man1 locations above so cron/daemon cwd cannot accidentally win.
    add(Path.cwd() / "ttychatter.mailbot.1")
    add(Path.cwd() / "ttychatter.mailbot.1.gz")

    return candidates


def read_manpage_file(path: Path) -> str:
    if path.suffix == ".gz":
        with gzip.open(path, "rt", encoding="utf-8", errors="replace") as fh:
            return fh.read().rstrip() + "\n"
    return path.read_text(encoding="utf-8", errors="replace").rstrip() + "\n"


def external_mailbot_manpage(cfg: Optional[Config] = None) -> Optional[str]:
    for path in mailbot_manpage_candidates(cfg):
        try:
            if path.is_file():
                return read_manpage_file(path)
        except OSError:
            continue
    return None


def mailbot_manpage(cfg: Optional[Config] = None) -> str:
    return external_mailbot_manpage(cfg) or embedded_mailbot_manpage(cfg)


def roff_plain_unescape(text: str) -> str:
    replacements = {
        r"\-": "-",
        r"\&": "",
        r"\(bu": "*",
        r"\(em": "--",
        r"\(en": "-",
        r"\fB": "",
        r"\fI": "",
        r"\fR": "",
        r"\fP": "",
    }
    for old, new in replacements.items():
        text = text.replace(old, new)
    text = re.sub(r"\\f\[[^\]]+\]", "", text)
    text = re.sub(r"\\s[+-]?\d+", "", text)
    text = text.replace(r"\ ", " ")
    return text


def split_roff_args(arg_text: str) -> List[str]:
    arg_text = roff_plain_unescape(arg_text or "")
    try:
        return shlex.split(arg_text)
    except ValueError:
        return arg_text.split()


def join_roff_args(args: List[str]) -> str:
    text = " ".join(roff_plain_unescape(x) for x in args).strip()
    text = re.sub(r"\s+([,.;:)\]])", r"\1", text)
    text = re.sub(r"([(\[])\s+", r"\1", text)
    return text


def append_plain_blank(lines: List[str]) -> None:
    if lines and lines[-1] != "":
        lines.append("")


def roff_to_plain_text(source: str) -> str:
    """Render the small man(7) macro subset used by ttychatter.mailbot as plain text."""
    output: List[str] = []
    pending_tp = False
    literal = False

    for raw in (source or "").splitlines():
        line = raw.rstrip()
        stripped = line.strip()
        if not stripped:
            append_plain_blank(output)
            continue
        if stripped.startswith('.\\"') or stripped.startswith('.\\\"'):
            continue

        if stripped.startswith('.'):
            match = re.match(r"^\.([A-Za-z][A-Za-z0-9]*)\s*(.*)$", stripped)
            if not match:
                continue
            macro = match.group(1)
            arg_text = match.group(2)
            args = split_roff_args(arg_text)

            if macro == "TH":
                append_plain_blank(output)
                title = join_roff_args(args[:2]) if args else "TTYCHATTER.MAILBOT"
                if len(args) >= 4:
                    title = f"{title} - {join_roff_args(args[2:4])}"
                output.append(title.upper())
                output.append("=" * len(output[-1]))
                append_plain_blank(output)
                pending_tp = False
                continue

            if macro in {"SH", "SS"}:
                append_plain_blank(output)
                title = join_roff_args(args) or "SECTION"
                if macro == "SH":
                    title = title.upper()
                    output.append(title)
                    output.append("-" * len(title))
                else:
                    output.append(title)
                append_plain_blank(output)
                pending_tp = False
                continue

            if macro in {"PP", "P", "LP"}:
                append_plain_blank(output)
                pending_tp = False
                continue

            if macro == "TP":
                append_plain_blank(output)
                pending_tp = True
                continue

            if macro == "IP":
                append_plain_blank(output)
                label = join_roff_args(args[:1])
                if label in {r"\(bu", "*", "bu"}:
                    output.append("-")
                elif label:
                    output.append(label)
                pending_tp = False
                continue

            if macro in {"B", "I", "BR", "BI", "RB", "RI", "IR", "IB", "SM"}:
                rendered = join_roff_args(args)
                if rendered:
                    output.append(rendered)
                pending_tp = False
                continue

            if macro in {"nf", "EX"}:
                append_plain_blank(output)
                literal = True
                pending_tp = False
                continue

            if macro in {"fi", "EE"}:
                append_plain_blank(output)
                literal = False
                pending_tp = False
                continue

            if macro in {"RS", "RE", "br"}:
                if macro == "br":
                    append_plain_blank(output)
                continue

            rendered = join_roff_args(args)
            if rendered:
                output.append(rendered)
            pending_tp = False
            continue

        rendered = roff_plain_unescape(line if literal else stripped)
        output.append(rendered)
        pending_tp = False

    cleaned: List[str] = []
    blank = False
    for line in output:
        line = line.rstrip()
        if not line:
            if not blank:
                cleaned.append("")
            blank = True
        else:
            cleaned.append(line)
            blank = False
    return "\n".join(cleaned).strip() + "\n"


def mailbot_manual_text(cfg: Optional[Config] = None) -> str:
    return roff_to_plain_text(mailbot_manpage(cfg))



def validate_model_list_args(args: List[str]) -> Tuple[bool, List[str], str]:
    no_value = {
        "--all",
        "--modellist-sort-tokens",
        "--hide-preview",
        "--show-preview",
        "--require-tokens",
        "--allow-missing-tokens",
    }
    with_value = {"--sort", "--min-input-tokens", "--min-output-tokens", "--model-type"}
    safe: List[str] = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in no_value:
            safe.append(arg)
            i += 1
            continue
        if arg in with_value:
            if i + 1 >= len(args):
                return False, [], f"{arg} requires a value"
            value = args[i + 1]
            if value.startswith("--"):
                return False, [], f"{arg} requires a value"
            safe.extend([arg, value])
            i += 2
            continue
        return False, [], f"unsafe or unsupported model-list flag: {arg}"
    return True, safe, ""


def user_ttyconfig_key_allowed(cfg: Config, key: str) -> bool:
    return key.strip().upper() in {x.strip().upper() for x in cfg.user_ttyconfig_allowed_keys}


def api_key_config_key(key: str) -> bool:
    return key.strip().upper() in {"OPENROUTER_API_KEY", "API_KEY", "TTYCHATTER_API_KEY"}


def dispatch_mailbot_command(cfg: Config, command_line: str, dry_run: bool = False, sender: str = "") -> Tuple[bool, str, List[ReplyAttachment]]:
    braced_delete = parse_braced_delete_command(command_line or "")
    if braced_delete is not None:
        tokens = braced_delete
    else:
        try:
            tokens = shlex.split(command_line or "help")
        except ValueError as exc:
            return False, f"could not parse command: {exc}\n", []
    if not tokens:
        tokens = ["help"]
    command = tokens[0].strip().lower().replace("_", "-")
    args = tokens[1:]
    aliases = {
        "?": "help",
        "admin-help": "help-admin",
        "operator-help": "help-admin",
        "manual": "manpage",
        "get-manpage": "manpage",
        "fetch-manpage": "manpage",
        "list": "sessions",
        "list-sessions": "sessions",
        "session-list": "sessions",
        "model-list": "models",
        "models-list": "models",
        "list-models": "models",
        "show-models": "models",
        "update-model-list": "update-models",
        "update-model-cache": "update-models",
        "refresh-models": "update-models",
        "refresh-model-cache": "update-models",
        "cache-models": "model-cache",
        "cached-models": "model-cache",
        "models-cache": "model-cache",
        "model-json": "model-cache",
        "search-models": "model-search",
        "models-search": "model-search",
        "model-list-search": "model-search",
        "find-model": "model-search",
        "find-models": "model-search",
        "grep-models": "model-search",
        "delete": "delete-session",
        "rm": "delete-session",
        "remove-session": "delete-session",
        "rm-session": "delete-session",
        "router-list": "routers",
        "faves": "favorites",
        "unbookmark-model": "unfavorite-model",
        "doctor": "ttydoctor",
        "ttyconfig-summary": "ttyconfig",
        "prefs": "ttyconfig",
        "preferences": "ttyconfig",
        "set": "tty-set",
        "unset": "tty-unset",
        "profile": "user",
        "registry": "user",
        "set-api-key": "api-key",
        "forget-api-key": "forget-api-key",
        "remove-api-key": "forget-api-key",
        "archive-public-session": "archive-session",
        "archive-on-expire": "archive-session",
        "public-archive": "archive-session",
        "archive-opt-in": "archive-session",
        "archive-opt-out": "archive-session",
    }
    archive_opt_alias = command
    command = aliases.get(command, command)
    if archive_opt_alias in {"archive-opt-in"} and not args:
        args = ["on"]
    elif archive_opt_alias in {"archive-opt-out"} and not args:
        args = ["off"]

    if command == "help":
        return True, mailbot_command_help(cfg), []

    if command == "help-admin":
        if not private_allowed_sender(sender, cfg):
            command_subject = footer_command_subject(cfg)
            return False, (
                "help-admin is available only to ALLOWED_FROM senders.\n\n"
                "For regular-user help, send:\n\n"
                f"  Subject: {command_subject}\n"
                "  Body: help\n"
            ), []
        return True, mailbot_admin_help(cfg), []

    if command == "manpage":
        manual = mailbot_manual_text(cfg)
        data = manual.encode("utf-8")
        if len(data) > cfg.max_outgoing_attachment_bytes:
            return False, f"manual attachment too large: {len(data)} bytes > {cfg.max_outgoing_attachment_bytes}\n", []
        body = "Attached: ttychatter.mailbot-manual.txt\n"
        return True, body, [ReplyAttachment("ttychatter.mailbot-manual.txt", data, "text", "plain")]

    if command == "config":
        if sender and not private_allowed_sender(sender, cfg):
            return False, (
                "config is an administrator command. "
                "User commands operate on your private mailbot profile; "
                "global mailbot configuration export/update is not available here.\n"
            ), []
        body, attachments = deliver_text_output(
            cfg,
            "config",
            public_config_text(cfg),
            "ttychatter-mailbot-config.txt",
            "ttychatter.mailbot config export",
        )
        return True, body, attachments

    if command == "user":
        return True, runtime_user_status(cfg), []

    if command == "api-key":
        if len(args) != 1:
            return False, "usage: api-key OPENROUTER_API_KEY\n", []
        if dry_run:
            return True, "[dry-run] would save per-user OpenRouter API key to a secret file\n", []
        try:
            return True, save_runtime_user_api_key(cfg, args[0]), []
        except Exception as exc:
            return False, f"api-key save failed: {exc}\n", []

    if command == "forget-api-key":
        if args:
            return False, "usage: forget-api-key\n", []
        if dry_run:
            return True, "[dry-run] would remove this user's per-user OpenRouter API key\n", []
        try:
            return True, forget_runtime_user_api_key(cfg), []
        except Exception as exc:
            return False, f"forget-api-key failed: {exc}\n", []

    if command == "sessions":
        body, attachments = deliver_text_output(cfg, "sessions", format_session_list_with_previews(cfg), "ttychatter-sessions.txt")
        return True, body, attachments

    if command == "search":
        query = " ".join(args).strip()
        if not query:
            return False, "usage: search TEXT\n", []
        return True, search_session_logs(cfg, query), []

    if command == "search-session":
        if len(args) < 2:
            return False, "usage: search-session SESSION TEXT\n", []
        return True, search_session_logs(cfg, " ".join(args[1:]), session=args[0]), []

    if command == "rename-session":
        if len(args) != 2:
            return False, "usage: rename-session OLD NEW\n", []
        if dry_run:
            return True, f"[dry-run] would rename session: {args[0]} -> {args[1]}\n", []
        try:
            return True, rename_session_file(cfg, args[0], args[1]), []
        except Exception as exc:
            return False, f"rename-session failed: {exc}\n", []

    if command == "delete-session":
        if len(args) != 1:
            return False, "usage: delete-session SESSION or delete{SESSION}\n", []
        try:
            name, target = validated_session_log_target(cfg, args[0])
        except Exception as exc:
            return False, f"delete-session failed: {exc}\n", []
        if dry_run:
            return True, f"[dry-run] would delete session: {name}\npath: {target}\n", []
        try:
            return True, delete_session_file(cfg, args[0]), []
        except Exception as exc:
            return False, f"delete-session failed: {exc}\n", []

    if command == "archive-session":
        if not args:
            return public_archive_preference_status(cfg, sender)
        if len(args) != 1 or normalize_keyword(args[0]) not in {"on", "off", "yes", "no", "true", "false", "1", "0", "status"}:
            return False, "usage: archive-session [on|off|status]\n", []
        action = normalize_keyword(args[0])
        if action == "status":
            return public_archive_preference_status(cfg, sender)
        enabled = action in {"on", "yes", "true", "1"}
        return set_public_archive_preference(cfg, sender, enabled, dry_run=dry_run)

    if command == "model-cache":
        if args:
            return False, "usage: model-cache\n", []
        if dry_run:
            return True, f"[dry-run] would attach existing cache only: {cfg.model_cache_file}\n", []
        return model_cache_reply(cfg)

    if command == "model-search":
        query = " ".join(args).strip()
        if not query:
            return False, "usage: model-search TEXT\n", []
        ok, search_body = search_model_cache(cfg, query)
        body, attachments = deliver_text_output(cfg, "model-search", search_body, "model-search.txt")
        return ok, body, attachments

    if command == "update-models":
        if args:
            return False, "usage: update-models\n", []
        if dry_run:
            return True, f"[dry-run] would run: {cfg.ttychatter_command} --update-models\n", []
        rc, stdout, stderr_text = run_ttychatter_cli(cfg, ["--update-models"])
        output = format_cli_result("ttychatter.python --update-models", rc, stdout, stderr_text, cfg.max_command_output_bytes)
        cache_path = parse_updated_model_cache_path("\n".join([stdout, stderr_text])) or cfg.model_cache_file
        ok_file, file_body, attachments = deliver_file_output(cfg, "model-cache", cache_path, "models-cache.json", "updated model cache")
        output += "\n" + file_body
        return rc == 0 and ok_file, output, attachments

    if command in {"models", "routers"}:
        ok, safe_args, reason = validate_model_list_args(args)
        if not ok:
            return False, reason + "\n", []
        cli = ["--models" if command == "models" else "--routers"] + safe_args
        if dry_run:
            return True, "[dry-run] would run: " + " ".join([cfg.ttychatter_command] + cli) + "\n", []
        rc, stdout, stderr_text = run_ttychatter_cli(cfg, cli)
        label = "ttychatter.python " + " ".join(cli)
        if stdout:
            intro = label + "\n" + f"exit_status: {rc}"
            if stderr_text:
                intro += "\n\n--- stderr ---\n" + truncate_text_bytes(stderr_text, cfg.max_command_output_bytes)
            delivered, attachments = deliver_text_output(cfg, command, stdout, f"ttychatter-{command}.txt", intro)
            return rc == 0, delivered, attachments
        body = format_cli_result(label, rc, stdout, stderr_text, cfg.max_command_output_bytes)
        return rc == 0, body, []

    fixed_tty_commands = {
        "favorites": ["--favorites"],
        "ttyconfig": ["--config"],
        "ttydoctor": ["--doctor"],
        "credits": ["--credits"],
    }
    if command in fixed_tty_commands:
        if args:
            return False, f"usage: {command}\n", []
        if dry_run:
            return True, "[dry-run] would run: " + " ".join([cfg.ttychatter_command] + fixed_tty_commands[command]) + "\n", []
        rc, stdout, stderr_text = run_ttychatter_cli(cfg, fixed_tty_commands[command])
        return rc == 0, format_cli_result("ttychatter.python " + " ".join(fixed_tty_commands[command]), rc, stdout, stderr_text, cfg.max_command_output_bytes), []

    single_arg_tty_commands = {
        "favorite-model": "--favorite-model",
        "unfavorite-model": "--unfavorite-model",
        "test-model": "--test-model",
        "show-memory": "--show-memory",
        "clear-memory": "--clear-memory",
    }
    if command in single_arg_tty_commands:
        if len(args) != 1:
            return False, f"usage: {command} ARG\n", []
        cli = [single_arg_tty_commands[command], args[0]]
        if dry_run:
            return True, "[dry-run] would run: " + " ".join([cfg.ttychatter_command] + cli) + "\n", []
        rc, stdout, stderr_text = run_ttychatter_cli(cfg, cli)
        return rc == 0, format_cli_result("ttychatter.python " + " ".join(cli), rc, stdout, stderr_text, cfg.max_command_output_bytes), []

    if command == "tty-unset":
        if len(args) != 1:
            return False, "usage: tty-unset KEY\n", []
        key = args[0]
        if api_key_config_key(key):
            if dry_run:
                return True, "[dry-run] would remove this user's per-user OpenRouter API key\n", []
            try:
                return True, forget_runtime_user_api_key(cfg), []
            except Exception as exc:
                return False, f"forget-api-key failed: {exc}\n", []
        if not user_ttyconfig_key_allowed(cfg, key):
            return False, "tty-unset refused; allowed keys: " + ", ".join(cfg.user_ttyconfig_allowed_keys) + "\n", []
        cli = ["--unset", key]
        if dry_run:
            return True, "[dry-run] would run: " + " ".join([cfg.ttychatter_command] + cli) + "\n", []
        rc, stdout, stderr_text = run_ttychatter_cli(cfg, cli)
        return rc == 0, format_cli_result("ttychatter.python --unset " + key, rc, stdout, stderr_text, cfg.max_command_output_bytes), []

    if command == "tty-set":
        if len(args) < 2:
            return False, "usage: tty-set KEY VALUE\n", []
        key = args[0]
        value = " ".join(args[1:])
        if api_key_config_key(key):
            if dry_run:
                return True, "[dry-run] would save per-user OpenRouter API key to a secret file\n", []
            try:
                return True, save_runtime_user_api_key(cfg, value), []
            except Exception as exc:
                return False, f"api-key save failed: {exc}\n", []
        if not user_ttyconfig_key_allowed(cfg, key):
            return False, "tty-set refused; allowed keys: " + ", ".join(cfg.user_ttyconfig_allowed_keys) + "\n", []
        cli = ["--set", key, value]
        if dry_run:
            return True, "[dry-run] would run: " + " ".join([cfg.ttychatter_command, "--set", key, "VALUE"]) + "\n", []
        rc, stdout, stderr_text = run_ttychatter_cli(cfg, cli)
        return rc == 0, format_cli_result(f"ttychatter.python --set {key} VALUE", rc, stdout, stderr_text, cfg.max_command_output_bytes), []

    return False, f"unknown mailbot command: {tokens[0]}\n\n" + mailbot_command_help(cfg), []


def fetch_message_peek(conn: imaplib.IMAP4, uid: bytes) -> Optional[Message]:
    """Fetch an unread candidate without consuming its unread state.

    The single most important safety rule in this mailbot is: inspection must
    not mutate the mailbox.  IMAP BODY[] and RFC822 fetches commonly set the
    \\Seen flag.  BODY.PEEK[] is the standard way to read enough of the message
    for parsing while leaving unread messages unread until ttychatter actually
    processes them successfully.
    """
    status, data = conn.uid("FETCH", uid, "(BODY.PEEK[])")
    if status != "OK" or not data or data[0] is None:
        return None
    raw = data[0][1]
    return email.message_from_bytes(raw, policy=email.policy.default)


def candidate_skip_reason(cfg: Config, msg: Message, uid: bytes, processed: set[str]) -> str:
    subject = msg.get("Subject", "")
    body = extract_body(msg, cfg.max_body_bytes)
    request = parse_subject_request(subject, cfg, body)
    sender = message_sender(msg)
    msgid = msg.get("Message-ID", f"imap-uid-{uid.decode(errors='replace')}")
    if msgid in processed:
        return "skip: Message-ID already processed"
    reject_reason = sender_reject_reason(sender, cfg)
    if reject_reason:
        return f"skip: {reject_reason} ({sender or 'empty sender'})"
    spam_reason = spam_reject_reason(cfg, msg, sender)
    if spam_reason:
        return f"skip: spam protection: {spam_reason}"
    if request is None:
        if cfg.open_to_public:
            return "match: public prompt (no control subject)"
        if cfg.subject_sessions:
            return "skip: empty or unrecognized subject"
        return f"skip: subject does not contain {subject_marker(cfg)}COMMAND or {subject_marker(cfg)}{cfg.session_open_delim}session{cfg.session_close_delim}"
    if not allowed_sender(sender, cfg):
        return f"skip: sender not allowed ({sender or 'empty sender'}); allowed={','.join(cfg.allowed_from) or 'empty'}"
    privileged = private_allowed_sender(sender, cfg)
    msg_limit_reason = message_limit_reject_reason(cfg, msg, privileged)
    if msg_limit_reason:
        return f"skip: {msg_limit_reason}"
    rate_reason = rate_limit_check(cfg, sender, privileged, record=False)
    if rate_reason:
        return f"skip: {rate_reason}"
    quota_reason = daily_quota_check(cfg, sender, privileged, record=False)
    if quota_reason:
        return f"skip: {quota_reason}"
    if (
        cfg.open_to_public
        and not private_allowed_sender(sender, cfg)
        and not registry_user_commands_available(sender, cfg)
        and request.kind == "command"
        and not public_command_allowed(cfg, request.value)
    ):
        return "match: public command refused"
    if cfg.open_to_public and not private_allowed_sender(sender, cfg) and request.kind == "config":
        return "match: public config command refused"
    if request.kind == "config":
        return "match: mailbot config command"
    if request.kind == "command":
        return "match: mailbot control command"
    return "match: ttychatter session"


def process_denied_control_message(cfg: Config, conn: imaplib.IMAP4, uid: bytes, msg: Message, command: str, reason: str, dry_run: bool = False) -> bool:
    msgid = msg.get("Message-ID", f"imap-uid-{uid.decode(errors='replace')}")
    processed = load_processed(cfg.processed_db)
    if msgid in processed:
        return False
    body = "command refused\n" + reason.rstrip() + "\n"
    reply = build_control_reply(cfg, msg, command, body, False, [])
    if dry_run:
        print(reply.as_string())
    else:
        send_reply(cfg, reply)
        remember_processed(cfg.processed_db, msgid)
        if cfg.mark_seen:
            conn.uid("STORE", uid, "+FLAGS", "(\\Seen)")
    return True


def process_config_message(cfg: Config, conn: imaplib.IMAP4, uid: bytes, msg: Message, dry_run: bool = False) -> bool:
    msgid = msg.get("Message-ID", f"imap-uid-{uid.decode(errors='replace')}")
    processed = load_processed(cfg.processed_db)
    if msgid in processed:
        return False

    found = find_config_attachment(msg, cfg.max_attachment_bytes)
    if found is None:
        body = (
            "ttychatter.mailbot config export\n"
            "\n"
            f"Edit the attached config file and mail it back with the same subject {subject_marker(cfg)}{cfg.config_subject_token}.\n"
            "Plaintext password values are redacted; encrypted password file paths are preserved.\n"
        )
        reply = build_config_reply(cfg, msg, body, attachment_text=public_config_text(cfg))
    else:
        filename, text = found
        if dry_run:
            body = f"[dry-run] would replace config from attachment: {filename}\n"
        else:
            backup = apply_config_attachment(cfg, text)
            body = f"updated config from attachment: {filename}\nbackup: {backup}\n"
        reply = build_config_reply(cfg, msg, body)

    if dry_run:
        print(reply.as_string())
    else:
        send_reply(cfg, reply)
        remember_processed(cfg.processed_db, msgid)
        if cfg.mark_seen:
            conn.uid("STORE", uid, "+FLAGS", "(\\Seen)")
    return True


def process_mailbot_command_message(cfg: Config, conn: imaplib.IMAP4, uid: bytes, msg: Message, command_line: str, dry_run: bool = False) -> bool:
    msgid = msg.get("Message-ID", f"imap-uid-{uid.decode(errors='replace')}")
    processed = load_processed(cfg.processed_db)
    if msgid in processed:
        return False

    body = extract_body(msg, cfg.max_body_bytes)
    body_first_line = first_command_line_from_body(body)
    if command_line:
        if body_first_line and command_line.strip() == body_first_line.strip():
            # Body-command subjects already supplied the command as the first
            # body line. Avoid converting Body: models into "models models".
            command_line = command_line.strip()
        else:
            command_line = maybe_append_body_arguments(command_line, body)
    else:
        command_line = body_first_line or "help"
    ok, output, attachments = dispatch_mailbot_command(cfg, command_line, dry_run=dry_run, sender=message_sender(msg))
    reply = build_control_reply(cfg, msg, command_line, output, ok, attachments)

    if dry_run:
        print(reply.as_string())
    else:
        send_reply(cfg, reply)
        remember_processed(cfg.processed_db, msgid)
        if cfg.mark_seen:
            conn.uid("STORE", uid, "+FLAGS", "(\\Seen)")
    return True


def process_message(cfg: Config, conn: imaplib.IMAP4, uid: bytes, dry_run: bool = False) -> bool:
    msg = fetch_message_peek(conn, uid)
    if msg is None:
        return False
    msgid = msg.get("Message-ID", f"imap-uid-{uid.decode(errors='replace')}")
    subject = msg.get("Subject", "")
    sender = message_sender(msg)
    if sender_reject_reason(sender, cfg):
        return False
    if spam_reject_reason(cfg, msg, sender):
        return False
    body_for_command = extract_body(msg, cfg.max_body_bytes)
    request = parse_subject_request(subject, cfg, body_for_command)
    if request is None:
        if cfg.open_to_public:
            request = SubjectRequest("session", public_session_name_for_message(cfg, msg, uid), raw=subject)
        else:
            return False
    if not allowed_sender(sender, cfg):
        return False

    processed = load_processed(cfg.processed_db)
    if msgid in processed:
        return False

    privileged = private_allowed_sender(sender, cfg)
    msg_limit_reason = message_limit_reject_reason(cfg, msg, privileged)
    if msg_limit_reason:
        print(f"skip: {msg_limit_reason}", file=sys.stderr)
        return False
    rate_reason = rate_limit_check(cfg, sender, privileged, record=not dry_run)
    if rate_reason:
        print(f"skip: {rate_reason}", file=sys.stderr)
        return False
    quota_reason = daily_quota_check(cfg, sender, privileged, record=not dry_run)
    if quota_reason:
        print(f"skip: {quota_reason}", file=sys.stderr)
        return False
    public_unprivileged = bool(cfg.open_to_public and not privileged)
    runtime_cfg = cfg
    if request.kind != "config":
        try:
            runtime_cfg = runtime_config_for_sender(cfg, sender)
        except Exception as exc:
            print(f"user registry setup failed for {sender}: {exc}", file=sys.stderr)
            return False
    if request.kind == "config":
        if cfg.open_to_public and not privileged:
            return process_denied_control_message(
                cfg,
                conn,
                uid,
                msg,
                "config",
                "public mode refuses config export/update for non-ALLOWED_FROM senders",
                dry_run=dry_run,
            )
        return process_config_message(cfg, conn, uid, msg, dry_run=dry_run)
    if request.kind == "command":
        if cfg.open_to_public and not privileged and not registry_user_commands_available(sender, cfg) and not public_command_allowed(cfg, request.value):
            return process_denied_control_message(
                cfg,
                conn,
                uid,
                msg,
                request.value,
                "public mode without USER_REGISTRY allows only: " + ", ".join(cfg.public_allowed_commands),
                dry_run=dry_run,
            )
        return process_mailbot_command_message(runtime_cfg, conn, uid, msg, request.value, dry_run=dry_run)

    session = request.value
    if public_unprivileged:
        if cfg.user_registry and cfg.subject_sessions:
            session = request.value or public_session_name_for_message(cfg, msg, uid)
        else:
            session = public_session_from_request(cfg, request, msg, uid)
            if not dry_run:
                record_public_session(cfg, session, sender)
    session_limit_reason = session_count_reject_reason(runtime_cfg, session, privileged)
    if session_limit_reason:
        print(f"skip: {session_limit_reason}", file=sys.stderr)
        return False
    body = request.body_override if request.body_override is not None else body_for_command
    if not body:
        body = "(empty email body)"

    runtime_cfg.work_dir.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="ttychatter-mailbot-", dir=str(runtime_cfg.work_dir)) as tmp:
        tempdir = Path(tmp)
        attachments = save_attachments(msg, tempdir, runtime_cfg.max_attachment_bytes) if runtime_cfg.process_attachments else []
        api_reason = api_cost_reject_reason(runtime_cfg, body, attachments, privileged)
        if api_reason:
            print(f"skip: {api_reason}", file=sys.stderr)
            return False
        rc, output, stderr_text = (0, "[dry-run] would call ttychatter here", "")
        if not dry_run:
            rc, output, stderr_text = run_ttychatter(runtime_cfg, session, body, attachments)
        ok = rc == 0
        reply_session = display_session_name(session, stderr_text)
        reply = build_reply(runtime_cfg, msg, reply_session, output if ok else stderr_text or output, stderr_text, ok)
        if not dry_run:
            send_reply(runtime_cfg, reply)
            if public_unprivileged and ok:
                trim_note = trim_public_session_log(runtime_cfg, session_log_path(runtime_cfg, reply_session), dry_run=False)
                if trim_note:
                    print(trim_note)
            remember_processed(runtime_cfg.processed_db, msgid)
            if runtime_cfg.mark_seen:
                conn.uid("STORE", uid, "+FLAGS", "(\\Seen)")
        else:
            print(reply.as_string())
    return True


def list_candidates(cfg: Config) -> int:
    """Print unread candidates and skip reasons without changing mail state."""
    cfg.work_dir.mkdir(parents=True, exist_ok=True)
    conn = imap_connect(cfg)
    try:
        status, data = conn.uid("SEARCH", None, "UNSEEN")
        if status != "OK":
            print("IMAP search failed", file=sys.stderr)
            return 1
        uids = (data[0] or b"").split()
        processed = load_processed(cfg.processed_db)
        if not uids:
            print("no unread candidates")
            return 0
        for uid in uids:
            msg = fetch_message_peek(conn, uid)
            if msg is None:
                print(f"uid={uid.decode(errors='replace')} skip: fetch failed")
                continue
            sender = message_sender(msg)
            subject = msg.get("Subject", "")
            msgid = msg.get("Message-ID", f"imap-uid-{uid.decode(errors='replace')}")
            reason = candidate_skip_reason(cfg, msg, uid, processed)
            print(f"uid={uid.decode(errors='replace')} from={sender} subject={subject!r} message_id={msgid!r} {reason}")
    finally:
        try:
            conn.logout()
        except Exception:
            pass
    return 0


def run_once(cfg: Config, dry_run: bool = False) -> int:
    cfg.work_dir.mkdir(parents=True, exist_ok=True)
    cfg.processed_db.parent.mkdir(parents=True, exist_ok=True)
    cfg.session_dir.mkdir(parents=True, exist_ok=True)
    cfg.attachment_dir.mkdir(parents=True, exist_ok=True)

    cleanup_note = cleanup_public_sessions(cfg, dry_run=dry_run)
    if cleanup_note:
        print(cleanup_note, end="")

    conn = imap_connect(cfg)
    processed_count = 0
    try:
        status, data = conn.uid("SEARCH", None, "UNSEEN")
        if status != "OK":
            print("IMAP search failed", file=sys.stderr)
            return 1
        uids = (data[0] or b"").split()
        for uid in uids[: cfg.max_messages_per_run]:
            if process_message(cfg, conn, uid, dry_run=dry_run):
                processed_count += 1
    finally:
        try:
            conn.logout()
        except Exception:
            pass
    print(f"processed messages: {processed_count}")
    return 0


def run_daemon(cfg: Config, dry_run: bool = False) -> int:
    while True:
        try:
            run_once(cfg, dry_run=dry_run)
        except KeyboardInterrupt:
            return 0
        except Exception as exc:
            print(f"mailbot error: {exc}", file=sys.stderr)
        time.sleep(cfg.poll_interval)


# ---------------------------------------------------------------------------
# CLI utilities
# ---------------------------------------------------------------------------


def config_readable(path: Path) -> bool:
    try:
        return path.is_file() and os.access(path, os.R_OK)
    except OSError:
        return False


def config_mode_string(path: Path) -> str:
    try:
        return oct(path.stat().st_mode & 0o777)
    except OSError:
        return "missing"


def print_raw_config(cfg: Config) -> None:
    print(public_config_text(cfg), end="")


def doctor(cfg: Config) -> int:
    checks: List[Tuple[str, bool, str]] = []
    checks.append(("process user", True, f"{getpass.getuser()} HOME={Path.home()}"))
    env_cfg = os.environ.get(CONFIG_ENV_VAR, "").strip()
    checks.append(("config env", True, f"{CONFIG_ENV_VAR}={env_cfg}" if env_cfg else "not set"))
    xdg_cfg = os.environ.get("XDG_CONFIG_HOME", "").strip()
    checks.append(("xdg config home", True, f"XDG_CONFIG_HOME={xdg_cfg}" if xdg_cfg else "not set"))
    checks.append(("config file", cfg.config_file.exists(), str(cfg.config_file)))
    checks.append(("config readable", config_readable(cfg.config_file), f"mode {config_mode_string(cfg.config_file)}"))
    parsed_keys, ignored_lines = config_parse_summary(cfg.config_file)
    if cfg.config_file.exists():
        ignored_detail = "; ".join(ignored_lines[:5])
        if len(ignored_lines) > 5:
            ignored_detail += f"; ... {len(ignored_lines) - 5} more"
        detail = f"{parsed_keys} recognized"
        if ignored_lines:
            detail += f", {len(ignored_lines)} ignored ({ignored_detail})"
        checks.append(("config parsed keys", parsed_keys > 0, detail))
    checks.append(("imap host", bool(cfg.imap_host), cfg.imap_host))
    checks.append(("imap user", bool(cfg.imap_user), cfg.imap_user or "missing"))
    imap_password_source_ok = bool(cfg.imap_password or cfg.imap_password_gpg_file.exists())
    checks.append(("imap password source", imap_password_source_ok, password_source_description(cfg.imap_password, cfg.imap_password_gpg_file)))
    checks.append(("open to public", True, "yes" if cfg.open_to_public else "no"))
    checks.append(("reject self sender", True, "yes" if cfg.reject_self_sender else "no"))
    checks.append(("deny from", True, ", ".join(cfg.deny_from) or "empty"))
    checks.append(("allowed from", bool(cfg.allowed_from) or cfg.open_to_public, ", ".join(cfg.allowed_from) or ("not required in public mode" if cfg.open_to_public else "missing")))
    checks.append(("public session mode", True, cfg.public_session_mode if cfg.open_to_public else "inactive"))
    checks.append(("public allowed commands", True, ",".join(cfg.public_allowed_commands) if cfg.open_to_public else "inactive"))
    checks.append(("user registry", True, "enabled" if cfg.user_registry else "disabled"))
    checks.append(("subject sessions", True, "enabled" if cfg.subject_sessions else "disabled"))
    default_key_present = bool(read_secret_file(cfg.default_openrouter_api_key_file) or os.environ.get("OPENROUTER_API_KEY") or os.environ.get("TTYCHATTER_API_KEY"))
    checks.append(("default OpenRouter key", default_key_present, cfg.runtime_api_key_source or str(cfg.default_openrouter_api_key_file)))
    checks.append(("spam protection", True, "enabled" if cfg.spam_protection else "disabled"))
    checks.append(("rate limit", True, "enabled" if cfg.rate_limit_enabled else "disabled"))
    checks.append(("daily quota", True, "enabled" if cfg.daily_quota_enabled else "disabled"))
    checks.append(("api cost protection", True, "enabled" if cfg.api_cost_protection else "disabled"))
    checks.append(("mail from", bool(cfg.mail_from or cfg.smtp_user or cfg.imap_user), cfg.mail_from or cfg.smtp_user or cfg.imap_user or "missing"))
    checks.append(("gpg", gpg_available(), "found" if gpg_available() else "not found"))
    checks.append(("ttychatter command", bool(cfg.ttychatter_command), cfg.ttychatter_command))
    checks.append(("model cache file", True, str(cfg.model_cache_file)))
    found_manpage = next((p for p in mailbot_manpage_candidates(cfg) if p.is_file()), None)
    checks.append(("mailbot manpage", True, str(found_manpage) if found_manpage else "embedded fallback"))
    for label, path in [
        ("session dir", cfg.session_dir),
        ("attachment dir", cfg.attachment_dir),
        ("model cache dir", cfg.model_cache_file.parent),
        ("work dir", cfg.work_dir),
        ("processed db dir", cfg.processed_db.parent),
        ("public session index dir", cfg.public_session_index_file.parent),
        ("user registry dir", cfg.user_registry_file.parent),
        ("user home root", cfg.user_home_root),
        ("user secret dir", cfg.user_secret_dir),
        ("default key dir", cfg.default_openrouter_api_key_file.parent),
        ("rate limit db dir", cfg.rate_limit_db.parent),
        ("daily quota db dir", cfg.daily_quota_db.parent),
    ]:
        try:
            path.mkdir(parents=True, exist_ok=True)
            writable = os.access(path, os.W_OK)
        except Exception:
            writable = False
        checks.append((label, writable, str(path)))

    rc = 0
    for name, ok, detail in checks:
        print(f"{'OK' if ok else 'FAIL'}\t{name}\t{detail}")
        hard_failures = {"config file", "config readable", "config parsed keys", "imap user", "imap password source", "mail from", "ttychatter command"}
        if not cfg.open_to_public:
            hard_failures.add("allowed from")
        if not ok and name in hard_failures:
            rc = 1
    for note in cfg.config_load_notes:
        print(f"WARN\tconfig parse\t{note}")
    return rc


def print_config(cfg: Config) -> None:
    # Never print password values.  Showing that a password source exists is
    # enough for diagnostics and avoids accidental secret disclosure in forum
    # posts or bug reports.
    print(f"PROCESS_USER={getpass.getuser()}")
    print(f"HOME={Path.home()}")
    print(f"{CONFIG_ENV_VAR}={os.environ.get(CONFIG_ENV_VAR, '').strip()}")
    print(f"XDG_CONFIG_HOME={os.environ.get('XDG_CONFIG_HOME', '').strip()}")
    print(f"CONFIG_FILE={cfg.config_file}")
    print(f"CONFIG_EXISTS={int(cfg.config_file.exists())}")
    print(f"CONFIG_READABLE={int(config_readable(cfg.config_file))}")
    print(f"CONFIG_MODE={config_mode_string(cfg.config_file)}")
    parsed_keys, ignored_lines = config_parse_summary(cfg.config_file)
    print(f"CONFIG_RECOGNIZED_KEYS={parsed_keys}")
    print(f"CONFIG_IGNORED_LINES={len(ignored_lines)}")
    if not cfg.config_file.exists():
        print("CONFIG_NOTE=no config file was read; values below are defaults plus environment overrides")
    for note in cfg.config_load_notes:
        print(f"CONFIG_LOAD_NOTE={note}")
    print(f"IMAP_HOST={cfg.imap_host}")
    print(f"IMAP_PORT={cfg.imap_port}")
    print(f"IMAP_SSL={int(cfg.imap_ssl)}")
    print(f"IMAP_USER={cfg.imap_user}")
    print(f"IMAP_PASSWORD={'set' if cfg.imap_password else 'unset'}")
    print(f"IMAP_PASSWORD_GPG_FILE={cfg.imap_password_gpg_file}")
    print(f"IMAP_MAILBOX={cfg.imap_mailbox}")
    print(f"SEND_METHOD={cfg.send_method}")
    print(f"SENDMAIL_PATH={cfg.sendmail_path}")
    print(f"SMTP_HOST={cfg.smtp_host}")
    print(f"SMTP_PORT={cfg.smtp_port}")
    print(f"SMTP_SSL={int(cfg.smtp_ssl)}")
    print(f"SMTP_STARTTLS={int(cfg.smtp_starttls)}")
    print(f"SMTP_USER={cfg.smtp_user}")
    print(f"SMTP_PASSWORD={'set' if cfg.smtp_password else 'unset'}")
    print(f"SMTP_PASSWORD_GPG_FILE={cfg.smtp_password_gpg_file}")
    print(f"MAIL_FROM={cfg.mail_from}")
    print(f"MAIL_TO={cfg.mail_to}")
    print(f"ALLOWED_FROM={','.join(cfg.allowed_from)}")
    print(f"DENY_FROM={','.join(cfg.deny_from)}")
    print(f"REJECT_SELF_SENDER={int(cfg.reject_self_sender)}")
    print(f"OPEN_TO_PUBLIC={int(cfg.open_to_public)}")
    print(f"PUBLIC_SESSION_MODE={cfg.public_session_mode}")
    print(f"PUBLIC_SESSION_PREFIX={cfg.public_session_prefix}")
    print(f"PUBLIC_SHARED_SESSION={cfg.public_shared_session}")
    print(f"PUBLIC_ALLOW_NAMED_SESSIONS={int(cfg.public_allow_named_sessions)}")
    print(f"PUBLIC_ALLOWED_COMMANDS={','.join(cfg.public_allowed_commands)}")
    print(f"PUBLIC_SESSION_CLEANUP={int(cfg.public_session_cleanup)}")
    print(f"PUBLIC_SESSION_TTL_HOURS={cfg.public_session_ttl_hours}")
    print(f"PUBLIC_SESSION_IDLE_HOURS={cfg.public_session_idle_hours}")
    print(f"PUBLIC_SESSION_MAX_COUNT={cfg.public_session_max_count}")
    print(f"PUBLIC_SESSION_MAX_TURNS={cfg.public_session_max_turns}")
    print(f"PUBLIC_SESSION_INDEX_FILE={cfg.public_session_index_file}")
    print(f"PUBLIC_SESSION_ARCHIVE_ON_DELETE={int(cfg.public_session_archive_on_delete)}")
    print(f"PUBLIC_SESSION_ARCHIVE_USER_TOGGLE={int(cfg.public_session_archive_user_toggle)}")
    print(f"PUBLIC_SESSION_ARCHIVE_FAILURE_POLICY={cfg.public_session_archive_failure_policy}")
    print(f"PUBLIC_SESSION_ARCHIVE_MAX_BYTES={cfg.public_session_archive_max_bytes}")
    print(f"SUBJECT_PREFIX={cfg.subject_prefix}")
    print(f"SUBJECT_SEPARATOR={cfg.subject_separator}")
    print(f"SESSION_OPEN_DELIM={cfg.session_open_delim}")
    print(f"SESSION_CLOSE_DELIM={cfg.session_close_delim}")
    print(f"ALLOW_COMMANDS_IN_SUBJECT={int(cfg.allow_commands_in_subject)}")
    print(f"ALLOW_BODY_COMMAND_SUBJECTS={int(cfg.allow_body_command_subjects)}")
    print(f"ALLOW_BARE_CONTROL_SUBJECTS={int(cfg.allow_bare_control_subjects)}")
    print(f"ALLOW_LEGACY_BRACED_CONTROL={int(cfg.allow_legacy_braced_control)}")
    print(f"RE_SESSION_SUBJECTS={cfg.re_session_subjects}")
    print(f"CONFIG_SUBJECT_TOKEN={cfg.config_subject_token}")
    print(f"MODELS_SUBJECT_TOKEN={cfg.models_subject_token}")
    print(f"COMMAND_SUBJECT_TOKEN={cfg.command_subject_token}")
    print(f"MAILBOT_SUBJECT_TOKEN={cfg.mailbot_subject_token}")
    print(f"BODY_COMMAND_SUBJECTS={','.join(cfg.body_command_subjects)}")
    print(f"MAILBOT_MANPAGE_FILE={cfg.mailbot_manpage_file or ''}")
    print(f"CONFIG_UPDATE_REQUIRES_ATTACHMENT={int(cfg.config_update_requires_attachment)}")
