# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
# The config parser is deliberately boring: KEY=VALUE lines, blank lines, and
# comments.  This is the same spirit as the rest of ttychatter.  A future
# maintainer should resist the urge to require YAML/TOML/JSON just to start a
# mail transport daemon.  Mailbots often run in plain server environments where
# minimalism and readability are more valuable than fancy config syntax.
# ---------------------------------------------------------------------------


@dataclass
class Config:
    config_file: Path = DEFAULT_CONFIG_FILE
    config_load_notes: List[str] = field(default_factory=list)

    imap_host: str = "localhost"
    imap_port: int = 993
    imap_ssl: bool = True
    imap_user: str = ""
    imap_password: str = ""
    imap_password_gpg_file: Path = DEFAULT_CONFIG_DIR / "imap-password.gpg"
    imap_mailbox: str = "INBOX"

    send_method: str = "sendmail"  # sendmail or smtp
    config_subject_token: str = "CONFIG"
    models_subject_token: str = "MODELS"
    command_subject_token: str = "CMD"
    mailbot_subject_token: str = "MAILBOT"
    body_command_subjects: List[str] = field(default_factory=lambda: ["MAILBOT", "CMD"])
    mailbot_manpage_file: Optional[Path] = None
    config_update_requires_attachment: bool = True
    sendmail_path: str = "/usr/sbin/sendmail"

    smtp_host: str = "localhost"
    smtp_port: int = 25
    smtp_ssl: bool = False
    smtp_starttls: bool = False
    smtp_user: str = ""
    smtp_password: str = ""
    smtp_password_gpg_file: Path = DEFAULT_CONFIG_DIR / "smtp-password.gpg"

    mail_from: str = ""
    mail_to: str = ""
    allowed_from: List[str] = field(default_factory=list)
    deny_from: List[str] = field(default_factory=list)
    reject_self_sender: bool = True

    subject_prefix: str = "tc"
    subject_separator: str = ":"
    session_open_delim: str = "{"
    session_close_delim: str = "}"
    allow_commands_in_subject: bool = True
    allow_body_command_subjects: bool = True
    allow_bare_control_subjects: bool = True
    allow_legacy_braced_control: bool = True
    re_session_subjects: str = "public"  # no, public, or always

    open_to_public: bool = False
    public_session_mode: str = "per-sender"  # per-sender, per-message, or shared
    public_session_prefix: str = "public"
    public_shared_session: str = "public-demo"
    public_allow_named_sessions: bool = False
    public_allowed_commands: List[str] = field(default_factory=lambda: ["help", "manpage", "model-cache", "model-search", "archive-session"])
    public_session_cleanup: bool = True
    public_session_ttl_hours: int = 168
    public_session_idle_hours: int = 72
    public_session_max_count: int = 200
    public_session_max_turns: int = 12
    public_session_index_file: Path = DEFAULT_STATE_DIR / "public-sessions.json"
    public_session_archive_on_delete: bool = True
    public_session_archive_user_toggle: bool = True
    public_session_archive_failure_policy: str = "keep"  # keep or delete
    public_session_archive_max_bytes: int = 1048576

    poll_interval: int = 60
    max_messages_per_run: int = 10
    max_body_bytes: int = 50000
    max_attachment_bytes: int = 1048576
    process_attachments: bool = True
    mark_seen: bool = True

    ttychatter_command: str = "ttychatter.python"
    ttychatter_extra_args: str = ""
    ttychatter_control_timeout: int = 180
    session_dir: Path = DEFAULT_SESSION_DIR
    attachment_dir: Path = DEFAULT_ATTACHMENT_DIR
    model_cache_file: Path = DEFAULT_MODEL_CACHE_FILE
    work_dir: Path = DEFAULT_CACHE_DIR / "work"
    processed_db: Path = DEFAULT_STATE_DIR / "processed-ids.txt"

    session_list_head_lines: int = 3
    session_list_tail_lines: int = 3
    session_list_max_sessions: int = 50
    session_preview_line_chars: int = 220
    session_search_max_matches: int = 100
    model_search_max_matches: int = 100
    command_output_mode: str = "auto"
    model_cache_output: str = "auto"
    model_search_output: str = "body"
    model_list_output: str = "auto"
    sessions_output: str = "body"
    config_output: str = "attachment"
    output_inline_max_bytes: int = 50000
    max_command_output_bytes: int = 200000
    max_outgoing_attachment_bytes: int = 8388608

    reply_subject_prefix: str = "Re:"
    include_ttychatter_stderr: bool = False

    # Multi-user registry / per-sender ttychatter homes. The mail transport
    # config remains global, but each sender gets a private ttychatter HOME,
    # config file, session directory, model cache, favorites file, and optional
    # API-key secret. This keeps subject-line sessions from colliding across
    # users and keeps plaintext keys out of normal config files.
    user_registry: bool = True
    subject_sessions: bool = True
    user_registry_file: Path = DEFAULT_USER_REGISTRY_FILE
    user_home_root: Path = DEFAULT_USER_HOME_ROOT
    user_secret_dir: Path = DEFAULT_USER_SECRET_DIR
    default_openrouter_api_key_file: Path = DEFAULT_OPENROUTER_API_KEY_FILE
    legacy_openrouter_config_file: Path = DEFAULT_LEGACY_OPENROUTER_CONFIG_FILE
    migrate_plaintext_openrouter_api_key: bool = True
    allow_user_api_keys: bool = True
    user_ttyconfig_allowed_keys: List[str] = field(default_factory=lambda: [
        "MODEL", "CONTEXT_TURNS", "HISTORY_LIMIT", "MODEL_TEST_PROMPT",
        "DEMO_MODE", "STARTUP_NOTICE", "MODEL_FILTER_GENERATE_CONTENT",
        "MODEL_FILTER_REQUIRE_TOKENS", "MODEL_FILTER_HIDE_PREVIEW",
        "MODEL_MIN_INPUT_TOKENS", "MODEL_MIN_OUTPUT_TOKENS",
        "MODEL_SORT_ORDER", "MODEL_TYPE_FILTER", "THEME", "SEND_INPUT",
        "CODE_ATTACHMENT_MIN_LINES", "MAX_ATTACHMENT_BYTES", "EDITOR",
    ])

    # Anti-abuse defaults are conservative and cheap: reject common mail-loop
    # and mailing-list headers, and cap work by sender plus globally. The bot
    # silently ignores refused mail by default to avoid backscatter.
    spam_protection: bool = True
    spam_reject_auto_submitted: bool = True
    spam_reject_list_mail: bool = True
    spam_max_recipients: int = 25
    rate_limit_enabled: bool = True
    rate_limit_db: Path = DEFAULT_RATE_LIMIT_DB
    rate_limit_window_seconds: int = 3600
    rate_limit_sender_messages: int = 20
    rate_limit_global_messages: int = 200
    rate_limit_public_sender_messages: int = 6
    rate_limit_public_global_messages: int = 60
    rate_limit_allowed_from: bool = True

    # Additional abuse controls. ALLOWED_FROM senders are treated as admins and
    # may bypass these caps when ABUSE_LIMIT_ALLOWED_FROM=0.
    abuse_limit_allowed_from: bool = True
    max_message_bytes: int = 262144
    max_attachment_count: int = 3
    max_total_attachment_bytes: int = 2097152
    daily_quota_enabled: bool = True
    daily_quota_db: Path = DEFAULT_DAILY_QUOTA_DB
    daily_quota_sender_messages: int = 50
    daily_quota_public_sender_messages: int = 12
    daily_quota_global_messages: int = 1000
    max_sessions_per_sender: int = 25
    api_cost_protection: bool = True
    api_max_input_chars: int = 100000
    api_max_estimated_tokens: int = 25000
    api_max_attachment_bytes: int = 2097152

    # Runtime-only fields populated after a sender is mapped to a registry user.
    runtime_user_email: str = ""
    runtime_user_id: str = ""
    runtime_ttychatter_home: Optional[Path] = None
    runtime_ttychatter_config_file: Optional[Path] = None
    runtime_user_api_key_file: Optional[Path] = None
    runtime_openrouter_api_key: str = ""
    runtime_api_key_source: str = ""


