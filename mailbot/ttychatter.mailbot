def set_password_command(cfg: Config, which: str, encrypted: bool) -> int:
    if encrypted and not gpg_available():
        print("gpg not found", file=sys.stderr)
        return 1
    secret = getpass.getpass(f"Enter {which.upper()} password: ")
    if not secret:
        print("empty password refused", file=sys.stderr)
        return 1
    if which == "imap":
        if encrypted:
            encrypt_secret_to_gpg(cfg.imap_password_gpg_file, secret)
            unset_config_value(cfg.config_file, "IMAP_PASSWORD")
            set_config_value(cfg.config_file, "IMAP_PASSWORD_GPG_FILE", str(cfg.imap_password_gpg_file))
            print(f"saved encrypted IMAP password to {cfg.imap_password_gpg_file}")
        else:
            set_config_value(cfg.config_file, "IMAP_PASSWORD", secret)
            print("saved IMAP_PASSWORD in plaintext config")
    else:
        if encrypted:
            encrypt_secret_to_gpg(cfg.smtp_password_gpg_file, secret)
            unset_config_value(cfg.config_file, "SMTP_PASSWORD")
            set_config_value(cfg.config_file, "SMTP_PASSWORD_GPG_FILE", str(cfg.smtp_password_gpg_file))
            print(f"saved encrypted SMTP password to {cfg.smtp_password_gpg_file}")
        else:
            set_config_value(cfg.config_file, "SMTP_PASSWORD", secret)
            print("saved SMTP_PASSWORD in plaintext config")
    return 0


def help_text() -> str:
    return f"""{PROGRAM} - email transport adapter and remote control surface for ttychatter

USAGE
    {PROGRAM} [--config-file PATH] --once [--dry-run] [--open-to-public]
    {PROGRAM} [--config-file PATH] --daemon [--open-to-public]
    {PROGRAM} --doctor
    {PROGRAM} --list-candidates
    {PROGRAM} --cleanup-public-sessions [--dry-run]
    {PROGRAM} --sessions
    {PROGRAM} --manpage
    {PROGRAM} --model-cache
    {PROGRAM} --model-search TEXT
    {PROGRAM} --update-models
    {PROGRAM} --delete-session SESSION [--dry-run]
    {PROGRAM} --config
    {PROGRAM} --raw-config
    {PROGRAM} --set KEY VALUE
    {PROGRAM} --unset KEY
    {PROGRAM} --set-imap-password [--gpg]
    {PROGRAM} --set-smtp-password [--gpg]
    {PROGRAM} --version
    {PROGRAM} --help

MAIL SUBJECTS
    Ordinary subject             Uses the subject as the sender's private session name when SUBJECT_SESSIONS=1
    Re: ordinary subject         Resumes that same sender/session pair
    tc:CONFIG                    Export/apply mailbot config attachment
    tc:MODELS                    Return existing models-cache.json; no refresh
    tc:MODELS TEXT               Search existing model cache for TEXT
    tc:CMD                       Run first nonempty body line as a command
    tc:command args              Run a mailbot command directly
    tc:delete{{session-name}}      Delete a ttychatter session log
    tc:rm{{session-name}}          Alias for delete{{session-name}}
    tc:archive-session on|off    Public archive-on-expire preference
    tc:{{session-name}}          Send body to ttychatter session
    tc:{{new}}                   Let ttychatter create its default timestamped session
    MAILBOT                      Use first nonempty body line as command/session selector

USER REGISTRY AND PREFERENCES
    USER_REGISTRY=1 creates a private ttychatter HOME per sender. The registry
    stores user metadata, while each user's ttychatter config stores allowed
    non-secret preferences. API keys are stored outside .config as chmod 600
    secret files and injected into ttychatter through the subprocess environment.

    Email commands:
      tc:user                    Show this sender's registry status
      tc:prefs                   Show this sender's ttychatter config
      tc:set MODEL openrouter/free
      tc:set CONTEXT_TURNS 12
      tc:api-key KEY             Save this sender's OpenRouter key to a secret file
      tc:forget-api-key          Remove this sender's key and use the server default

PUBLIC MODE
    --open-to-public accepts non-control subjects as prompts from any sender.
    With USER_REGISTRY=1 and SUBJECT_SESSIONS=1, senders are isolated by their
    registry HOME and by subject-named sessions. Registry users may use the
    normal user command set; commands operate on that sender's private registry
    profile. ALLOWED_FROM remains the private/admin allowlist for global mailbot
    controls such as tc:CONFIG export/update.

    With USER_REGISTRY=0, non-ALLOWED_FROM senders are isolated by
    PUBLIC_SESSION_MODE and may use only PUBLIC_ALLOWED_COMMANDS. Public
    sessions are cleaned up by the PUBLIC_SESSION_* policy; by default inactive
    public logs expire after 72 hours and are trimmed to the last 12
    user/assistant cycles. When enabled, expired logs are emailed to the public
    sender before local deletion; users may toggle that with archive-session
    on/off.

OUTPUT MODES
    COMMAND_OUTPUT_MODE and command-specific MODEL_CACHE_OUTPUT,
    MODEL_SEARCH_OUTPUT, MODEL_LIST_OUTPUT, SESSIONS_OUTPUT, and CONFIG_OUTPUT
    accept auto, body, or attachment.

CONFIG PATH
    If --config-file is omitted, the path is resolved as:
    TTYCHATTER_MAILBOT_CONFIG, then XDG_CONFIG_HOME/ttychatter/mailbot/config,
    then ~/.config/ttychatter/mailbot/config.

SECURITY
    Private mode requires ALLOWED_FROM. Public mode should use a separate
    mailbox, conservative limits, per-sender sessions, and a small public
    command allowlist. REJECT_SELF_SENDER=1 is the default and should stay
    enabled for ALLOWED_FROM=*. DENY_FROM blocks listed senders before
    allowlist or public-mode checks. Spam protection rejects auto-submitted and
    list/bulk mail, and rate limits work by sender and globally. Email is not
    a confidential transport; use api-key only when you accept that risk.
"""


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--config-file", default=None)
    parser.add_argument("--once", action="store_true")
    parser.add_argument("--daemon", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--open-to-public", action="store_true")
    parser.add_argument("--cleanup-public-sessions", action="store_true")
    parser.add_argument("--doctor", action="store_true")
    parser.add_argument("--list-candidates", action="store_true")
    parser.add_argument("--sessions", action="store_true")
    parser.add_argument("--list-sessions", action="store_true")
    parser.add_argument("--manpage", action="store_true")
    parser.add_argument("--model-cache", action="store_true")
    parser.add_argument("--model-search", metavar="TEXT")
    parser.add_argument("--update-models", action="store_true")
    parser.add_argument("--delete-session", metavar="SESSION")
    parser.add_argument("--config", action="store_true")
    parser.add_argument("--raw-config", action="store_true")
    parser.add_argument("--set", nargs=2, metavar=("KEY", "VALUE"))
    parser.add_argument("--unset", metavar="KEY")
    parser.add_argument("--set-imap-password", action="store_true")
    parser.add_argument("--set-smtp-password", action="store_true")
    parser.add_argument("--gpg", action="store_true")
    parser.add_argument("--version", action="store_true")
    parser.add_argument("--help", "-h", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.help:
        print(help_text())
        return 0
    if args.version:
        print(f"{PROGRAM} version {VERSION}")
        return 0

    cfg = load_config(resolve_config_file(args.config_file))
    try:
        migrate_plaintext_openrouter_api_key(cfg)
    except Exception as exc:
        cfg.config_load_notes.append(f"OpenRouter API-key migration failed: {exc}")
    if args.open_to_public:
        cfg.open_to_public = True

    if args.cleanup_public_sessions:
        cfg.open_to_public = True
        cfg.public_session_cleanup = True
        print(cleanup_public_sessions(cfg, dry_run=args.dry_run), end="")
        return 0

    if args.manpage:
        print(mailbot_manpage(cfg), end="")
        return 0
    if args.sessions or args.list_sessions:
        print(format_session_list_with_previews(cfg), end="")
        return 0
    if args.model_cache:
        ok, body, _attachments = dispatch_mailbot_command(cfg, "model-cache", dry_run=args.dry_run)
        print(body, end="")
        return 0 if ok else 1
    if args.model_search:
        ok, body, _attachments = dispatch_mailbot_command(cfg, "model-search " + shlex.quote(args.model_search), dry_run=args.dry_run)
        print(body, end="")
        return 0 if ok else 1
    if args.update_models:
        ok, body, _attachments = dispatch_mailbot_command(cfg, "update-models", dry_run=args.dry_run)
        print(body, end="")
        return 0 if ok else 1
    if args.delete_session:
        ok, body, _attachments = dispatch_mailbot_command(cfg, "delete-session " + shlex.quote(args.delete_session), dry_run=args.dry_run)
        print(body, end="")
        return 0 if ok else 1

    if args.set:
        set_config_value(cfg.config_file, args.set[0], args.set[1])
        return 0
    if args.unset:
        unset_config_value(cfg.config_file, args.unset)
        return 0
    if args.config:
        print_config(cfg)
        return 0
    if args.raw_config:
        print_raw_config(cfg)
        return 0
    if args.set_imap_password:
        return set_password_command(cfg, "imap", args.gpg)
    if args.set_smtp_password:
        return set_password_command(cfg, "smtp", args.gpg)
    if args.doctor:
        return doctor(cfg)
    if args.list_candidates:
        return list_candidates(cfg)
    if args.daemon:
        try:
            return run_daemon(cfg, dry_run=args.dry_run)
        except imaplib.IMAP4.error as exc:
            print(f"IMAP error: {exc}", file=sys.stderr)
            return 1
        except RuntimeError as exc:
            print(f"mailbot error: {exc}", file=sys.stderr)
            return 1
    if args.once:
        try:
            return run_once(cfg, dry_run=args.dry_run)
        except imaplib.IMAP4.error as exc:
            print(f"IMAP error: {exc}", file=sys.stderr)
            return 1
        except RuntimeError as exc:
            print(f"mailbot error: {exc}", file=sys.stderr)
            return 1

    print(help_text(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
