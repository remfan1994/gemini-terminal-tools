# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function help_menu
# Built-in user help. Keep it synchronized with the man page because
# terminal users often discover tools through --help first.
# ----------------------------------------------------------
help_menu() {
  cat <<EOF
$PROGRAM - terminal OpenRouter interface

USAGE
    $PROGRAM
    $PROGRAM -i [--session SESSION]
    $PROGRAM input.txt
    $PROGRAM input.txt output.log
    $PROGRAM --prompt TEXT [--output FILE]
    $PROGRAM --input FILE [--output FILE]
    $PROGRAM --input -
    $PROGRAM --session SESSION
    $PROGRAM --new
    $PROGRAM --resume <session>
    $PROGRAM --list
    $PROGRAM --rename-session SESSION TITLE
    $PROGRAM --turns SESSION
    $PROGRAM --branch SESSION TURN
    $PROGRAM --edit-turn SESSION TURN
    $PROGRAM --export SESSION [--format markdown|text|json] [--output FILE]
    $PROGRAM --models [--all] [--model-type TYPE]
    $PROGRAM --favorites
    $PROGRAM --favorite-model MODEL
    $PROGRAM --unfavorite-model MODEL
    $PROGRAM --models --sort input-tokens
    $PROGRAM --models --min-input-tokens 100000
    $PROGRAM --update-models
    $PROGRAM --test-model MODEL [--save]
    $PROGRAM --select-model [--save]
    $PROGRAM --config
    $PROGRAM --set KEY VALUE
    $PROGRAM --unset KEY
    $PROGRAM --set-api-key
    $PROGRAM --forget-api-key
    $PROGRAM --show-memory <session>
    $PROGRAM --edit-memory <session>
    $PROGRAM --clear-memory <session>
    $PROGRAM --editor-prompt [session]
    $PROGRAM --attach FILE [session]
    $PROGRAM --stream | --no-stream
    $PROGRAM --status | --no-status
    $PROGRAM --voice-input FILE | --transcribe FILE
    $PROGRAM --speak | --no-speak
    $PROGRAM --loopback [session]
    $PROGRAM --loopback-file PATH [session]
    $PROGRAM --credits
    $PROGRAM --search QUERY [--all-sessions]
    $PROGRAM --doctor
    $PROGRAM --version
    $PROGRAM --help

GPG API KEY STORAGE
    --set-api-key offers runtime-only, GPG-encrypted, or plaintext config storage.
    If gpg is not installed, the command says "gpg not found" and skips encrypted storage.
    Plaintext saves warn before writing OPENROUTER_API_KEY to config.

MODEL HELP
    Official OpenRouter model documentation:
        https://openrouter.ai/docs/models

    Models API reference:
        https://openrouter.ai/docs/api-reference/models/get-models

    Chat-completions API reference:
        https://openrouter.ai/docs/api-reference/chat/send-chat-completion-request

RUNTIME COMMAND MODE
    During a running chat, submit a line beginning with ':' to run a local
    command instead of sending a message to the AI backend.

    Examples:
        :help
        :rename Research Notes
        :turns
        :branch 4
        :stream on
        :status on
        :speak last
        :models
        :favorites
        :favorite openrouter/auto
        :unfavorite openrouter/auto
        :select-model
        :test-model openrouter/auto
        :config
        :set CONTEXT_TURNS 20
        :memory
        :search text
        :search-all text
        :attach /path/to/file.txt
        :editor
        :credits

    Type :help during a chat for the full runtime command list.

SESSION TITLES
    Logs keep timestamped filenames. --list shows Session-Title metadata when present.
    --rename-session changes title metadata, not the filename.
    Optional title generation is off by default and uses SESSION_AUTO_TITLE=1 plus SESSION_TITLE_MODEL.

STREAMING / STATUS / VOICE
    --stream shows provider token deltas while preserving the complete saved reply.
    --status/--progress prints local progress notes, not hidden model reasoning.
    Voice input/output are external command hooks via VOICE_INPUT_CMD and VOICE_OUTPUT_CMD/TTS_CMD.

CONFIG PARITY
    Portable ncurses/C equivalents supported here include:
        THEME
        SEND_INPUT
        CODE_ATTACHMENT_MIN_LINES
        STREAM
        STATUS_UPDATES
        SESSION_AUTO_TITLE
        SESSION_TITLE_MODEL
        SESSION_TITLE_MAX_WORDS
        VOICE_INPUT_CMD
        VOICE_OUTPUT_CMD
        VOICE_OUTPUT
        MODEL_FAVORITES_FILE

MODEL FILTER ALIASES
    --routers                       Show router/free routes in model list
    --show-preview | --hide-preview Control model preview text
    --require-tokens | --allow-missing-tokens
                                    Control token metadata filtering
    --min-output-tokens N            Filter by output-token capacity
    --unbookmark-model MODEL         Alias for --unfavorite-model
    --sessions                       Alias for --list

COMPATIBILITY / TESTING
    --demo                           Use local demo responses and demo model rows
    --interactive                    Alias for -i
    --progress | --no-progress       Aliases for --status/--no-status
    --autoscan-model                 Removed compatibility option; exits with guidance

LOOPBACK OUTPUT
    --loopback routes interface text to stderr and writes AI responses to stdout.
    This is for piping ttychatter output into another program.

    --loopback-file PATH appends each AI response to PATH.

INPUT
    Type/paste text, then send according to SEND_INPUT.
    SEND_INPUT=ctrl_d keeps multiline Ctrl+D behavior.
    SEND_INPUT=enter reads one line per message.

VERSION
    $PROGRAM version $VERSION
EOF
}

# ==========================================================
# SESSION MANAGEMENT
# ==========================================================

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function resolve_session_path
# resolve_session_path is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
resolve_session_path() { printf '%s/%s.log\n' "$SESSION_DIR" "$1"; }

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function list_sessions
# list_sessions is a named maintenance unit. Keep behavior stable, check
# call sites before changing it, and update man pages/help/comments when
# behavior changes.
# ----------------------------------------------------------
list_sessions() { local path; for path in "$SESSION_DIR"/*.log; do [ -e "$path" ] || continue; basename "$path" .log; done; }

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function rename_session_command
# rename_session_command is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
rename_session_command() {
  local old_name new_name old_path new_path
  old_name="$(sanitize_session_name "$1")"; new_name="$(sanitize_session_name "$2")"
  old_path="$(resolve_session_path "$old_name")"; new_path="$(resolve_session_path "$new_name")"
  [ -f "$old_path" ] || { printf 'ERROR: session not found: %s\n' "$old_name" >&2; return 1; }
  [ ! -e "$new_path" ] || { printf 'ERROR: destination already exists: %s\n' "$new_name" >&2; return 1; }
  mv "$old_path" "$new_path"
  printf 'renamed session: %s -> %s\n' "$old_name" "$new_name"
}

# ==========================================================
# MEMORY SNAPSHOTS / RESUME CONTEXT
# ==========================================================

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function load_context_from_path
# Rebuilds memory from logs. This is what lets Bash resumed sessions behave
# like conversations instead of just appending to a file.
# ----------------------------------------------------------
load_context_from_path() {
  local path="$1" max_entries
  [ -f "$path" ] || return 0
  max_entries=$((CONTEXT_TURNS * 2))
  [ "$max_entries" -lt 2 ] && max_entries=2
  awk -v max="$max_entries" '
    function push(role,text, i) {
      if (role == "" || text == "") return
      entries[++n] = role ": " text
      if (n > max) { for (i = 2; i <= n; i++) entries[i-1] = entries[i]; n = max }
    }
    function flush() {
      if (speaker != "") {
        low = tolower(speaker)
        if (low != "system" && speaker != "remfan1994") {
          role = (speaker == "AI" || speaker == "OpenRouter" || speaker == "Assistant") ? "Assistant" : "User"
          push(role, text)
        }
      }
      speaker = ""; text = ""
    }
    /^\[[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\] [^:]+:/ {
      flush()
      line = $0
      sub(/^\[[^]]*\] /, "", line)
      speaker = line
      sub(/:.*/, "", speaker)
      sub(/^[^:]*:[[:space:]]*/, "", line)
      text = line
      next
    }
    { if (speaker != "") text = text "\n" $0 }
    END { flush(); for (i = 1; i <= n; i++) printf "%s%c", entries[i], 0 }
  ' "$path"
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function load_context_from_session
# load_context_from_session is a named maintenance unit. Keep behavior
# stable, check call sites before changing it, and update man
# pages/help/comments when behavior changes.
# ----------------------------------------------------------
load_context_from_session() { load_context_from_path "$SESSION"; }

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function rebuild_context_from_session
# rebuild_context_from_session is a named maintenance unit. Keep behavior
# stable, check call sites before changing it, and update man
# pages/help/comments when behavior changes.
# ----------------------------------------------------------
rebuild_context_from_session() {
  CONTEXT_BUFFER=()
  [ -f "$SESSION" ] || return 0
  while IFS= read -r -d '' entry; do CONTEXT_BUFFER+=("$entry"); done < <(load_context_from_session)
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function write_context_snapshot_to_path
# Stores explicit memory snapshots in logs. This future-proofs resume
# behavior when logs become long or contain non-chat system messages.
# ----------------------------------------------------------
write_context_snapshot_to_path() {
  local path="$1" ts="$2" item
  printf '[%s] system: CONTEXT_BEGIN\n' "$ts" >> "$path"
  for item in "${CONTEXT_BUFFER[@]}"; do printf '%s\n' "$item" >> "$path"; done
  printf '[%s] system: CONTEXT_END\n' "$ts" >> "$path"
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function write_context_snapshot
# write_context_snapshot is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
write_context_snapshot() { write_context_snapshot_to_path "$SESSION" "$1"; }

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function show_memory_command
# show_memory_command is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
show_memory_command() {
  local name path
  name="$(sanitize_session_name "$1")"; path="$(resolve_session_path "$name")"
  [ -f "$path" ] || { printf 'ERROR: session not found: %s\n' "$name" >&2; return 1; }
  while IFS= read -r -d '' entry; do printf '%s\n' "$entry"; done < <(load_context_from_path "$path")
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function edit_memory_command
# edit_memory_command is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
edit_memory_command() {
  local name path tmp editor
  name="$(sanitize_session_name "$1")"; path="$(resolve_session_path "$name")"
  [ -f "$path" ] || { printf 'ERROR: session not found: %s\n' "$name" >&2; return 1; }
  tmp="$(mktemp)"
  while IFS= read -r -d '' entry; do printf '%s\n' "$entry" >> "$tmp"; done < <(load_context_from_path "$path")
  editor="$(editor_command)"; $editor "$tmp"
  mapfile -t CONTEXT_BUFFER < "$tmp"; rm -f "$tmp"
  write_context_snapshot_to_path "$path" "$(timestamp)"
  printf 'saved edited memory snapshot for session: %s\n' "$name"
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function clear_memory_command
# clear_memory_command is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
clear_memory_command() {
  local name path
  name="$(sanitize_session_name "$1")"; path="$(resolve_session_path "$name")"
  [ -f "$path" ] || { printf 'ERROR: session not found: %s\n' "$name" >&2; return 1; }
  CONTEXT_BUFFER=(); write_context_snapshot_to_path "$path" "$(timestamp)"
  printf 'cleared memory snapshot for session: %s\n' "$name"
}

demo_models_json() {
  cat <<'JSON'
{"data":[{"id":"demo/auto","name":"Demo Auto Router","description":"Local demo model. No network request is made.","context_length":8192,"architecture":{"modality":"text"}}, {"id":"demo/free","name":"Demo Free Route","description":"Local demo route for UI testing.","context_length":4096,"architecture":{"modality":"text"}}, {"id":"demo/code-helper","name":"Demo Code Helper","description":"Local demo row for code-block and attachment testing.","context_length":32768,"architecture":{"modality":"text"}}]}
JSON
}

demo_ai_response() {
  local prompt="$1"
  printf '%s\n' "Demo mode is active; no OpenRouter request was made."
  printf 'Prompt excerpt: %s\n' "$(printf '%s' "$prompt" | tr '\n' ' ' | cut -c 1-140)"
  printf '\nShort inline code block:\n```text\nok\n```\n'
  printf '\nLong code block for attachment-threshold testing:\n```sh\necho ttychatter demo mode\necho no provider request was made\necho long code blocks should become attachments\necho done\n```\n'
}

# ==========================================================
# MODEL CACHE / FILTERING
# ==========================================================

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function fetch_models_live_json
# The only live model-list fetch path. Ordinary model display should prefer
# cache when possible to avoid unnecessary network calls.
# ----------------------------------------------------------
fetch_models_live_json() {
  local url response curl_status
  if truthy "$DEMO_MODE"; then demo_models_json; return 0; fi
  require_api_key || return 1
  url="https://openrouter.ai/api/v1/models"
  response="$(curl -sS --max-time 60 -H "Authorization: Bearer $OPENROUTER_API_KEY" "$url" 2>&1)"; curl_status=$?
  [ "$curl_status" -eq 0 ] || { printf '%s\n' "curl error while fetching models: $response" >&2; return 1; }
  printf '%s' "$response"
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function update_models_cache
# User-requested cache refresh. Model discovery belongs here, not hidden
# behind casual screen navigation.
# ----------------------------------------------------------
update_models_cache() {
  local json
  json="$(fetch_models_live_json)" || return 1
  printf '%s' "$json" > "$MODEL_CACHE_FILE"
  chmod 600 "$MODEL_CACHE_FILE" 2>/dev/null || true
  printf 'updated model cache: %s\n' "$MODEL_CACHE_FILE" >&2
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function models_json_for_display
# models_json_for_display is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
models_json_for_display() {
  if truthy "$DEMO_MODE"; then demo_models_json; return 0; fi
  if [ -f "$MODEL_CACHE_FILE" ]; then cat "$MODEL_CACHE_FILE"; else update_models_cache >/dev/null || return 1; cat "$MODEL_CACHE_FILE"; fi
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function parse_models_table
# Python JSON parsing keeps model metadata extraction maintainable. Bash-
# only must approximate this, but this edition should stay robust.
# ----------------------------------------------------------
parse_models_table() {
  local show_all="$1"
  local raw
  raw="$(cat)"
  python3 -c '
import json, sys
show_all=sys.argv[1]=="1"
truth=lambda v: str(v).lower() in ("1","yes","true","on","y")
filter_chat=truth(sys.argv[2]); require_tokens=truth(sys.argv[3]); hide_preview=truth(sys.argv[4])
try: min_in=int(sys.argv[5])
except Exception: min_in=0
try: min_out=int(sys.argv[6])
except Exception: min_out=0
sort_order=sys.argv[7]
fav_path=sys.argv[8]
favorites=set()
try:
    with open(fav_path,"r",encoding="utf-8",errors="replace") as fh:
        favorites={line.strip() for line in fh if line.strip()}
except Exception:
    pass
raw=sys.stdin.read()
try: data=json.loads(raw)
except Exception as exc:
    print(f"ERROR: could not parse OpenRouter model-list JSON: {exc}", file=sys.stderr); sys.exit(1)
if "error" in data:
    err=data["error"]
    if isinstance(err, dict):
        print(f"ERROR: OpenRouter API error {err.get('code','')}: {err.get('message','')}", file=sys.stderr)
    else:
        print(f"ERROR: OpenRouter API error: {err}", file=sys.stderr)
    sys.exit(1)
rows=[]
for item in data.get("data", data.get("models", [])):
    model_id=str(item.get("id") or item.get("name") or "")
    if not model_id: continue
    display=str(item.get("name") or item.get("display_name") or model_id)
    desc=str(item.get("description") or "")
    context=item.get("context_length") or item.get("contextLength") or 0
    try: input_limit=int(context or 0)
    except Exception: input_limit=0
    output_limit=item.get("max_completion_tokens") or item.get("maxCompletionTokens") or 0
    try: output_limit=int(output_limit or 0)
    except Exception: output_limit=0
    arch=item.get("architecture") if isinstance(item.get("architecture"), dict) else {}
    modalities=arch.get("input_modalities") or arch.get("inputModalities") or arch.get("modality") or ""
    if isinstance(modalities, list): modality=" ".join(map(str, modalities))
    else: modality=str(modalities)
    hay=" ".join([model_id,display,desc]).lower(); preview=any(w in hay for w in ["preview","experimental"," exp ","-exp","_exp"," beta","-beta","_beta"])
    methods=["chat"]
    if "image" in modality.lower(): methods.append("image")
    if model_id in ("openrouter/auto", "openrouter/free", "demo/auto", "demo/free") or model_id.endswith(":free"): methods.append("router")
    if model_id.endswith(":free") or model_id in ("openrouter/free", "demo/free"): methods.append("free")
    if model_id.startswith("demo/"): methods.append("demo")
    if model_id in favorites: methods.append("favorite")
    if not show_all:
        if require_tokens and input_limit <= 0: continue
        if hide_preview and preview: continue
        if input_limit < min_in: continue
        if output_limit < min_out: continue
    badges=[]; badges.extend(methods)
    if preview: badges.append("preview")
    if input_limit<=0: badges.append("no-context-meta")
    rows.append((model_id,display,input_limit,output_limit,",".join(badges) or "-"))
if sort_order in ("input_desc","input","tokens","context"):
    rows.sort(key=lambda r:(r[2],r[0]), reverse=True)
elif sort_order in ("output_desc","output"):
    rows.sort(key=lambda r:(r[3],r[0]), reverse=True)
elif sort_order=="display":
    rows.sort(key=lambda r:(r[1].lower(),r[0]))
elif sort_order=="favorites":
    rows.sort(key=lambda r:(r[0] not in favorites, r[0].lower()))
elif sort_order=="type":
    rows.sort(key=lambda r:("router" not in r[4], "free" not in r[4], r[0].lower()))
else:
    rows.sort(key=lambda r:r[0].lower())
for r in rows: print("\t".join(map(str,r)))
' "$show_all" "$MODEL_FILTER_GENERATE_CONTENT" "$MODEL_FILTER_REQUIRE_TOKENS" "$MODEL_FILTER_HIDE_PREVIEW" "$MODEL_MIN_INPUT_TOKENS" "$MODEL_MIN_OUTPUT_TOKENS" "$MODEL_SORT_ORDER" "$MODEL_FAVORITES_FILE" <<< "$raw"
}
# ----------------------------------------------------------

# ----------------------------------------------------------

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function model_type_filter_output
# OpenRouter has both fixed model IDs and router-like entries such as
# openrouter/auto and openrouter/free.  Bash has no dropdown UI, so this helper
# gives the command line the same conceptual feature as the ncurses router
# selector: users can ask for routers, fixed models, free routes, or auto.
# The parser uses visible metadata columns produced by parse_models_table rather
# than making a second network request.
# ----------------------------------------------------------
model_type_filter_output() {
  local type="${MODEL_TYPE_FILTER:-all}"
  awk -F '\t' -v t="$type" '
    BEGIN { IGNORECASE=1 }
    t == "all" { print; next }
    { id=$1; badges=$5 }
    t == "routers" && (id ~ /^openrouter\// || badges ~ /router|free/) { print; next }
    t == "fixed" && !(id ~ /^openrouter\// || badges ~ /router|free/) { print; next }
    t == "free" && (id == "openrouter/free" || id ~ /:free$/ || badges ~ /free/) { print; next }
    t == "auto" && (id == "openrouter/auto") { print; next }
  '
}

# MAINTAINER COMMENTARY: function print_models
# print_models is a named maintenance unit. Keep behavior stable, check call
# sites before changing it, and update man pages/help/comments when behavior
# changes.
# ----------------------------------------------------------
print_models() { local json; json="$(models_json_for_display)" || return 1; printf '%s' "$json" | parse_models_table "$SHOW_ALL_MODELS" | model_type_filter_output; }

# ==========================================================
# OPENROUTER GENERATION / ATTACHMENT PAYLOADS
# ==========================================================

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function make_openrouter_payload
# Builds valid OpenRouter JSON from arbitrary text and attachments. Do not
# replace with manual string interpolation unless you also handle quotes,
# backslashes, and newlines.
# ----------------------------------------------------------
make_openrouter_payload() {
  local model="$1"
  shift
  python3 -c '
import base64, json, mimetypes, os, sys
from pathlib import Path

max_bytes = int(sys.argv[1])
model = sys.argv[2]
files = sys.argv[3:]
text = sys.stdin.read()

text_exts = {
    ".txt", ".md", ".markdown", ".sh", ".bash", ".py", ".json",
    ".yml", ".yaml", ".html", ".css", ".js", ".c", ".cpp", ".h",
    ".sql", ".log"
}

content_parts = []
base_text = text

for file_name in files:
    path = Path(os.path.expanduser(os.path.expandvars(file_name)))
    if not path.exists() or not path.is_file():
        print(f"attachment not found: {file_name}", file=sys.stderr)
        sys.exit(2)

    size = path.stat().st_size
    if size > max_bytes:
        print(f"attachment too large: {path} ({size} bytes > {max_bytes})", file=sys.stderr)
        sys.exit(2)

    mime = mimetypes.guess_type(str(path))[0] or "application/octet-stream"

    if mime.startswith("text/") or path.suffix.lower() in text_exts:
        content = path.read_text(encoding="utf-8", errors="replace")
        base_text += f"\n\n[Attached file: {path.name}]\n{content}"
    elif mime.startswith("image/"):
        data = base64.b64encode(path.read_bytes()).decode("ascii")
        content_parts.append({
            "type": "image_url",
            "image_url": {"url": f"data:{mime};base64,{data}"}
        })
    else:
        base_text += f"\n\n[Attachment not sent inline by ttychatter.python: {path.name} ({mime})]"

if content_parts:
    content = [{"type": "text", "text": base_text}] + content_parts
else:
    content = base_text

payload = {
    "model": model,
    "messages": [{"role": "user", "content": content}]
}
print(json.dumps(payload, ensure_ascii=False))
' "$MAX_ATTACHMENT_BYTES" "$model" "$@"
}
# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function parse_openrouter_response
# parse_openrouter_response is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
parse_openrouter_response() {
  python3 -c '''
import json, sys
attachment_dir = sys.argv[1]
session_name = sys.argv[2] or "model-test"
raw = sys.stdin.read()

if not raw.strip():
    print("invalid JSON response: empty response body")
    sys.exit(1)

try:
    data = json.loads(raw)
except Exception as exc:
    print(f"invalid JSON response: {exc}; raw response: {raw[:1000]}")
    sys.exit(1)

if "error" in data:
    err = data["error"]
    if isinstance(err, dict):
        code = err.get("code", "")
        message = err.get("message", "")
        print(f"OpenRouter API error {code}: {message}".strip())
    else:
        print(f"OpenRouter API error: {err}")
    sys.exit(1)

texts = []
for choice in data.get("choices", []):
    msg = choice.get("message", {}) if isinstance(choice, dict) else {}
    content = msg.get("content", "")
    if isinstance(content, str):
        texts.append(content)
    elif isinstance(content, list):
        for part in content:
            if isinstance(part, dict):
                if isinstance(part.get("text"), str):
                    texts.append(part["text"])
                elif isinstance(part.get("content"), str):
                    texts.append(part["content"])

output = "\n".join(t for t in texts if t is not None)
if not output.strip():
    print("OpenRouter returned an empty text response")
    sys.exit(1)
print(output)
''' "$ATTACHMENT_DIR" "$SESSION_NAME"
}
# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function call_openrouter_model
# Single generation transport function. Keeping curl/API behavior
# centralized makes quota, timeout, and error changes easier.
# ----------------------------------------------------------
call_openrouter_model() {
  local model="$1" prompt="$2" timeout="${3:-120}"; shift 3 || true
  local attachments=("$@") clean_model response curl_status output parse_status
  local body_file err_file http_code
  if truthy "$DEMO_MODE"; then demo_ai_response "$prompt"; return 0; fi
  if truthy "$STREAM"; then
    call_openrouter_model_stream "$model" "$prompt" "$timeout" "${attachments[@]}"
    return $?
  fi
  require_api_key || return 1
  clean_model="$(normalize_model_id "$model")"

  body_file="$(mktemp "${TMPDIR:-/tmp}/ttychatter.openrouter.body.XXXXXX")" || return 1
  err_file="$(mktemp "${TMPDIR:-/tmp}/ttychatter.openrouter.err.XXXXXX")" || { rm -f "$body_file"; return 1; }

  http_code="$(
    printf '%s' "$prompt" |
      make_openrouter_payload "$clean_model" "${attachments[@]}" |
      curl -sS --max-time "$timeout" \
        -o "$body_file" \
        -w "%{http_code}" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENROUTER_API_KEY" \
        -H "HTTP-Referer: https://github.com/remfan1994/ttychatter" \
        -H "X-Title: ttychatter" \
        -d @- \
        "https://openrouter.ai/api/v1/chat/completions" \
        2>"$err_file"
  )"
  curl_status=$?
  response="$(cat "$body_file" 2>/dev/null || true)"

  if [ "$curl_status" -ne 0 ]; then
    printf 'curl error (%s): %s\n' "$curl_status" "$(cat "$err_file" 2>/dev/null)"
    rm -f "$body_file" "$err_file"
    return 1
  fi

  case "$http_code" in
    2??) ;;
    *)
      if [ -n "$response" ]; then
        printf 'OpenRouter HTTP error %s: %s\n' "$http_code" "$response"
      else
        printf 'OpenRouter HTTP error %s with empty response body\n' "$http_code"
      fi
      rm -f "$body_file" "$err_file"
      return 1
      ;;
  esac

  if [ -z "$response" ]; then
    printf 'OpenRouter returned HTTP %s with an empty response body\n' "$http_code"
    rm -f "$body_file" "$err_file"
    return 1
  fi

  output="$(printf '%s' "$response" | parse_openrouter_response)"; parse_status=$?
  rm -f "$body_file" "$err_file"
  printf '%s\n' "$output"; return "$parse_status"
}
# ==========================================================
# USER-OPERATED MODEL TESTING / SELECTION
# ==========================================================

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function run_model_test
# User-operated model test. This replaced automatic scanning/probing; keep
# it one-model-at-a-time and transparent to the user.
# ----------------------------------------------------------
run_model_test() { local model="$1" output status; printf 'Model: %s\nTest prompt: %s\n\n--- model response ---\n' "$model" "$MODEL_TEST_PROMPT"; output="$(call_openrouter_model "$model" "$MODEL_TEST_PROMPT" 60)"; status=$?; printf '%s\n--- end response ---\n' "$output"; return "$status"; }

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function test_model_command
# test_model_command is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
test_model_command() {
  local model="$1" status
  [ -n "$model" ] || { printf '%s\n' "ERROR: --test-model requires a model id." >&2; return 2; }
  run_model_test "$model"; status=$?
  if [ "$status" -eq 0 ] && [ "$SAVE" -eq 1 ]; then set_config_value "MODEL" "$(normalize_model_id "$model")"; printf 'saved MODEL=%s to %s\n' "$(normalize_model_id "$model")" "$CONFIG_FILE" >&2; fi
  return "$status"
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function removed_autoscan_message
# removed_autoscan_message is a named maintenance unit. Keep behavior
# stable, check call sites before changing it, and update man
# pages/help/comments when behavior changes.
# ----------------------------------------------------------
removed_autoscan_message() { cat <<EOF
ERROR: --autoscan-model has been removed.

Use one of these instead:

    $PROGRAM --models
    $PROGRAM --test-model <model_id>
    $PROGRAM --select-model
    $PROGRAM --favorites
    $PROGRAM --favorite-model openrouter/auto

The Bash version no longer probes every available model automatically.
EOF
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function select_model_command
# Line-oriented model selector. It should use metadata and optional testing
# instead of guessing which future OpenRouter model is best.
# ----------------------------------------------------------
select_model_command() {
  local json table line index choice selected_line selected_model display input_limit output_limit badges answer test_status=0
  json="$(models_json_for_display)" || return 1
  table="$(printf '%s' "$json" | parse_models_table "$SHOW_ALL_MODELS")" || return 1
  [ -n "$table" ] || { printf '%s\n' "No models matched current filters."; return 1; }
  mapfile -t MODEL_LINES <<< "$table"
  printf '%s\n\n' "Available models:"
  index=1
  for line in "${MODEL_LINES[@]}"; do
    IFS=$'\t' read -r selected_model display input_limit output_limit badges <<< "$line"
    printf '%3d) %s - %s (input:%s output:%s badges:%s)\n' "$index" "$selected_model" "$display" "$input_limit" "$output_limit" "$badges"
    index=$((index + 1))
  done
  printf '\nSelect model number: '; IFS= read -r choice
  case "$choice" in ""|*[!0-9]*) printf '%s\n' "Invalid selection."; return 1 ;; esac
  [ "$choice" -ge 1 ] && [ "$choice" -le "${#MODEL_LINES[@]}" ] || { printf '%s\n' "Selection out of range."; return 1; }
  selected_line="${MODEL_LINES[$((choice - 1))]}"; IFS=$'\t' read -r selected_model display input_limit output_limit badges <<< "$selected_line"
  printf 'Selected model: %s\n' "$selected_model"
  printf 'Test selected model now? [Y/n] '; IFS= read -r answer
  case "$answer" in n|N|no|NO) ;; *) run_model_test "$selected_model"; test_status=$? ;; esac
  if [ "$SAVE" -eq 1 ]; then
    [ "$test_status" -eq 0 ] || { printf '%s\n' "Test failed; model not saved."; return 1; }
    set_config_value "MODEL" "$selected_model"; printf 'saved MODEL=%s to %s\n' "$selected_model" "$CONFIG_FILE"; return 0
  fi
  printf 'Save MODEL=%s to config? [y/N] ' "$selected_model"; IFS= read -r answer
  case "$answer" in y|Y|yes|YES) set_config_value "MODEL" "$selected_model"; printf 'saved MODEL=%s to %s\n' "$selected_model" "$CONFIG_FILE" ;; *) printf '%s\n' "Model not saved." ;; esac
}


# ==========================================================
# CONTEXT MEMORY BUFFER
# ----------------------------------------------------------
# CONTEXT_TURNS counts recent user/assistant exchanges.
# Internally, each exchange is stored as two entries:
#   User: ...
#   Assistant: ...
# ==========================================================

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function add_to_context
# Adds one speaker entry to rolling context memory. This is not the same as
# permanent logging.
# ----------------------------------------------------------
add_to_context() {
  CONTEXT_BUFFER+=("$1")
  trim_context_buffer
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function trim_context_buffer
# trim_context_buffer is a named maintenance unit. Keep behavior stable,
# check call sites before changing it, and update man pages/help/comments
# when behavior changes.
# ----------------------------------------------------------
trim_context_buffer() {
  local max_entries=$((CONTEXT_TURNS * 2))
  while [ "${#CONTEXT_BUFFER[@]}" -gt "$max_entries" ]; do
    CONTEXT_BUFFER=("${CONTEXT_BUFFER[@]:1}")
  done
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function build_context
# build_context is a named maintenance unit. Keep behavior stable, check
# call sites before changing it, and update man pages/help/comments when
# behavior changes.
# ----------------------------------------------------------
build_context() {
  local context="$SUMMARY"
  local msg
  for msg in "${CONTEXT_BUFFER[@]}"; do
    if [ -n "$context" ]; then
      context+=$'\n'
    fi
    context+="$msg"
  done
  printf '%s' "$context"
}

# ==========================================================
# ATTACHMENT EXTRACTION SYSTEM
# ==========================================================

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function extract_attachments
# Turns fenced code blocks into files. This preserves terminal readability
# and makes generated artifacts useful in a Unix workflow.
# ----------------------------------------------------------
extract_attachments() {
  python3 -c '
import os, re, sys
attachment_dir=sys.argv[1]; session_name=sys.argv[2]; min_lines=int(sys.argv[3]); text=sys.stdin.read()
ext_map={"bash":".sh","sh":".sh","shell":".sh","python":".py","py":".py","json":".json","yaml":".yml","yml":".yml","javascript":".js","js":".js","html":".html","css":".css","sql":".sql","c":".c","cpp":".cpp","c++":".cpp","text":".txt"}
pattern=re.compile(r"```([A-Za-z0-9_+.#-]*)[ \t]*\n(.*?)```", re.DOTALL)
def safe_tag(lang):
    lang=(lang or "text").strip().lower().replace("+","p").replace("#","sharp")
    return re.sub(r"[^A-Za-z0-9._-]+","_",lang) or "text"
def next_number(lang,ext):
    highest=0; regex=re.compile(r"^"+re.escape(session_name)+"-"+re.escape(lang)+r"-(\d{2,})"+re.escape(ext)+r"$")
    if os.path.isdir(attachment_dir):
        for name in os.listdir(attachment_dir):
            m=regex.match(name)
            if m: highest=max(highest,int(m.group(1)))
    return highest+1
def repl(m):
    content=m.group(2)
    if len([line for line in content.splitlines() if line.strip()]) < min_lines:
        return m.group(0)
    raw=(m.group(1) or "text").strip().lower(); lang=safe_tag(raw); ext=ext_map.get(raw,ext_map.get(lang,".txt")); num=next_number(lang,ext)
    filename=f"{session_name}-{lang}-{num:02d}{ext}"; path=os.path.join(attachment_dir,filename); os.makedirs(attachment_dir,exist_ok=True)
    with open(path,"w",encoding="utf-8") as fh: fh.write(content)
    return f"\n[attachment saved]\nfile: {filename}\nlocation: {attachment_dir}\n"
print(pattern.sub(repl,text))
' "$ATTACHMENT_DIR" "$SESSION_NAME" "$CODE_ATTACHMENT_MIN_LINES"
}

# ==========================================================
# EXTERNAL EDITOR PROMPT
# ==========================================================

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function compose_with_editor
# External editor support for long prompts. This is a Unix productivity
# feature, not a convenience gimmick.
# ----------------------------------------------------------
compose_with_editor() {
  local tmp editor
  tmp="$(mktemp)"; editor="$(editor_command)"
  $editor "$tmp"
  cat "$tmp"
  rm -f "$tmp"
}


# ==========================================================
# RUNTIME COLON-COMMAND MODE
# ----------------------------------------------------------
# The ncurses edition has function-key menus. Bash does not have a reliable,
# portable way to offer that kind of UI without becoming a different program,
# so the Bash-family clients use a local command mode inside the normal chat
# loop. If the first character of the submitted input is a colon, the input is
# interpreted by the client and is NOT sent to OpenRouter.
#
# This is intentionally similar to IRC slash commands, vi/ex commands, and
# other terminal-native command modes. We chose ':' rather than '/' because
# paths and URLs commonly begin with or contain '/', while ':' at the beginning
# of a submitted chat message is rare and easy to document.
#
# The command mode exists for end-user usability, not developer cleverness. It
# lets someone rename a session, attach a file, inspect memory, open an editor,
# list models, test a model, or view credits without exiting and relaunching.
# Future maintainers should keep this command set line-oriented and readable.
# If a new feature exists in ncurses as a screen, its Bash equivalent should be
# considered here as a colon command when that makes sense.
# ==========================================================

runtime_command_help() {
  cat <<EOF
Runtime commands are local ttychatter.python commands.
They are not logged as chat, not stored in memory, and not sent to OpenRouter.

General:
  :help                         Show this runtime command menu
  :quit                         Exit the running chat
  :credits                      Show project credits and Project Lead notice
  :doctor                       Run diagnostics

Sessions:
  :list                         List saved sessions
  :rename NAME                  Rename the current session/log file

Models:
  :models                       Show filtered cached/live model list
  :update-models                Refresh model cache from OpenRouter
  :select-model                 Open numbered model selector
  :test-model MODEL             Test one model with MODEL_TEST_PROMPT
  :model MODEL                  Use MODEL for this running chat only
  :model-save MODEL             Use MODEL now and save it to config

Config and API key:
  :config                       Print current config summary
  :set KEY VALUE                Save config KEY=VALUE
  :unset KEY                    Remove KEY from config
  :set-api-key                  Prompt and save OPENROUTER_API_KEY
    API_KEY_GPG_FILE
  :forget-api-key               Remove OPENROUTER_API_KEY from config

Memory:
  :memory                       Show current in-process memory/context
  :edit-memory                  Edit current memory/context in external editor
  :clear-memory                 Clear current memory/context

Search:
  :search TEXT                  Search current session log
  :search-all TEXT              Search all saved session logs

Files and editor:
  :attach FILE                  Attach FILE to the next OpenRouter message
  :attachments                  List saved generated/code attachments
        :pending                      Show files queued for the next message
  :editor                       Compose a prompt in external editor and send it
  :turns                        List message numbers in the current session
  :branch N                     Create a branch after message N
  :stream on|off                Toggle streaming token display
  :status on|off                Toggle local status/progress output
  :voice FILE                   Transcribe FILE with VOICE_INPUT_CMD and send
  :speak on|off|last            Toggle or replay voice output hook

Notes:
  - Colon commands must be the first thing in the submitted input.
  - Use Ctrl+D after typing a colon command, the same as sending a message.
  - Use a backslash before a colon if you truly want to send a message that
    begins with a colon; the client will remove the backslash and send it.
EOF
}

rename_current_session() {
  local new_name="$1"
  local clean_name new_path old_path

  if [ -z "$new_name" ]; then
    printf '%s\n' "usage: :rename NEW_SESSION_NAME"
    return 1
  fi

  clean_name="$(sanitize_session_name "$new_name")"
  new_path="$(resolve_session_path "$clean_name")"
  old_path="$SESSION"

  if [ "$new_path" = "$old_path" ]; then
    printf 'session already named: %s\n' "$clean_name"
    return 0
  fi

  if [ -e "$new_path" ]; then
    printf 'cannot rename: target session already exists: %s\n' "$clean_name"
    return 1
  fi

  if [ -f "$old_path" ]; then
    mv "$old_path" "$new_path" || return 1
  fi

  SESSION_NAME="$clean_name"
  SESSION="$new_path"
  printf 'current session renamed to: %s\n' "$SESSION_NAME"
}

show_current_memory_runtime() {
  local item
  if [ "${#CONTEXT_BUFFER[@]}" -eq 0 ]; then
    printf '%s\n' "current memory is empty"
    return 0
  fi
  printf '%s\n' "current memory/context buffer:"
  printf '%s\n' "----------------------------------------"
  for item in "${CONTEXT_BUFFER[@]}"; do
    printf '%s\n' "$item"
  done
  printf '%s\n' "----------------------------------------"
}

edit_current_memory_runtime() {
  local tmp editor line
  tmp="$(mktemp)" || return 1

  for line in "${CONTEXT_BUFFER[@]}"; do
    printf '%s\n' "$line" >> "$tmp"
  done

  editor="$(editor_command)"
  $editor "$tmp"

  CONTEXT_BUFFER=()
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] && CONTEXT_BUFFER+=("$line")
  done < "$tmp"
  rm -f "$tmp"
  trim_context_buffer
  write_context_snapshot "$(timestamp)"
  printf 'memory updated; entries: %s\n' "${#CONTEXT_BUFFER[@]}"
}

list_attachments_runtime() {
  local file
  if [ ! -d "$ATTACHMENT_DIR" ]; then
    printf 'attachment directory does not exist: %s\n' "$ATTACHMENT_DIR"
    return 1
  fi
  for file in "$ATTACHMENT_DIR"/*; do
    [ -e "$file" ] || { printf 'no attachments found in %s\n' "$ATTACHMENT_DIR"; return 0; }
    basename "$file"
  done
}

apply_runtime_config_change() {
  local key="$1"
  local value="$2"

  case "$key" in
    MODEL)
      MODEL="$(normalize_model_id "$value")"
      if truthy "$DEMO_MODE" && [ -z "$MODEL" ]; then MODEL="demo/auto"; fi
ACTIVE_MODEL="$(effective_model)"
      ;;
    CONTEXT_TURNS)
      CONTEXT_TURNS="$(positive_int_or_default "$value" "$CONTEXT_TURNS")"
      trim_context_buffer
      ;;
    SESSION_DIR)
      SESSION_DIR="$(expand_path "$value")"
      mkdir -p "$SESSION_DIR"
      ;;
    ATTACHMENT_DIR)
      ATTACHMENT_DIR="$(expand_path "$value")"
      mkdir -p "$ATTACHMENT_DIR"
      ;;
    MODEL_TEST_PROMPT)
      MODEL_TEST_PROMPT="$value"
      ;;
    STARTUP_NOTICE)
      STARTUP_NOTICE="$value"
      ;;
  esac
}



# ==========================================================
# PARITY: SESSION TITLES, STREAMING, VOICE, BRANCHING, EXPORT
# ==========================================================

resolve_session_arg() {
  case "$1" in
    */*|*.log) printf '%s\n' "$(expand_path "$1")" ;;
    *) printf '%s/%s.log\n' "$SESSION_DIR" "$(sanitize_session_name "$1")" ;;
  esac
}

default_session_name_unique() {
  local base name path n
  base="session-$(date +%Y-%m-%d-%H-%M-%S)"
  name="$base"
  path="$(resolve_session_path "$name")"
  n=1
  while [ -e "$path" ]; do
    name="$(printf '%s-%03d' "$base" "$n")"
    path="$(resolve_session_path "$name")"
    n=$((n+1))
  done
  printf '%s\n' "$name"
}

session_title_clean() {
  local raw="${1:-}" max="${2:-$SESSION_TITLE_MAX_WORDS}"
  case "$max" in ''|*[!0-9]*|0) max=8 ;; esac
  raw="$(printf '%s' "$raw" | tr '\r\n\t' '   ' | tr -c '[:print:]' ' ' | sed -E 's/[[:space:]]+/ /g; s/^[[:space:]]+//; s/[[:space:]]+$//; s/^([Ss][Ee][Ss][Ss][Ii][Oo][Nn][ -]?)?[Tt][Ii][Tt][Ll][Ee][[:space:]]*:[[:space:]]*//; s/^[^[:alnum:]]+//; s/[^[:alnum:]]+$//')"
  [ -n "$raw" ] || return 1
  printf '%s\n' "$raw" | awk -v max="$max" '{ out=""; for (i=1; i<=NF && i<=max; i++) out = out (i>1 ? " " : "") $i; if (length(out) > 96) { out = substr(out,1,96); sub(/[[:space:]][^[:space:]]*$/, "", out); } if (out != "") print out; }'
}

session_title_from_file() {
  local path="$1" raw
  [ -f "$path" ] || return 1
  raw="$(awk '{ line=$0; if (line ~ /[Ss][Ee][Ss][Ss][Ii][Oo][Nn]-[Tt][Ii][Tt][Ll][Ee][[:space:]]*:/) { sub(/^.*[Ss][Ee][Ss][Ss][Ii][Oo][Nn]-[Tt][Ii][Tt][Ll][Ee][[:space:]]*:[[:space:]]*/, "", line); val=line } } END { if (val != "") print val; else exit 1 }' "$path")" || return 1
  session_title_clean "$raw" "$SESSION_TITLE_MAX_WORDS"
}
write_session_title_metadata() {
  local path="$1" title="$2" clean
  clean="$(session_title_clean "$title" "$SESSION_TITLE_MAX_WORDS")"
  [ -n "$clean" ] || return 1
  mkdir -p "$(dirname "$path")"
  printf '[%s] system: session-title: %s\n' "$(timestamp)" "$clean" >> "$path"
}

ensure_prechat_line() {
  local path="$1"
  mkdir -p "$(dirname "$path")"
  if [ ! -s "$path" ]; then
    printf '%s\n' "$TC_PRECHAT_LINE" > "$path"
  fi
}

list_sessions() {
  local path base title shown=0 updated size
  mkdir -p "$SESSION_DIR"
  printf '%-42s %-32s %s\n' "TITLE" "FILE" "SIZE"
  printf '%-42s %-32s %s\n' "-----" "----" "----"
  for path in "$SESSION_DIR"/*.log; do
    [ -e "$path" ] || continue
    base="$(basename "$path" .log)"
    title="$(session_title_from_file "$path" 2>/dev/null || true)"
    [ -n "$title" ] || title="$base"
    size="$(wc -c < "$path" 2>/dev/null | tr -d ' ')"
    printf '%-42.42s %-32s %s\n' "$title" "$(basename "$path")" "$size"
    shown=1
  done
  [ "$shown" -eq 1 ] || printf '%s\n' "no saved sessions"
}

rename_session_command() {
  local target="$1" title="$2" path
  [ -n "$target" ] && [ -n "$title" ] || { printf '%s\n' "ERROR: --rename-session requires SESSION TITLE" >&2; return 2; }
  path="$(resolve_session_arg "$target")"
  [ -f "$path" ] || { printf 'ERROR: session not found: %s\n' "$target" >&2; return 1; }
  ensure_prechat_line "$path"
  write_session_title_metadata "$path" "$title" || return 1
  printf 'session title set: %s\n' "$(session_title_from_file "$path" 2>/dev/null || printf '%s' "$title")"
}

rename_current_session() {
  local title="$1"
  [ -n "$title" ] || { printf '%s\n' "usage: :rename NEW_TITLE"; return 1; }
  ensure_prechat_line "$SESSION"
  write_session_title_metadata "$SESSION" "$title" || return 1
  printf 'session title set: %s\n' "$(session_title_from_file "$SESSION" 2>/dev/null || printf '%s' "$title")"
}

status_update() {
  truthy "$STATUS_UPDATES" || return 0
  printf '[%s] status: %s\n' "$(timestamp)" "$*" >&2
}

shell_quote() { python3 -c 'import shlex, sys; print(shlex.quote(sys.argv[1]))' "$1"; }

command_with_file_placeholder() {
  local template="$1" file="$2" q
  q="$(shell_quote "$file")"
  case "$template" in *%f*) printf '%s\n' "${template//%f/$q}" ;; *) printf '%s %s\n' "$template" "$q" ;; esac
}

run_voice_input_command() {
  local path="$1" cmd out
  [ -n "$path" ] || { printf '%s\n' "ERROR: --voice-input requires a file" >&2; return 2; }
  [ -n "$VOICE_INPUT_CMD" ] || { printf '%s\n' "ERROR: VOICE_INPUT_CMD is not configured" >&2; return 1; }
  cmd="$(command_with_file_placeholder "$VOICE_INPUT_CMD" "$path")"
  out="$(eval "$cmd")" || return 1
  printf '%s\n' "$out"
}

run_voice_output_command() {
  local text="$1" cmd="${VOICE_OUTPUT_CMD:-$TTS_CMD}"
  [ -n "$cmd" ] || { printf '%s\n' "ERROR: VOICE_OUTPUT_CMD/TTS_CMD is not configured" >&2; return 1; }
  printf '%s\n' "$text" | eval "$cmd"
}

maybe_generate_session_title() {
  local path="$1" user_text="$2" ai_text="$3" prompt title saved_stream
  truthy "$SESSION_AUTO_TITLE" || return 0
  [ -n "$path" ] || return 0
  [ -n "$(session_title_from_file "$path" 2>/dev/null || true)" ] && return 0
  if truthy "$DEMO_MODE"; then
    title="$(session_title_clean "$user_text" "$SESSION_TITLE_MAX_WORDS")"
  else
    [ -n "$OPENROUTER_API_KEY" ] || return 0
    [ -n "$SESSION_TITLE_MODEL" ] || return 0
    prompt="Generate a concise topical title for this ttychatter session. Reply with only the title, no quotes, no explanation, maximum $SESSION_TITLE_MAX_WORDS words.\n\nUser: $user_text\nAssistant: $ai_text"
    saved_stream="$STREAM"; STREAM=0
    title="$(call_openrouter_model "$SESSION_TITLE_MODEL" "$prompt" 60 2>/dev/null | head -n 1)"
    STREAM="$saved_stream"
    title="$(session_title_clean "$title" "$SESSION_TITLE_MAX_WORDS")"
  fi
  [ -n "$title" ] && write_session_title_metadata "$path" "$title"
}

call_openrouter_model_stream() {
  local model="$1" prompt="$2" timeout="${3:-120}"; shift 3 || true
  local attachments=("$@") clean_model payload_file status
  clean_model="$(normalize_model_id "$model")"
  payload_file="$(mktemp "${TMPDIR:-/tmp}/ttychatter.stream.payload.XXXXXX")" || return 1
  printf '%s' "$prompt" | make_openrouter_payload "$clean_model" "${attachments[@]}" > "$payload_file" || { rm -f "$payload_file"; return 1; }
  python3 - "$OPENROUTER_API_KEY" "$payload_file" "$timeout" <<'PY_STREAM'
import json, sys, urllib.request, urllib.error
api_key, payload_path, timeout = sys.argv[1], sys.argv[2], float(sys.argv[3])
with open(payload_path, 'r', encoding='utf-8') as fh:
    payload=json.load(fh)
payload['stream']=True
body=json.dumps(payload).encode('utf-8')
req=urllib.request.Request('https://openrouter.ai/api/v1/chat/completions', data=body, headers={
    'Content-Type':'application/json',
    'Authorization':'Bearer '+api_key,
    'HTTP-Referer':'https://github.com/remfan1994/ttychatter',
    'X-Title':'ttychatter',
})
parts=[]
try:
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        for raw in resp:
            line=raw.decode('utf-8','replace').strip()
            if not line or not line.startswith('data:'):
                continue
            data=line[5:].strip()
            if data == '[DONE]':
                break
            try:
                obj=json.loads(data)
            except Exception:
                continue
            for ch in obj.get('choices',[]) or []:
                delta=ch.get('delta') or {}
                piece=delta.get('content')
                if piece is None:
                    msg=ch.get('message') or {}
                    piece=msg.get('content')
                if isinstance(piece, str) and piece:
                    parts.append(piece)
                    sys.stderr.write(piece)
                    sys.stderr.flush()
except urllib.error.HTTPError as exc:
    sys.stderr.write('OpenRouter HTTP error %s: %s\n' % (exc.code, exc.read().decode('utf-8','replace')))
    sys.exit(1)
except Exception as exc:
    sys.stderr.write('streaming error: %s\n' % exc)
    sys.exit(1)
if parts:
    sys.stderr.write('\n')
print(''.join(parts))
PY_STREAM
  status=$?
  rm -f "$payload_file"
  return "$status"
}

turns_command() {
  local path="$1"
  path="$(resolve_session_arg "$path")"
  [ -f "$path" ] || { printf 'session not found: %s\n' "$path" >&2; return 1; }
  python3 - "$path" <<'PY_TURNS'
import re, sys
path=sys.argv[1]
pat=re.compile(r'^\[([0-9]{2}:[0-9]{2}:[0-9]{2})\] ([^:]+): ?(.*)$')
entries=[]; speaker=None; buf=[]
def flush():
    global speaker, buf
    if speaker is None: return
    sp=speaker.strip()
    if sp.lower()=='system' or sp=='remfan1994': return
    role='assistant' if sp in {'AI','OpenRouter','Assistant'} else 'user'
    text='\n'.join(buf)
    if text.startswith('CONTEXT_'): return
    entries.append((role,text))
with open(path,'r',encoding='utf-8',errors='replace') as fh:
    for raw in fh:
        line=raw.rstrip('\n')
        m=pat.match(line)
        if m:
            flush(); speaker=m.group(2); buf=[m.group(3)]
        else:
            if speaker is not None: buf.append(line)
flush()
print('{:<5} {:<10} {}'.format('MSG','ROLE','PREVIEW'))
for i,(role,text) in enumerate(entries,1):
    prev=re.sub(r'\s+',' ',text).strip()
    if len(prev)>88: prev=prev[:85]+'...'
    print('{:<5} {:<10} {}'.format(i,role,prev))
PY_TURNS
}

branch_session_command() {
  local source="$1" turn="$2" src branch name
  [ -n "$source" ] && [ -n "$turn" ] || { printf '%s\n' "usage: --branch SESSION TURN" >&2; return 2; }
  case "$turn" in ''|*[!0-9]*) printf '%s\n' "branch turn must be numeric" >&2; return 2 ;; esac
  src="$(resolve_session_arg "$source")"
  [ -f "$src" ] || { printf 'session not found: %s\n' "$src" >&2; return 1; }
  name="$(default_session_name_unique)"
  branch="$(resolve_session_path "$name")"
  ensure_prechat_line "$branch"
  printf '[%s] system: branch-from: %s\n[%s] system: branch-turn: %s\n[%s] system: branch-reason: manual-branch\n' "$(timestamp)" "$src" "$(timestamp)" "$turn" "$(timestamp)" >> "$branch"
  python3 - "$src" "$branch" "$turn" <<'PY_BRANCH'
import re, sys
src,dst,max_turn=sys.argv[1],sys.argv[2],int(sys.argv[3])
pat=re.compile(r'^\[[0-9]{2}:[0-9]{2}:[0-9]{2}\] ([^:]+):')
count=0; copying=False
with open(src,'r',encoding='utf-8',errors='replace') as r, open(dst,'a',encoding='utf-8') as w:
    for line in r:
        m=pat.match(line)
        if m:
            sp=m.group(1).strip()
            real=not (sp.lower()=='system' or sp=='remfan1994')
            if real:
                count += 1
                if count > max_turn:
                    break
                copying=True
            else:
                copying=False
        if copying:
            w.write(line)
PY_BRANCH
  title="$(session_title_from_file "$src" 2>/dev/null || basename "$src" .log)"
  write_session_title_metadata "$branch" "Branch of $title" >/dev/null 2>&1 || true
  printf '%s\n' "$branch"
}

extract_turn_text_command() {
  local source="$1" turn="$2"
  python3 - "$source" "$turn" <<'PY_EXTRACT_TURN'
import re, sys
path=sys.argv[1]; target=int(sys.argv[2])
pat=re.compile(r'^\[([0-9]{2}:[0-9]{2}:[0-9]{2})\] ([^:]+): ?(.*)$')
entries=[]; speaker=None; buf=[]
def flush():
    global speaker, buf
    if speaker is None: return
    sp=speaker.strip()
    if sp.lower()=='system' or sp=='remfan1994': return
    role='assistant' if sp in {'AI','OpenRouter','Assistant'} else 'user'
    text='\n'.join(buf)
    if text.startswith('CONTEXT_'): return
    entries.append((role,text))
with open(path,'r',encoding='utf-8',errors='replace') as fh:
    for raw in fh:
        line=raw.rstrip('\n')
        m=pat.match(line)
        if m:
            flush(); speaker=m.group(2); buf=[m.group(3)]
        else:
            if speaker is not None: buf.append(line)
flush()
if target < 1 or target > len(entries):
    print('turn out of range', file=sys.stderr); sys.exit(2)
role,text=entries[target-1]
if role != 'user':
    print('can only edit user turns', file=sys.stderr); sys.exit(2)
print(text)
PY_EXTRACT_TURN
}

edit_turn_command() {
  local source="$1" turn="$2" src tmp editor edited branch old_session old_name output cleaned prompt_text branch_name title model_id status
  [ -n "$source" ] && [ -n "$turn" ] || { printf '%s\n' "usage: --edit-turn SESSION TURN" >&2; return 2; }
  case "$turn" in ''|*[!0-9]*|0) printf '%s\n' "edit turn must be a positive number" >&2; return 2 ;; esac
  src="$(resolve_session_arg "$source")"
  [ -f "$src" ] || { printf 'session not found: %s\n' "$src" >&2; return 1; }
  tmp="$(mktemp)" || return 1
  extract_turn_text_command "$src" "$turn" > "$tmp" || { rm -f "$tmp"; return 1; }
  if [ ! -t 0 ] && [ -z "$EDITOR_CMD" ] && [ -z "${VISUAL:-}" ] && [ -z "${EDITOR:-}" ]; then
    rm -f "$tmp"
    printf '%s\n' "ERROR: --edit-turn needs a terminal editor; set EDITOR, VISUAL, or EDITOR_CMD" >&2
    return 2
  fi
  editor="$(editor_command)"; $editor "$tmp" || { rm -f "$tmp"; return 1; }
  edited="$(cat "$tmp")"; rm -f "$tmp"
  [ -n "$edited" ] || { printf '%s\n' "edited prompt is empty" >&2; return 1; }

  branch_name="$(default_session_name_unique)"
  branch="$(resolve_session_path "$branch_name")"
  ensure_prechat_line "$branch"
  printf '[%s] system: branch-from: %s\n[%s] system: branch-turn: %s\n[%s] system: branch-reason: edited-user-turn\n' "$(timestamp)" "$src" "$(timestamp)" "$((turn-1))" "$(timestamp)" >> "$branch"
  python3 - "$src" "$branch" "$((turn-1))" <<'PY_EDIT_BRANCH'
import re, sys
src,dst,max_turn=sys.argv[1],sys.argv[2],int(sys.argv[3])
pat=re.compile(r'^\[[0-9]{2}:[0-9]{2}:[0-9]{2}\] ([^:]+):')
count=0; copying=False
with open(src,'r',encoding='utf-8',errors='replace') as r, open(dst,'a',encoding='utf-8') as w:
    for line in r:
        m=pat.match(line)
        if m:
            sp=m.group(1).strip()
            real=not (sp.lower()=='system' or sp=='remfan1994')
            if real:
                count += 1
                if count > max_turn:
                    break
                copying=True
            else:
                copying=False
        if copying:
            w.write(line)
PY_EDIT_BRANCH
  title="$(session_title_from_file "$src" 2>/dev/null || basename "$src" .log)"
  write_session_title_metadata "$branch" "Branch of $title" >/dev/null 2>&1 || true
  printf '[%s] system: edit-turn: %s\n' "$(timestamp)" "$turn" >> "$branch"
  printf '[%s] %s: %s\n' "$(timestamp)" "$USER_NAME" "$edited" >> "$branch"

  old_session="${SESSION:-}"; old_name="${SESSION_NAME:-}"
  SESSION="$branch"; SESSION_NAME="$(basename "$branch" .log)"; CONTEXT_BUFFER=(); rebuild_context_from_session
  add_to_context "User: $edited"
  status_update "generating branch response"
  prompt_text="$(build_context)"
  model_id="$(effective_model)"
  output="$(call_openrouter_model "$model_id" "$prompt_text" 120)"; status=$?
  [ "$status" -ne 0 ] && output="(response error: $output)"
  [ -n "$output" ] || output="(empty response or API error)"
  printf '[%s] AI: %s\n' "$(timestamp)" "$output" >> "$branch"
  cleaned="$output"
  add_to_context "Assistant: $cleaned"
  write_context_snapshot "$(timestamp)"
  maybe_generate_session_title "$branch" "$edited" "$cleaned"
  printf 'branched edited session: %s\n' "$branch"
  printf '%s\n' "$cleaned"
  SESSION="$old_session"; SESSION_NAME="$old_name"
}
export_session_command() {
  local name="$1" fmt="${2:-markdown}" out="$3" path title tmp
  [ -n "$name" ] || { printf '%s\n' "usage: --export SESSION [--format markdown|text|json] [--output FILE" >&2; return 2; }
  path="$(resolve_session_arg "$name")"
  [ -f "$path" ] || { printf 'session not found: %s\n' "$path" >&2; return 1; }
  title="$(session_title_from_file "$path" 2>/dev/null || basename "$path" .log)"
  tmp="$(mktemp)" || return 1
  python3 - "$path" "$title" "$fmt" > "$tmp" <<'PY_EXPORT'
import json, re, sys
path,title,fmt=sys.argv[1],sys.argv[2],sys.argv[3].lower()
pat=re.compile(r'^\[([0-9]{2}:[0-9]{2}:[0-9]{2})\] ([^:]+): ?(.*)$')
entries=[]; ts=None; speaker=None; buf=[]
def flush():
    global ts, speaker, buf
    if speaker is None: return
    sp=speaker.strip()
    if sp.lower()=='system' or sp=='remfan1994': return
    role='assistant' if sp in {'AI','OpenRouter','Assistant'} else 'user'
    text='\n'.join(buf)
    if text.startswith('CONTEXT_'): return
    entries.append({'role':role,'speaker':sp,'text':text,'time':ts})
with open(path,'r',encoding='utf-8',errors='replace') as fh:
    for raw in fh:
        line=raw.rstrip('\n')
        m=pat.match(line)
        if m:
            flush(); ts=m.group(1); speaker=m.group(2); buf=[m.group(3)]
        else:
            if speaker is not None: buf.append(line)
flush()
if fmt == 'json':
    print(json.dumps({'title':title,'session':path,'messages':entries}, ensure_ascii=False, indent=2))
elif fmt == 'text':
    print('Title: '+title); print('Session: '+path); print()
    for m in entries:
        label='Assistant' if m['role']=='assistant' else 'User'
        print(label+':'); print(m['text']); print()
else:
    print('# '+title); print(); print('Source: `'+path+'`'); print()
    for m in entries:
        label='Assistant' if m['role']=='assistant' else 'User'
        print('## '+label); print(); print(m['text']); print()
PY_EXPORT
  if [ -n "$out" ]; then cat "$tmp" > "$out"; else cat "$tmp"; fi
  rm -f "$tmp"
}

# ==========================================================
# SEARCH SUPPORT
# ----------------------------------------------------------
# Bash clients do not have a full-screen transcript window, but they still need
# the same practical ability to find old conversations.  Search is kept simple:
# grep through human-readable session logs.  This keeps the behavior compatible
# with the project's plain-text durability philosophy and avoids building a
# hidden index or database that future maintainers would have to migrate.
# ==========================================================

search_session_file() {
  local file="$1"
  local query="$2"

  [ -f "$file" ] || { printf 'no such session log: %s\n' "$file"; return 1; }
  grep -in -- "$query" "$file" 2>/dev/null | sed "s#^#$(basename "$file"):#"
}

search_all_sessions() {
  local query="$1"
  local file
  local found=0

  for file in "$SESSION_DIR"/*.log; do
    [ -e "$file" ] || continue
    if grep -iq -- "$query" "$file" 2>/dev/null; then
      found=1
      printf '%s\n' "--- $(basename "$file") ---"
      grep -in -- "$query" "$file" 2>/dev/null
    fi
  done

  [ "$found" -eq 1 ] || printf 'no matches for: %s\n' "$query"
}

search_command() {
  local query="$1"
  local all="$2"

  [ -n "$query" ] || { printf '%s\n' "ERROR: --search requires text."; return 2; }
  if [ "$all" -eq 1 ]; then
    search_all_sessions "$query"
  else
    search_session_file "$SESSION" "$query"
  fi
}

handle_runtime_command() {
  local raw="$1"
  local command rest key value editor_buffer runtime_status

  case "$raw" in
    \\:*)
      RUNTIME_SEND_OVERRIDE="${raw#\\}"
      return 2
      ;;
    :*)
      ;;
    *)
      return 1
      ;;
  esac

  raw="${raw#:}"
  command="${raw%%[[:space:]]*}"
  if [ "$command" = "$raw" ]; then rest=""; else rest="${raw#*[[:space:]]}"; fi

  case "$command" in
    ""|help|h|\?) runtime_command_help ;;
    quit|exit) printf '%s\n' "exiting"; exit 0 ;;
    credits) credits ;;
    doctor) doctor_command ;;
    search)
      [ -n "$rest" ] || { printf '%s
' "usage: :search TEXT"; return 0; }
      search_session_file "$SESSION" "$rest"
      ;;
    search-all|search_all)
      [ -n "$rest" ] || { printf '%s
' "usage: :search-all TEXT"; return 0; }
      search_all_sessions "$rest"
      ;;

    list|sessions) list_sessions ;;
    rename) rename_current_session "$rest" ;;
    turns) turns_command "$SESSION_NAME" ;;
    branch|fork) branch_session_command "$SESSION_NAME" "$rest" ;;
    stream) case "$rest" in on|1|yes|true) STREAM=1; printf '%s
' "streaming enabled" ;; off|0|no|false) STREAM=0; printf '%s
' "streaming disabled" ;; *) printf '%s
' "usage: :stream on|off" ;; esac ;;
    status|progress) case "$rest" in on|1|yes|true) STATUS_UPDATES=1; printf '%s
' "status updates enabled" ;; off|0|no|false) STATUS_UPDATES=0; printf '%s
' "status updates disabled" ;; *) printf '%s
' "usage: :status on|off" ;; esac ;;
    voice|transcribe) [ -n "$rest" ] && { voice_text="$(run_voice_input_command "$rest")" && send_one_message "$voice_text"; } || printf '%s
' "usage: :voice FILE" ;;
    speak) case "$rest" in on) VOICE_OUTPUT=1; printf '%s
' "voice output enabled" ;; off) VOICE_OUTPUT=0; printf '%s
' "voice output disabled" ;; last) [ -n "${LAST_AI_OUTPUT:-}" ] && run_voice_output_command "$LAST_AI_OUTPUT" || printf '%s
' "no previous AI output" ;; *) printf '%s
' "usage: :speak on|off|last" ;; esac ;;

    models) print_models ;;
    routers) MODEL_TYPE_FILTER="routers"; print_models ;;
    update-models|update_models) update_models_cache ;;
    routers) MODEL_TYPE_FILTER="routers"; print_models ;;
    select-model|select_model) select_model_command ;;
    favorites) list_favorite_models ;;
    favorite) favorite_model_command "$rest" ;;
    unfavorite|unbookmark) unfavorite_model_command "$rest" ;;
    test-model|test_model)
      [ -n "$rest" ] || { printf '%s\n' "usage: :test-model MODEL"; return 0; }
      test_model_command "$rest"
      ;;
    model)
      [ -n "$rest" ] || { printf 'active model: %s\n' "$(model_label)"; return 0; }
      MODEL="$(normalize_model_id "$rest")"
      if truthy "$DEMO_MODE" && [ -z "$MODEL" ]; then MODEL="demo/auto"; fi
ACTIVE_MODEL="$(effective_model)"
      printf 'active model for this chat: %s\n' "$ACTIVE_MODEL"
      ;;
    model-save)
      [ -n "$rest" ] || { printf '%s\n' "usage: :model-save MODEL"; return 0; }
      MODEL="$(normalize_model_id "$rest")"
      if truthy "$DEMO_MODE" && [ -z "$MODEL" ]; then MODEL="demo/auto"; fi
ACTIVE_MODEL="$(effective_model)"
      set_config_value "MODEL" "$ACTIVE_MODEL"
      printf 'active model saved: %s\n' "$ACTIVE_MODEL"
      ;;

    config) print_config_summary ;;
    set)
      key="${rest%%[[:space:]]*}"
      if [ "$key" = "$rest" ]; then value=""; else value="${rest#*[[:space:]]}"; fi
      [ -n "$key" ] || { printf '%s\n' "usage: :set KEY VALUE"; return 0; }
      set_config_value "$key" "$value"
      apply_runtime_config_change "$key" "$value"
      printf 'set %s=%s\n' "$key" "$value"
      ;;
    unset)
      [ -n "$rest" ] || { printf '%s\n' "usage: :unset KEY"; return 0; }
      remove_config_key "$rest"
      [ "$rest" = "MODEL" ] && { MODEL=""; if truthy "$DEMO_MODE" && [ -z "$MODEL" ]; then MODEL="demo/auto"; fi
ACTIVE_MODEL="$(effective_model)"; }
      printf 'removed config key if present: %s\n' "$rest"
      ;;
    set-api-key|api-key) set_api_key_command ;;
    forget-api-key) forget_api_key_command ;;

    memory|show-memory) show_current_memory_runtime ;;
    edit-memory) edit_current_memory_runtime ;;
    clear-memory)
      CONTEXT_BUFFER=()
      write_context_snapshot "$(timestamp)"
      printf '%s\n' "current memory cleared"
      ;;

    attach)
      [ -n "$rest" ] || { printf '%s\n' "usage: :attach FILE"; return 0; }
      ATTACH_FILES+=("$rest")
      printf 'queued attachment for next message: %s\n' "$rest"
      ;;
    attachments) list_attachments_runtime ;;
    pending) if [ "${#ATTACH_FILES[@]}" -eq 0 ]; then printf 'no pending attachments\n'; else printf 'pending attachments:\n'; for f in "${ATTACH_FILES[@]}"; do printf '  %s\n' "$f"; done; fi ;;
    editor)
      editor_buffer="$(compose_with_editor)"
      [ -z "$editor_buffer" ] && { printf '%s\n' "editor returned empty prompt"; return 0; }
      send_one_message "$editor_buffer"
      ;;

    *)
      printf 'unknown runtime command: :%s\n' "$command"
      printf '%s\n' "type :help for available commands"
      ;;
  esac

  return 0
}

# ==========================================================
# ARGUMENT PARSING
# ==========================================================

POSITIONAL_ARGS=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help|help) ACTION="help" ;;
    --version) ACTION="version" ;;
    --credits) ACTION="credits" ;;
    --doctor) ACTION="doctor" ;;
    --demo) DEMO_MODE=1 ;;
    -i|--interactive) FORCE_INTERACTIVE=1 ;;
    -n|--new) NEW_SESSION=1 ;;
    -p|--prompt) shift; PROMPT_TEXT="${1:-}" ;;
    --input) shift; INPUT_FILE="${1:-}" ;;
    -o|--output) shift; OUTPUT_PATH="${1:-}" ;;
    -s|--session) shift; SESSION_NAME="${1:-}" ;;
    --stream) STREAM=1 ;;
    --no-stream) STREAM=0 ;;
    --status|--progress) STATUS_UPDATES=1 ;;
    --no-status|--no-progress) STATUS_UPDATES=0 ;;
    --voice-input) shift; VOICE_INPUT_PATH="${1:-}" ;;
    --transcribe) ACTION="transcribe"; shift; VOICE_INPUT_PATH="${1:-}" ;;
    --speak) VOICE_OUTPUT=1 ;;
    --no-speak) VOICE_OUTPUT=0 ;;
    --turns) ACTION="turns"; shift; TURNS_SESSION="${1:-}" ;;
    --branch) ACTION="branch"; shift; BRANCH_SESSION="${1:-}"; shift; BRANCH_TURN="${1:-}" ;;
    --edit-turn) ACTION="edit-turn"; shift; EDIT_SESSION="${1:-}"; shift; EDIT_TURN="${1:-}" ;;
    --export) ACTION="export"; shift; EXPORT_SESSION="${1:-}" ;;
    --format) shift; EXPORT_FORMAT="${1:-markdown}" ;;
    --models) ACTION="models" ;;
    --routers) ACTION="models"; MODEL_TYPE_FILTER="routers" ;;
    --all) SHOW_ALL_MODELS=1 ;;
    --show-preview) MODEL_FILTER_HIDE_PREVIEW=0 ;;
    --hide-preview) MODEL_FILTER_HIDE_PREVIEW=1 ;;
    --require-tokens) MODEL_FILTER_REQUIRE_TOKENS=1 ;;
    --allow-missing-tokens) MODEL_FILTER_REQUIRE_TOKENS=0 ;;
    --model-type) shift; MODEL_TYPE_FILTER="${1:-all}" ;;
    --sort) shift; MODEL_SORT_ORDER="${1:-$MODEL_SORT_ORDER}" ;;
    --min-input-tokens) shift; MODEL_MIN_INPUT_TOKENS="${1:-$MODEL_MIN_INPUT_TOKENS}" ;;
    --min-output-tokens) shift; MODEL_MIN_OUTPUT_TOKENS="${1:-$MODEL_MIN_OUTPUT_TOKENS}" ;;
    --update-models) ACTION="update-models" ;;
    --autoscan-model) ACTION="removed-autoscan" ;;
    --test-model) ACTION="test"; shift; TEST_MODEL="${1:-}" ;;
    --select-model) ACTION="select" ;;
    --favorites) ACTION="favorites" ;;
    --favorite-model) ACTION="favorite"; shift; FAVORITE_MODEL_ARG="${1:-}" ;;
    --unfavorite-model|--unbookmark-model) ACTION="unfavorite"; shift; UNFAVORITE_MODEL_ARG="${1:-}" ;;
    --set-api-key) ACTION="set-api-key" ;;
    --forget-api-key) ACTION="forget-api-key" ;;
    --config) ACTION="config" ;;
    --set) ACTION="set-config"; shift; SET_KEY="${1:-}"; shift; SET_VALUE="${1:-}" ;;
    --unset) ACTION="unset-config"; shift; UNSET_KEY="${1:-}" ;;
    --show-memory) ACTION="show-memory"; shift; MEMORY_SESSION="${1:-}" ;;
    --edit-memory) ACTION="edit-memory"; shift; MEMORY_SESSION="${1:-}" ;;
    --clear-memory) ACTION="clear-memory"; shift; MEMORY_SESSION="${1:-}" ;;
    --editor-prompt) EDITOR_PROMPT=1 ;;
    --attach) shift; [ -n "${1:-}" ] || { printf '%s\n' "ERROR: --attach requires a file." >&2; exit 2; }; ATTACH_FILES+=("$1") ;;
    --search) ACTION="search"; shift; SEARCH_QUERY="${1:-}" ;;
    --all-sessions) SEARCH_ALL=1 ;;
    --list|--sessions) ACTION="list" ;;
    --rename-session) ACTION="rename"; shift; RENAME_OLD="${1:-}"; shift; RENAME_NEW="${1:-}" ;;
    --loopback) LOOPBACK=1 ;;
    --loopback-file) shift; LOOPBACK_FILE="${1:-}" ;;
    --save) SAVE=1 ;;
    --resume) RESUME=1; shift; SESSION_NAME="${1:-}" ;;
    --) shift; while [ "$#" -gt 0 ]; do POSITIONAL_ARGS+=("$1"); shift; done; break ;;
    -*) printf 'ERROR: unknown option: %s\n' "$1" >&2; exit 2 ;;
    *) POSITIONAL_ARGS+=("$1") ;;
  esac
  shift
done

if [ "${#POSITIONAL_ARGS[@]}" -eq 1 ] && [ -z "$SESSION_NAME" ] && [ -z "$PROMPT_TEXT" ] && [ -z "$INPUT_FILE" ]; then
  if [ -f "${POSITIONAL_ARGS[0]}" ]; then INPUT_FILE="${POSITIONAL_ARGS[0]}"; else SESSION_NAME="${POSITIONAL_ARGS[0]}"; fi
elif [ "${#POSITIONAL_ARGS[@]}" -eq 2 ] && [ -z "$INPUT_FILE" ] && [ -z "$OUTPUT_PATH" ]; then
  INPUT_FILE="${POSITIONAL_ARGS[0]}"; OUTPUT_PATH="${POSITIONAL_ARGS[1]}"
elif [ "${#POSITIONAL_ARGS[@]}" -gt 0 ]; then
  printf 'ERROR: unexpected argument: %s\n' "${POSITIONAL_ARGS[*]}" >&2; exit 2
fi

case "$ACTION" in
  help) help_menu; exit 0 ;;
  version) version; exit 0 ;;
  credits) credits; exit 0 ;;
  doctor) doctor_command; exit $? ;;
  transcribe) run_voice_input_command "$VOICE_INPUT_PATH"; exit $? ;;
  turns) turns_command "$TURNS_SESSION"; exit $? ;;
  branch) branch_session_command "$BRANCH_SESSION" "$BRANCH_TURN"; exit $? ;;
  edit-turn) edit_turn_command "$EDIT_SESSION" "$EDIT_TURN"; exit $? ;;
  export) export_session_command "$EXPORT_SESSION" "$EXPORT_FORMAT" "$OUTPUT_PATH"; exit $? ;;
  search) [ -n "$SEARCH_QUERY" ] || { printf '%s\n' "ERROR: --search requires text" >&2; exit 2; };
          if [ -z "$SESSION_NAME" ]; then SEARCH_ALL=1; else SESSION="$(resolve_session_arg "$SESSION_NAME")"; fi
          search_command "$SEARCH_QUERY" "$SEARCH_ALL"; exit $? ;;
  list) list_sessions; exit 0 ;;
  rename) rename_session_command "$RENAME_OLD" "$RENAME_NEW"; exit $? ;;
  models) print_models; exit $? ;;
  favorites) list_favorite_models; exit $? ;;
  favorite) favorite_model_command "$FAVORITE_MODEL_ARG"; exit $? ;;
  unfavorite) unfavorite_model_command "$UNFAVORITE_MODEL_ARG"; exit $? ;;
  update-models) update_models_cache; exit $? ;;
  test) test_model_command "$TEST_MODEL"; exit $? ;;
  removed-autoscan) removed_autoscan_message >&2; exit 2 ;;
  select) select_model_command; exit $? ;;
  set-api-key) set_api_key_command; exit $? ;;
  forget-api-key) forget_api_key_command; exit $? ;;
  config) print_config_summary; exit 0 ;;
  set-config) [ -n "$SET_KEY" ] || { printf '%s\n' "ERROR: --set requires KEY VALUE" >&2; exit 2; }; set_config_value "$SET_KEY" "$SET_VALUE"; exit $? ;;
  unset-config) [ -n "$UNSET_KEY" ] || { printf '%s\n' "ERROR: --unset requires KEY" >&2; exit 2; }; remove_config_key "$UNSET_KEY"; exit $? ;;
  show-memory) [ -n "$MEMORY_SESSION" ] || { printf '%s\n' "ERROR: --show-memory requires a session" >&2; exit 2; }; show_memory_command "$MEMORY_SESSION"; exit $? ;;
  edit-memory) [ -n "$MEMORY_SESSION" ] || { printf '%s\n' "ERROR: --edit-memory requires a session" >&2; exit 2; }; edit_memory_command "$MEMORY_SESSION"; exit $? ;;
  clear-memory) [ -n "$MEMORY_SESSION" ] || { printf '%s\n' "ERROR: --clear-memory requires a session" >&2; exit 2; }; clear_memory_command "$MEMORY_SESSION"; exit $? ;;
esac

if [ "$SAVE" -eq 1 ]; then printf '%s\n' "ERROR: --save is only valid with --test-model or --select-model." >&2; exit 2; fi

# ==========================================================
# CHAT SESSION SETUP
# ==========================================================

require_api_key || exit 1

if [ "$NEW_SESSION" -eq 1 ] && { [ -n "$SESSION_NAME" ] || [ -n "$OUTPUT_PATH" ] || [ "$RESUME" -eq 1 ]; }; then
  printf '%s\n' "ERROR: --new cannot be combined with --session, --output, --resume, or a session operand" >&2
  exit 2
fi

SESSION_ARG="$SESSION_NAME"
if [ -z "$SESSION_ARG" ]; then
  SESSION_NAME="$(default_session_name_unique)"
  SESSION="$(resolve_session_path "$SESSION_NAME")"
elif [ -n "$OUTPUT_PATH" ]; then
  SESSION_NAME="$(sanitize_session_name "$SESSION_ARG")"
  SESSION="$(expand_path "$OUTPUT_PATH")"
else
  case "$SESSION_ARG" in
    */*|*.log) SESSION="$(resolve_session_arg "$SESSION_ARG")"; SESSION_NAME="$(basename "$SESSION" .log)" ;;
    *) SESSION_NAME="$(sanitize_session_name "$SESSION_ARG")"; SESSION="$(resolve_session_path "$SESSION_NAME")" ;;
  esac
fi

SESSION_WAS_EMPTY=1
[ -s "$SESSION" ] && SESSION_WAS_EMPTY=0
if [ "$RESUME" -eq 1 ] && [ ! -f "$SESSION" ]; then printf 'ERROR: session not found: %s\n' "$SESSION_NAME" >&2; exit 1; fi
ensure_prechat_line "$SESSION"

rebuild_context_from_session
if truthy "$DEMO_MODE" && [ -z "$MODEL" ]; then MODEL="demo/auto"; fi
ACTIVE_MODEL="$(effective_model)"
NOTICE_VISIBLE=0
if truthy "$STARTUP_NOTICE" && [ "$SESSION_WAS_EMPTY" -eq 1 ]; then NOTICE_VISIBLE=1; fi

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function print_chat_header
# print_chat_header is a named maintenance unit. Keep behavior stable, check
# call sites before changing it, and update man pages/help/comments when
# behavior changes.
# ----------------------------------------------------------
print_chat_header() {
  printf '%s\n' "$PROGRAM"
  printf 'session: %s\n' "$SESSION"
  printf 'model: %s\n' "$(model_label)"
  printf 'context turns: %s\n' "$CONTEXT_TURNS"
  [ -f "$SESSION" ] && [ "${#CONTEXT_BUFFER[@]}" -gt 0 ] && printf 'loaded context entries: %s\n' "${#CONTEXT_BUFFER[@]}"
  [ "${#ATTACH_FILES[@]}" -gt 0 ] && printf 'pending attachments: %s\n' "${#ATTACH_FILES[@]}"
  printf '%s\n\n' "Ctrl+D to send message, :help for commands, Ctrl+C to exit"
  if [ -z "$MODEL" ]; then
    printf '%s\n' "No MODEL configured. Using fallback model."
    printf '  %s --select-model\n\n' "$PROGRAM"
  fi
}

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function print_project_lead_notice
# print_project_lead_notice is a named maintenance unit. Keep behavior
# stable, check call sites before changing it, and update man
# pages/help/comments when behavior changes.
# ----------------------------------------------------------
print_project_lead_notice() { printf '[%s] %s: %s\n\n' "$(timestamp)" "$PROJECT_LEAD_NAME" "$PROJECT_LEAD_NOTICE"; }

# ----------------------------------------------------------
# MAINTAINER COMMENTARY: function send_one_message
# Main per-message path: log user input, update memory, call OpenRouter, extract
# attachments, snapshot memory, and display output.
# ----------------------------------------------------------
send_one_message() {
  local buffer="$1" ts output output_status cleaned_output prompt_text
  ts="$(timestamp)"
  [ -z "$buffer" ] && { printf '%s\n' "empty message ignored"; return 1; }
  ensure_prechat_line "$SESSION"
  printf '[%s] %s: %s\n' "$ts" "$USER_NAME" "$buffer" >> "$SESSION"
  add_to_context "User: $buffer"
  printf '\n________________________________________\nEND INPUT\n________________________________________\n'
  status_update "preparing request for $ACTIVE_MODEL"
  printf '[%s] Generating response...\n' "$(timestamp)"
  printf '________________________________________\nBEGIN OUTPUT\n________________________________________\n\n'
  prompt_text="$(build_context)"
  output="$(call_openrouter_model "$ACTIVE_MODEL" "$prompt_text" 120 "${ATTACH_FILES[@]}")"; output_status=$?
  ATTACH_FILES=()
  [ "$output_status" -ne 0 ] && output="(response error: $output)"
  [ -z "$output" ] && output="(empty response or API error)"
  printf '[%s] AI: %s\n' "$(timestamp)" "$output" >> "$SESSION"
  cleaned_output="$(printf '%s' "$output" | extract_attachments)"
  add_to_context "Assistant: $cleaned_output"
  write_context_snapshot "$(timestamp)"
  maybe_generate_session_title "$SESSION" "$buffer" "$cleaned_output"
  LAST_AI_OUTPUT="$cleaned_output"
  if truthy "$VOICE_OUTPUT"; then run_voice_output_command "$cleaned_output" || true; fi
  if [ "$LOOPBACK" -eq 1 ]; then
    printf '%s\n' "$cleaned_output" >&3
  fi
  if [ -n "$LOOPBACK_FILE" ]; then
    printf '%s\n' "$cleaned_output" >> "$LOOPBACK_FILE"
  fi
  printf '%s\n\n' "$cleaned_output"
}
# ----------------------------------------------------------
# MAINTAINER COMMENTARY: loopback output routing
# Loopback is for users who want to pipe AI responses from the running
# terminal client into another program.  A normal interactive chat prints
# prompts, status lines, separators, and responses to stdout.  That is useful
# for a human, but bad for pipelines because the receiving program cannot
# distinguish interface chrome from the actual AI text.
#
# The Bash editions solve this by duplicating the original stdout onto fd 3,
# then redirecting ordinary stdout to stderr when --loopback is active.  The
# interface remains visible in the terminal, while the clean AI response is
# written to fd 3.  This keeps the client interactive without forcing a
# separate batch mode.
# ----------------------------------------------------------
exec 3>&1
if [ "$LOOPBACK" -eq 1 ]; then
  exec 1>&2
fi

print_chat_header
[ "$NOTICE_VISIBLE" -eq 1 ] && print_project_lead_notice

if [ -n "$VOICE_INPUT_PATH" ]; then
  PROMPT_TEXT="$(run_voice_input_command "$VOICE_INPUT_PATH")" || exit $?
fi
if [ -n "$INPUT_FILE" ]; then
  if [ "$INPUT_FILE" = "-" ]; then PROMPT_TEXT="$(cat)"; else PROMPT_TEXT="$(cat "$INPUT_FILE")" || exit 1; fi
fi
if [ -n "$PROMPT_TEXT" ] || { [ ! -t 0 ] && [ "$FORCE_INTERACTIVE" -eq 0 ]; }; then
  if [ -z "$PROMPT_TEXT" ]; then PROMPT_TEXT="$(cat)"; fi
  send_one_message "$PROMPT_TEXT"
  exit $?
fi

if [ "$EDITOR_PROMPT" -eq 1 ]; then
  buffer="$(compose_with_editor)"
  if [ "$NOTICE_VISIBLE" -eq 1 ]; then clear_screen; NOTICE_VISIBLE=0; print_chat_header; printf '[%s] %s: %s\n' "$(timestamp)" "$USER_NAME" "$buffer"; fi
  send_one_message "$buffer"
  exit $?
fi

while true; do
  TS="$(timestamp)"
  printf '[%s] %s> ' "$TS" "$USER_NAME"
  buffer="$(cat)"
  if [ -z "$buffer" ]; then
    [ -t 0 ] || exit 0
    continue
  fi

  RUNTIME_SEND_OVERRIDE=""
  if handle_runtime_command "$buffer"; then
    continue
  else
    runtime_status=$?
    if [ "$runtime_status" -eq 2 ]; then
      buffer="$RUNTIME_SEND_OVERRIDE"
    fi
  fi

  if [ "$NOTICE_VISIBLE" -eq 1 ]; then clear_screen; NOTICE_VISIBLE=0; print_chat_header; printf '[%s] %s: %s
' "$TS" "$USER_NAME" "$buffer"; fi
  send_one_message "$buffer"
done
