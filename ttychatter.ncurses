@dataclass
# ------------------------------------------------------------
# MAINTAINER COMMENTARY: class ModelInfo
# Structured model metadata from OpenRouter listModels. The selector should rely on this metadata
# instead of guessing future model names.
# ------------------------------------------------------------
class ModelInfo:
    model_id: str
    api_name: str
    display_name: str
    description: str
    input_token_limit: Optional[int] = None
    output_token_limit: Optional[int] = None
    methods: List[str] = field(default_factory=list)


def demo_model_list() -> List[ModelInfo]:
    """Return a small local model catalog for no-network testing.

    This is deliberately not a fake provider abstraction. It is a user-facing
    safety feature: maintainers and users can test model-browser rendering,
    search, favorites, sorting, sessions, and message flow without spending
    OpenRouter requests or touching openrouter/free. Keep these rows obviously
    marked as demo rows so nobody confuses them with the live OpenRouter catalog.
    """
    return [
        ModelInfo(
            model_id="demo/auto",
            api_name="demo/auto",
            display_name="Demo Auto Router",
            description="Local demo model. No network request is made.",
            input_token_limit=8192,
            output_token_limit=1024,
            methods=["chat.completions", "router", "demo"],
        ),
        ModelInfo(
            model_id="demo/free",
            api_name="demo/free",
            display_name="Demo Free Route",
            description="Local demo row that behaves like a free/router-style model for UI testing.",
            input_token_limit=4096,
            output_token_limit=512,
            methods=["chat.completions", "router", "free", "demo"],
        ),
        ModelInfo(
            model_id="demo/code-helper",
            api_name="demo/code-helper",
            display_name="Demo Code Helper",
            description="Local demo row that returns short and long code blocks for attachment testing.",
            input_token_limit=32768,
            output_token_limit=4096,
            methods=["chat.completions", "demo"],
        ),
    ]


def demo_ai_response(prompt_text: str, attachments: List[PendingAttachment]) -> str:
    """Return a local response without contacting OpenRouter.

    The response intentionally includes one short code block and one long code
    block. That makes demo mode useful for the exact kind of release-candidate
    testing the project needs: users can verify transcript rendering, code-block
    threshold behavior, attachment extraction, session logging, and memory updates
    without sending fake prompts to OpenRouter.
    """
    attachment_note = ""
    if attachments:
        names = ", ".join(item.path.name for item in attachments)
        attachment_note = f"\n\nQueued attachment(s) seen locally: {names}."
    prompt_excerpt = prompt_text.strip().replace("\n", " ")[:140]
    return (
        "Demo mode is active; no OpenRouter request was made. "
        f"I received this local prompt excerpt: {prompt_excerpt!r}."
        + attachment_note
        + "\n\nShort inline code block:\n```text\nok\n```"
        + "\n\nLong code block for attachment-threshold testing:\n"
        + "```python\n"
        + "def demo():\n"
        + "    print('ttychatter demo mode')\n"
        + "    print('no provider request was made')\n"
        + "    print('longer code blocks should become attachments')\n"
        + "    return True\n"
        + "```"
    )


@dataclass
# ------------------------------------------------------------
