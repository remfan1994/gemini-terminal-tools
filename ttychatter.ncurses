# ------------------------------------------------------------
class ModelFilter:
    # Metadata-based filters for the model selector. These use the capabilities
    # returned by the model-list endpoint instead of probing every model.
    require_token_limits: bool = True
    hide_preview_or_experimental: bool = False
    min_input_tokens: int = 1
    min_output_tokens: int = 1
    sort_mode: str = "api"


@dataclass
# ------------------------------------------------------------
# MAINTAINER COMMENTARY: class PendingAttachment
# Maintainer note for PendingAttachment: this routine is part of the long-term public behavior
# of the program. When changing it, check callers, documentation, config compatibility, session-
# log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
class PendingAttachment:
    path: Path
    mime_type: str


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_endpoint
# Maintainer note for model_endpoint: this routine is part of the long-term public behavior of
# the program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_endpoint(cfg: Config, model_id: str) -> str:
    """Return the OpenRouter chat-completions endpoint.

    OpenRouter exposes an OpenAI-compatible chat-completions API. That is the
    reason this provider migration is feasible without rewriting the entire UI:
    the application still builds a list of chat messages and receives a message
    response, but model discovery and authentication move from OpenRouter-specific
    query parameters to OpenRouter bearer-token headers.
    """
    return "https://openrouter.ai/api/v1/chat/completions"


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def guess_mime
# Maintainer note for guess_mime: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def guess_mime(path: Path) -> str:
    mime, _encoding = mimetypes.guess_type(str(path))
    return mime or "application/octet-stream"


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def mime_extension
# Maintainer note for mime_extension: this routine is part of the long-term public behavior of
# the program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def mime_extension(mime_type: str) -> str:
    ext = mimetypes.guess_extension(mime_type) or ".bin"
    if ext == ".jpe":
        ext = ".jpg"
    return ext


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def build_openrouter_user_content
# Builds REST request parts. Keep text/media separation clear so maintainers can adapt when
# AI changes MIME or file handling rules.
# ------------------------------------------------------------
def build_openrouter_user_content(prompt_text: str, attachments: List[PendingAttachment]) -> object:
    """Build OpenRouter chat-message content for text plus optional files.

    Text-only requests use a plain string because that is the most widely
    compatible OpenOpenRouter chat-completions shape. When attachments are
    present, the content becomes a list of typed parts. Text files are folded
    into text parts. Image files are sent as data URLs where possible because
    many OpenRouter multimodal models understand OpenAI-style image_url parts.
    Other binary files are represented by a text notice rather than silently
    pretending every model can consume every media type.
    """
    if not attachments:
        return prompt_text

    content_parts: List[dict] = [{"type": "text", "text": prompt_text}]
    for item in attachments:
        path = item.path
        mime_type = item.mime_type
        try:
            size = path.stat().st_size
        except OSError:
            content_parts.append({"type": "text", "text": f"\n[Attachment unavailable: {path}]"})
            continue
        if size > MAX_INLINE_ATTACHMENT_BYTES:
            content_parts.append({"type": "text", "text": f"\n[Attachment skipped; larger than {MAX_INLINE_ATTACHMENT_BYTES} bytes: {path.name}]"})
            continue
        if mime_type.startswith("text/") or mime_type in {"application/json", "application/xml", "application/x-yaml"}:
            try:
                data = path.read_text(encoding="utf-8", errors="replace")
            except OSError as exc:
                data = f"[Could not read attachment: {exc}]"
            content_parts.append({"type": "text", "text": f"\n\n[Attached text file: {path.name}]\n{data}"})
        elif mime_type.startswith("image/"):
            try:
                encoded = base64.b64encode(path.read_bytes()).decode("ascii")
            except OSError as exc:
                content_parts.append({"type": "text", "text": f"\n[Could not read image attachment {path.name}: {exc}]"})
                continue
            content_parts.append({"type": "image_url", "image_url": {"url": f"data:{mime_type};base64,{encoded}"}})
        else:
            content_parts.append({"type": "text", "text": f"\n[Attached file not sent inline because MIME type is not yet supported by ttychatter OpenRouter mode: {path.name} ({mime_type})]"})
    return content_parts


def parse_openrouter_text_and_files(body: str, attachment_dir: Path, session_name: str) -> str:
    """Extract text from an OpenRouter chat-completions response.

    Most OpenRouter models return choices[0].message.content as a string. Some
    OpenAI-compatible APIs can return structured content parts. This function is
    defensive so provider-side response changes are visible as parse errors
    instead of crashing the whole TUI.
    """
    parsed = json.loads(body)
    chunks: List[str] = []
    for choice in parsed.get("choices", []):
        message = choice.get("message", {})
        content = message.get("content", "")
        if isinstance(content, str):
            chunks.append(content)
        elif isinstance(content, list):
            for part in content:
                if isinstance(part, dict):
                    if isinstance(part.get("text"), str):
                        chunks.append(part["text"])
                    elif isinstance(part.get("content"), str):
                        chunks.append(part["content"])
    return "\n".join(c for c in chunks if c)



# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def generate_with_model
# Single AI generation request. All request-part construction funnels through this area so
# attachments, text prompts, and future media behavior stay centralized.
# ------------------------------------------------------------
def generate_with_model(
    cfg: Config,
    model_id: str,
    prompt_text: str,
    session_name: str,
    attachment_dir: Path,
    attachments: Optional[List[PendingAttachment]] = None,
    timeout: int = 120,
) -> Tuple[bool, str]:
    """Send one OpenRouter chat-completions request.

    Maintainers: keep this function boring. All provider-specific behavior for
    a normal response should remain concentrated here. If OpenRouter changes its
    request or response schema, patch this function and the model-list parser
    first before touching the UI state machine.
    """
    if cfg.demo_mode:
        return True, demo_ai_response(prompt_text, attachments or [])

    if not cfg.api_key:
        return False, "No OpenRouter API key loaded. Press F3 to paste an API key."

    payload = {
        "model": normalize_model_id(model_id),
        "messages": [
            {
                "role": "user",
                "content": build_openrouter_user_content(prompt_text, attachments or []),
            }
        ],
    }
    data = json.dumps(payload).encode("utf-8")
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {cfg.api_key}",
        "HTTP-Referer": "https://github.com/remfan1994/ttychatter",
        "X-Title": "ttychatter",
    }
    request = urllib.request.Request(model_endpoint(cfg, model_id), data=data, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            body = response.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        return False, f"OpenRouter HTTP error {exc.code}: {body[:1000]}"
    except urllib.error.URLError as exc:
        return False, f"OpenRouter network error: {exc}"
    except Exception as exc:
        return False, f"OpenRouter request error: {exc}"

    try:
        text = parse_openrouter_text_and_files(body, attachment_dir, session_name)
    except Exception as exc:
        return False, f"OpenRouter response parse error: {exc}; raw response: {body[:1000]}"
    if not text.strip():
        return False, "OpenRouter returned an empty text response"
    return True, text


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def call_ai
# Maintainer note for call_openrouter: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def call_ai(cfg: Config, prompt_text: str, session_name: str, attachment_dir: Path, attachments: List[PendingAttachment]) -> str:
    ok, text = generate_with_model(cfg, cfg.effective_model, prompt_text, session_name, attachment_dir, attachments, timeout=120)
    if ok:
        return text
    return f"({text})"


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def fetch_models
# Network model discovery. This should be called only when the user asks to update/load models,
# not merely because they opened a screen.
# ------------------------------------------------------------
def fetch_models(cfg: Config) -> Tuple[List[ModelInfo], Optional[str]]:
    """Fetch OpenRouter model metadata.

    OpenRouter's model catalog is the legitimate source for model names,
    context lengths, architecture hints, pricing metadata, and provider routing
    information. The UI should prefer cached metadata and only refresh the list
    when the user explicitly asks, because catalog refreshes are network actions.
    """
    if cfg.demo_mode:
        return demo_model_list(), None

    if not cfg.api_key:
        return [], "No OpenRouter API key loaded. Press F3 to paste an API key."

    request = urllib.request.Request(
        "https://openrouter.ai/api/v1/models",
        headers={"Authorization": f"Bearer {cfg.api_key}"},
        method="GET",
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            body = response.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        return [], f"OpenRouter model-list HTTP error {exc.code}: {body[:1000]}"
    except urllib.error.URLError as exc:
        return [], f"OpenRouter model-list network error: {exc}"
    except Exception as exc:
        return [], f"OpenRouter model-list request error: {exc}"

    try:
        parsed = json.loads(body)
    except Exception as exc:
        return [], f"OpenRouter model-list parse error: {exc}; raw response: {body[:1000]}"

    models: List[ModelInfo] = []
    for raw in parsed.get("data", parsed.get("models", [])):
        model_id = str(raw.get("id") or raw.get("name") or "")
        if not model_id:
            continue
        display = str(raw.get("name") or raw.get("display_name") or model_id)
        description = str(raw.get("description") or "")
        context_len = raw.get("context_length") or raw.get("contextLength") or raw.get("inputTokenLimit")
        try:
            input_limit = int(context_len) if context_len is not None else None
        except Exception:
            input_limit = None
        arch = raw.get("architecture") if isinstance(raw.get("architecture"), dict) else {}
        modality = arch.get("modality") or arch.get("input_modalities") or ""
        methods = ["chat.completions"]
        if "image" in str(modality).lower():
            methods.append("image")
        if model_id.startswith("openrouter/"):
            methods.append("router")
        pricing = raw.get("pricing") if isinstance(raw.get("pricing"), dict) else {}
        if model_id.endswith(":free") or model_id == "openrouter/free":
            methods.append("free")
        if pricing:
            description = (description + "\n" if description else "") + "Pricing metadata: " + json.dumps(pricing, sort_keys=True)
        models.append(ModelInfo(
            model_id=model_id,
            api_name=model_id,
            display_name=display,
            description=description,
            input_token_limit=input_limit,
            output_token_limit=None,
            methods=methods,
        ))
    return models, None


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_to_dict
# Maintainer note for model_to_dict: this routine is part of the long-term public behavior of
# the program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_to_dict(model: ModelInfo) -> dict:
    return {
        "model_id": model.model_id,
        "api_name": model.api_name,
        "display_name": model.display_name,
        "description": model.description,
        "input_token_limit": model.input_token_limit,
        "output_token_limit": model.output_token_limit,
        "methods": model.methods,
    }


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_from_dict
# Maintainer note for model_from_dict: this routine is part of the long-term public behavior of
# the program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_from_dict(raw: dict) -> ModelInfo:
    return ModelInfo(
        model_id=str(raw.get("model_id", "")),
        api_name=str(raw.get("api_name", "")),
        display_name=str(raw.get("display_name", raw.get("model_id", ""))),
        description=str(raw.get("description", "")),
        input_token_limit=raw.get("input_token_limit"),
        output_token_limit=raw.get("output_token_limit"),
        methods=list(raw.get("methods", [])),
    )




# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_supports_generate_content
# Maintainer note for model_supports_generate_content: this routine is part of the long-term
# public behavior of the program. When changing it, check callers, documentation, config
# compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_supports_generate_content(model: ModelInfo) -> bool:
    return "chat.completions" in (model.methods or [])


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_token_value
# Maintainer note for model_token_value: this routine is part of the long-term public behavior
# of the program. When changing it, check callers, documentation, config compatibility, session-
# log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_token_value(value: Optional[int]) -> int:
    try:
        if value is None:
            return 0
        return int(value)
    except (TypeError, ValueError):
        return 0


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_has_token_limits
# Maintainer note for model_has_token_limits: this routine is part of the long-term public
# behavior of the program. When changing it, check callers, documentation, config compatibility,
# session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_has_token_limits(model: ModelInfo) -> bool:
    return model_token_value(model.input_token_limit) > 0 and model_token_value(model.output_token_limit) > 0


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_is_preview_or_experimental
# Maintainer note for model_is_preview_or_experimental: this routine is part of the long-term
# public behavior of the program. When changing it, check callers, documentation, config
# compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_is_preview_or_experimental(model: ModelInfo) -> bool:
    text = " ".join([
        model.model_id or "",
        model.display_name or "",
        model.api_name or "",
        model.description or "",
    ]).lower()
    markers = ["preview", "experimental", " exp", "-exp", "_exp", " beta", "-beta", "_beta"]
    return any(marker in text for marker in markers)


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def sort_models_for_browser
# Maintainer note for sort_models_for_browser: this routine is part of the long-term public
# behavior of the program. When changing it, check callers, documentation, config compatibility,
# session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def sort_models_for_browser(models: List[ModelInfo], sort_mode: str) -> List[ModelInfo]:
    if sort_mode == "input":
        return sorted(models, key=lambda m: (model_token_value(m.input_token_limit), m.model_id.lower()), reverse=True)
    if sort_mode == "output":
        return sorted(models, key=lambda m: (model_token_value(m.output_token_limit), m.model_id.lower()), reverse=True)
    if sort_mode == "display":
        return sorted(models, key=lambda m: ((m.display_name or m.model_id).lower(), m.model_id.lower()))
    return sorted(models, key=lambda m: m.model_id.lower())


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def save_model_cache
# Stores the model list locally so ordinary navigation does not ping OpenRouter. Cache files are not
# authoritative; they are convenience snapshots.
# ------------------------------------------------------------
def save_model_cache(cfg: Config, models: List[ModelInfo]) -> None:
    cfg.model_cache_file.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "updated_at": datetime.now().isoformat(timespec="seconds"),
        "models": [model_to_dict(model) for model in models],
    }
    cfg.model_cache_file.write_text(json.dumps(payload, indent=2), encoding="utf-8")


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def load_model_cache
# Reads cached model metadata. If the cache is stale or missing, present that fact clearly
# rather than quietly forcing a network call.
# ------------------------------------------------------------
def load_model_cache(cfg: Config) -> Tuple[List[ModelInfo], Optional[str], str]:
    if not cfg.model_cache_file.exists():
        return [], "No cached model list found. Use 'Load/update model list from OpenRouter' first.", ""
    try:
        raw = json.loads(cfg.model_cache_file.read_text(encoding="utf-8", errors="replace"))
        models = [model_from_dict(item) for item in raw.get("models", [])]
        models = [model for model in models if model.model_id]
        updated_at = str(raw.get("updated_at", "unknown time"))
    except Exception as exc:
        return [], f"Could not read model cache: {exc}", ""
    if not models:
        return [], "Cached model list is empty. Use 'Load/update model list from OpenRouter'.", updated_at
    return models, None, updated_at


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_has_preview_marker
# Maintainer note for model_has_preview_marker: this routine is part of the long-term public
# behavior of the program. When changing it, check callers, documentation, config compatibility,
# session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_has_preview_marker(model: ModelInfo) -> bool:
    haystack = " ".join([model.model_id, model.display_name, model.description]).lower()
    markers = ("preview", "experimental", " exp", "-exp", "_exp", " beta", "-beta", "_beta")
    return any(marker in haystack for marker in markers)


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def apply_model_filters
# Filters model metadata for usability. This is the preferred alternative to autoscan/probing;
# use capabilities and token limits before testing a selected model.
# ------------------------------------------------------------
def apply_model_filters(models: List[ModelInfo], model_filter: ModelFilter) -> List[ModelInfo]:
    filtered: List[ModelInfo] = []

    for model in models:
        input_limit = model.input_token_limit or 0
        output_limit = model.output_token_limit or 0

        if model_filter.require_token_limits and (input_limit <= 0 or output_limit <= 0):
            continue
        if input_limit < model_filter.min_input_tokens:
            continue
        if output_limit < model_filter.min_output_tokens:
            continue
        if model_filter.hide_preview_or_experimental and model_has_preview_marker(model):
            continue

        filtered.append(model)

    if model_filter.sort_mode == "model":
        filtered.sort(key=lambda item: item.model_id)
    elif model_filter.sort_mode == "input-desc":
        filtered.sort(key=lambda item: (item.input_token_limit or 0, item.model_id), reverse=True)
    elif model_filter.sort_mode == "output-desc":
        filtered.sort(key=lambda item: (item.output_token_limit or 0, item.model_id), reverse=True)

    return filtered


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def describe_model_filter
# Maintainer note for describe_model_filter: this routine is part of the long-term public
# behavior of the program. When changing it, check callers, documentation, config compatibility,
# session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def describe_model_filter(model_filter: ModelFilter) -> str:
    parts = []
    if model_filter.require_token_limits:
        parts.append("token limits required")
    if model_filter.hide_preview_or_experimental:
        parts.append("preview/experimental hidden")
    if model_filter.min_input_tokens > 1:
        parts.append(f"min input {model_filter.min_input_tokens}")
    if model_filter.min_output_tokens > 1:
        parts.append(f"min output {model_filter.min_output_tokens}")
    if model_filter.sort_mode != "api":
        parts.append(f"sort {model_filter.sort_mode}")
    return ", ".join(parts) if parts else "no extra filters"


# ---------------------------------------------------------------------------
# Model metadata filtering
# ---------------------------------------------------------------------------
# These filters use listModels metadata (supportedGenerationMethods, token
# limits, model names/descriptions) instead of probing every model. This is
# the preferred model-selection path. The separate model tester remains
# available for one user-selected model.
# ---------------------------------------------------------------------------


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_token_value
# Maintainer note for model_token_value: this routine is part of the long-term public behavior
# of the program. When changing it, check callers, documentation, config compatibility, session-
# log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_token_value(value: Optional[int]) -> int:
    try:
        if value is None:
            return 0
        return int(value)
    except Exception:
        return 0


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_supports_generate_content
# Maintainer note for model_supports_generate_content: this routine is part of the long-term
# public behavior of the program. When changing it, check callers, documentation, config
# compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_supports_generate_content(model: ModelInfo) -> bool:
    return "chat.completions" in (model.methods or [])


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_has_required_token_limits
# Maintainer note for model_has_required_token_limits: this routine is part of the long-term
# public behavior of the program. When changing it, check callers, documentation, config
# compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_has_required_token_limits(model: ModelInfo) -> bool:
    return model_token_value(model.input_token_limit) > 0 and model_token_value(model.output_token_limit) > 0


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_looks_preview
# Maintainer note for model_looks_preview: this routine is part of the long-term public behavior
# of the program. When changing it, check callers, documentation, config compatibility, session-
# log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_looks_preview(model: ModelInfo) -> bool:
    text = " ".join([model.model_id or "", model.display_name or "", model.api_name or "", model.description or ""]).lower()
    return any(token in text for token in ["preview", "experimental", " exp", "-exp", "_exp", " beta", "-beta", "_beta"])

# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_type_label
# OpenRouter exposes both fixed model IDs and router-like aliases.  A fixed
# model is a concrete provider/model route, while entries such as
# openrouter/auto and openrouter/free are routing directives.  This function
# keeps that distinction visible in the model browser without pretending the
# list API exposes a perfect formal type field.  Future provider ports should
# preserve the same conceptual distinction: fixed endpoints are not the same as
# routers, aliases, or provider-defined pools.
# ------------------------------------------------------------
def model_type_label(model: ModelInfo) -> str:
    mid = (model.model_id or "").lower()
    methods = {item.lower() for item in (model.methods or [])}
    if mid == "openrouter/auto":
        return "auto"
    if mid == "openrouter/free" or mid.endswith(":free") or "free" in methods:
        return "free"
    if mid.startswith("openrouter/") or "router" in methods:
        return "router"
    return "fixed"


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_matches_type_filter
# The model-type filter is intentionally not a pricing or quality filter.  It
# is a navigation aid.  Users asked to distinguish router entries such as
# openrouter/auto and openrouter/free from fixed models.  Keep this function
# conservative and obvious; do not infer costs or hidden capabilities here.
# ------------------------------------------------------------
def model_matches_type_filter(model: ModelInfo, type_filter: str) -> bool:
    kind = model_type_label(model)
    if type_filter == "all":
        return True
    if type_filter == "routers":
        return kind in {"router", "free", "auto"}
    if type_filter == "fixed":
        return kind == "fixed"
    if type_filter == "free":
        return kind == "free"
    if type_filter == "auto":
        return kind == "auto"
    return True



# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def sort_model_list
# Maintainer note for sort_model_list: this routine is part of the long-term public behavior of
# the program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def sort_model_list(cfg: Config, models: List[ModelInfo]) -> List[ModelInfo]:
    if cfg.model_sort_order == "name":
        return sorted(models, key=lambda model: model.model_id.lower())
    if cfg.model_sort_order == "display":
        return sorted(models, key=lambda model: (model.display_name or model.model_id).lower())
    if cfg.model_sort_order == "input-desc":
        return sorted(models, key=lambda model: (model_token_value(model.input_token_limit), model.model_id.lower()), reverse=True)
    if cfg.model_sort_order == "output-desc":
        return sorted(models, key=lambda model: (model_token_value(model.output_token_limit), model.model_id.lower()), reverse=True)
    if cfg.model_sort_order == "type":
        return sorted(models, key=lambda model: (model_type_label(model), model.model_id.lower()))
    return list(models)


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def filter_model_list
# Maintainer note for filter_model_list: this routine is part of the long-term public behavior
# of the program. When changing it, check callers, documentation, config compatibility, session-
# log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def filter_model_list(cfg: Config, models: List[ModelInfo]) -> List[ModelInfo]:
    filtered = list(models)
    if cfg.model_filter_chat_completions:
        filtered = [model for model in filtered if model_supports_generate_content(model)]
    if cfg.model_filter_require_tokens:
        filtered = [model for model in filtered if model_has_required_token_limits(model)]
    if cfg.model_filter_hide_preview:
        filtered = [model for model in filtered if not model_looks_preview(model)]
    if cfg.model_min_input_tokens > 0:
        filtered = [model for model in filtered if model_token_value(model.input_token_limit) >= cfg.model_min_input_tokens]
    if cfg.model_min_output_tokens > 0:
        filtered = [model for model in filtered if model_token_value(model.output_token_limit) >= cfg.model_min_output_tokens]
    if cfg.model_type_filter != "all":
        filtered = [model for model in filtered if model_matches_type_filter(model, cfg.model_type_filter)]
    return sort_model_list(cfg, filtered)


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_filter_summary
# Maintainer note for model_filter_summary: this routine is part of the long-term public
# behavior of the program. When changing it, check callers, documentation, config compatibility,
# session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_filter_summary(cfg: Config, before_count: int, after_count: int) -> str:
    flags = []
    if cfg.model_filter_chat_completions:
        flags.append("chat.completions")
    if cfg.model_filter_require_tokens:
        flags.append("token limits")
    if cfg.model_filter_hide_preview:
        flags.append("hide preview/experimental")
    flags.append(f"min input:{cfg.model_min_input_tokens}")
    flags.append(f"min output:{cfg.model_min_output_tokens}")
    if cfg.model_type_filter != "all":
        flags.append(f"type:{cfg.model_type_filter}")
    flags.append(f"sort:{cfg.model_sort_order}")
    return f"Showing {after_count}/{before_count} models | " + ", ".join(flags)


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def model_badges
# Maintainer note for model_badges: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def model_badges(model: ModelInfo) -> str:
    badges = [model_type_label(model)]
    if model_supports_generate_content(model):
        badges.append("gen")
    if model_has_required_token_limits(model):
        badges.append("tokens")
    if model_looks_preview(model):
        badges.append("preview")
    return "/".join(badges) or "metadata"


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def print_model_rows
# Maintainer note for print_model_rows: this routine is part of the long-term public behavior of
# the program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def print_model_rows(models: List[ModelInfo]) -> None:
    for model in models:
        print(
            f"{model.model_id}\t"
            f"{model.display_name or model.model_id}\t"
            f"input:{model.input_token_limit or '?'}\t"
            f"output:{model.output_token_limit or '?'}\t"
            f"type:{model_type_label(model)}\t"
            f"{model_badges(model)}"
        )


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def update_models_command
# Maintainer note for update_models_command: this routine is part of the long-term public
# behavior of the program. When changing it, check callers, documentation, config compatibility,
# session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def update_models_command(cfg: Config) -> int:
    models, error = fetch_models(cfg)
    if error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1
    save_model_cache(cfg, models)
    visible = filter_model_list(cfg, models)
    print(f"# updated cache: {cfg.model_cache_file}", file=sys.stderr)
    print(f"# {model_filter_summary(cfg, len(models), len(visible))}", file=sys.stderr)
    print_model_rows(visible)
    return 0


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def print_models
# Maintainer note for print_models: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def print_models(cfg: Config, update: bool = False) -> int:
    if update:
        models, error = fetch_models(cfg)
        if error:
            print(f"ERROR: {error}", file=sys.stderr)
            return 1
        save_model_cache(cfg, models)
    else:
        models, error, _updated_at = load_model_cache(cfg)
        if error:
            models, error = fetch_models(cfg)
            if error:
                print(f"ERROR: {error}", file=sys.stderr)
                return 1
            save_model_cache(cfg, models)

    visible = filter_model_list(cfg, models)
    print(f"# {model_filter_summary(cfg, len(models), len(visible))}", file=sys.stderr)
    for model in visible:
        print(
            f"{model.model_id}\t{model.display_name or model.model_id}\t"
            f"input:{model.input_token_limit or '?'}\toutput:{model.output_token_limit or '?'}\t"
            f"methods:{','.join(model.methods or [])}"
        )
    return 0


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def print_model_test
# Maintainer note for print_model_test: this routine is part of the long-term public behavior of
# the program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def print_model_test(cfg: Config, model_id: str) -> int:
    attachment_dir = cfg.effective_attachment_dir
    ok, text = generate_with_model(cfg, model_id, cfg.model_test_prompt, "model-test", attachment_dir, [], timeout=60)
    print("MODEL TEST PROMPT:")
    print(cfg.model_test_prompt)
    print("\nMODEL RESPONSE:")
    print(text)
    return 0 if ok else 1


# ---------------------------------------------------------------------------
# Session logs and context snapshots
# ---------------------------------------------------------------------------


ENTRY_RE = re.compile(r"^\[(\d{2}:\d{2}:\d{2})\] ([^:]+): (.*)$")
SNAPSHOT_PREFIX = "CONTEXT_SNAPSHOT_JSON "


@dataclass
# ------------------------------------------------------------
# MAINTAINER COMMENTARY: class LogEntry
# Maintainer note for LogEntry: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
class LogEntry:
    timestamp: str
    speaker: str
    text: str


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def now_time
# Maintainer note for now_time: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def now_time() -> str:
    return datetime.now().strftime("%H:%M:%S")


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def append_log
# Maintainer note for append_log: this routine is part of the long-term public behavior of the
# program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def append_log(path: Path, speaker: str, text: str, timestamp: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(f"[{timestamp}] {speaker}: {text}\n")


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def append_context_snapshot
# Maintainer note for append_context_snapshot: this routine is part of the long-term public
# behavior of the program. When changing it, check callers, documentation, config compatibility,
# session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def append_context_snapshot(path: Path, context_buffer: List[str]) -> None:
    snapshot = SNAPSHOT_PREFIX + json.dumps(context_buffer, ensure_ascii=False)
    append_log(path, "system", snapshot, now_time())


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def is_snapshot_entry
# Maintainer note for is_snapshot_entry: this routine is part of the long-term public behavior
# of the program. When changing it, check callers, documentation, config compatibility, session-
# log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def is_snapshot_entry(entry: LogEntry) -> bool:
    return entry.speaker == "system" and entry.text.startswith(SNAPSHOT_PREFIX)


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def load_log_entries
# Parses the human-readable session log. The log format is part of the project contract; change
# it cautiously and preserve backward compatibility.
# ------------------------------------------------------------
def load_log_entries(path: Path) -> List[LogEntry]:
    if not path.exists():
        return []

    entries: List[LogEntry] = []
    current_timestamp: Optional[str] = None
    current_speaker: Optional[str] = None
    current_lines: List[str] = []

    with path.open("r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.rstrip("\n")
            match = ENTRY_RE.match(line)
            if match:
                if current_speaker is not None and current_timestamp is not None:
                    entries.append(LogEntry(current_timestamp, current_speaker, "\n".join(current_lines)))
                current_timestamp = match.group(1)
                current_speaker = match.group(2)
                current_lines = [match.group(3)]
            else:
                if current_speaker is not None:
                    current_lines.append(line)

    if current_speaker is not None and current_timestamp is not None:
        entries.append(LogEntry(current_timestamp, current_speaker, "\n".join(current_lines)))

    return entries


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def latest_context_snapshot
# Finds saved memory snapshots. This lets resumed sessions restore context without replaying
# every line in a long log.
# ------------------------------------------------------------
def latest_context_snapshot(entries: List[LogEntry]) -> Optional[List[str]]:
    for entry in reversed(entries):
        if not is_snapshot_entry(entry):
            continue
        raw = entry.text[len(SNAPSHOT_PREFIX):]
        try:
            value = json.loads(raw)
        except Exception:
            continue
        if isinstance(value, list) and all(isinstance(item, str) for item in value):
            return value
    return None


# ---------------------------------------------------------------------------
# Attachment extraction
# ---------------------------------------------------------------------------


EXT_MAP = {
    "bash": ".sh", "sh": ".sh", "shell": ".sh", "python": ".py", "py": ".py",
    "json": ".json", "yaml": ".yml", "yml": ".yml", "javascript": ".js", "js": ".js",
    "html": ".html", "css": ".css", "sql": ".sql", "c": ".c", "cpp": ".cpp",
    "c++": ".cpp", "text": ".txt",
}
FENCE_RE = re.compile(r"```([A-Za-z0-9_+.#-]*)[ \t]*\n(.*?)```", re.DOTALL)


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def safe_attachment_tag
# Maintainer note for safe_attachment_tag: this routine is part of the long-term public behavior
# of the program. When changing it, check callers, documentation, config compatibility, session-
# log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def safe_attachment_tag(lang: str) -> str:
    lang = lang.strip().lower() or "text"
    lang = lang.replace("+", "p").replace("#", "sharp")
    lang = re.sub(r"[^A-Za-z0-9._-]+", "_", lang)
    return lang or "text"


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def next_attachment_number
# Maintainer note for next_attachment_number: this routine is part of the long-term public
# behavior of the program. When changing it, check callers, documentation, config compatibility,
# session-log compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def next_attachment_number(attachment_dir: Path, session_name: str, lang: str, ext: str) -> int:
    pattern = re.compile(rf"^{re.escape(session_name)}-{re.escape(lang)}-(\d{{2,}}){re.escape(ext)}$")
    highest = 0
    for path in attachment_dir.glob(f"{session_name}-{lang}-*{ext}"):
        match = pattern.match(path.name)
        if match:
            highest = max(highest, int(match.group(1)))
    return highest + 1


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def extract_code_attachments
# This function is the boundary between raw model text and display-safe transcript text.
# It is deliberately conservative: the session log keeps the original response, while the
# visible transcript receives either the original fenced code block for short examples or
# a small attachment notice for long blocks.  The function exists so demo mode and real
# provider mode follow the same path; otherwise a bug could hide until a user sends an
# actual network request.  Maintainers should be careful not to make the regex greedy,
# because a greedy fence parser can swallow normal prose after a code block.
# ------------------------------------------------------------
def extract_code_attachments(text: str, attachment_dir: Path, session_name: str, min_lines: int = 5) -> str:
    """Extract only long fenced code blocks into attachment files.

    Short code snippets are often part of normal prose and should remain in the
    transcript. Long blocks are better saved as files. The regex is deliberately
    conservative and non-greedy; malformed fences stay in the transcript instead
    of risking destructive over-extraction.
    """
    attachment_dir.mkdir(parents=True, exist_ok=True)

    def replacement(match: re.Match[str]) -> str:
        raw_lang = match.group(1).strip().lower() or "text"
        content = match.group(2)
        nonempty_lines = [line for line in content.splitlines() if line.strip()]
        if len(nonempty_lines) < max(1, min_lines):
            return match.group(0)
        lang = safe_attachment_tag(raw_lang)
        ext = EXT_MAP.get(raw_lang, EXT_MAP.get(lang, ".txt"))
        number = next_attachment_number(attachment_dir, session_name, lang, ext)
        filename = f"{session_name}-{lang}-{number:02d}{ext}"
        path = attachment_dir / filename
        path.write_text(content, encoding="utf-8")
        return f"\n[code attachment saved]\nfile: {filename}\nlines: {len(content.splitlines())}\nlocation: {attachment_dir}\n"

    return FENCE_RE.sub(replacement, text)


# ---------------------------------------------------------------------------
# Text wrapping and transcript items
# ---------------------------------------------------------------------------


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def wrap_for_width
# Maintainer note for wrap_for_width: this routine is part of the long-term public behavior of
# the program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
def wrap_for_width(text: str, width: int) -> List[str]:
    width = max(1, width)
    result: List[str] = []
    for paragraph in text.splitlines() or [""]:
        if paragraph == "":
            result.append("")
        else:
            result.extend(
                textwrap.wrap(
                    paragraph,
                    width=width,
                    replace_whitespace=False,
                    drop_whitespace=False,
                    break_long_words=True,
                    break_on_hyphens=False,
                )
            )
    return result or [""]


@dataclass
# ------------------------------------------------------------
# MAINTAINER COMMENTARY: class TranscriptItem
# Maintainer note for TranscriptItem: this routine is part of the long-term public behavior of
# the program. When changing it, check callers, documentation, config compatibility, session-log
# compatibility, and the parallel Bash/C implementation plans.
# ------------------------------------------------------------
class TranscriptItem:
    speaker: str
    text: str
    timestamp: str = field(default_factory=now_time)


@dataclass
