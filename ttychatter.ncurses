class InputSegment:
    display: str
    logical_row: int
    start: int
    available: int


# ---------------------------------------------------------------------------
# Curses application
# ---------------------------------------------------------------------------


# ------------------------------------------------------------
# MAINTAINER COMMENTARY: class AICursesApp
# Main ncurses application object. It owns UI state, transcript state, input state, and
# navigation. Keep external API/config/storage helpers outside when possible so the future C
# implementation can mirror the architecture.
# ------------------------------------------------------------
class AICursesApp:
    INPUT_HEIGHT = 6
    TRANSCRIPT_REPLAY_LIMIT = 80

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def __init__
    # Maintainer note for __init__: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def __init__(self, cfg: Config, session_name: str, session_path: Path):
        self.cfg = cfg
        self.session_name = session_name
        self.session_path = session_path
        self.attachment_dir = cfg.effective_attachment_dir
        self.username = os.environ.get("USER") or os.environ.get("LOGNAME") or "user"

        self.context_buffer: List[str] = []
        self.transcript: List[TranscriptItem] = []
        self.transcript_scroll = 0
        self.pending_attachments: List[PendingAttachment] = []

        # Model-selector filters use metadata from the model list, not probe
        # requests. They are initialized from config, then can be adjusted in
        # the F2 model-filter menu for the current run.
        self.model_filter = ModelFilter(
            require_token_limits=cfg.model_filter_require_tokens,
            hide_preview_or_experimental=cfg.model_filter_hide_preview,
            min_input_tokens=cfg.model_min_input_tokens,
            min_output_tokens=cfg.model_min_output_tokens,
            sort_mode=cfg.model_sort_order if cfg.model_sort_order in {"api", "model", "input-desc", "output-desc"} else "api",
        )

        self.input_lines: List[str] = [""]
        self.cursor_row = 0
        self.cursor_col = 0
        self.input_scroll = 0

        self.layout: dict[str, int] = {}
        self.last_input_segments: List[InputSegment] = []
        self.command_hotspots: List[Tuple[int, int, int, str]] = []
        self.command_click_targets: List[Tuple[int, int, str]] = []

        self.status = self.default_status()
        self.should_quit = False
        self.startup_notice_active = False
        self.first_user_message_sent = False

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def default_status
    # Maintainer note for default_status: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def default_status(self) -> str:
        return "F1 Menu | Ctrl+G Send | F10 Quit"

    # ------------------------------------------------------------------
    # Context memory
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def load_session_into_ui
    # Maintainer note for load_session_into_ui: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def load_session_into_ui(self) -> None:
        entries = load_log_entries(self.session_path)
        if not entries:
            self.maybe_show_startup_notice()
            return

        for entry in entries[-self.TRANSCRIPT_REPLAY_LIMIT:]:
            if is_snapshot_entry(entry):
                continue
            self.transcript.append(TranscriptItem(entry.speaker, entry.text, entry.timestamp))

        snapshot = latest_context_snapshot(entries)
        if snapshot is not None:
            self.context_buffer = snapshot
        else:
            max_entries = self.cfg.context_turns * 2
            for entry in entries[-max_entries:]:
                if is_snapshot_entry(entry) or entry.speaker == "system":
                    continue
                if entry.speaker == "AI":
                    self.context_buffer.append("Assistant: " + entry.text)
                else:
                    self.context_buffer.append("User: " + entry.text)

        self.trim_context_buffer()
        self.status = f"loaded session: {self.session_name}"

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def reset_to_session
    # Maintainer note for reset_to_session: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def reset_to_session(self, session_name: str, session_path: Path) -> None:
        self.session_name = session_name
        self.session_path = session_path
        self.transcript = []
        self.context_buffer = []
        self.transcript_scroll = 0
        self.startup_notice_active = False
        self.first_user_message_sent = False
        self.load_session_into_ui()

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def trim_context_buffer
    # Maintainer note for trim_context_buffer: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def trim_context_buffer(self) -> None:
        max_entries = self.cfg.context_turns * 2
        if len(self.context_buffer) > max_entries:
            self.context_buffer = self.context_buffer[-max_entries:]

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def build_context
    # Maintainer note for build_context: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def build_context(self) -> str:
        return "\n".join(self.context_buffer)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def save_context_snapshot
    # Maintainer note for save_context_snapshot: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def save_context_snapshot(self) -> None:
        append_context_snapshot(self.session_path, self.context_buffer)

    # ------------------------------------------------------------------
    # Curses drawing and style helpers
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def dim_attr
    # Maintainer note for dim_attr: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def dim_attr(self) -> int:
        """Return the subdued text style for the active theme.

        This is not just cosmetic.  ttychatter uses dim/normal/reverse as a
        semantic map: AI output and metadata recede, user input stays readable,
        and selections remain obvious.  Terminals differ wildly, so this helper
        keeps all dimming decisions in one place.  The theme names are deliberately
        simple; they are behavior profiles rather than a promise of exact RGB
        colors on every terminal.
        """
        if self.cfg.monochrome or self.cfg.theme == "mono":
            return 0
        if self.cfg.theme == "high_contrast":
            return curses.A_BOLD
        if self.cfg.theme == "solarized_dark":
            return curses.A_DIM
        if self.cfg.theme == "dim":
            return curses.A_DIM
        return curses.A_DIM

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def reverse_attr
    # Main selection/header style.  Reverse video is the most portable way to
    # make something look selected in a text terminal because it does not depend
    # on a particular color palette.  High-contrast mode adds bold so selected
    # rows remain clear even on dim displays.
    # ------------------------------------------------------------
    def reverse_attr(self) -> int:
        if self.cfg.theme == "high_contrast":
            return curses.A_REVERSE | curses.A_BOLD
        return curses.A_REVERSE

    def reverse_dim_attr(self) -> int:
        """Reverse-video style used for secondary bars.

        Header bars should be visually stronger than middle command bars or
        table headings.  This helper gives the secondary bars a lower-weight
        appearance when the terminal supports A_DIM.  In monochrome mode it
        falls back to plain reverse video so information is not hidden.
        """
        if self.cfg.monochrome or self.cfg.theme in {"mono", "high_contrast"}:
            return self.reverse_attr()
        return curses.A_REVERSE | curses.A_DIM

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def attr_header
    # Maintainer note for attr_header: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def attr_header(self) -> int:
        # Compatibility helper for menus that use header-style reverse video.
        return self.reverse_attr()

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def attr_dim
    # Maintainer note for attr_dim: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def attr_dim(self) -> int:
        # Compatibility helper for menus that use dim/grey metadata styling.
        return self.dim_attr()

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def transcript_attr_for
    # Maintainer note for transcript_attr_for: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def transcript_attr_for(self, speaker: str) -> int:
        """Map transcript speakers to theme roles.

        The visible conversation has two different jobs: it must be pleasant to
        read, and it must make ownership of each message unmistakable.  The user
        asked for the active user's messages to stay bright/normal while AI and
        system text sits back in grey/dim.  High-contrast and mono modes keep the
        same ownership distinction through labels even when dimming is disabled.
        """
        if self.cfg.monochrome or self.cfg.theme == "mono":
            return 0
        if speaker in {"OpenRouter", "AI"}:
            return curses.A_BOLD if self.cfg.theme == "high_contrast" else self.dim_attr()
        if speaker == self.username:
            return curses.A_BOLD if self.cfg.theme == "high_contrast" else 0
        if speaker == "remfan1994" or speaker == "system":
            return self.dim_attr()
        return 0

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def maybe_show_startup_notice
    # Maintainer note for maybe_show_startup_notice: this routine is part of the long-term
    # public behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def maybe_show_startup_notice(self) -> None:
        if not self.cfg.startup_notice:
            return
        self.startup_notice_active = True
        self.transcript.append(TranscriptItem("remfan1994", PROJECT_NOTICE, now_time()))
        self.transcript.append(TranscriptItem("system", "Message list window: the notice above disappears when you start chatting, and messages to and from the AI will appear here. Press Ctrl+G or Enter according to SEND_INPUT to send.", now_time()))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def remove_startup_notice
    # Maintainer note for remove_startup_notice: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def remove_startup_notice(self) -> None:
        if not self.startup_notice_active:
            return
        self.transcript = [
            item for item in self.transcript
            if not ((item.speaker == "remfan1994" and item.text == PROJECT_NOTICE) or (item.speaker == "system" and item.text.startswith("Message list window:")))
        ]
        self.startup_notice_active = False

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def safe_addstr
    #
    # This is the small drawing primitive that almost every screen uses.  It
    # deserves more explanation than a normal wrapper because terminal drawing
    # bugs are among the hardest defects for future maintainers to reproduce.
    #
    # Curses draws by absolute cell coordinates: y is the row, x is the column,
    # both starting at zero.  On many terminals, writing to the final cell of
    # the final row can trigger an implicit scroll or raise curses.error.  The
    # earliest ttychatter builds avoided that by never writing the final column
    # anywhere.  That prevented bottom-right crashes, but it also made users
    # with large fonts / low resolutions see every line clipped by one visible
    # character.  The current compromise reserves the last cell ONLY on the
    # bottom row.  Everywhere else, the full line width is usable.
    #
    # If a porter rewrites the UI for another toolkit, this function is the
    # place to preserve the "do not explode at the terminal edge" rule without
    # globally stealing a column from all text.
    # ------------------------------------------------------------
    def safe_addstr(self, y: int, x: int, text: str, max_width: Optional[int] = None, attr: int = 0) -> None:
        height, width = self.stdscr.getmaxyx()
        if y < 0 or y >= height or x < 0 or x >= width:
            return
        limit = width - x
        if max_width is not None:
            limit = min(limit, max_width)
        if y == height - 1:
            limit = max(0, limit - 1)
        if limit <= 0:
            return
        try:
            self.stdscr.addstr(y, x, text[:limit], attr)
        except curses.error:
            pass

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def transcript_display_lines
    # Maintainer note for transcript_display_lines: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def transcript_display_lines(self, width: int) -> List[Tuple[str, int]]:
        lines: List[Tuple[str, int]] = []
        for item in self.transcript:
            attr = self.transcript_attr_for(item.speaker)
            attr_prefix = "[system] " if item.speaker == "system" else ""
            prefix = f"[{item.timestamp}] {item.speaker}: {attr_prefix}"
            for wrapped in wrap_for_width(prefix + item.text, width):
                lines.append((wrapped, attr))
            lines.append(("", 0))
        return lines

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def model_label
    # Maintainer note for model_label: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def model_label(self) -> str:
        if self.cfg.model:
            return self.cfg.model
        return f"{FALLBACK_MODEL} (fallback)"

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def draw_header
    # Maintainer note for draw_header: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def draw_header(self, width: int) -> None:
        key_state = "key:loaded" if self.cfg.api_key else "key:missing"
        attach_state = f" files:{len(self.pending_attachments)}" if self.pending_attachments else ""
        mode_state = " ~DEMO~" if self.cfg.demo_mode else ""
        header = f"{PROGRAM}{mode_state} | {self.session_name} | {self.model_label()} | {key_state}{attach_state}"
        self.safe_addstr(0, 0, header, width, self.reverse_attr())
        self.safe_addstr(1, 0, "_" * width, width, self.dim_attr())

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def draw_transcript
    # Maintainer note for draw_transcript: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def draw_transcript(self, start_y: int, height: int, width: int) -> None:
        lines = self.transcript_display_lines(width)
        max_scroll = max(0, len(lines) - height)
        self.transcript_scroll = min(self.transcript_scroll, max_scroll)
        start = max(0, len(lines) - height - self.transcript_scroll)
        visible = lines[start : start + height]
        for offset in range(height):
            if offset < len(visible):
                text, attr = visible[offset]
                self.safe_addstr(start_y + offset, 0, text, width, attr)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def input_segments
    # Maintainer note for input_segments: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def input_segments(self, width: int) -> Tuple[List[InputSegment], int, int]:
        marker_width = 2
        available = max(1, width - marker_width)
        segments: List[InputSegment] = []
        cursor_visual_index = 0
        cursor_x = marker_width

        for logical_row, line in enumerate(self.input_lines):
            cursor_segment = self.cursor_col // available if logical_row == self.cursor_row else 0
            segment_count = max(1, (len(line) + available - 1) // available)
            if logical_row == self.cursor_row:
                segment_count = max(segment_count, cursor_segment + 1)

            for segment in range(segment_count):
                start = segment * available
                marker = "> " if logical_row == 0 and segment == 0 else "  "
                chunk = line[start : start + available]
                segments.append(InputSegment(marker + chunk, logical_row, start, available))
                if logical_row == self.cursor_row and segment == cursor_segment:
                    cursor_visual_index = len(segments) - 1
                    cursor_x = marker_width + (self.cursor_col % available)

        return segments or [InputSegment("> ", 0, 0, max(1, width - 2))], cursor_visual_index, cursor_x

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def command_bar_items
    # Maintainer note for command_bar_items: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def command_bar_items(self) -> List[Tuple[str, str]]:
        return [
            ("F1 Help", "help"),
            ("F2 Models", "models"),
            ("F3 Key", "api-key"),
            ("F4 Sessions", "sessions"),
            ("F5 Options", "options"),
            ("F6 Memory", "memory"),
            ("F7 Files", "files"),
            ("F8 Editor", "editor"),
            ("F9 Credits", "credits"),
        ]

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def draw_command_bar
    # Maintainer note for draw_command_bar: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def draw_command_bar(self, y: int, width: int) -> None:
        # The command bar must remain useful even on narrow terminal windows.
        # Earlier versions tried to print every F-key label on one line and
        # simply clipped the text. That worked on wide terminals but looked
        # broken on Chromebook/Crostini windows with large fonts. The command
        # bar now has a compact fallback: on narrow screens it shows only the
        # essentials (F1 help, the configured send key, and F10 quit). F1 then
        # acts as the complete command launcher. Visible labels remain clickable
        # so mouse users are not punished for the compact layout.
        self.command_click_targets = []
        self.safe_addstr(y, 0, "_" * width, width, self.dim_attr())
        if width < 72:
            items = [("F1 Menu", "help"), (f"Send:{self.cfg.send_input}", "send"), ("F10 Quit", "quit")]
        else:
            items = self.command_bar_items()
        x = 0
        for idx, (label, action) in enumerate(items):
            text = label if idx == 0 else " | " + label
            if x + len(text) >= width:
                if x + 4 < width:
                    self.safe_addstr(y, x, " ...", width - x, self.dim_attr())
                break
            self.safe_addstr(y, x, text, width - x, self.dim_attr())
            label_start = x + (3 if idx else 0)
            label_end = label_start + len(label)
            self.command_click_targets.append((label_start, label_end, action))
            x += len(text)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def draw_input
    # Maintainer note for draw_input: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def draw_input(self, label_y: int, input_y: int, width: int) -> None:
        self.draw_command_bar(label_y, width)

        segments, cursor_visual_index, cursor_x = self.input_segments(width)
        self.last_input_segments = segments
        if cursor_visual_index < self.input_scroll:
            self.input_scroll = cursor_visual_index
        elif cursor_visual_index >= self.input_scroll + self.INPUT_HEIGHT:
            self.input_scroll = cursor_visual_index - self.INPUT_HEIGHT + 1
        self.input_scroll = max(0, min(self.input_scroll, max(0, len(segments) - self.INPUT_HEIGHT)))

        if self.current_input() == "":
            placeholder = "> " + self.cfg.input_placeholder
            self.safe_addstr(input_y, 0, placeholder, width, self.dim_attr())
            for offset in range(1, self.INPUT_HEIGHT):
                self.safe_addstr(input_y + offset, 0, "", width)
            try:
                curses.curs_set(1)
                self.stdscr.move(input_y, 2)
            except curses.error:
                pass
            return

        visible = segments[self.input_scroll : self.input_scroll + self.INPUT_HEIGHT]
        for offset in range(self.INPUT_HEIGHT):
            text = visible[offset].display if offset < len(visible) else ""
            self.safe_addstr(input_y + offset, 0, text, width)

        cursor_screen_y = input_y + cursor_visual_index - self.input_scroll
        try:
            curses.curs_set(1)
            self.stdscr.move(cursor_screen_y, min(cursor_x, width - 2))
        except curses.error:
            pass

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def draw_status
    # Maintainer note for draw_status: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def draw_status(self, y: int, width: int) -> None:
        self.safe_addstr(y, 0, "_" * width, width, self.dim_attr())
        self.safe_addstr(y, 0, self.status, width, self.reverse_attr())

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def draw
    # Maintainer note for draw: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def draw(self) -> None:
        self.stdscr.erase()
        height, width = self.stdscr.getmaxyx()
        min_height = self.INPUT_HEIGHT + 6
        if height < min_height or width < 40:
            self.layout = {}
            self.safe_addstr(0, 0, "terminal too small", width, self.reverse_attr())
            self.stdscr.refresh()
            return

        header_h = 2
        status_h = 1
        input_label_h = 1
        transcript_h = height - header_h - input_label_h - self.INPUT_HEIGHT - status_h
        transcript_y = header_h
        input_label_y = transcript_y + transcript_h
        input_y = input_label_y + input_label_h
        status_y = height - 1
        self.layout = {
            "width": width,
            "height": height,
            "transcript_y": transcript_y,
            "transcript_h": transcript_h,
            "input_label_y": input_label_y,
            "command_y": input_label_y,
            "input_y": input_y,
            "input_h": self.INPUT_HEIGHT,
            "status_y": status_y,
        }
        self.draw_header(width)
        self.draw_transcript(transcript_y, transcript_h, width)
        self.draw_input(input_label_y, input_y, width)
        self.draw_status(status_y, width)
        self.stdscr.refresh()

    # ------------------------------------------------------------------
    # Mouse handling
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def mouse_wheel_delta
    # Maintainer note for mouse_wheel_delta: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def mouse_wheel_delta(self, state: int) -> int:
        if state & getattr(curses, "BUTTON4_PRESSED", 0):
            return 1
        if state & getattr(curses, "BUTTON5_PRESSED", 0):
            return -1
        return 0

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def mouse_button1
    # Maintainer note for mouse_button1: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def mouse_button1(self, state: int) -> bool:
        masks = [
            getattr(curses, "BUTTON1_PRESSED", 0),
            getattr(curses, "BUTTON1_CLICKED", 0),
            getattr(curses, "BUTTON1_DOUBLE_CLICKED", 0),
            getattr(curses, "BUTTON1_TRIPLE_CLICKED", 0),
        ]
        return any(state & mask for mask in masks)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def mouse_button1_double
    # Maintainer note for mouse_button1_double: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def mouse_button1_double(self, state: int) -> bool:
        return bool(state & getattr(curses, "BUTTON1_DOUBLE_CLICKED", 0))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def handle_mouse
    # Maintainer note for handle_mouse: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def handle_mouse(self) -> None:
        try:
            _mouse_id, x, y, _z, state = curses.getmouse()
        except curses.error:
            return
        delta = self.mouse_wheel_delta(state)
        if delta:
            if delta > 0:
                self.transcript_scroll += MOUSE_SCROLL_LINES
            else:
                self.transcript_scroll = max(0, self.transcript_scroll - MOUSE_SCROLL_LINES)
            self.status = "mousewheel: transcript scroll"
            return
        if not self.layout:
            return
        if self.mouse_button1(state):
            label_y = self.layout.get("input_label_y", -1)
            if y == label_y:
                for start, end, action in self.command_click_targets:
                    if start <= x < end:
                        self.dispatch_command_action(action)
                        return

            input_y = self.layout.get("input_y", -1)
            input_h = self.layout.get("input_h", 0)
            if input_y <= y < input_y + input_h:
                self.place_cursor_from_mouse(x, y - input_y)
                self.status = "mouse: input cursor placed"

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def place_cursor_from_mouse
    # Maintainer note for place_cursor_from_mouse: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def place_cursor_from_mouse(self, x: int, visible_row: int) -> None:
        index = self.input_scroll + visible_row
        if index < 0 or index >= len(self.last_input_segments):
            return
        segment = self.last_input_segments[index]
        line = self.input_lines[segment.logical_row]
        clicked_col = max(0, x - 2)
        logical_col = min(len(line), segment.start + clicked_col)
        self.cursor_row = segment.logical_row
        self.cursor_col = logical_col

    # ------------------------------------------------------------------
    # Generic modals and external editor
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def show_message
    # Maintainer note for show_message: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def show_message(self, title: str, lines: List[str]) -> None:
        """Show a resolution-safe full-screen scrollable page.

        The earlier modal version could clip long text on small terminals.
        This page owns the whole screen, wraps all lines, and supports
        PgUp/PgDn, mousewheel, q/Esc, and any key to leave when content fits.
        """
        scroll = 0
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            body_h = max(1, height - 4)
            wrapped: List[str] = []
            for line in lines:
                if line == "":
                    wrapped.append("")
                else:
                    wrapped.extend(wrap_for_width(line, max(10, width)))

            max_scroll = max(0, len(wrapped) - body_h)
            scroll = max(0, min(scroll, max_scroll))

            self.safe_addstr(0, 0, title, width, self.reverse_attr())
            self.safe_addstr(1, 0, "_" * width, width, self.dim_attr())

            visible = wrapped[scroll:scroll + body_h]
            for idx, line in enumerate(visible):
                self.safe_addstr(2 + idx, 0, line, width)

            footer = "q/Esc=return | PgUp/PgDn/wheel=scroll"
            if max_scroll == 0:
                footer = "q/Esc/any key=return"
            self.safe_addstr(height - 1, 0, footer, width, self.reverse_attr())
            self.stdscr.refresh()

            ch = self.stdscr.getch()
            if self.handle_global_hotkey(ch):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, _y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    scroll = max(0, scroll - MOUSE_SCROLL_LINES)
                    continue
                if delta < 0:
                    scroll = min(max_scroll, scroll + MOUSE_SCROLL_LINES)
                    continue
                return
            if ch in (27, ord("q"), ord("Q")):
                return
            if ch == curses.KEY_PPAGE:
                scroll = max(0, scroll - body_h)
                continue
            if ch == curses.KEY_NPAGE:
                scroll = min(max_scroll, scroll + body_h)
                continue
            if max_scroll == 0:
                return

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def ask_yes_no
    # Maintainer note for ask_yes_no: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def ask_yes_no(self, title: str, message: str, default: bool = False) -> bool:
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            box_w = min(width - 4, 76)
            box_h = 10
            top = max(0, (height - box_h) // 2)
            left = max(0, (width - box_w) // 2)
            self.safe_addstr(top, left, "+" + "-" * (box_w - 2) + "+", attr=self.reverse_attr())
            self.safe_addstr(top + 1, left, "|" + title.center(box_w - 2) + "|", attr=self.reverse_attr())
            self.safe_addstr(top + 2, left, "+" + "-" * (box_w - 2) + "+", attr=self.reverse_attr())
            y = top + 3
            for line in wrap_for_width(message, box_w - 4)[:3]:
                self.safe_addstr(y, left + 2, line, box_w - 4)
                y += 1
            default_label = "yes" if default else "no"
            self.safe_addstr(top + box_h - 2, left + 2, f"Y/N? Enter={default_label} | Esc=no", box_w - 4, self.dim_attr())
            self.safe_addstr(top + box_h - 1, left, "+" + "-" * (box_w - 2) + "+", attr=self.reverse_attr())
            self.stdscr.refresh()
            ch = self.stdscr.getch()
            # Function keys remain global even inside confirmation dialogs.
            # If the user opens the wrong screen, pressing another function
            # key should jump there immediately instead of trapping them here.
            if self.handle_global_hotkey(ch):
                return default
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, x, y_mouse, _z, state = curses.getmouse()
                except curses.error:
                    continue
                if self.mouse_button1(state) and top <= y_mouse <= top + box_h:
                    return x < left + (box_w // 2)
            if ch in (ord("y"), ord("Y")):
                return True
            if ch in (ord("n"), ord("N"), 27):
                return False
            if ch in (10, 13, curses.KEY_ENTER):
                return default

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def text_input_modal
    # Maintainer note for text_input_modal: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def text_input_modal(self, title: str, prompt: str, initial: str = "", secret: bool = False) -> Optional[str]:
        value = initial
        cursor = len(value)
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            box_w = min(width - 4, 84)
            box_h = 11
            top = max(0, (height - box_h) // 2)
            left = max(0, (width - box_w) // 2)
            shown_value = ("*" * max(0, len(value) - 4) + value[-4:]) if secret else value
            field_w = box_w - 6
            shown = shown_value[max(0, cursor - field_w + 1):][:field_w]
            self.safe_addstr(top, left, "+" + "-" * (box_w - 2) + "+", attr=self.reverse_attr())
            self.safe_addstr(top + 1, left, "|" + title.center(box_w - 2) + "|", attr=self.reverse_attr())
            self.safe_addstr(top + 2, left, "+" + "-" * (box_w - 2) + "+", attr=self.reverse_attr())
            for idx, line in enumerate(wrap_for_width(prompt, box_w - 4)[:3]):
                self.safe_addstr(top + 3 + idx, left + 2, line, box_w - 4)
            self.safe_addstr(top + 7, left + 2, " " * field_w, field_w, self.reverse_attr())
            self.safe_addstr(top + 7, left + 2, shown, field_w, self.reverse_attr())
            self.safe_addstr(top + 9, left + 2, "Enter=accept | Esc=cancel | Backspace=edit", box_w - 4, self.dim_attr())
            self.safe_addstr(top + 10, left, "+" + "-" * (box_w - 2) + "+", attr=self.reverse_attr())
            self.stdscr.refresh()
            ch = self.stdscr.getch()
            # Function keys remain global even inside text entry dialogs.
            # This keeps F2/F3/F4/etc. as navigation tools everywhere in the UI.
            if self.handle_global_hotkey(ch):
                return None
            if ch in (10, 13, curses.KEY_ENTER):
                return value.strip()
            if ch == 27:
                return None
            if ch in (curses.KEY_BACKSPACE, 127, 8):
                if cursor > 0:
                    value = value[: cursor - 1] + value[cursor:]
                    cursor -= 1
            elif ch == curses.KEY_DC:
                if cursor < len(value):
                    value = value[:cursor] + value[cursor + 1:]
            elif ch == curses.KEY_LEFT:
                cursor = max(0, cursor - 1)
            elif ch == curses.KEY_RIGHT:
                cursor = min(len(value), cursor + 1)
            elif ch == curses.KEY_HOME:
                cursor = 0
            elif ch == curses.KEY_END:
                cursor = len(value)
            elif 32 <= ch <= 126:
                value = value[:cursor] + chr(ch) + value[cursor:]
                cursor += 1

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def run_external_editor
    # Maintainer note for run_external_editor: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def run_external_editor(self, initial_text: str, suffix: str = ".txt") -> Optional[str]:
        editor = self.cfg.effective_editor
        fd, path_str = tempfile.mkstemp(prefix="ttychatter.ncurses-", suffix=suffix)
        path = Path(path_str)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                fh.write(initial_text)
            curses.def_prog_mode()
            curses.endwin()
            try:
                subprocess.call(shlex.split(editor) + [str(path)])
            finally:
                curses.reset_prog_mode()
                self.stdscr.keypad(True)
            return path.read_text(encoding="utf-8", errors="replace")
        except Exception as exc:
            self.status = f"editor error: {exc}"
            return None
        finally:
            try:
                path.unlink()
            except OSError:
                pass

    # ------------------------------------------------------------------
    # High-level feature screens
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def command_items
    # Maintainer note for command_items: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def command_items(self) -> List[Tuple[str, str, str]]:
        return [
            ("F1", "Help / command menu", "noop"),
            ("D", "Diagnostics / doctor checks", "doctor"),
            ("F2", "Models: list, inspect, test, activate, save", "models"),
            ("F3", "API key manager", "api_key"),
            ("F4", "Sessions: browse, open, create, rename", "sessions"),
            ("F5", "Options: edit config-backed settings", "options"),
            ("F6", "Memory: view, edit, clear, rebuild", "memory"),
            ("F7", "Files: attach local files, browse saved attachments", "files"),
            ("F8", "External editor for current prompt", "editor"),
            ("F9", "Credits / about", "credits"),
            ("Ctrl+G", "Send current message", "send"),
            ("F10", "Quit", "quit"),
        ]

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def run_command
    # Maintainer note for run_command: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def run_command(self, action: str) -> None:
        if action == "noop":
            return
        if action == "help":
            self.open_help()
        elif action == "doctor":
            self.open_doctor()
        elif action == "models":
            self.open_model_selector()
        elif action == "api_key":
            self.open_api_key_input()
        elif action == "sessions":
            self.open_session_browser()
        elif action == "options":
            self.open_options_menu()
        elif action == "memory":
            self.open_memory_menu()
        elif action == "files":
            self.open_file_menu()
        elif action == "editor":
            self.open_external_editor_for_input()
        elif action == "credits":
            self.open_credits()
        elif action == "send":
            self.send_current_message()
        elif action == "quit":
            self.should_quit = True

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_help
    # F1 command surface. This is not just documentation; it is a launch pad for the app
    # features.
    # ------------------------------------------------------------
    def open_help(self) -> None:
        # F1 is now an actionable command menu, not only a static help page.
        # Function keys work while this menu is open, Enter launches the
        # highlighted command, and mouse clicks launch rows directly.
        selected = 0
        top_index = 0
        items = self.command_items()
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 7)
            self.safe_addstr(0, 0, "F1 HELP / COMMAND MENU", width, self.reverse_attr())
            self.safe_addstr(1, 0, "Enter/click=launch | F2-F10 work here | Ctrl+G=send | Esc/q=return", width, self.dim_attr())
            self.safe_addstr(2, 0, "_" * width, width, self.dim_attr())

            if selected < top_index:
                top_index = selected
            elif selected >= top_index + visible_h:
                top_index = selected - visible_h + 1

            for row in range(visible_h):
                idx = top_index + row
                if idx >= len(items):
                    break
                key, desc, action = items[idx]
                attr = self.reverse_attr() if idx == selected else 0
                self.safe_addstr(3 + row, 0, f"{key:<8} {desc}", width, attr)

            footer = "Mousewheel/PgUp/PgDn=scroll | Enter/click=launch | q/Esc=return"
            self.safe_addstr(height - 2, 0, "_" * width, width, self.dim_attr())
            self.safe_addstr(height - 1, 0, footer, width, self.reverse_attr())
            self.stdscr.refresh()

            ch = self.stdscr.getch()
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - MOUSE_SCROLL_LINES)
                    continue
                if delta < 0:
                    selected = min(len(items) - 1, selected + MOUSE_SCROLL_LINES)
                    continue
                if self.mouse_button1(state) and 3 <= y < 3 + visible_h:
                    idx = top_index + (y - 3)
                    if 0 <= idx < len(items):
                        selected = idx
                        self.run_command(items[selected][2])
                        return
                continue

            if ch in (27, ord("q"), ord("Q")):
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
            elif ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(items) - 1, selected + 1)
            elif ch == curses.KEY_PPAGE:
                selected = max(0, selected - visible_h)
            elif ch == curses.KEY_NPAGE:
                selected = min(len(items) - 1, selected + visible_h)
            elif ch == curses.KEY_HOME:
                selected = 0
            elif ch == curses.KEY_END:
                selected = len(items) - 1
            elif ch in (10, 13, curses.KEY_ENTER):
                self.run_command(items[selected][2])
                return
            elif ch in (ord("d"), ord("D")):
                self.run_command("doctor")
                return
            elif ch == curses.KEY_F1:
                continue
            elif ch == curses.KEY_F2:
                self.run_command("models"); return
            elif ch == curses.KEY_F3:
                self.run_command("api_key"); return
            elif ch == curses.KEY_F4:
                self.run_command("sessions"); return
            elif ch == curses.KEY_F5:
                self.run_command("options"); return
            elif ch == curses.KEY_F6:
                self.run_command("memory"); return
            elif ch == curses.KEY_F7:
                self.run_command("files"); return
            elif ch == curses.KEY_F8:
                self.run_command("editor"); return
            elif ch == curses.KEY_F9:
                self.run_command("credits"); return
            elif ch in (curses.KEY_F10, 17):
                self.run_command("quit"); return
            elif ch == 7:
                self.run_command("send"); return

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_doctor
    # Maintainer note for open_doctor: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_doctor(self) -> None:
        """Display the command-line doctor report inside ncurses.

        This gives users a bug-report screen without requiring them to leave the
        program. Like --doctor, it avoids printing secrets and does not call
        chat.completions.
        """
        self.show_message("DIAGNOSTICS", doctor_lines(self.cfg))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_credits
    # Maintainer note for open_credits: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_credits(self) -> None:
        self.show_message("CREDITS", [
            "ttychatter",
            f"GitHub: {self.cfg.github_url}",
            "",
            "Project focus: user-friendly and robust AI chat in the text terminal.",
            "Browsers and browser interfaces are not required for sending text messages and attachments back and forth to an AI.",
            "",
            "Project lead notice is displayed inside the blank chat window on new sessions and disappears when the first user message is sent.",
            "",
            PROJECT_NOTICE,
        ])

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_api_key_input
    # Maintainer note for open_api_key_input: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_api_key_input(self) -> None:
        key = self.text_input_modal("API KEY", "Paste OpenRouter API key. It is used for this run unless you choose to save it.", secret=True)
        if not key:
            self.status = "API key entry cancelled"
            return
        self.cfg.api_key = key
        if self.ask_yes_no("SAVE API KEY", "Save OPENROUTER_API_KEY to config? This stores it in plaintext. Default is no.", default=False):
            set_config_value(self.cfg, "OPENROUTER_API_KEY", key)
            self.status = "API key saved to config"
        else:
            self.status = "API key active for this run only"
        if self.ask_yes_no("FORGET API KEY", "Forget the runtime API key now? Default is no.", default=False):
            self.cfg.api_key = ""
            self.status = "API key forgotten for this run"

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def show_model_info
    # Maintainer note for show_model_info: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def show_model_info(self, model: ModelInfo) -> None:
        self.show_message("MODEL INFO", [
            f"Model ID: {model.model_id}",
            f"API name: {model.api_name}",
            f"Display name: {model.display_name}",
            f"Input token limit: {model.input_token_limit}",
            f"Output token limit: {model.output_token_limit}",
            f"Methods: {', '.join(model.methods)}",
            "",
            model.description or "No description returned by API.",
        ])

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def test_model_interactive
    # Maintainer note for test_model_interactive: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def test_model_interactive(self, model: ModelInfo) -> None:
        if not self.cfg.api_key:
            self.show_message("MODEL TEST", ["No API key loaded. Press F3 first."])
            return
        self.status = f"testing model: {model.model_id}"
        self.draw()
        ok, text = generate_with_model(self.cfg, model.model_id, self.cfg.model_test_prompt, self.session_name, self.attachment_dir, [], timeout=60)
        lines = ["Prompt sent:", self.cfg.model_test_prompt, "", "Model response:", text]
        self.show_message("MODEL TEST RESULT", lines)
        if ok and self.ask_yes_no("ACTIVATE MODEL", f"Activate {model.model_id} for this run?", default=True):
            self.cfg.model = model.model_id
            self.transcript.append(TranscriptItem("system", f"Model activated after test: {model.model_id}"))
            self.status = f"activated model: {model.model_id}"
            if self.ask_yes_no("SAVE MODEL", f"Save MODEL={model.model_id} to config?", default=True):
                set_config_value(self.cfg, "MODEL", model.model_id)
                self.status = f"model saved: {model.model_id}"

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_model_selector
    # F2 model workflow. It should separate local cached viewing from explicit network refreshes
    # and keep testing user-operated.
    # ------------------------------------------------------------
    def open_model_selector(self) -> None:
        """Open a local model-management menu without network access.

        Earlier releases immediately fetched OpenRouter's model list when F2 was
        pressed. That was surprising, especially offline or on limited quota.
        F2 now opens a local menu first. The user explicitly chooses whether
        to use the cached list or update the list from OpenRouter.
        """
        selected = 0
        while True:
            models_cached, cache_error, updated_at = load_model_cache(self.cfg)
            cached_label = f"cached model list ({len(models_cached)} models, updated {updated_at})" if models_cached else "cached model list unavailable"
            filter_label = model_filter_summary(self.cfg, len(models_cached), len(filter_model_list(self.cfg, models_cached))) if models_cached else model_filter_summary(self.cfg, 0, 0)
            actions = [
                ("c", f"Open {cached_label}", "cached"),
                ("u", "Update model list from OpenRouter", "update"),
                ("f", f"Model filters: {filter_label}", "filters"),
                ("r", "Router shortcuts (openrouter/auto, openrouter/free, discovered routers)", "routers"),
                ("t", f"Test current model: {self.model_label()}", "test-current"),
                ("e", "Enter model ID manually", "enter"),
                ("s", f"Save current model: {self.model_label()}", "save-current"),
                ("q", "Return to chat", "return"),
            ]

            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 6)
            self.safe_addstr(0, 0, "MODEL MENU", width, self.reverse_attr())
            self.safe_addstr(1, 0, "Cached list is preferred. Updating contacts OpenRouter only after confirmation.", width, self.dim_attr())
            self.safe_addstr(2, 0, f"Current model: {self.model_label()}", width)
            self.safe_addstr(3, 0, "Enter/click=choose | f=filters | F-keys jump screens | Esc/q=return", width, self.dim_attr())
            self.safe_addstr(4, 0, "_" * width, width, self.dim_attr())

            selected = max(0, min(selected, len(actions) - 1))
            for row, (key, label, _action) in enumerate(actions[:visible_h]):
                attr = self.reverse_attr() if row == selected else 0
                self.safe_addstr(5 + row, 0, f"{key}  {label}", width, attr)

            self.stdscr.refresh()
            ch = self.stdscr.getch()
            if self.handle_global_hotkey(ch, current_action="models"):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - 1)
                    continue
                if delta < 0:
                    selected = min(len(actions) - 1, selected + 1)
                    continue
                if self.mouse_button1(state) and 5 <= y < 5 + len(actions):
                    selected = y - 5
                    ch = 10
                else:
                    continue
            if ch in (27, ord("q"), ord("Q")):
                self.status = "model menu closed"
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
                continue
            if ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(actions) - 1, selected + 1)
                continue
            if ch not in (10, 13, curses.KEY_ENTER):
                for idx, (key, _label, _action) in enumerate(actions):
                    if ch in (ord(key), ord(key.upper())):
                        selected = idx
                        ch = 10
                        break
            if ch not in (10, 13, curses.KEY_ENTER):
                continue

            action = actions[selected][2]
            if action == "return":
                self.status = "model menu closed"
                return
            if action == "update":
                if not self.cfg.api_key:
                    self.show_message("MODEL LIST", ["No API key loaded. Press F3 to paste one."])
                    continue
                if not self.ask_yes_no("UPDATE MODEL LIST", "This will connect to OpenRouter and refresh the cached model list. Continue?", default=False):
                    self.status = "model list update cancelled"
                    continue
                self.status = "loading model list from OpenRouter..."
                self.draw()
                models, error = fetch_models(self.cfg)
                if error:
                    self.show_message("MODEL LIST ERROR", [
                        error,
                        "",
                        "If this is a DNS/network error, verify that the Linux container is online and can resolve openrouter.ai.",
                    ])
                    self.status = "model list failed"
                    continue
                save_model_cache(self.cfg, models)
                self.status = f"model list updated: {len(models)} models"
                self.open_model_list_selector(models, source_label="OpenRouter live list")
                return
            if action == "cached":
                if cache_error:
                    self.show_message("MODEL CACHE", [cache_error])
                    continue
                self.open_model_list_selector(models_cached, source_label=f"cached list updated {updated_at}")
                return
            if action == "filters":
                self.open_model_filter_menu()
                continue
            if action == "routers":
                self.open_router_shortcuts(models_cached if models_cached else [])
                continue
            if action == "test-current":
                model = ModelInfo(
                    model_id=normalize_model_id(self.cfg.effective_model),
                    api_name="",
                    display_name=normalize_model_id(self.cfg.effective_model),
                    description="Current configured/fallback model.",
                )
                self.test_model_interactive(model)
                continue
            if action == "enter":
                new_model = self.text_input_modal("ENTER MODEL ID", "Enter exact OpenRouter model ID:", self.cfg.model or self.cfg.effective_model)
                if new_model:
                    self.cfg.model = normalize_model_id(new_model)
                    self.transcript.append(TranscriptItem("system", f"Model entered manually: {self.cfg.model}"))
                    self.status = f"model activated: {self.cfg.model}"
                    if self.ask_yes_no("SAVE MODEL", f"Save MODEL={self.cfg.model} to config?", default=True):
                        set_config_value(self.cfg, "MODEL", self.cfg.model)
                        self.status = f"model saved: {self.cfg.model}"
                continue
            if action == "save-current":
                set_config_value(self.cfg, "MODEL", normalize_model_id(self.cfg.effective_model))
                self.status = f"model saved: {normalize_model_id(self.cfg.effective_model)}"
                continue

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_router_shortcuts
    # Router shortcuts are OpenRouter-specific navigation aids.  They are kept
    # separate from ordinary fixed models because openrouter/auto and
    # openrouter/free are not normal model IDs in the user's mental model: they
    # are routing choices.  This screen therefore gives the user a small,
    # explicit dropdown-style list before they dive into the full model table.
    # The list includes the two well-known routers plus any additional cached
    # OpenRouter router rows discovered from the model catalog.
    # ------------------------------------------------------------
    def open_router_shortcuts(self, cached_models: List[ModelInfo]) -> None:
        base = ["openrouter/auto", "openrouter/free"]
        discovered = [m.model_id for m in cached_models if model_type_label(m) in {"router", "free", "auto"}]
        choices = []
        for item in base + discovered:
            if item and item not in choices:
                choices.append(item)
        if not choices:
            choices = base
        chosen = self.choice_modal(
            "ROUTER / SPECIAL MODEL",
            "Choose an OpenRouter router/special entry. Routers are provider-defined selection policies, not fixed models.",
            choices,
            self.cfg.effective_model,
        )
        if not chosen:
            return
        self.cfg.model = normalize_model_id(chosen)
        self.transcript.append(TranscriptItem("system", f"Router/model selected: {self.cfg.model}"))
        self.status = f"activated router/model: {self.cfg.model}"
        if self.ask_yes_no("SAVE MODEL", f"Save MODEL={self.cfg.model} to config?", default=True):
            set_config_value(self.cfg, "MODEL", self.cfg.model)
            self.status = f"saved MODEL={self.cfg.model}"

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_model_filter_menu
    # Maintainer note for open_model_filter_menu: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_model_filter_menu(self) -> None:
        """Edit model-list metadata filters.

        These settings use only the model-list metadata returned by OpenRouter:
        supportedGenerationMethods, token limits, names, and descriptions. No
        model generation requests are sent from this screen.
        """
        selected = 0
        sort_orders = ["favorites", "type", "api", "name", "display", "input-desc", "output-desc"]

        while True:
            rows = [
                ("MODEL_FILTER_CHAT_COMPLETIONS", "bool", "Require chat.completions support", self.cfg.model_filter_chat_completions),
                ("MODEL_FILTER_REQUIRE_TOKENS", "bool", "Require input/output token limits > 0", self.cfg.model_filter_require_tokens),
                ("MODEL_FILTER_HIDE_PREVIEW", "bool", "Hide preview/experimental/beta models", self.cfg.model_filter_hide_preview),
                ("MODEL_MIN_INPUT_TOKENS", "int", "Minimum input tokens", str(self.cfg.model_min_input_tokens)),
                ("MODEL_MIN_OUTPUT_TOKENS", "int", "Minimum output tokens", str(self.cfg.model_min_output_tokens)),
                ("MODEL_SORT_ORDER", "choice", "Sort order", self.cfg.model_sort_order),
                ("MODEL_TYPE_FILTER", "choice", "Model type", self.cfg.model_type_filter),
            ]
            selected = max(0, min(selected, len(rows) - 1))
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 6)
            self.safe_addstr(0, 0, "MODEL FILTERS", width, self.reverse_attr())
            self.safe_addstr(1, 0, "Space/Enter=toggle/cycle/edit | Esc/q=back | F-keys jump", width, self.dim_attr())
            self.safe_addstr(2, 0, "Uses OpenRouter model metadata; does not test/probe models.", width, self.dim_attr())
            self.safe_addstr(3, 0, "_" * width, width, self.dim_attr())

            for row in range(visible_h):
                idx = row
                if idx >= len(rows):
                    break
                _key, kind, label, value = rows[idx]
                attr = self.reverse_attr() if idx == selected else 0
                if kind == "bool":
                    mark = "[x]" if value else "[ ]"
                    line = f"{mark} {label}"
                else:
                    line = f"{label:<42} [{value}]"
                self.safe_addstr(4 + row, 0, line, width, attr)
            self.safe_addstr(height - 1, 0, "Model tests remain user-operated with t on one highlighted model.", width, self.dim_attr())
            self.stdscr.refresh()
            ch = self.stdscr.getch()
            if self.handle_global_hotkey(ch, current_action="models"):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - 1)
                    continue
                if delta < 0:
                    selected = min(len(rows) - 1, selected + 1)
                    continue
                if self.mouse_button1(state) and 4 <= y < 4 + len(rows):
                    selected = y - 4
                    ch = 10
                else:
                    continue
            if ch in (27, ord("q"), ord("Q")):
                self.status = "model filters closed"
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
                continue
            if ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(rows) - 1, selected + 1)
                continue
            if ch not in (10, 13, curses.KEY_ENTER, ord(" ")):
                continue

            key, kind, _label, value = rows[selected]
            if kind == "bool":
                new_value = not bool(value)
                if key == "MODEL_FILTER_CHAT_COMPLETIONS":
                    self.cfg.model_filter_chat_completions = new_value
                elif key == "MODEL_FILTER_REQUIRE_TOKENS":
                    self.cfg.model_filter_require_tokens = new_value
                elif key == "MODEL_FILTER_HIDE_PREVIEW":
                    self.cfg.model_filter_hide_preview = new_value
                set_config_value(self.cfg, key, "1" if new_value else "0")
                self.status = f"saved {key}"
            elif kind == "choice":
                if key == "MODEL_SORT_ORDER":
                    current_idx = sort_orders.index(self.cfg.model_sort_order) if self.cfg.model_sort_order in sort_orders else 0
                    self.cfg.model_sort_order = sort_orders[(current_idx + 1) % len(sort_orders)]
                    set_config_value(self.cfg, key, self.cfg.model_sort_order)
                    self.status = f"saved {key}={self.cfg.model_sort_order}"
                elif key == "MODEL_TYPE_FILTER":
                    current_idx = MODEL_TYPE_CHOICES.index(self.cfg.model_type_filter) if self.cfg.model_type_filter in MODEL_TYPE_CHOICES else 0
                    self.cfg.model_type_filter = MODEL_TYPE_CHOICES[(current_idx + 1) % len(MODEL_TYPE_CHOICES)]
                    set_config_value(self.cfg, key, self.cfg.model_type_filter)
                    self.status = f"saved {key}={self.cfg.model_type_filter}"
            else:
                new_text = self.text_input_modal("MODEL FILTER", f"Edit {key}:", str(value))
                if new_text is not None:
                    if key == "MODEL_MIN_INPUT_TOKENS":
                        self.cfg.model_min_input_tokens = parse_positive_int(new_text, self.cfg.model_min_input_tokens)
                        set_config_value(self.cfg, key, str(self.cfg.model_min_input_tokens))
                    elif key == "MODEL_MIN_OUTPUT_TOKENS":
                        self.cfg.model_min_output_tokens = parse_positive_int(new_text, self.cfg.model_min_output_tokens)
                        set_config_value(self.cfg, key, str(self.cfg.model_min_output_tokens))
                    self.status = f"saved {key}"


    def load_model_favorites(self) -> set[str]:
        """Read persistent favorite model IDs.

        Favorites are intentionally stored as one model ID per line. That keeps
        them editable by humans and portable to Bash/C editions without JSON.
        """
        path = self.cfg.effective_model_favorites_file
        if not path.exists():
            return set()
        return {line.strip() for line in path.read_text(encoding="utf-8", errors="replace").splitlines() if line.strip()}

    def save_model_favorites(self, favorites: set[str]) -> None:
        path = self.cfg.effective_model_favorites_file
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(sorted(favorites)) + ("\n" if favorites else ""), encoding="utf-8")

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_model_list_selector
    # Maintainer note for open_model_list_selector: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_model_list_selector(self, models: List[ModelInfo], source_label: str = "model list") -> None:
        """Browse, search, favorite, sort, test, activate, and save models.

        This deliberately resembles old file/server browsers: a table of rows,
        a search string, visible metadata, keyboard/mouse navigation, and a few
        commands that operate on the highlighted row.  The model list is not a
        magic recommendation engine. It exposes provider metadata and lets the
        user decide.
        """
        if not models:
            self.show_message("MODEL BROWSER", ["No models available."])
            return

        raw_models = list(models)
        selected = 0
        top_index = 0
        search = ""
        favorites = self.load_model_favorites()
        sort_modes = ["favorites", "name", "input-desc", "output-desc", "api"]

        while True:
            filtered = filter_model_list(self.cfg, raw_models)
            if search:
                needle = search.lower()
                filtered = [m for m in filtered if needle in m.model_id.lower() or needle in m.display_name.lower() or needle in m.description.lower()]
            if self.cfg.model_sort_order == "favorites":
                filtered = sorted(filtered, key=lambda m: (m.model_id not in favorites, m.model_id.lower()))
            current = normalize_model_id(self.cfg.effective_model)

            if not filtered:
                self.stdscr.erase()
                height, width = self.stdscr.getmaxyx()
                self.safe_addstr(0, 0, "MODEL BROWSER", width, self.reverse_attr())
                self.safe_addstr(1, 0, f"Source: {source_label}", width, self.dim_attr())
                self.safe_addstr(2, 0, f"Search: {search or '(none)'}", width, self.dim_attr())
                self.safe_addstr(4, 0, "No models match active filters/search.", width)
                self.safe_addstr(6, 0, "/=search | f=filters | Esc/q=back | F-keys jump", width, self.dim_attr())
                self.stdscr.refresh()
                ch = self.stdscr.getch()
                if self.handle_global_hotkey(ch, current_action="models"):
                    return
                if ch in (27, ord("q"), ord("Q")):
                    return
                if ch == ord("/"):
                    value = self.text_input_modal("MODEL SEARCH", "Search model IDs, names, descriptions:", search)
                    if value is not None:
                        search = value.strip()
                if ch in (ord("f"), ord("F")):
                    self.open_model_filter_menu()
                continue

            selected = max(0, min(selected, len(filtered) - 1))
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 9)
            self.safe_addstr(0, 0, "MODEL BROWSER", width, self.reverse_attr())
            self.safe_addstr(1, 0, f"Source: {source_label} | Search: {search or '(none)'} | Sort: {self.cfg.model_sort_order}", width, self.dim_attr())
            self.safe_addstr(2, 0, "/=search | b=favorite | o/O=sort +/- | t=test | i=info | s=save | Enter=activate", width, self.dim_attr())
            self.safe_addstr(3, 0, "Fav  Type    Model                              InTok     OutTok    Features", width, self.reverse_dim_attr())
            self.safe_addstr(4, 0, "_" * width, width, self.dim_attr())

            if selected < top_index:
                top_index = selected
            elif selected >= top_index + visible_h:
                top_index = selected - visible_h + 1
            top_index = max(0, min(top_index, max(0, len(filtered) - visible_h)))

            for row in range(visible_h):
                model_index = top_index + row
                if model_index >= len(filtered):
                    break
                model = filtered[model_index]
                fav = "*" if model.model_id in favorites else " "
                model_text = model.model_id[:38]
                in_tok = str(model.input_token_limit or "?")[:8]
                out_tok = str(model.output_token_limit or "?")[:8]
                kind = model_type_label(model)[:7]
                badges = model_badges(model)[:24]
                line = f" {fav}   {kind:<7} {model_text:<34} {in_tok:>8} {out_tok:>8}  {badges}"
                attr = self.reverse_attr() if model_index == selected else 0
                if model.model_id == current and attr == 0:
                    attr = self.dim_attr()
                self.safe_addstr(5 + row, 0, line, width, attr)

            self.safe_addstr(height - 2, 0, "_" * width, width, self.dim_attr())
            self.safe_addstr(height - 1, 0, f"{selected + 1}/{len(filtered)} shown; {len(raw_models)} total; {len(favorites)} favorites", width, self.dim_attr())
            self.stdscr.refresh()
            ch = self.stdscr.getch()
            if self.handle_global_hotkey(ch, current_action="models"):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - MOUSE_SCROLL_LINES)
                    continue
                if delta < 0:
                    selected = min(len(filtered) - 1, selected + MOUSE_SCROLL_LINES)
                    continue
                if self.mouse_button1(state) and 5 <= y < 5 + visible_h:
                    idx = top_index + (y - 5)
                    if 0 <= idx < len(filtered):
                        selected = idx
                        if self.mouse_button1_double(state):
                            self.cfg.model = filtered[selected].model_id
                            self.status = f"activated model: {self.cfg.model}"
                            return
                    continue
            if ch in (27, ord("q"), ord("Q")):
                self.status = "model browser closed"
                return
            if ch in (ord("/"),):
                value = self.text_input_modal("MODEL SEARCH", "Search model IDs, names, descriptions:", search)
                if value is not None:
                    search = value.strip()
                    selected = 0
                    top_index = 0
                continue
            if ch in (ord("b"), ord("B")):
                mid = filtered[selected].model_id
                if mid in favorites:
                    favorites.remove(mid)
                    self.status = f"removed favorite: {mid}"
                else:
                    favorites.add(mid)
                    self.status = f"added favorite: {mid}"
                self.save_model_favorites(favorites)
                continue
            if ch in (ord("o"), ord("O")):
                try:
                    idx = sort_modes.index(self.cfg.model_sort_order)
                except ValueError:
                    idx = 0
                # Model browsing should feel like an old server/file browser:
                # one key cycles sort modes forward, and Shift+O walks the same
                # cycle backward.  This is faster than entering the options
                # screen when the user is actively comparing model rows.
                delta = -1 if ch == ord("O") else 1
                self.cfg.model_sort_order = sort_modes[(idx + delta) % len(sort_modes)]
                set_config_value(self.cfg, "MODEL_SORT_ORDER", self.cfg.model_sort_order)
                self.status = f"model sort: {self.cfg.model_sort_order}"
                selected = 0
                top_index = 0
                continue
            if ch in (ord("f"), ord("F")):
                self.open_model_filter_menu()
                continue
            if ch in (ord("i"), ord("I")):
                self.show_model_info(filtered[selected])
                continue
            if ch in (ord("t"), ord("T")):
                self.test_model_interactive(filtered[selected])
                continue
            if ch in (ord("s"), ord("S")):
                set_config_value(self.cfg, "MODEL", filtered[selected].model_id)
                self.status = f"model saved: {filtered[selected].model_id}"
                return
            if ch in (10, 13, curses.KEY_ENTER):
                self.cfg.model = filtered[selected].model_id
                self.status = f"activated model: {self.cfg.model}"
                self.transcript.append(TranscriptItem("system", f"Model activated: {self.cfg.model}"))
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
            elif ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(filtered) - 1, selected + 1)
            elif ch == curses.KEY_PPAGE:
                selected = max(0, selected - visible_h)
            elif ch == curses.KEY_NPAGE:
                selected = min(len(filtered) - 1, selected + visible_h)
            elif ch == curses.KEY_HOME:
                selected = 0
            elif ch == curses.KEY_END:
                selected = len(filtered) - 1

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def session_names
    # Maintainer note for session_names: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def session_names(self) -> List[str]:
        self.cfg.session_dir.mkdir(parents=True, exist_ok=True)
        return sorted(path.stem for path in self.cfg.session_dir.glob("*.log"))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def rename_session
    # Maintainer note for rename_session: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def rename_session(self, old_name: str, new_name: str) -> None:
        new_name = sanitize_session_name(new_name)
        old_path = self.cfg.session_dir / f"{old_name}.log"
        new_path = self.cfg.session_dir / f"{new_name}.log"
        if new_path.exists() and new_path != old_path:
            self.show_message("RENAME SESSION", [f"Target already exists: {new_name}"])
            return
        if old_path.exists():
            old_path.rename(new_path)
        # Rename attachment prefixes for consistency.
        for path in self.attachment_dir.glob(f"{old_name}-*"):
            path.rename(self.attachment_dir / (new_name + path.name[len(old_name):]))
        if old_name == self.session_name:
            self.session_name = new_name
            self.session_path = new_path
        self.status = f"renamed session: {old_name} -> {new_name}"

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_session_browser
    # Maintainer note for open_session_browser: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_session_browser(self) -> None:
        selected = 0
        top_index = 0
        while True:
            names = self.session_names()
            if not names:
                self.show_message("SESSIONS", ["No sessions found."])
                return
            selected = min(selected, len(names) - 1)
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 6)
            self.safe_addstr(0, 0, "SESSION BROWSER", width, self.reverse_attr())
            self.safe_addstr(1, 0, "Enter=switch | a=new chat | d=delete | r=rename | n=rename current | j/k move | Esc/q=cancel", width, self.dim_attr())
            self.safe_addstr(2, 0, f"Current: {self.session_name}", width)
            self.safe_addstr(3, 0, "_" * width, width, self.dim_attr())
            if selected < top_index:
                top_index = selected
            elif selected >= top_index + visible_h:
                top_index = selected - visible_h + 1
            for row in range(visible_h):
                idx = top_index + row
                if idx >= len(names):
                    break
                marker = "* " if names[idx] == self.session_name else "  "
                attr = self.reverse_attr() if idx == selected else 0
                self.safe_addstr(4 + row, 0, marker + names[idx], width, attr)
            self.safe_addstr(height - 1, 0, f"{selected + 1}/{len(names)}", width, self.dim_attr())
            self.stdscr.refresh()
            ch = self.stdscr.getch()
            if self.handle_global_hotkey(ch, current_action="sessions"):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - MOUSE_SCROLL_LINES)
                elif delta < 0:
                    selected = min(len(names) - 1, selected + MOUSE_SCROLL_LINES)
                elif self.mouse_button1(state) and 4 <= y < 4 + visible_h:
                    idx = top_index + (y - 4)
                    if 0 <= idx < len(names):
                        selected = idx
                continue
            if ch in (27, ord("q"), ord("Q")):
                return
            if ch in (10, 13, curses.KEY_ENTER):
                name = names[selected]
                self.reset_to_session(name, self.cfg.session_dir / f"{name}.log")
                return
            if ch in (ord("a"), ord("A")):
                new = self.text_input_modal("NEW SESSION", "Name this new chat session (blank for timestamp):", "")
                if new is None:
                    continue
                name = sanitize_session_name(new) if new.strip() else default_session_name()
                self.reset_to_session(name, self.cfg.session_dir / f"{name}.log")
                return
            if ch in (ord("d"), ord("D")):
                victim = names[selected]
                if victim == self.session_name:
                    if not self.ask_yes_no("DELETE CURRENT SESSION", f"Delete current session log {victim}.log?", default=False):
                        continue
                else:
                    if not self.ask_yes_no("DELETE SESSION", f"Delete session log {victim}.log?", default=False):
                        continue
                try:
                    (self.cfg.session_dir / f"{victim}.log").unlink()
                    self.status = f"deleted session: {victim}"
                    if victim == self.session_name:
                        name = default_session_name()
                        self.reset_to_session(name, self.cfg.session_dir / f"{name}.log")
                        return
                except OSError as exc:
                    self.show_message("DELETE SESSION", [f"Could not delete {victim}: {exc}"])
                continue
            if ch in (ord("r"), ord("R")):
                old = names[selected]
                new = self.text_input_modal("RENAME SESSION", f"Rename session '{old}' to:", old)
                if new:
                    self.rename_session(old, new)
                continue
            if ch in (ord("n"), ord("N")):
                new = self.text_input_modal("RENAME CURRENT SESSION", "New name for current session:", self.session_name)
                if new:
                    self.rename_session(self.session_name, new)
                continue
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
            elif ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(names) - 1, selected + 1)
            elif ch == curses.KEY_PPAGE:
                selected = max(0, selected - visible_h)
            elif ch == curses.KEY_NPAGE:
                selected = min(len(names) - 1, selected + visible_h)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def choice_modal
    #
    # Choice values such as SEND_INPUT should never force users to remember and
    # type magic strings.  In a terminal UI, a setting with a small legal value
    # set should look and behave like an old options dialog: move to the row,
    # press Enter, select from a list.  This helper is intentionally tiny but it
    # centralizes that behavior so future option fields do not quietly degrade
    # into free-form text entry again.
    #
    # Navigation mirrors the rest of ttychatter: arrows, j/k, PgUp/PgDn,
    # Home/End, mousewheel, row click, Enter.  Function keys remain global even
    # inside this chooser so a mistaken key does not trap the user.
    # ------------------------------------------------------------
    def choice_modal(self, title: str, prompt: str, choices: List[str], current: str) -> Optional[str]:
        if not choices:
            return None
        selected = choices.index(current) if current in choices else 0
        top_index = 0
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 6)
            self.safe_addstr(0, 0, title, width, self.reverse_attr())
            self.safe_addstr(1, 0, prompt, width, self.dim_attr())
            self.safe_addstr(2, 0, "Enter/click=choose | j/k move | Esc/q=cancel | F-keys jump", width, self.dim_attr())
            self.safe_addstr(3, 0, "_" * width, width, self.dim_attr())

            if selected < top_index:
                top_index = selected
            elif selected >= top_index + visible_h:
                top_index = selected - visible_h + 1
            top_index = max(0, min(top_index, max(0, len(choices) - visible_h)))

            for row in range(visible_h):
                idx = top_index + row
                if idx >= len(choices):
                    break
                mark = "* " if choices[idx] == current else "  "
                attr = self.reverse_attr() if idx == selected else 0
                self.safe_addstr(4 + row, 0, mark + choices[idx], width, attr)

            self.safe_addstr(height - 1, 0, f"{selected + 1}/{len(choices)}", width, self.reverse_dim_attr())
            self.stdscr.refresh()
            ch = self.stdscr.getch()
            if self.handle_global_hotkey(ch, current_action="options"):
                return None
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - MOUSE_SCROLL_LINES)
                    continue
                if delta < 0:
                    selected = min(len(choices) - 1, selected + MOUSE_SCROLL_LINES)
                    continue
                if self.mouse_button1(state) and 4 <= y < 4 + visible_h:
                    idx = top_index + (y - 4)
                    if 0 <= idx < len(choices):
                        selected = idx
                        if self.mouse_button1_double(state):
                            return choices[selected]
                    continue
            if ch in (27, ord("q"), ord("Q")):
                return None
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
            elif ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(choices) - 1, selected + 1)
            elif ch == curses.KEY_PPAGE:
                selected = max(0, selected - visible_h)
            elif ch == curses.KEY_NPAGE:
                selected = min(len(choices) - 1, selected + visible_h)
            elif ch == curses.KEY_HOME:
                selected = 0
            elif ch == curses.KEY_END:
                selected = len(choices) - 1
            elif ch in (10, 13, curses.KEY_ENTER):
                return choices[selected]

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_options_menu
    # Options UI. This should behave like a friendly form, not like dumping users into raw
    # config editing.
    # ------------------------------------------------------------
    def open_options_menu(self) -> None:
        """w3m-style options form.

        The old options screen behaved like a list of config-file lines. This
        form keeps values visible together, uses checkboxes for booleans, and
        edits the active field inline without opening a second full-screen
        editor for every option.
        """
        selected = 0
        top_index = 0
        editing = False
        edit_value = ""

        # ------------------------------------------------------------
        # MAINTAINER COMMENTARY: def current_fields
        # Maintainer note for current_fields: this routine is part of the long-term public
        # behavior of the program. When changing it, check callers, documentation, config
        # compatibility, session-log compatibility, and the parallel Bash/C implementation
        # plans.
        # ------------------------------------------------------------
        def current_fields() -> List[dict]:
            return [
                {"key": "MODEL", "label": "Model", "kind": "text", "value": self.cfg.model},
                {"key": "CONTEXT_TURNS", "label": "Context turns", "kind": "int", "value": str(self.cfg.context_turns)},
                {"key": "SESSION_DIR", "label": "Session directory", "kind": "path", "value": str(self.cfg.session_dir)},
                {"key": "ATTACHMENT_DIR", "label": "Attachment directory", "kind": "path", "value": str(self.cfg.effective_attachment_dir)},
                {"key": "EDITOR", "label": "External editor", "kind": "text", "value": self.cfg.editor},
                {"key": "MODEL_CACHE_FILE", "label": "Model cache file", "kind": "path", "value": str(self.cfg.model_cache_file)},
                {"key": "MODEL_FILTER_CHAT_COMPLETIONS", "label": "Model browser: chat.completions only", "kind": "bool", "value": self.cfg.model_filter_chat_completions},
                {"key": "MODEL_FILTER_REQUIRE_TOKENS", "label": "Model browser: require token limits", "kind": "bool", "value": self.cfg.model_filter_require_tokens},
                {"key": "MODEL_FILTER_HIDE_PREVIEW", "label": "Model browser: hide preview/experimental", "kind": "bool", "value": self.cfg.model_filter_hide_preview},
                {"key": "MODEL_MIN_INPUT_TOKENS", "label": "Model browser: min input tokens", "kind": "int", "value": str(self.cfg.model_min_input_tokens)},
                {"key": "MODEL_MIN_OUTPUT_TOKENS", "label": "Model browser: min output tokens", "kind": "int", "value": str(self.cfg.model_min_output_tokens)},
                {"key": "MODEL_SORT_ORDER", "label": "Model browser: sort order", "kind": "choice", "value": self.cfg.model_sort_order, "choices": ["favorites", "type", "api", "name", "display", "input-desc", "output-desc"]},
                {"key": "MODEL_TYPE_FILTER", "label": "Model browser: type filter", "kind": "choice", "value": self.cfg.model_type_filter, "choices": MODEL_TYPE_CHOICES},
                {"key": "THEME", "label": "Theme / style profile", "kind": "choice", "value": self.cfg.theme, "choices": THEME_CHOICES},
                {"key": "MODEL_TEST_PROMPT", "label": "Model test prompt", "kind": "text", "value": self.cfg.model_test_prompt},
                {"key": "INPUT_PLACEHOLDER", "label": "Input placeholder", "kind": "text", "value": self.cfg.input_placeholder},
                {"key": "SEND_INPUT", "label": "Send key", "kind": "choice", "value": self.cfg.send_input, "choices": ["enter", "ctrl_g"]},
                {"key": "PROMPT_SESSION_NAME", "label": "Prompt for session name", "kind": "bool", "value": self.cfg.prompt_session_name},
                {"key": "CODE_ATTACHMENT_MIN_LINES", "label": "Code block attachment min lines", "kind": "int", "value": str(self.cfg.code_attachment_min_lines)},
                {"key": "MONOCHROME", "label": "Monochrome mode", "kind": "bool", "value": self.cfg.monochrome},
                {"key": "STARTUP_NOTICE", "label": "Startup Project Lead notice", "kind": "bool", "value": self.cfg.startup_notice},
                {"key": "DEMO_MODE", "label": "Demo mode", "kind": "bool", "value": self.cfg.demo_mode},
                {"key": "CONFIRM_LIVE_SEND", "label": "Confirm first live send", "kind": "bool", "value": self.cfg.confirm_live_send},
                {"key": "API_KEY_GPG_FILE", "label": "GPG API-key file", "kind": "text", "value": str(self.cfg.effective_api_key_gpg_file)},
            ]

        # ------------------------------------------------------------
        # MAINTAINER COMMENTARY: def apply_field
        # Maintainer note for apply_field: this routine is part of the long-term public behavior
        # of the program. When changing it, check callers, documentation, config compatibility,
        # session-log compatibility, and the parallel Bash/C implementation plans.
        # ------------------------------------------------------------
        def apply_field(key: str, value: object) -> None:
            if key == "MODEL":
                self.cfg.model = normalize_model_id(str(value))
                set_config_value(self.cfg, key, self.cfg.model)
            elif key == "CONTEXT_TURNS":
                self.cfg.context_turns = parse_positive_int(str(value), self.cfg.context_turns)
                set_config_value(self.cfg, key, str(self.cfg.context_turns))
            elif key == "SESSION_DIR":
                self.cfg.session_dir = expand_path(str(value))
                self.cfg.session_dir.mkdir(parents=True, exist_ok=True)
                set_config_value(self.cfg, key, str(self.cfg.session_dir))
            elif key == "ATTACHMENT_DIR":
                self.cfg.attachment_dir = expand_path(str(value))
                self.attachment_dir = self.cfg.effective_attachment_dir
                self.attachment_dir.mkdir(parents=True, exist_ok=True)
                set_config_value(self.cfg, key, str(self.attachment_dir))
            elif key == "EDITOR":
                self.cfg.editor = str(value)
                set_config_value(self.cfg, key, self.cfg.editor)
            elif key == "MODEL_CACHE_FILE":
                self.cfg.model_cache_file = expand_path(str(value))
                self.cfg.model_cache_file.parent.mkdir(parents=True, exist_ok=True)
                set_config_value(self.cfg, key, str(self.cfg.model_cache_file))
            elif key == "MODEL_FILTER_CHAT_COMPLETIONS":
                self.cfg.model_filter_chat_completions = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.model_filter_chat_completions else "0")
            elif key == "MODEL_FILTER_REQUIRE_TOKENS":
                self.cfg.model_filter_require_tokens = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.model_filter_require_tokens else "0")
            elif key == "MODEL_FILTER_HIDE_PREVIEW":
                self.cfg.model_filter_hide_preview = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.model_filter_hide_preview else "0")
            elif key == "MODEL_MIN_INPUT_TOKENS":
                self.cfg.model_min_input_tokens = parse_nonnegative_int(str(value), self.cfg.model_min_input_tokens)
                set_config_value(self.cfg, key, str(self.cfg.model_min_input_tokens))
            elif key == "MODEL_MIN_OUTPUT_TOKENS":
                self.cfg.model_min_output_tokens = parse_nonnegative_int(str(value), self.cfg.model_min_output_tokens)
                set_config_value(self.cfg, key, str(self.cfg.model_min_output_tokens))
            elif key == "MODEL_SORT_ORDER":
                value_text = str(value)
                if value_text in {"favorites", "type", "api", "name", "display", "input-desc", "output-desc"}:
                    self.cfg.model_sort_order = value_text
                    set_config_value(self.cfg, key, self.cfg.model_sort_order)
            elif key == "MODEL_TYPE_FILTER":
                value_text = str(value)
                if value_text in MODEL_TYPE_CHOICES:
                    self.cfg.model_type_filter = value_text
                    set_config_value(self.cfg, key, self.cfg.model_type_filter)
            elif key == "THEME":
                value_text = str(value)
                if value_text in THEME_CHOICES:
                    self.cfg.theme = value_text
                    self.cfg.monochrome = value_text == "mono"
                    set_config_value(self.cfg, key, self.cfg.theme)
            elif key == "MODEL_TEST_PROMPT":
                self.cfg.model_test_prompt = str(value)
                set_config_value(self.cfg, key, self.cfg.model_test_prompt)
            elif key == "INPUT_PLACEHOLDER":
                self.cfg.input_placeholder = str(value)
                set_config_value(self.cfg, key, self.cfg.input_placeholder)
            elif key == "SEND_INPUT":
                self.cfg.send_input = str(value)
                set_config_value(self.cfg, key, self.cfg.send_input)
            elif key == "PROMPT_SESSION_NAME":
                self.cfg.prompt_session_name = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.prompt_session_name else "0")
            elif key == "CODE_ATTACHMENT_MIN_LINES":
                self.cfg.code_attachment_min_lines = parse_positive_int(str(value), self.cfg.code_attachment_min_lines)
                set_config_value(self.cfg, key, str(self.cfg.code_attachment_min_lines))
            elif key == "MONOCHROME":
                self.cfg.monochrome = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.monochrome else "0")
            elif key == "STARTUP_NOTICE":
                self.cfg.startup_notice = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.startup_notice else "0")
            elif key == "DEMO_MODE":
                self.cfg.demo_mode = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.demo_mode else "0")
            elif key == "CONFIRM_LIVE_SEND":
                self.cfg.confirm_live_send = bool(value)
                set_config_value(self.cfg, key, "1" if self.cfg.confirm_live_send else "0")
            elif key == "API_KEY_GPG_FILE":
                self.cfg.api_key_gpg_file = expand_path(str(value))
                set_config_value(self.cfg, key, str(self.cfg.api_key_gpg_file))
            self.status = f"saved option: {key}"

        while True:
            fields = current_fields()
            selected = max(0, min(selected, len(fields) - 1))
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            body_h = max(1, height - 6)
            if selected < top_index:
                top_index = selected
            elif selected >= top_index + body_h:
                top_index = selected - body_h + 1

            self.safe_addstr(0, 0, "OPTIONS", width, self.reverse_attr())
            help_line = "Space=toggle | Enter=edit | s=save edit | Esc/q=return | F-keys jump screens"
            if editing:
                help_line = "Editing inline: Enter/s=save | Esc=cancel edit | Backspace=delete"
            self.safe_addstr(1, 0, help_line, width, self.dim_attr())
            self.safe_addstr(2, 0, "_" * width, width, self.dim_attr())

            for row in range(body_h):
                idx = top_index + row
                if idx >= len(fields):
                    break
                field = fields[idx]
                attr = self.reverse_attr() if idx == selected else 0
                if field["kind"] == "bool":
                    mark = "[x]" if field["value"] else "[ ]"
                    line = f"{mark} {field['label']}"
                else:
                    val = str(field["value"])
                    if editing and idx == selected:
                        val = edit_value
                    line = f"{field['label']:<24} [{val}]"
                self.safe_addstr(3 + row, 0, line, width, attr)

            self.safe_addstr(height - 2, 0, "_" * width, width, self.dim_attr())
            if editing:
                self.safe_addstr(height - 1, 0, f"Editing {fields[selected]['key']}: {edit_value}", width, self.reverse_attr())
            else:
                self.safe_addstr(height - 1, 0, f"{selected + 1}/{len(fields)}  Config: {self.cfg.config_file}", width, self.reverse_attr())
            self.stdscr.refresh()

            ch = self.stdscr.getch()
            if self.handle_global_hotkey(ch, current_action="options"):
                return
            field = fields[selected]

            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - MOUSE_SCROLL_LINES)
                elif delta < 0:
                    selected = min(len(fields) - 1, selected + MOUSE_SCROLL_LINES)
                elif self.mouse_button1(state) and 3 <= y < 3 + body_h:
                    idx = top_index + (y - 3)
                    if 0 <= idx < len(fields):
                        selected = idx
                        if self.mouse_button1_double(state):
                            ch = 10
                else:
                    continue

            if editing:
                if ch in (27,):
                    editing = False
                    edit_value = ""
                    continue
                if ch in (10, 13, curses.KEY_ENTER, ord("s"), ord("S")):
                    apply_field(field["key"], edit_value)
                    editing = False
                    edit_value = ""
                    continue
                if ch in (curses.KEY_BACKSPACE, 127, 8):
                    edit_value = edit_value[:-1]
                    continue
                if ch == curses.KEY_DC:
                    continue
                if 32 <= ch <= 126:
                    edit_value += chr(ch)
                    continue
                continue

            if ch in (27, ord("q"), ord("Q")):
                return
            if ch in (curses.KEY_UP, ord("k")):
                selected = max(0, selected - 1)
            elif ch in (curses.KEY_DOWN, ord("j")):
                selected = min(len(fields) - 1, selected + 1)
            elif ch == curses.KEY_PPAGE:
                selected = max(0, selected - body_h)
            elif ch == curses.KEY_NPAGE:
                selected = min(len(fields) - 1, selected + body_h)
            elif ch == curses.KEY_HOME:
                selected = 0
            elif ch == curses.KEY_END:
                selected = len(fields) - 1
            elif ch in (ord(" "),):
                if field["kind"] == "bool":
                    apply_field(field["key"], not bool(field["value"]))
            elif ch in (10, 13, curses.KEY_ENTER):
                if field["kind"] == "bool":
                    apply_field(field["key"], not bool(field["value"]))
                elif field["kind"] == "choice":
                    # Choice fields are not free-form strings.  SEND_INPUT is
                    # the main example: users should choose from supported send
                    # gestures rather than typing labels like ctrl_g manually.
                    # The chooser also gives us room to document terminal-
                    # dependent options such as ctrl_enter without pretending
                    # every terminal can distinguish them.
                    chosen = self.choice_modal(
                        f"CHOOSE {field['key']}",
                        "Choose one supported value.  ctrl_enter depends on terminal support.",
                        field.get("choices", []),
                        str(field["value"]),
                    )
                    if chosen is not None:
                        apply_field(field["key"], chosen)
                else:
                    editing = True
                    edit_value = str(field["value"])

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_memory_menu
    # Maintainer note for open_memory_menu: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_memory_menu(self) -> None:
        """Open the memory/context tools menu.

        Terminal-physics note for future maintainers:
        this screen is visually a small menu, not a transcript.  It should
        therefore behave like every other small menu in ttychatter: Up/Down,
        j/k, mousewheel, click, Enter, and global F-keys all work.  Earlier
        versions accepted only letter shortcuts here, which made this screen
        feel like a trap compared with F5 Options.  Consistency matters more
        than saving a few lines of code because users often navigate by muscle
        memory, in the dark, or on cramped keyboards.
        """
        choices = [
            ("v", "view memory"),
            ("e", "edit memory in external editor"),
            ("c", "clear memory"),
            ("r", "rebuild memory from log"),
            ("q", "return to chat"),
        ]
        selected = 0
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 5)
            self.safe_addstr(0, 0, "MEMORY MENU", width, self.reverse_attr())
            self.safe_addstr(1, 0, f"Context entries: {len(self.context_buffer)} | CONTEXT_TURNS={self.cfg.context_turns}", width)
            self.safe_addstr(2, 0, "Enter=select | j/k move | Esc/q=return | F-keys jump", width, self.dim_attr())
            self.safe_addstr(3, 0, "_" * width, width, self.dim_attr())
            selected = max(0, min(selected, len(choices) - 1))
            for row, (_key, label) in enumerate(choices[:visible_h]):
                attr = self.reverse_attr() if row == selected else 0
                self.safe_addstr(4 + row, 0, f"{_key}  {label}", width, attr)
            self.stdscr.refresh()
            ch = self.stdscr.getch()
            if self.handle_global_hotkey(ch, current_action="memory"):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - MOUSE_SCROLL_LINES)
                    continue
                if delta < 0:
                    selected = min(len(choices) - 1, selected + MOUSE_SCROLL_LINES)
                    continue
                if self.mouse_button1(state) and 4 <= y < 4 + len(choices):
                    selected = y - 4
                    ch = 10
                else:
                    continue
            if ch in (27, ord("q"), ord("Q")):
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
                continue
            if ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(choices) - 1, selected + 1)
                continue
            if ch in (10, 13, curses.KEY_ENTER):
                action = choices[selected][0]
            else:
                action = chr(ch).lower() if 0 <= ch < 256 else ""

            if action == "v":
                self.show_message("CURRENT MEMORY", self.context_buffer or ["Memory is empty."])
            elif action == "e":
                edited = self.run_external_editor("\n".join(self.context_buffer))
                if edited is not None:
                    self.context_buffer = [line for line in edited.splitlines() if line.strip()]
                    self.trim_context_buffer()
                    self.save_context_snapshot()
                    self.status = "memory edited and snapshot saved"
                    return
            elif action == "c":
                if self.ask_yes_no("CLEAR MEMORY", "Clear current memory context? Logs are not deleted.", default=False):
                    self.context_buffer = []
                    self.save_context_snapshot()
                    self.status = "memory cleared"
                    return
            elif action == "r":
                self.context_buffer = []
                entries = load_log_entries(self.session_path)
                snapshot = latest_context_snapshot(entries)
                if snapshot:
                    self.context_buffer = snapshot
                else:
                    max_entries = self.cfg.context_turns * 2
                    for entry in entries[-max_entries:]:
                        if is_snapshot_entry(entry) or entry.speaker == "system":
                            continue
                        self.context_buffer.append(("Assistant: " if entry.speaker == "AI" else "User: ") + entry.text)
                self.trim_context_buffer()
                self.status = "memory rebuilt from log"
                return

    # ------------------------------------------------------------
    def file_picker(self, start_dir: Path, title: str) -> Optional[Path]:
        current = start_dir.expanduser().resolve()
        selected = 0
        top_index = 0
        while True:
            try:
                entries = [current.parent] + sorted(current.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower()))
            except OSError as exc:
                self.show_message(title, [f"Cannot read directory: {exc}"])
                return None
            selected = min(selected, len(entries) - 1)
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 5)
            self.safe_addstr(0, 0, title, width, self.reverse_attr())
            self.safe_addstr(1, 0, f"Directory: {current}", width)
            self.safe_addstr(2, 0, "Enter=open/select | Esc/q=cancel | wheel=scroll", width, self.dim_attr())
            if selected < top_index: top_index = selected
            elif selected >= top_index + visible_h: top_index = selected - visible_h + 1
            for row in range(visible_h):
                idx = top_index + row
                if idx >= len(entries): break
                p = entries[idx]
                label = "../" if idx == 0 else (p.name + ("/" if p.is_dir() else ""))
                attr = self.reverse_attr() if idx == selected else 0
                self.safe_addstr(3 + row, 0, label, width, attr)
            self.stdscr.refresh()
            ch = self.stdscr.getch()
            if self.handle_global_hotkey(ch, current_action="files"):
                return None
            if ch == curses.KEY_MOUSE:
                try: _mid, _x, y, _z, state = curses.getmouse()
                except curses.error: continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0: selected = max(0, selected - MOUSE_SCROLL_LINES)
                elif delta < 0: selected = min(len(entries) - 1, selected + MOUSE_SCROLL_LINES)
                elif self.mouse_button1(state) and 3 <= y < 3 + visible_h:
                    idx = top_index + (y - 3)
                    if 0 <= idx < len(entries): selected = idx
                continue
            if ch in (27, ord("q"), ord("Q")): return None
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
            elif ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(entries) - 1, selected + 1)
            elif ch in (10, 13, curses.KEY_ENTER):
                chosen = entries[selected]
                if chosen.is_dir():
                    current = chosen.resolve(); selected = 0; top_index = 0
                else:
                    return chosen

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def quick_attach_file
    # Ctrl+T uses this helper to expose the most common file workflow without
    # forcing the user through the full F7 file menu.  The shortcut deliberately
    # reuses the same file picker and PendingAttachment object as F7 so the
    # application has one attachment pipeline rather than two subtly different
    # pipelines.  If future ports add drag/drop, paste-from-clipboard, or richer
    # file browsers, keep them feeding this same pending-attachment list.
    # ------------------------------------------------------------
    def quick_attach_file(self) -> None:
        path = self.file_picker(Path.cwd(), "ATTACH FILE")
        if path:
            self.pending_attachments.append(PendingAttachment(path, guess_mime(path)))
            self.status = f"attached file for next request: {path.name}"

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_file_menu
    # File and attachment workflow. Keep user-visible file actions explicit because media
    # compatibility depends on the chosen model/API behavior.
    # ------------------------------------------------------------
    def open_file_menu(self) -> None:
        choices = [
            ("a", "attach file for next AI request"),
            ("l", "list pending files"),
            ("c", "clear pending files"),
            ("b", "browse saved attachment directory"),
            ("q", "cancel"),
        ]
        selected = 0
        while True:
            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            self.safe_addstr(0, 0, "FILES / ATTACHMENTS", width, self.reverse_attr())
            self.safe_addstr(1, 0, f"Pending files: {len(self.pending_attachments)}", width)
            self.safe_addstr(2, 0, "Enter=select | Esc/q=cancel | wheel=move", width, self.dim_attr())
            self.safe_addstr(3, 0, "_" * width, width, self.dim_attr())
            visible_h = max(1, height - 5)
            for row, (_key, label) in enumerate(choices[:visible_h]):
                attr = self.reverse_attr() if row == selected else 0
                self.safe_addstr(4 + row, 0, f"{_key}  {label}", width, attr)
            self.stdscr.refresh()

            ch = self.stdscr.getch()
            if self.handle_global_hotkey(ch, current_action="files"):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - 1)
                elif delta < 0:
                    selected = min(len(choices) - 1, selected + 1)
                elif self.mouse_button1(state) and 4 <= y < 4 + len(choices):
                    selected = y - 4
                    ch = 10
                else:
                    continue

            if ch in (27, ord("q"), ord("Q")):
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1)
                continue
            if ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(choices) - 1, selected + 1)
                continue
            if ch in (10, 13, curses.KEY_ENTER):
                action = choices[selected][0]
            else:
                action = chr(ch).lower() if 0 <= ch < 256 else ""

            if action == "a":
                path = self.file_picker(Path.cwd(), "ATTACH FILE")
                if path:
                    self.pending_attachments.append(PendingAttachment(path, guess_mime(path)))
                    self.status = f"attached file for next request: {path.name}"
                    return
            elif action == "l":
                self.show_message("PENDING FILES", [f"{p.path} ({p.mime_type})" for p in self.pending_attachments] or ["No pending files."])
            elif action == "c":
                self.pending_attachments = []
                self.status = "pending files cleared"
                return
            elif action == "b":
                path = self.file_picker(self.attachment_dir, "BROWSE SAVED ATTACHMENTS")
                if path and self.ask_yes_no("OPEN FILE", f"Open {path.name} in external editor/viewer?", default=True):
                    self.run_external_editor(path.read_text(encoding="utf-8", errors="replace") if path.stat().st_size < 2_000_000 else f"Binary/large file: {path}")
                    return

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def detected_editors
    # Maintainer note for detected_editors: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def detected_editors(self) -> List[Tuple[str, str]]:
        """Return common editors that are actually runnable from PATH.

        The project goal is a friendly terminal client, so F8 should not assume
        the user remembers the exact path to their editor. This helper finds
        common editors with shutil.which(), which answers the practical
        question: can this command be launched from this terminal session?
        """
        names = ["nvim", "vim", "vi", "micro", "nano", "pico", "emacs", "mg", "joe", "jed", "ed"]
        found: List[Tuple[str, str]] = []
        seen = set()
        for name in names:
            path = shutil.which(name)
            if path and path not in seen:
                found.append((name, path))
                seen.add(path)
        return found

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def browse_for_editor
    # Maintainer note for browse_for_editor: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def browse_for_editor(self) -> Optional[str]:
        """Browse common executable directories for an editor command.

        This is intentionally similar to an old "Run... Browse" dialog: the
        user can select an executable file without typing its full path.
        """
        for start in [Path("/usr/bin"), Path("/bin"), Path("/usr/local/bin"), Path.home()]:
            if start.exists():
                chosen = self.file_browser("BROWSE FOR EDITOR EXECUTABLE", start)
                if chosen is not None:
                    return str(chosen)
        return None

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_editor_menu
    # External editor chooser. This supports Unix-style composition workflows similar to mail
    # clients such as mutt.
    # ------------------------------------------------------------
    def open_editor_menu(self) -> None:
        """Open a menu for choosing, saving, browsing, and launching editors.

        Earlier versions launched the configured editor immediately. That was
        too abrupt and not friendly to users who are not sure which editor is
        available. The menu preserves the mutt-style external editor workflow
        while making the editor choice discoverable.
        """
        selected = 0
        custom_editor = self.cfg.effective_editor
        while True:
            detected = self.detected_editors()
            items: List[Tuple[str, str, str]] = []
            for name, path in detected:
                items.append((name, f"{name} ({path})", path))
            items.extend([
                ("custom", f"Enter custom editor command/path (current: {custom_editor})", "__custom__"),
                ("browse", "Browse for editor executable", "__browse__"),
                ("save", f"Save current editor to config: {custom_editor}", "__save__"),
                ("open", "Open current prompt in current editor", "__open__"),
                ("quit", "Return to chat", "__quit__"),
            ])

            self.stdscr.erase()
            height, width = self.stdscr.getmaxyx()
            visible_h = max(1, height - 5)
            self.safe_addstr(0, 0, "EDITOR MENU", width, self.reverse_attr())
            self.safe_addstr(1, 0, "Enter/click=choose | F-keys jump screens | Esc/q=return", width, self.dim_attr())
            self.safe_addstr(2, 0, f"Effective editor: {self.cfg.effective_editor}", width)
            self.safe_addstr(3, 0, "_" * width, width, self.dim_attr())
            selected = max(0, min(selected, len(items) - 1))
            for row, (name, label, _value) in enumerate(items[:visible_h]):
                attr = self.reverse_attr() if row == selected else 0
                self.safe_addstr(4 + row, 0, f"{name:<10} {label}", width, attr)
            self.stdscr.refresh()

            ch = self.stdscr.getch()
            if self.handle_global_hotkey(ch, current_action="editor"):
                return
            if ch == curses.KEY_MOUSE:
                try:
                    _mid, _x, y, _z, state = curses.getmouse()
                except curses.error:
                    continue
                delta = self.mouse_wheel_delta(state)
                if delta > 0:
                    selected = max(0, selected - MOUSE_SCROLL_LINES); continue
                if delta < 0:
                    selected = min(len(items) - 1, selected + MOUSE_SCROLL_LINES); continue
                if self.mouse_button1(state) and 4 <= y < 4 + min(visible_h, len(items)):
                    selected = y - 4
                    ch = 10
                else:
                    continue
            if ch in (27, ord("q"), ord("Q")):
                self.status = "editor menu closed"
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                selected = max(0, selected - 1); continue
            if ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                selected = min(len(items) - 1, selected + 1); continue
            if ch not in (10, 13, curses.KEY_ENTER):
                continue

            _name, _label, value = items[selected]
            if value == "__quit__":
                self.status = "editor menu closed"
                return
            if value == "__custom__":
                entered = self.text_input_modal("CUSTOM EDITOR", "Enter editor command or executable path.", initial=custom_editor)
                if entered:
                    custom_editor = entered
                    self.cfg.editor = entered
                    self.status = f"editor selected: {entered}"
                continue
            if value == "__browse__":
                chosen = self.browse_for_editor()
                if chosen:
                    custom_editor = chosen
                    self.cfg.editor = chosen
                    self.status = f"editor selected: {chosen}"
                continue
            if value == "__save__":
                if custom_editor:
                    set_config_value(self.cfg, "EDITOR", custom_editor)
                    self.cfg.editor = custom_editor
                    self.status = f"editor saved: {custom_editor}"
                continue
            if value == "__open__":
                selected_editor = custom_editor
            else:
                selected_editor = value
                custom_editor = value
                self.cfg.editor = value
                self.status = f"editor selected: {value}"

            old_editor = self.cfg.editor
            self.cfg.editor = selected_editor
            edited = self.run_external_editor(self.current_input())
            self.cfg.editor = old_editor if value == "__open__" else self.cfg.editor
            if edited is not None:
                self.input_lines = edited.rstrip("\n").splitlines() or [""]
                self.cursor_row = len(self.input_lines) - 1
                self.cursor_col = len(self.input_lines[-1])
                self.status = "input loaded from external editor"
            return

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def open_external_editor_for_input
    # Maintainer note for open_external_editor_for_input: this routine is part of the long-term
    # public behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def open_external_editor_for_input(self) -> None:
        self.open_editor_menu()

    # ------------------------------------------------------------------
    # Input editing and sending
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def insert_text
    # Maintainer note for insert_text: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def insert_text(self, text: str) -> None:
        line = self.input_lines[self.cursor_row]
        self.input_lines[self.cursor_row] = line[: self.cursor_col] + text + line[self.cursor_col:]
        self.cursor_col += len(text)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def insert_newline
    # Maintainer note for insert_newline: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def insert_newline(self) -> None:
        line = self.input_lines[self.cursor_row]
        self.input_lines[self.cursor_row] = line[: self.cursor_col]
        self.input_lines.insert(self.cursor_row + 1, line[self.cursor_col:])
        self.cursor_row += 1
        self.cursor_col = 0

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def backspace
    # Maintainer note for backspace: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def backspace(self) -> None:
        if self.cursor_col > 0:
            line = self.input_lines[self.cursor_row]
            self.input_lines[self.cursor_row] = line[: self.cursor_col - 1] + line[self.cursor_col:]
            self.cursor_col -= 1
        elif self.cursor_row > 0:
            previous_len = len(self.input_lines[self.cursor_row - 1])
            self.input_lines[self.cursor_row - 1] += self.input_lines[self.cursor_row]
            del self.input_lines[self.cursor_row]
            self.cursor_row -= 1
            self.cursor_col = previous_len

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def delete_forward
    # Maintainer note for delete_forward: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def delete_forward(self) -> None:
        line = self.input_lines[self.cursor_row]
        if self.cursor_col < len(line):
            self.input_lines[self.cursor_row] = line[: self.cursor_col] + line[self.cursor_col + 1:]
        elif self.cursor_row < len(self.input_lines) - 1:
            self.input_lines[self.cursor_row] += self.input_lines[self.cursor_row + 1]
            del self.input_lines[self.cursor_row + 1]

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def move_left
    # Maintainer note for move_left: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def move_left(self) -> None:
        if self.cursor_col > 0: self.cursor_col -= 1
        elif self.cursor_row > 0: self.cursor_row -= 1; self.cursor_col = len(self.input_lines[self.cursor_row])

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def move_right
    # Maintainer note for move_right: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def move_right(self) -> None:
        line = self.input_lines[self.cursor_row]
        if self.cursor_col < len(line): self.cursor_col += 1
        elif self.cursor_row < len(self.input_lines) - 1: self.cursor_row += 1; self.cursor_col = 0

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def move_up
    # Maintainer note for move_up: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def move_up(self) -> None:
        if self.cursor_row > 0:
            self.cursor_row -= 1; self.cursor_col = min(self.cursor_col, len(self.input_lines[self.cursor_row]))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def move_down
    # Maintainer note for move_down: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def move_down(self) -> None:
        if self.cursor_row < len(self.input_lines) - 1:
            self.cursor_row += 1; self.cursor_col = min(self.cursor_col, len(self.input_lines[self.cursor_row]))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def clear_input
    # Maintainer note for clear_input: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def clear_input(self) -> None:
        self.input_lines = [""]; self.cursor_row = 0; self.cursor_col = 0; self.input_scroll = 0

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def current_input
    # Maintainer note for current_input: this routine is part of the long-term public behavior
    # of the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def current_input(self) -> str:
        return "\n".join(self.input_lines).strip("\n")

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def send_current_message
    # Message send path. This is where UI text becomes session log entries, memory context,
    # AI request parts, and visible transcript output.
    # ------------------------------------------------------------
    def send_current_message(self) -> None:
        message = self.current_input()
        if not message.strip() and not self.pending_attachments:
            self.status = "empty message ignored"
            self.clear_input()
            return
        if not message.strip() and self.pending_attachments:
            message = "Please review the attached file(s)."

        if (not self.cfg.demo_mode) and self.cfg.confirm_live_send and (not self.cfg.live_send_confirmed):
            if not self.ask_yes_no(
                "LIVE OPENROUTER REQUEST",
                "This will send a real chat request to OpenRouter. Use --demo to test the interface without network chat calls. Continue?",
                default=False,
            ):
                self.status = "live send cancelled; run with --demo for offline testing"
                return
            self.cfg.live_send_confirmed = True

        user_time = now_time()
        attachment_note = ""
        if self.pending_attachments:
            attachment_note = "\n[Pending attachments sent: " + ", ".join(p.path.name for p in self.pending_attachments) + "]"
        self.transcript.append(TranscriptItem(self.username, message + attachment_note, user_time))
        append_log(self.session_path, self.username, message + attachment_note, user_time)
        self.context_buffer.append("User: " + message + attachment_note)
        self.trim_context_buffer()
        self.clear_input()
        self.transcript_scroll = 0
        self.status = "Generating response..."
        self.draw()

        context = self.build_context()
        prompt_text = (context + "\n" if context else "") + "User: " + message
        attachments_to_send = list(self.pending_attachments)
        raw_output = call_ai(self.cfg, prompt_text, self.session_name, self.attachment_dir, attachments_to_send)
        self.pending_attachments = []

        openrouter_time = now_time()
        append_log(self.session_path, "AI", raw_output, openrouter_time)
        cleaned_output = extract_code_attachments(raw_output, self.attachment_dir, self.session_name, self.cfg.code_attachment_min_lines)
        if self.cfg.loopback_file is not None:
            try:
                self.cfg.loopback_file.parent.mkdir(parents=True, exist_ok=True)
                with self.cfg.loopback_file.open("a", encoding="utf-8") as loopback_fh:
                    loopback_fh.write(cleaned_output + "\n")
            except OSError as exc:
                self.status = f"loopback file write failed: {exc}"

        self.context_buffer.append("Assistant: " + cleaned_output)
        self.trim_context_buffer()
        self.save_context_snapshot()
        self.transcript.append(TranscriptItem("AI", cleaned_output, openrouter_time))
        self.status = "response complete"

    # ------------------------------------------------------------------
    # Command dispatch
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def action_for_function_key
    # Maintainer note for action_for_function_key: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def action_for_function_key(self, ch: int) -> Optional[str]:
        mapping = {
            curses.KEY_F1: "help",
            curses.KEY_F2: "models",
            curses.KEY_F3: "api-key",
            curses.KEY_F4: "sessions",
            curses.KEY_F5: "options",
            curses.KEY_F6: "memory",
            curses.KEY_F7: "files",
            curses.KEY_F8: "editor",
            curses.KEY_F9: "credits",
            curses.KEY_F10: "quit",
        }
        return mapping.get(ch)

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def dispatch_command_action
    # Maintainer note for dispatch_command_action: this routine is part of the long-term public
    # behavior of the program. When changing it, check callers, documentation, config
    # compatibility, session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def dispatch_command_action(self, action: str) -> None:
        if action == "help":
            self.open_help()
        elif action == "doctor":
            self.open_doctor()
        elif action == "models":
            self.open_model_selector()
        elif action == "api-key":
            self.open_api_key_input()
        elif action == "sessions":
            self.open_session_browser()
        elif action == "options":
            self.open_options_menu()
        elif action == "memory":
            self.open_memory_menu()
        elif action == "files":
            self.open_file_menu()
        elif action == "editor":
            self.open_external_editor_for_input()
        elif action == "credits":
            self.open_credits()
        elif action == "quit":
            self.should_quit = True

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def handle_global_hotkey
    # Global function-key routing. This is critical for usability: users should be able to jump
    # from any feature screen to any other feature screen without first escaping back to the
    # main chat.
    # ------------------------------------------------------------
    def handle_global_hotkey(self, ch: int, current_action: Optional[str] = None) -> bool:
        """Allow F-key navigation from feature screens.

        A user looking at F1/F2/F5/etc. screens should be able to jump
        directly to another screen by pressing that function key. The only
        exception is pressing the function key for the screen already open;
        that is ignored to avoid recursive redraw loops.
        """
        action = self.action_for_function_key(ch)
        if not action:
            return False
        if current_action is not None and action == current_action:
            return False
        self.dispatch_command_action(action)
        return True

    # ------------------------------------------------------------------
    # Main event loop
    # ------------------------------------------------------------------

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def handle_key
    # Maintainer note for handle_key: this routine is part of the long-term public behavior of
    # the program. When changing it, check callers, documentation, config compatibility,
    # session-log compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def handle_key(self, ch: int) -> None:
        if ch == curses.KEY_MOUSE:
            self.handle_mouse()
            return

        action = self.action_for_function_key(ch)
        if action:
            self.dispatch_command_action(action)
            return

        if ch == 7:  # Ctrl+G remains a reliable send key. F5 is Options, not send.
            self.send_current_message()
            return

        if ch == 20:  # Ctrl+T = quick attach file.  Mnemonic: Transfer/Tack-on.
            self.quick_attach_file()
            return

        if ch == 17:  # Ctrl+Q
            self.should_quit = True
            return
        if ch == curses.KEY_ENTER and self.cfg.send_input == "ctrl_enter":
            # Ctrl+Enter is terminal-dependent: many terminal emulators collapse
            # it into ordinary Enter. If curses reports a distinct KEY_ENTER,
            # honor it here; otherwise users should choose enter or ctrl_g.
            self.send_current_message()
        elif ch in (10, 13, curses.KEY_ENTER):
            if self.cfg.send_input == "enter":
                self.send_current_message()
            else:
                self.insert_newline()
        elif ch in (curses.KEY_BACKSPACE, 127, 8): self.backspace()
        elif ch == curses.KEY_DC: self.delete_forward()
        elif ch == curses.KEY_LEFT: self.move_left()
        elif ch == curses.KEY_RIGHT: self.move_right()
        elif ch == curses.KEY_UP: self.move_up()
        elif ch == curses.KEY_DOWN: self.move_down()
        elif ch == curses.KEY_HOME: self.cursor_col = 0
        elif ch == curses.KEY_END: self.cursor_col = len(self.input_lines[self.cursor_row])
        elif ch == curses.KEY_PPAGE: self.transcript_scroll += 10
        elif ch == curses.KEY_NPAGE: self.transcript_scroll = max(0, self.transcript_scroll - 10)
        elif ch == 21: self.clear_input()
        elif ch == 12: pass
        elif ch == 9: self.insert_text("    ")
        elif 32 <= ch <= 126: self.insert_text(chr(ch))

    # ------------------------------------------------------------
    # MAINTAINER COMMENTARY: def run
    # Maintainer note for run: this routine is part of the long-term public behavior of the
    # program. When changing it, check callers, documentation, config compatibility, session-log
    # compatibility, and the parallel Bash/C implementation plans.
    # ------------------------------------------------------------
    def run(self, stdscr: curses.window) -> None:
        self.stdscr = stdscr
        curses.noecho(); curses.cbreak(); stdscr.keypad(True)
        mouse_mask = curses.ALL_MOUSE_EVENTS | getattr(curses, "REPORT_MOUSE_POSITION", 0)
        try: curses.mousemask(mouse_mask)
        except curses.error: pass
        self.load_session_into_ui()
        if not self.cfg.api_key: self.status = "No API key loaded. Press F3 to paste one."
        elif not self.cfg.model: self.status = "No MODEL configured. Press F2 to choose/test one."
        while not self.should_quit:
            self.draw()
            try: ch = stdscr.getch()
            except KeyboardInterrupt: break
            self.handle_key(ch)


# ---------------------------------------------------------------------------
# Program entry point
# ---------------------------------------------------------------------------



def resolve_session_argument(cfg: Config, value: str) -> Tuple[str, Path]:
    """Resolve --resume values in user-friendly ways.

    Accept all of these forms so shell tab-completion is useful:
        --resume notes
        --resume notes.log
        --resume /path/to/notes.log
    """
    raw = Path(os.path.expanduser(value))
    if raw.suffix == ".log" or "/" in value:
        path = raw if raw.is_absolute() else (Path.cwd() / raw)
        return sanitize_session_name(path.stem), path
    name = sanitize_session_name(value)
    return name, cfg.session_dir / f"{name}.log"

# ------------------------------------------------------------
# MAINTAINER COMMENTARY: def main
# Program bootstrap. Keep this thin: parse args, prepare config/dirs, run simple non-interactive
# commands, then hand control to curses.
# ------------------------------------------------------------
def main() -> int:
    args = parse_args()
    if args.version:
        print(f"{PROGRAM} version {VERSION}")
        return 0

    cfg = load_config()
    if args.demo:
        cfg.demo_mode = True
        if not cfg.model:
            cfg.model = "demo/auto"
    if args.loopback_file:
        cfg.loopback_file = expand_path(args.loopback_file)
    cfg.session_dir.mkdir(parents=True, exist_ok=True)
    cfg.effective_attachment_dir.mkdir(parents=True, exist_ok=True)

    if args.list:
        list_sessions(cfg.session_dir)
        return 0
    if args.model_type:
        cfg.model_type_filter = args.model_type
    if args.routers:
        cfg.model_type_filter = "routers"
        return print_models(cfg)
    if args.models:
        return print_models(cfg)
    if args.update_models:
        return update_models_command(cfg)
    if args.doctor:
        return print_doctor(cfg)
    if args.test_model:
        return print_model_test(cfg, args.test_model)
    if args.resume and args.session_name:
        print("error: use either a session name or --resume, not both", file=sys.stderr)
        return 2

    if args.resume:
        session_name, session_path = resolve_session_argument(cfg, args.resume)
        if not session_path.exists():
            print(f"error: session not found: {session_name}", file=sys.stderr)
            return 1
    elif args.session_name:
        session_name = sanitize_session_name(args.session_name)
        session_path = cfg.session_dir / f"{session_name}.log"
    else:
        session_name = default_session_name()
        session_path = cfg.session_dir / f"{session_name}.log"

    app = AICursesApp(cfg, session_name, session_path)
    try:
        curses.wrapper(app.run)
    except KeyboardInterrupt:
        return 0
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
